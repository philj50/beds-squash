---
import Base from '@/layouts/Base.astro';
import JuniorAdminMenu from '@/components/JuniorAdminMenu.astro';
import JuniorClosedPoster from '@/components/JuniorClosedPoster.astro';
import JuniorClosedQr from '@/components/JuniorClosedQr.astro';
import { getClubs } from '@/lib/content';
import { AGE_REFERENCE, ENTRY_CLOSES, TOURNAMENT_ON } from '@/lib/junior-age';
import { url } from '@/lib/site';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';

const clubs = (await getClubs()).map((club) => club.data.name);
---

<Base
  title="Junior County Closed entry"
  description="Enter the Bedfordshire Junior County Closed. A parent or guardian signs the player up, and the age group is worked out from the date of birth."
  crumbs={[
    { name: 'Juniors', path: '/juniors/' },
    { name: 'Junior County Closed', path: '/juniors/closed/' },
  ]}
>
  <section class="section">
    <div class="container closed" id="closed-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <div class="closed__layout">
        <div>
          <p class="eyebrow">Juniors</p>
          <h1>Junior County Closed</h1>
          <JuniorAdminMenu />
          <JuniorClosedQr showEnter={false} />
          <p class="lede">
            Sunday 8th November, 10am–5pm at Towers Health &amp; Racquets Club. Entry is free. Entries close on Wednesday 28th October. A parent or guardian enters the player here. The age group is worked out from the date of birth, using age on {AGE_REFERENCE}.
          </p>
          <JuniorClosedPoster />
          <ul class="categories">
            <li>Mixed U9</li>
            <li>Girls U11</li>
            <li>Girls U13</li>
            <li>Girls U15</li>
            <li>Girls U17</li>
            <li>Girls U19</li>
            <li>Boys U11</li>
            <li>Boys U13</li>
            <li>Boys U15</li>
            <li>Boys U17</li>
            <li>Boys U19</li>
          </ul>
          <p class="note">*actual categories we run and format will depend on entry number</p>
          <p class="lede">Any queries please email <a href="mailto:bsrajunior@gmail.com">bsrajunior@gmail.com</a>.</p>
          <p class="status" data-status role="status"></p>
          <p class="thanks" data-thanks hidden>Entry received. The organiser has these details. Nothing has been emailed.</p>

          <form class="card entry-form" data-form>
            <div class="card__body stack">
              <h2>Player</h2>
              <div class="pair">
                <label>First name <input name="player_first_name" required maxlength="60" autocomplete="given-name" /></label>
                <label>Last name <input name="player_last_name" required maxlength="60" autocomplete="family-name" /></label>
              </div>
              <label>Date of birth <input name="date_of_birth" type="date" required min="2007-11-09" max={TOURNAMENT_ON} /></label>
              <p class="category" data-category>Choose a date of birth to see the age group.</p>
              <label data-section>
                Section
                <select name="draw" required data-draw>
                  <option value="">Choose</option>
                  <option>Boys</option>
                  <option>Girls</option>
                </select>
              </label>
              <label>
                Club
                <input name="club" required minlength="2" maxlength="80" list="clubs" autocomplete="organization" />
              </label>
              <datalist id="clubs">
                {clubs.map((name) => <option value={name} />)}
              </datalist>

              <h2>Parent or guardian</h2>
              <label>Name <input name="guardian_name" required minlength="2" maxlength="80" autocomplete="name" /></label>
              <div class="pair">
                <label>Email <input name="guardian_email" type="email" required autocomplete="email" /></label>
                <label>Phone <input name="guardian_phone" type="tel" required minlength="8" maxlength="20" autocomplete="tel" /></label>
              </div>

              <h2>Emergency contact</h2>
              <div class="pair">
                <label>Name <input name="emergency_name" required minlength="2" maxlength="80" autocomplete="off" /></label>
                <label>Phone <input name="emergency_phone" type="tel" required minlength="8" maxlength="20" autocomplete="off" /></label>
              </div>
              <label>Anything the organiser should know <textarea name="notes" maxlength="500" rows="3"></textarea></label>
              <label class="check">
                <input name="guardian_confirmed" type="checkbox" required />
                <span>I am the parent or guardian of this player, and I agree to the <a href={url('/documents/code-of-conduct-juniors/')}>junior code of conduct</a> and the <a href={url('/documents/code-of-conduct-parents/')}>parents’ code of conduct</a>.</span>
              </label>
              <label class="trap" aria-hidden="true">Company <input name="company" tabindex="-1" autocomplete="off" /></label>
              <button class="btn btn--primary" type="submit">Enter</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { ageCategory, ENTRY_CLOSES, entryLabel } from '@/lib/junior-age';

  const root = document.getElementById('closed-app');
  if (!root) throw new Error('entry form missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const form = root.querySelector<HTMLFormElement>('[data-form]')!;
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const thanks = root.querySelector<HTMLElement>('[data-thanks]')!;
  const categoryEl = root.querySelector<HTMLElement>('[data-category]')!;
  const dob = form.querySelector<HTMLInputElement>('[name="date_of_birth"]')!;
  const draw = form.querySelector<HTMLSelectElement>('[data-draw]')!;
  const section = form.querySelector<HTMLElement>('[data-section]')!;

  const londonToday = () =>
    new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/London', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());

  const showCategory = () => {
    const mixed = draw.querySelector('option[value="Mixed"]');
    if (!dob.value) {
      categoryEl.textContent = 'Choose a date of birth to see the age group.';
      return;
    }
    const category = ageCategory(dob.value);
    if (!category) {
      categoryEl.textContent = 'That date of birth is outside the junior age groups, so this player cannot be entered.';
      return;
    }
    if (category === 'Under 9') {
      if (!mixed) draw.add(new Option('Mixed', 'Mixed'));
      draw.value = 'Mixed';
      section.hidden = true;
      categoryEl.textContent = 'Age group: Mixed U9';
      return;
    }
    mixed?.remove();
    if (draw.value === 'Mixed') draw.value = '';
    section.hidden = false;
    categoryEl.textContent =
      draw.value === 'Boys' || draw.value === 'Girls'
        ? `Age group: ${entryLabel(category, draw.value)}`
        : 'Choose Boys or Girls to see the age group.';
  };
  dob.addEventListener('change', showCategory);
  draw.addEventListener('change', showCategory);
  if (londonToday() > ENTRY_CLOSES) {
    form.hidden = true;
    statusEl.textContent = 'Entries closed on Wednesday 28th October.';
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    if (String(data.get('company') ?? '').trim()) {
      form.hidden = true;
      thanks.hidden = false;
      return;
    }
    if (londonToday() > ENTRY_CLOSES) {
      statusEl.textContent = 'Entries closed on Wednesday 28th October.';
      return;
    }
    const dateOfBirth = String(data.get('date_of_birth'));
    const category = ageCategory(dateOfBirth);
    const sectionChoice = category === 'Under 9' ? 'Mixed' : String(data.get('draw'));
    if (!category || (sectionChoice !== 'Boys' && sectionChoice !== 'Girls' && sectionChoice !== 'Mixed')) {
      statusEl.textContent = 'That date of birth is outside the junior age groups.';
      return;
    }
    statusEl.textContent = 'Sending the entry…';
    const { error } = await supabase.from('junior_entries').insert({
      player_first_name: String(data.get('player_first_name')).trim(),
      player_last_name: String(data.get('player_last_name')).trim(),
      date_of_birth: dateOfBirth,
      age_category: category,
      draw: sectionChoice,
      club: String(data.get('club')).trim(),
      guardian_name: String(data.get('guardian_name')).trim(),
      guardian_email: String(data.get('guardian_email')).trim(),
      guardian_phone: String(data.get('guardian_phone')).trim(),
      emergency_name: String(data.get('emergency_name')).trim(),
      emergency_phone: String(data.get('emergency_phone')).trim(),
      notes: String(data.get('notes') ?? '').trim() || null,
      guardian_confirmed: true,
    });
    if (error) {
      statusEl.textContent = error.code === '23505' ? 'This player is already entered.' : error.message;
      return;
    }
    statusEl.textContent = '';
    form.hidden = true;
    thanks.hidden = false;
  });
</script>

<style>
  .closed {
    max-width: 64rem;
  }
  .closed__layout {
    display: block;
  }
  .lede {
    color: var(--ink-200);
  }
  .categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 0.2rem 1rem;
    margin: 0.75rem 0;
    padding-left: 1.1rem;
  }
  .note {
    margin: 0 0 0.75rem;
    color: var(--ink-200);
    font-size: 0.9rem;
  }
  .stack {
    display: grid;
    gap: 0.75rem;
  }
  .pair {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .pair {
      grid-template-columns: 1fr 1fr;
    }
  }
  label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  [data-section][hidden] {
    display: none;
  }
  input,
  select,
  textarea {
    width: 100%;
    background: var(--ink-900);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.75rem;
    font: inherit;
  }
  .check {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }
  .check input {
    width: auto;
    margin-top: 0.2rem;
    background: #fff;
    color: var(--text);
  }
  .category {
    margin: 0;
    color: var(--gold-400);
    font-weight: 600;
  }
  .status:empty {
    display: none;
  }
  .status,
  .thanks {
    margin: 1rem 0;
  }
  .trap {
    position: absolute;
    left: -10000px;
    height: 0;
    overflow: hidden;
  }
  .junior-admin {
    margin: 0.4rem 0 0.8rem;
  }
  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.cookie-notice),
    .entry-form,
    .lede,
    .status,
    .thanks,
    .no-print {
      display: none !important;
    }
    .closed__layout {
      display: block;
    }
  }
</style>
