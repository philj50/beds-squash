---
import Base from '@/layouts/Base.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { url } from '@/lib/site';
---

<Base title="Junior County Closed entries" description="Organiser list of Junior County Closed entries." noindex>
  <section class="section">
    <div class="container entries" id="entries-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <h1>Junior County Closed entries</h1>
      <p class="lede">Player details stay on this page. An admin can correct every field on an entry. Saving or removing an entry sends a short note to the Junior organisers. It does not send an email.</p>
      <p class="status" data-status role="status"></p>

      <div data-panel="signed-in" hidden>
        <p class="who" data-who></p>
        <p class="actions">
          <a class="btn btn--ghost btn--sm" href={url('/juniors/closed/')}>Entry page</a>
          <a class="btn btn--ghost btn--sm" href={url('/captains/admin/')}>Admin</a>
          <a class="btn btn--ghost btn--sm" href={url('/captains/profile/')}>Profile</a>
          <button class="btn btn--ghost btn--sm" type="button" data-sign-out>Sign out</button>
        </p>
        <p data-denied hidden>This account cannot see entries.</p>
        <div data-list hidden></div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { loadAccount, noteActivity, organisesGroup, privateStop, sendToLogin, stopMessage } from '@/lib/account';
  import { ENTRY_GROUPS } from '@/lib/junior-age';

  type Entry = {
    id: number;
    player_first_name: string;
    player_last_name: string;
    date_of_birth: string;
    age_category: string;
    draw: string;
    club: string;
    guardian_name: string;
    guardian_email: string;
    guardian_phone: string;
    emergency_name: string;
    emergency_phone: string;
    notes: string | null;
    show_name?: boolean;
    created_at: string;
  };

  const root = document.getElementById('entries-app');
  if (!root) throw new Error('entries app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const signedIn = root.querySelector<HTMLElement>('[data-panel="signed-in"]')!;
  const list = root.querySelector<HTMLElement>('[data-list]')!;
  const denied = root.querySelector<HTMLElement>('[data-denied]')!;
  const whoEl = root.querySelector<HTMLElement>('[data-who]')!;

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);

  const when = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

  root.querySelector('[data-sign-out]')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    await showSession();
  });

  function editField(label: string, hint: string, control: string, tag = 'Editable') {
    return `<label class="field"><span class="field__name">${label} <span class="field__tag">${tag}</span></span>${control}<span class="field__hint">${hint}</span></label>`;
  }

  function editor(entry: Entry, columns: number) {
    const section = ['Boys', 'Girls', 'Mixed']
      .map((option) => `<option${entry.draw === option ? ' selected' : ''}>${option}</option>`)
      .join('');
    return `<tr data-editor-row="${entry.id}" hidden><td colspan="${columns}"><form class="stack editor" data-editor="${entry.id}">
      <p class="editor__lead">Change any field, then save. The age group follows the date of birth. Under 9 is saved as Mixed.</p>
      <div class="pair">
        ${editField('First name', 'The junior who is playing.', `<input name="player_first_name" required maxlength="60" value="${escapeHtml(entry.player_first_name)}" autocomplete="off" />`)}
        ${editField('Last name', 'The family name of the junior.', `<input name="player_last_name" required maxlength="60" value="${escapeHtml(entry.player_last_name)}" autocomplete="off" />`)}
      </div>
      <div class="pair">
        ${editField('Date of birth', 'This sets the age group.', `<input name="date_of_birth" type="date" required value="${escapeHtml(entry.date_of_birth)}" />`)}
        ${editField('Section', 'Boys, Girls, or Mixed for Under 9.', `<select name="draw">${section}</select>`)}
      </div>
      ${editField('Club', 'The club the junior plays for.', `<input name="club" required minlength="2" maxlength="80" value="${escapeHtml(entry.club)}" autocomplete="off" />`)}
      <h3>Parent or guardian</h3>
      ${editField('Parent name', 'The parent or guardian.', `<input name="guardian_name" required minlength="2" maxlength="80" value="${escapeHtml(entry.guardian_name)}" autocomplete="off" />`)}
      <div class="pair">
        ${editField('Parent email', 'Where the organiser can write.', `<input name="guardian_email" type="email" required maxlength="120" value="${escapeHtml(entry.guardian_email)}" autocomplete="off" />`)}
        ${editField('Parent phone', 'A number for the parent.', `<input name="guardian_phone" type="tel" required minlength="8" maxlength="20" value="${escapeHtml(entry.guardian_phone)}" autocomplete="off" />`)}
      </div>
      <h3>Emergency contact</h3>
      <div class="pair">
        ${editField('Emergency name', 'Who to call in an emergency.', `<input name="emergency_name" required minlength="2" maxlength="80" value="${escapeHtml(entry.emergency_name)}" autocomplete="off" />`)}
        ${editField('Emergency phone', 'A number for that contact.', `<input name="emergency_phone" type="tel" required minlength="8" maxlength="20" value="${escapeHtml(entry.emergency_phone)}" autocomplete="off" />`)}
      </div>
      ${editField('Notes', 'Anything the organiser should know. Leave this blank if there is nothing to add.', `<textarea name="notes" maxlength="500" rows="3">${escapeHtml(entry.notes ?? '')}</textarea>`, 'Optional')}
      ${editField('Public name', 'Tick this to show the first name and surname initial on the public junior page.', `<input name="show_name" type="checkbox"${entry.show_name ? ' checked' : ''} />`, 'Optional')}
      <p class="actions"><button class="btn btn--primary btn--sm" type="submit">Save changes</button><button class="btn btn--ghost btn--sm" type="button" data-cancel>Cancel</button></p>
    </form></td></tr>`;
  }

  list.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const edit = target.closest<HTMLButtonElement>('[data-edit]');
    if (edit?.dataset.edit) {
      const formRow = list.querySelector<HTMLElement>(`[data-editor-row="${edit.dataset.edit}"]`);
      if (formRow) formRow.hidden = false;
      return;
    }
    const cancel = target.closest<HTMLButtonElement>('[data-cancel]');
    if (cancel) {
      const formRow = cancel.closest<HTMLElement>('[data-editor-row]');
      if (formRow) formRow.hidden = true;
      return;
    }
    const button = target.closest<HTMLButtonElement>('[data-remove]');
    if (!button) return;
    const name = button.dataset.name ?? 'this player';
    if (!confirm(`Remove ${name} from the entry list?`)) return;
    const { error } = await supabase.from('junior_entries').delete().eq('id', Number(button.dataset.remove));
    if (error) statusEl.textContent = error.message;
    else await showSession();
  });

  list.addEventListener('submit', async (event) => {
    const form = (event.target as HTMLElement).closest<HTMLFormElement>('[data-editor]');
    if (!form?.dataset.editor) return;
    event.preventDefault();
    const data = new FormData(form);
    const text = (name: string) => String(data.get(name) ?? '').trim().replace(/\s+/g, ' ');
    const first = text('player_first_name');
    const last = text('player_last_name');
    const dateOfBirth = String(data.get('date_of_birth') ?? '');
    const draw = String(data.get('draw') ?? '');
    const club = text('club');
    const guardian = text('guardian_name');
    const email = String(data.get('guardian_email') ?? '').trim();
    const guardianPhone = text('guardian_phone');
    const emergency = text('emergency_name');
    const emergencyPhone = text('emergency_phone');
    const notes = String(data.get('notes') ?? '').trim();
    if (!first || !last || first.length > 60 || last.length > 60) {
      statusEl.textContent = "Add the junior's first and last name.";
      return;
    }
    if (club.length < 2 || club.length > 80) {
      statusEl.textContent = 'Add the club.';
      return;
    }
    if (guardian.length < 2 || guardian.length > 80) {
      statusEl.textContent = 'Add the parent or guardian.';
      return;
    }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) || email.length > 120) {
      statusEl.textContent = 'Add a parent email.';
      return;
    }
    if (guardianPhone.length < 8 || guardianPhone.length > 20 || emergencyPhone.length < 8 || emergencyPhone.length > 20) {
      statusEl.textContent = 'Add a phone number.';
      return;
    }
    if (emergency.length < 2 || emergency.length > 80) {
      statusEl.textContent = 'Add an emergency contact.';
      return;
    }
    if (notes.length > 500) {
      statusEl.textContent = 'Keep the notes to 500 characters.';
      return;
    }
    statusEl.textContent = 'Saving…';
    const { error } = await supabase.rpc('edit_junior_entry', {
      p_id: Number(form.dataset.editor),
      p_first_name: first,
      p_last_name: last,
      p_date_of_birth: dateOfBirth,
      p_draw: draw,
      p_club: club,
      p_guardian_name: guardian,
      p_guardian_email: email,
      p_guardian_phone: guardianPhone,
      p_emergency_name: emergency,
      p_emergency_phone: emergencyPhone,
      p_notes: notes || null,
      p_show_name: form.querySelector<HTMLInputElement>('[name="show_name"]')?.checked === true,
    });
    if (error) {
      statusEl.textContent = error.message;
      return;
    }
    statusEl.textContent = 'Saved.';
    await showSession();
  });

  async function showSession() {
    const { data } = await supabase.auth.getSession();
    const session = data.session;
    signedIn.hidden = !session;
    if (!session) {
      list.hidden = true;
      denied.hidden = true;
      sendToLogin();
      return;
    }
    whoEl.textContent = `Signed in as ${session.user.email ?? 'organiser'}`;
    const account = await loadAccount(supabase);
    if (account) {
      const stop = await privateStop(supabase, account);
      if (stop) {
        denied.hidden = false;
        denied.textContent = stopMessage(stop);
        list.hidden = true;
        return;
      }
    }
    if (account?.playerOnly || !(await organisesGroup(supabase, session.user.id, 'junior_organisers'))) {
      denied.hidden = false;
      denied.textContent = 'This account cannot see entries.';
      list.hidden = true;
      return;
    }
    denied.hidden = true;
    void noteActivity(supabase);
    const { data: rows, error } = await supabase
      .from('junior_entries')
      .select('id, player_first_name, player_last_name, date_of_birth, age_category, draw, club, guardian_name, guardian_email, guardian_phone, emergency_name, emergency_phone, notes, show_name, created_at')
      .order('player_last_name');
    if (error) {
      statusEl.textContent = error.message;
      return;
    }
    const entries = (rows ?? []) as Entry[];
    const canEdit = Boolean(account?.isAdmin);
    list.hidden = false;
    const placed = new Set<number>();
    const sections = ENTRY_GROUPS.map((category) => {
      const group = entries.filter((entry) => entry.age_category === category.age && entry.draw === category.draw);
      for (const entry of group) placed.add(entry.id);
      const section = document.createElement('section');
      section.innerHTML = `
            <h2>${escapeHtml(category.label)} <span class="muted">(${group.length})</span></h2>
            ${
              group.length
                ? `<div class="table-wrap"><table>
                    <thead><tr><th>Player</th><th>Born</th><th>Club</th><th>Parent</th><th>Emergency</th><th>Notes</th><th>Public name</th><th></th></tr></thead>
                    <tbody>${group
                      .map((entry) => {
                        const player = `${entry.player_first_name} ${entry.player_last_name}`;
                        const edit = canEdit ? `<button class="btn btn--ghost btn--sm" type="button" data-edit="${entry.id}">Edit</button>` : '';
                        const publicName = entry.show_name ? 'Yes' : 'No';
                        return `<tr>
                          <td>${escapeHtml(player)}</td>
                          <td>${escapeHtml(when.format(new Date(`${entry.date_of_birth}T12:00:00`)))}</td>
                          <td>${escapeHtml(entry.club)}</td>
                          <td>${escapeHtml(entry.guardian_name)}<br><span class="muted">${escapeHtml(entry.guardian_email)}</span><br><span class="muted">${escapeHtml(entry.guardian_phone)}</span></td>
                          <td>${escapeHtml(entry.emergency_name)}<br><span class="muted">${escapeHtml(entry.emergency_phone)}</span></td>
                          <td>${escapeHtml(entry.notes ?? '')}</td>
                          <td>${publicName}</td>
                          <td class="row-actions">${edit}<button class="btn btn--ghost btn--sm" type="button" data-remove="${entry.id}" data-name="${escapeHtml(player)}">Remove</button></td>
                        </tr>${canEdit ? editor(entry, 8) : ''}`;
                      })
                      .join('')}</tbody>
                  </table></div>`
                : '<p class="muted">No entries.</p>'
            }`;
      return section;
    });
    const leftover = entries.filter((entry) => !placed.has(entry.id));
    if (leftover.length) {
      const section = document.createElement('section');
      section.innerHTML = `
        <h2>Other <span class="muted">(${leftover.length})</span></h2>
        <div class="table-wrap"><table>
          <thead><tr><th>Player</th><th>Born</th><th>Category</th><th>Club</th><th>Parent</th><th>Emergency</th><th>Notes</th><th>Public name</th><th></th></tr></thead>
          <tbody>${leftover
            .map((entry) => {
              const player = `${entry.player_first_name} ${entry.player_last_name}`;
              const edit = canEdit ? `<button class="btn btn--ghost btn--sm" type="button" data-edit="${entry.id}">Edit</button>` : '';
              const publicName = entry.show_name ? 'Yes' : 'No';
              return `<tr>
                <td>${escapeHtml(player)}</td>
                <td>${escapeHtml(when.format(new Date(`${entry.date_of_birth}T12:00:00`)))}</td>
                <td>${escapeHtml(entry.draw)} ${escapeHtml(entry.age_category)}</td>
                <td>${escapeHtml(entry.club)}</td>
                <td>${escapeHtml(entry.guardian_name)}<br><span class="muted">${escapeHtml(entry.guardian_email)}</span><br><span class="muted">${escapeHtml(entry.guardian_phone)}</span></td>
                <td>${escapeHtml(entry.emergency_name)}<br><span class="muted">${escapeHtml(entry.emergency_phone)}</span></td>
                <td>${escapeHtml(entry.notes ?? '')}</td>
                <td>${publicName}</td>
                <td class="row-actions">${edit}<button class="btn btn--ghost btn--sm" type="button" data-remove="${entry.id}" data-name="${escapeHtml(player)}">Remove</button></td>
              </tr>${canEdit ? editor(entry, 9) : ''}`;
            })
            .join('')}</tbody>
        </table></div>`;
      sections.push(section);
    }
    list.replaceChildren(...sections);
  }

  showSession();
</script>

<style is:global>
  #entries-app {
    max-width: 72rem;
  }
  #entries-app .lede {
    color: var(--ink-200);
  }
  #entries-app .stack {
    display: grid;
    gap: 0.75rem;
  }
  #entries-app label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  #entries-app label.check {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }
  #entries-app input,
  #entries-app select,
  #entries-app textarea {
    width: 100%;
    background: var(--ink-900);
    color: #fff;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.75rem;
    font: inherit;
  }
  #entries-app .pair {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 700px) {
    #entries-app .pair {
      grid-template-columns: 1fr 1fr;
    }
  }
  #entries-app .editor {
    margin: 0.4rem 0 0.8rem;
    padding: 1rem;
    border: 2px solid var(--accent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg-card));
  }
  #entries-app .editor__lead,
  #entries-app .editor h3 {
    margin: 0;
  }
  #entries-app .field__name {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
  }
  #entries-app .field__tag {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  #entries-app .field__hint {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  #entries-app .editor input,
  #entries-app .editor select,
  #entries-app .editor textarea,
  html[data-theme='navy'] #entries-app .editor input,
  html[data-theme='navy'] #entries-app .editor select,
  html[data-theme='navy'] #entries-app .editor textarea,
  html[data-theme='light'] #entries-app .editor input,
  html[data-theme='light'] #entries-app .editor select,
  html[data-theme='light'] #entries-app .editor textarea {
    background: #fff;
    color: #163556;
    color-scheme: light;
    border: 2px solid var(--accent);
  }
  #entries-app .editor input[type='checkbox'],
  html[data-theme='navy'] #entries-app .editor input[type='checkbox'],
  html[data-theme='light'] #entries-app .editor input[type='checkbox'] {
    width: 1.1rem;
    min-width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.15rem;
    padding: 0;
    justify-self: start;
  }
  #entries-app .row-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  #entries-app [hidden] {
    display: none !important;
  }
  #entries-app .status:empty {
    display: none;
  }
  #entries-app .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  #entries-app h2 {
    margin-top: 1.5rem;
  }
  #entries-app .table-wrap {
    overflow-x: auto;
  }
  #entries-app table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  #entries-app th,
  #entries-app td {
    text-align: left;
    vertical-align: middle;
    line-height: 1.25;
    padding: 0.2rem 0.4rem;
    border-bottom: 1px solid var(--border);
  }
</style>
