---
import Base from '@/layouts/Base.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { url } from '@/lib/site';

const profileHref = url('/captains/profile/');
---

<Base title="Log in" description="Sign in to your Bedfordshire Squash account." noindex>
  <section class="section">
    <div
      class="container login"
      id="login-app"
      data-url={SUPABASE_URL}
      data-key={SUPABASE_PUBLISHABLE_KEY}
      data-profile={profileHref}
    >
      <h1>Log in</h1>
      <p class="lede">Use the email or login and the password you were given. After you sign in, change the password on your profile. Nothing is emailed.</p>
      <p class="status" data-status role="status"></p>
      <form id="login" class="card" method="post" action={url('/login/')} data-form="sign-in">
        <div class="card__body stack">
          <div class="field">
            <label for="username">Email or login</label>
            <input id="username" name="username" type="text" autocomplete="username" required autocapitalize="none" autocorrect="off" spellcheck="false" placeholder="Email or login" />
          </div>
          <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required placeholder="Password" />
          </div>
          <button class="btn btn--primary" type="submit">Log in</button>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';

  const root = document.getElementById('login-app');
  if (!root) throw new Error('login app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const profileHref = root.dataset.profile!;
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

  function safeNext(raw: string | null) {
    if (!raw || raw.includes('://') || raw.includes('\\') || raw.startsWith('//') || raw.includes('/login')) return profileHref;
    if (base && !raw.startsWith(`${base}/`)) return profileHref;
    if (!base && !raw.startsWith('/')) return profileHref;
    return raw;
  }

  const nextHref = safeNext(new URLSearchParams(location.search).get('next'));
  const form = root.querySelector<HTMLFormElement>('[data-form="sign-in"]')!;

  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.getRegistrations().then((regs) => {
      regs.forEach((reg) => {
        reg.unregister();
      });
    });
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    let email = String(data.get('username') ?? '').trim();
    if (email.toLowerCase() === 'bsca') email = 'county-admin@players.invalid';
    const password = String(data.get('password') ?? '');
    statusEl.textContent = 'Signing in…';
    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) {
      statusEl.textContent = error.message;
      return;
    }
    await supabase.rpc('record_my_sign_in');

    // Chrome saves a password when a sign-in finishes like this:
    // the address changes, and the password form is gone.
    // https://www.chromium.org/developers/design-documents/create-amazing-password-forms/
    history.pushState({}, '', nextHref);
    form.remove();
    statusEl.textContent = 'Signed in. If Chrome asks to save the password, choose Save.';
    window.setTimeout(() => location.reload(), 4000);
  });

  const { data } = await supabase.auth.getSession();
  if (data.session) location.replace(nextHref);
</script>

<style>
  .login {
    max-width: 28rem;
  }
  .lede {
    color: var(--ink-200);
  }
  .status:empty {
    display: none;
  }
  .status {
    margin: 1rem 0;
    color: var(--gold-400);
  }
  .stack {
    display: grid;
    gap: 0.75rem;
  }
  .field {
    display: grid;
    gap: 0.3rem;
  }
  label {
    font-size: 0.9rem;
  }
  input {
    width: 100%;
    background: var(--ink-900);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.75rem;
    font: inherit;
  }
</style>
