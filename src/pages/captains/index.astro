---
import Base from '@/layouts/Base.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
---

<Base
  title="Squad"
  description="Sign in to manage your squad, fixtures, availability and team selection for Bedfordshire squash leagues."
  noindex
>
  <section class="section section--tight">
    <div class="container captain" id="captain-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <h1>Squad</h1>
      <p class="lede">
        Captains add players to the squad and set each player's email. Nothing is emailed.
        Players mark whether they can play on
        <a href={`${import.meta.env.BASE_URL}captains/matches/`}>Matches</a>.
        Your name, team and password are on your <a href={`${import.meta.env.BASE_URL}captains/profile/`}>profile</a>.
        A county admin creates each account.
      </p>
      <p class="status" data-status role="status"></p>

      <div data-panel="signed-in" hidden>
        <p class="who" data-who></p>
        <p class="actions">
          <a class="btn btn--primary btn--sm" href={`${import.meta.env.BASE_URL}captains/matches/`}>Matches</a>
          <a class="btn btn--ghost btn--sm" data-admin-link hidden href={`${import.meta.env.BASE_URL}captains/admin/`}>Administration</a>
          <a class="btn btn--ghost btn--sm" href={`${import.meta.env.BASE_URL}captains/profile/`}>Profile</a>
          <button class="btn btn--ghost btn--sm" type="button" data-sign-out>Sign out</button>
        </p>

        <div class="card" data-unassigned hidden>
          <div class="card__body">
            <h2>No team yet</h2>
            <p class="muted">An admin matches your account to a team. When that is done, you can add players here.</p>
          </div>
        </div>

        <div class="card" data-player-only hidden>
          <div class="card__body">
            <h2>Your team</h2>
            <p data-player-places></p>
            <p class="muted">Mark whether you can play on <a href={`${import.meta.env.BASE_URL}captains/matches/`}>Matches</a>. Your captain looks after the squad list and the playing order.</p>
          </div>
        </div>

        <div data-squads></div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { loadAccount, sendToLogin } from '@/lib/account';

  const root = document.getElementById('captain-app');
  if (!root) throw new Error('captain app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const signedIn = root.querySelector<HTMLElement>('[data-panel="signed-in"]')!;
  const squadHost = root.querySelector<HTMLElement>('[data-squads]')!;
  const unassigned = root.querySelector<HTMLElement>('[data-unassigned]')!;
  const playerOnlyPanel = root.querySelector<HTMLElement>('[data-player-only]')!;
  const playerPlaces = root.querySelector<HTMLElement>('[data-player-places]')!;
  const adminLink = root.querySelector<HTMLElement>('[data-admin-link]')!;
  const whoEl = root.querySelector<HTMLElement>('[data-who]')!;

  const setStatus = (message: string) => {
    statusEl.textContent = message;
  };

  root.querySelector('[data-sign-out]')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    await showSession();
  });

  squadHost.addEventListener('submit', async (event) => {
    const form = event.target as HTMLFormElement;
    if (!form.matches('[data-form="player"]')) return;
    event.preventDefault();
    const data = new FormData(form);
    const email = String(data.get('email') ?? '').trim();
    const phone = String(data.get('phone') ?? '').trim();
    const { error } = await supabase.from('squad_players').insert({
      squad_id: Number(form.dataset.squadId),
      display_name: String(data.get('display_name')).trim(),
      email: email || null,
      phone: phone || null,
    });
    if (error) {
      setStatus(error.message);
      return;
    }
    form.reset();
    setStatus('');
    await showSession();
  });

  squadHost.addEventListener('focusout', async (event) => {
    const input = (event.target as HTMLElement).closest<HTMLInputElement>('[data-player-email]');
    if (!input) return;
    const email = input.value.trim().toLowerCase();
    if (email === (input.dataset.saved ?? '')) return;
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setStatus('Enter a valid email, or leave it blank.');
      return;
    }
    const name = input.dataset.playerName || 'this player';
    setStatus('Saving email…');
    const { error } = await supabase.from('squad_players').update({ email: email || null }).eq('id', Number(input.dataset.playerEmail));
    if (error) {
      setStatus(error.message);
      return;
    }
    input.dataset.saved = email;
    setStatus(`Email saved for ${name}.`);
  });

  squadHost.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-player]');
    if (!button) return;
    const { error } = await supabase.from('squad_players').delete().eq('id', Number(button.dataset.removePlayer));
    if (error) setStatus(error.message);
    else await showSession();
  });

  async function showSession() {
    const account = await loadAccount(supabase);
    signedIn.hidden = !account;
    if (!account) {
      squadHost.replaceChildren();
      unassigned.hidden = true;
      playerOnlyPanel.hidden = true;
      adminLink.hidden = true;
      sendToLogin();
      return;
    }
    whoEl.textContent = `Signed in as ${account.displayName || account.email}`;
    adminLink.hidden = !account.isAdmin;
    if (account.playerOnly) {
      squadHost.replaceChildren();
      unassigned.hidden = true;
      playerOnlyPanel.hidden = false;
      playerPlaces.textContent = account.places.map((place) => place.label).join('. ') || 'Your team is not set yet.';
      return;
    }
    playerOnlyPanel.hidden = true;

    const { data: squads, error } = await supabase
      .from('captain_squads')
      .select('id, name, squad_players (id, display_name, email, england_squash_id, phone)')
      .order('created_at', { ascending: true });
    if (error) {
      setStatus(error.message);
      return;
    }
    unassigned.hidden = (squads ?? []).length > 0;
    squadHost.replaceChildren(
      ...(squads ?? []).map((squad) => {
        const card = document.createElement('article');
        card.className = 'card';
        const players = ((squad.squad_players ?? []) as { id: number; display_name: string; email: string | null; phone: string | null; england_squash_id: string | null }[])
          .slice()
          .sort((a, b) => a.display_name.localeCompare(b.display_name, 'en'));
        const rows = players.length
          ? players
              .map(
                (player) =>
                  `<tr>` +
                  `<td>${escapeHtml(player.display_name)}</td>` +
                  `<td><input data-player-email="${player.id}" data-player-name="${escapeHtml(player.display_name)}" data-saved="${escapeHtml(player.email ?? '')}" aria-label="Email for ${escapeHtml(player.display_name)}" type="email" value="${escapeHtml(player.email ?? '')}" autocomplete="off" /></td>` +
                  `<td>${player.england_squash_id ? escapeHtml(player.england_squash_id) : '<span class="muted">—</span>'}</td>` +
                  `<td>${player.phone ? escapeHtml(player.phone) : '<span class="muted">—</span>'}</td>` +
                  `<td class="col-remove"><button class="btn btn--ghost btn--sm" type="button" data-remove-player="${player.id}">Remove</button></td>` +
                  `</tr>`,
              )
              .join('')
          : '<tr class="empty"><td colspan="4">No players yet.</td><td class="col-remove"></td></tr>';
        card.innerHTML = `
          <div class="card__body">
            <h2>${escapeHtml(squad.name)}</h2>
            <form data-form="player" data-squad-id="${squad.id}">
              <div class="table-wrap">
                <table class="squad-table">
                  <colgroup>
                    <col class="col-name" />
                    <col class="col-email" />
                    <col class="col-es" />
                    <col class="col-phone" />
                    <col class="col-remove" />
                  </colgroup>
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Email</th>
                      <th>ES number</th>
                      <th>Phone</th>
                      <th class="col-remove">Remove</th>
                    </tr>
                  </thead>
                  <tbody>${rows}</tbody>
                  <tfoot>
                    <tr>
                      <td><input name="display_name" aria-label="Name" placeholder="Name" required minlength="2" maxlength="80" autocomplete="off" /></td>
                      <td><input name="email" aria-label="Email" placeholder="Email" type="email" autocomplete="off" /></td>
                      <td></td>
                      <td><input name="phone" aria-label="Phone" placeholder="Phone" type="tel" autocomplete="off" /></td>
                      <td class="col-remove"><button class="btn btn--primary btn--sm" type="submit">Add</button></td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </form>
          </div>`;
        return card;
      }),
    );
  }

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
  }

  showSession();
</script>

<style>
  .captain {
    max-width: 960px;
  }
  .captain h1 {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    margin-bottom: 0.35rem;
  }
  .test-flag {
    border: 1px solid var(--gold-500);
    color: var(--gold-400);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    margin: 0 0 1.25rem;
  }
  .lede {
    color: var(--ink-200);
  }
  .status:empty {
    display: none;
  }
  .status {
    margin: 1rem 0;
    color: var(--gold-400);
  }
  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .stack {
    display: grid;
    gap: 0.75rem;
  }
  label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  input {
    width: 100%;
    background: var(--ink-900);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.75rem;
    font: inherit;
  }
  .check input {
    width: auto;
  }
  .pw-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .small {
    font-size: 0.85rem;
    margin: 0;
  }
  .who {
    margin-bottom: 0.5rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }
  [data-squads] {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }
</style>

<style is:global>
  #captain-app [data-squads] .table-wrap {
    border: 2px solid var(--gold-500);
    border-radius: var(--radius);
    background: var(--ink-800);
    overflow-x: auto;
    margin-top: 0.75rem;
  }
  #captain-app .squad-table {
    width: 100%;
    min-width: 48rem;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 0.84rem;
    line-height: 1.25;
  }
  #captain-app .squad-table .col-name {
    width: 22%;
  }
  #captain-app .squad-table .col-email {
    width: 30%;
  }
  #captain-app .squad-table .col-es {
    width: 14%;
  }
  #captain-app .squad-table .col-phone {
    width: 18%;
  }
  #captain-app .squad-table .col-remove {
    width: 8.5rem;
  }
  #captain-app .squad-table th,
  #captain-app .squad-table td {
    text-align: left;
    vertical-align: middle;
    padding: 0.2rem 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    overflow-wrap: anywhere;
  }
  #captain-app .squad-table th {
    color: var(--gold-400);
    font-weight: 700;
    background: var(--ink-700);
    white-space: nowrap;
  }
  #captain-app .squad-table tbody tr:nth-child(odd) td {
    background: rgba(255, 255, 255, 0.03);
  }
  #captain-app .squad-table .col-remove,
  #captain-app .squad-table th.col-remove,
  #captain-app .squad-table td.col-remove {
    width: 8.5rem;
    text-align: center;
    white-space: nowrap;
    overflow-wrap: normal;
  }
  #captain-app .squad-table tfoot td {
    background: var(--ink-900);
  }
  #captain-app .squad-table input {
    width: 100%;
    min-width: 0;
    background: var(--ink-950);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.28rem 0.4rem;
    font: inherit;
  }
  #captain-app .squad-table .empty td {
    color: var(--ink-200);
  }
</style>
