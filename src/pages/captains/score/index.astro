---
import Base from '@/layouts/Base.astro';
import closed2026 from '@/data/sportmgr/945811.json';
import closed2027 from '@/data/sportmgr/1244761.json';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';

const names = [
  ...new Set(
    [...closed2027.entries, ...closed2026.entries]
      .map((entry) => entry.name?.trim())
      .filter((name): name is string => Boolean(name)),
  ),
].sort((a, b) => a.localeCompare(b, 'en'));
---

<Base
  title="Score a match"
  description="Mark a squash match on Beds Squash. PAR to 11, win by two, best of five."
  noindex
  crumbs={[{ name: 'Score a match', path: '/captains/score/' }]}
>
  <section class="section">
    <div class="container score" id="score-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <h1>Score a match</h1>
      <p class="lede">
        Pick the two players, then tap the player who won the rally. PAR to 11, win by two, best of five. Tick Let people watch and the match is listed under Current matches, so anyone on the site can follow it. The rally runs down the middle, and a clock runs for each game. After a game the board says Next game, then counts a 90 second rest. The first serve is from the right. Change it to the left when that is the box. The same player then serves from the other side. Hand out means the other player serves, from the right unless you change it. A let is played again. A stroke gives the point to the player you tap. The score stays on Beds Squash for an admin to check. It is not sent to Sport Manager.
      </p>
      <p class="status" data-status role="status"></p>
      <p class="signin" data-signin hidden>
        <a data-login href="/login/">Sign in</a>
        to keep the score on the site and to let other people watch. You can still mark a match on this browser first.
      </p>

      <div class="current">
        <div class="recent-head">
          <h2>Current matches</h2>
          <label class="share">
            <input type="checkbox" data-refresh />
            Auto refresh
          </label>
          <label class="share">
            <input type="checkbox" data-say />
            Say the score
          </label>
        </div>
        <p class="current-note" data-current-note></p>
        <ol class="recent" data-current></ol>
      </div>

      <form class="card setup" data-setup>
        <div class="card__body stack">
          <label>
            Player A
            <span class="picker">
              <input name="player-a" autocomplete="off" autocapitalize="words" required placeholder="First player" />
              <div class="picks" data-picks="a" hidden></div>
            </span>
            <span class="sl-note" data-sl="a" hidden></span>
          </label>
          <label>
            Player B
            <span class="picker">
              <input name="player-b" autocomplete="off" autocapitalize="words" required placeholder="Second player" />
              <div class="picks" data-picks="b" hidden></div>
            </span>
            <span class="sl-note" data-sl="b" hidden></span>
          </label>
          <label class="share">
            <input type="checkbox" data-share />
            Let people watch this match
          </label>
          <button class="btn btn--primary" type="submit">Start match</button>
        </div>
      </form>

      <div class="board" data-board hidden>
        <div class="topbar">
          <p class="game-no" data-game-no>Game 1/5</p>
          <div class="top-actions">
            <button class="btn btn--ghost btn--sm" type="button" data-let>Let</button>
            <button class="btn btn--ghost btn--sm" type="button" data-stroke aria-pressed="false">Stroke</button>
            <button class="btn btn--ghost btn--sm" type="button" data-undo>Undo</button>
          </div>
        </div>
        <p class="call" data-call aria-live="polite"></p>
        <div class="pills">
          <button class="pill pill--a" type="button" data-side="a">
            <span class="who" data-name="a"></span>
            <span class="level" data-level="a"></span>
          </button>
          <button class="pill pill--b" type="button" data-side="b">
            <span class="who" data-name="b"></span>
            <span class="level" data-level="b"></span>
          </button>
        </div>
        <div class="game-counts" data-game-counts hidden>
          <span data-games-label="a"></span>
          <span data-games-label="b"></span>
        </div>
        <div class="prior" data-prior hidden></div>
        <div class="court">
          <button class="side side--a" type="button" data-side="a">
            <span class="points" data-points="a">0</span>
          </button>
          <div class="middle">
            <div class="reel" data-tape></div>
            <button class="rest-badge" type="button" data-rest hidden>Next game</button>
          </div>
          <button class="side side--b" type="button" data-side="b">
            <span class="points" data-points="b">0</span>
          </button>
        </div>
        <div class="foot">
          <div class="foot-copy">
            <p class="clock" data-clock>00:00</p>
            <p data-serve-who></p>
          </div>
          <button class="serve-pip" type="button" data-box-toggle aria-label="Service box R">R</button>
        </div>
        <p class="line" data-line></p>
        <p class="actions">
          <label class="share share--board">
            <input type="checkbox" data-share />
            Let people watch
          </label>
          <label class="share share--board">
            <input type="checkbox" data-say />
            Say the score
          </label>
          <button class="btn btn--ghost btn--sm" type="button" data-hand>Other player serves</button>
          <button class="btn btn--primary" type="button" data-save hidden>Save score</button>
          <button class="btn btn--ghost" type="button" data-new>New match</button>
          <button class="btn btn--ghost" type="button" data-back>Back to current matches</button>
        </p>
        <p class="watch-marker" data-watch-marker hidden></p>
      </div>

      <section class="public-watch" data-public-watch hidden>
        <p class="public-watch__names"><span data-public-a></span> v <span data-public-b></span></p>
        <p class="public-watch__score" data-public-score></p>
        <p class="watch-marker" data-public-marker hidden></p>
        <p class="current-note" data-public-note>Sign in to see the full names and the point-by-point score.</p>
        <p class="actions">
          <label class="share">
            <input type="checkbox" data-say />
            Say the score
          </label>
        </p>
        <p class="actions">
          <button class="btn btn--ghost" type="button" data-public-back>Back to current matches</button>
        </p>
      </section>

      <section class="result-card" data-result hidden>
        <p class="result-kicker">Beds Squash</p>
        <div class="result-players">
          <p data-result-a></p>
          <p data-result-b></p>
        </div>
        <p class="result-score" data-result-score></p>
        <div class="result-sheet" data-result-sheet></div>
        <p class="result-marker" data-result-marker></p>
        <p class="result-link" data-result-link-row hidden>
          <a data-result-link href=""></a>
        </p>
        <p class="current-note" data-result-note></p>
        <p class="actions">
          <button class="btn btn--primary" type="button" data-result-pic>Save picture</button>
          <button class="btn btn--ghost" type="button" data-result-copy hidden>Copy link</button>
        </p>
      </section>

      <div class="recent-head">
        <h2>Marked here</h2>
        <button class="btn btn--ghost btn--sm" type="button" data-clear hidden>Clear</button>
      </div>
      <ol class="recent" data-recent></ol>
      <script id="score-names" type="application/json" is:inline set:html={JSON.stringify(names)}></script>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import {
    addLet,
    addPoint,
    addStroke,
    canChooseServer,
    cleanName,
    currentGame,
    currentRallies,
    finishedGames,
    freshMatch,
    gameStem,
    gamesWon,
    hasRallies,
    legalMatch,
    markerCall,
    matchWinner,
    otherPlayer,
    publicPlayerName,
    restoreMatch,
    scoreLine,
    setBox,
    setServer,
    spokenMark,
    spokenScoreLine,
    undoPoint,
    type Game,
    type ScoreState,
    type Side,
  } from '@/lib/scoreboard';

  type Marked = {
    id: number | string;
    playerA: string;
    playerB: string;
    winner: Side;
    score: string;
    marker: string;
    createdAt: string;
    history?: ScoreState;
    local?: boolean;
  };

  const LOCAL_KEY = 'beds-marked-matches';
  const root = document.getElementById('score-app');
  if (!root) throw new Error('score app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const signinEl = root.querySelector<HTMLElement>('[data-signin]')!;
  const loginLink = root.querySelector<HTMLAnchorElement>('[data-login]')!;
  const setup = root.querySelector<HTMLFormElement>('[data-setup]')!;
  const board = root.querySelector<HTMLElement>('[data-board]')!;
  const callEl = root.querySelector<HTMLElement>('[data-call]')!;
  const lineEl = root.querySelector<HTMLElement>('[data-line]')!;
  const undoBtn = root.querySelector<HTMLButtonElement>('[data-undo]')!;
  const saveBtn = root.querySelector<HTMLButtonElement>('[data-save]')!;
  const handBtn = root.querySelector<HTMLButtonElement>('[data-hand]')!;
  const letBtn = root.querySelector<HTMLButtonElement>('[data-let]')!;
  const strokeBtn = root.querySelector<HTMLButtonElement>('[data-stroke]')!;
  const clearBtn = root.querySelector<HTMLButtonElement>('[data-clear]')!;
  const currentEl = root.querySelector<HTMLOListElement>('[data-current]')!;
  const currentNote = root.querySelector<HTMLElement>('[data-current-note]')!;
  const refreshBox = root.querySelector<HTMLInputElement>('[data-refresh]')!;
  const backBtn = root.querySelector<HTMLButtonElement>('[data-back]')!;
  const publicWatch = root.querySelector<HTMLElement>('[data-public-watch]')!;
  const publicMarker = root.querySelector<HTMLElement>('[data-public-marker]')!;
  const watchMarkerEl = root.querySelector<HTMLElement>('[data-watch-marker]')!;
  const resultEl = root.querySelector<HTMLElement>('[data-result]')!;
  const resultSheet = root.querySelector<HTMLElement>('[data-result-sheet]')!;
  const resultLinkRow = root.querySelector<HTMLElement>('[data-result-link-row]')!;
  const resultLink = root.querySelector<HTMLAnchorElement>('[data-result-link]')!;
  const resultNote = root.querySelector<HTMLElement>('[data-result-note]')!;
  const resultPic = root.querySelector<HTMLButtonElement>('[data-result-pic]')!;
  const resultCopy = root.querySelector<HTMLButtonElement>('[data-result-copy]')!;
  const serveWho = root.querySelector<HTMLElement>('[data-serve-who]')!;
  const tapeEl = root.querySelector<HTMLElement>('[data-tape]')!;
  const gameNoEl = root.querySelector<HTMLElement>('[data-game-no]')!;
  const countsEl = root.querySelector<HTMLElement>('[data-game-counts]')!;
  const priorEl = root.querySelector<HTMLElement>('[data-prior]')!;
  const restBtn = root.querySelector<HTMLButtonElement>('[data-rest]')!;
  const clockEl = root.querySelector<HTMLElement>('[data-clock]')!;
  const boxToggle = root.querySelector<HTMLButtonElement>('[data-box-toggle]')!;
  const recentEl = root.querySelector<HTMLOListElement>('[data-recent]')!;
  const inputA = setup.querySelector<HTMLInputElement>('[name="player-a"]')!;
  const inputB = setup.querySelector<HTMLInputElement>('[name="player-b"]')!;

  const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
  loginLink.href = `${base}/login/?next=${encodeURIComponent(location.pathname + location.search)}`;

  let state: ScoreState = freshMatch();
  let names = { a: '', b: '' };
  let saved = false;
  let signedIn = false;
  let editingId: number | null = null;
  let recent: Marked[] = [];
  let strokeArmed = false;
  let nameChoices: string[] = [];
  let shareLive = false;
  let watching = false;
  let watchId: number | null = null;
  let watchedJson = '';
  let liveReady = true;
  let refreshOn = localStorage.getItem('beds-live-refresh') !== '0';
  let sayScore = localStorage.getItem('beds-say-score') === '1';
  let heard = '';
  let voiceArmed = false;
  let publishTimer = 0;
  let markerName = '';
  let cardMarker = '';
  let resultId: number | null = null;
  let resultPublishing = false;
  let resultBlocked = false;
  let resultMode = false;
  let resultScrolled = false;

  type LiveRow = {
    id: number;
    playerA: string;
    playerB: string;
    score: string;
    marker: string | null;
    updatedAt: string;
    history: unknown;
  };

  let currentRows: LiveRow[] = [];
  let watchMarker = '';
  /** Ninety seconds between games, the interval allowed by the singles rules. */
  const REST_MS = 90_000;
  const NEXT_MS = 2_500;
  let phase: 'play' | 'next' | 'rest' | 'done' = 'play';
  let clockStart = 0;
  let clockElapsed = 0;
  let breakForGames = 0;
  let nextUntil = 0;
  let restUntil = 0;

  function formatClock(ms: number) {
    const total = Math.max(0, Math.floor(ms / 1000));
    const minutes = Math.floor(total / 60);
    const seconds = total % 60;
    return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
  }

  function elapsedMs() {
    if (phase !== 'play') return clockElapsed;
    return clockElapsed + (performance.now() - clockStart);
  }

  function resetClock() {
    clockElapsed = 0;
    clockStart = performance.now();
  }

  function freezeClock() {
    if (phase !== 'play') return;
    clockElapsed += performance.now() - clockStart;
  }

  function armSession() {
    const finished = finishedGames(state).length;
    phase = matchWinner(state) ? 'done' : 'play';
    breakForGames = finished;
    if (phase === 'play') resetClock();
    else clockElapsed = 0;
  }

  /** Move between the game clock, the next-game message, and the rest. */
  function syncBreak() {
    const finished = finishedGames(state).length;
    const over = Boolean(matchWinner(state));
    const live = currentRallies(state).length > 0;
    if (over) {
      if (phase === 'play') freezeClock();
      phase = 'done';
      breakForGames = finished;
      return;
    }
    if ((phase === 'next' || phase === 'rest') && live) {
      phase = 'play';
      resetClock();
      return;
    }
    if (finished > breakForGames && !live) {
      if (phase === 'play') freezeClock();
      phase = 'next';
      nextUntil = performance.now() + NEXT_MS;
      breakForGames = finished;
      return;
    }
    if (finished < breakForGames) {
      breakForGames = finished;
      phase = 'play';
      clockStart = performance.now();
    }
  }

  function show(message: string) {
    statusEl.textContent = message;
  }

  function readNames(): string[] {
    const node = document.getElementById('score-names');
    const raw = node?.textContent?.trim();
    if (!raw) return [];
    const parsed = JSON.parse(raw) as unknown;
    return Array.isArray(parsed) ? parsed.filter((name) => typeof name === 'string') : [];
  }

  function personKey(name: string) {
    return name.trim().replace(/\s+/g, ' ').toLowerCase();
  }

  const levelsByName = new Map<string, number[]>();
  const levelNames = new Map<string, string>();
  let levelsReady = false;

  function formatLevels(levels: number[]) {
    return [...new Set(levels)].sort((a, b) => a - b).map((level) => level.toLocaleString('en-GB')).join(', ');
  }

  function slText(name: string) {
    const levels = levelsByName.get(personKey(name));
    if (!levels?.length) return '';
    return `SL ${formatLevels(levels)}`;
  }

  function paintLevels() {
    for (const side of ['a', 'b'] as const) {
      const input = side === 'a' ? inputA : inputB;
      const note = root.querySelector<HTMLElement>(`[data-sl="${side}"]`)!;
      const chosen = input.value.trim();
      const level = slText(chosen);
      note.textContent = level || (levelsReady && chosen.length >= 2 ? 'No SquashLevels level' : '');
      note.hidden = !note.textContent;
      const onCourt = root.querySelector<HTMLElement>(`[data-level="${side}"]`);
      if (onCourt) onCourt.textContent = slText(names[side]);
    }
  }

  function fillNames(extra: string[]) {
    const seen = new Set<string>();
    nameChoices = [];
    for (const name of [...readNames(), ...extra, ...levelNames.values()].sort((a, b) => a.localeCompare(b, 'en'))) {
      const key = personKey(name);
      if (!key || seen.has(key)) continue;
      seen.add(key);
      nameChoices.push(name);
    }
    paintLevels();
    const active = document.activeElement;
    paintPicks(active === inputA ? 'a' : active === inputB ? 'b' : null);
  }

  function matchingNames(query: string) {
    const key = personKey(query);
    return nameChoices
      .filter((name) => !key || personKey(name).includes(key))
      .sort((a, b) => {
        const aStart = key && personKey(a).startsWith(key) ? 0 : 1;
        const bStart = key && personKey(b).startsWith(key) ? 0 : 1;
        return aStart - bStart || a.localeCompare(b, 'en');
      })
      .slice(0, 12);
  }

  function paintPicks(side: 'a' | 'b' | null) {
    for (const which of ['a', 'b'] as const) {
      const box = root.querySelector<HTMLElement>(`[data-picks="${which}"]`)!;
      box.replaceChildren();
      if (side !== which) {
        box.hidden = true;
        continue;
      }
      const input = which === 'a' ? inputA : inputB;
      const rows = matchingNames(input.value);
      box.hidden = rows.length === 0;
      for (const name of rows) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'pick';
        const level = slText(name);
        button.textContent = level ? `${name} · ${level}` : name;
        button.addEventListener('pointerdown', (event) => {
          event.preventDefault();
          input.value = name;
          box.hidden = true;
          paintLevels();
        });
        box.append(button);
      }
    }
  }

  async function loadLevels() {
    for (let from = 0; ; from += 1000) {
      const { data, error } = await supabase
        .from('squashlevels_players')
        .select('display_name, current_level')
        .order('display_name', { ascending: true })
        .range(from, from + 999);
      if (error) break;
      if (!data?.length) {
        levelsReady = true;
        break;
      }
      for (const row of data as { display_name: string | null; current_level: number | null }[]) {
        const name = row.display_name?.trim();
        if (!name || row.current_level == null) continue;
        const key = personKey(name);
        if (!levelNames.has(key)) levelNames.set(key, name.replace(/\s+/g, ' '));
        const levels = levelsByName.get(key) ?? [];
        levels.push(Number(row.current_level));
        levelsByName.set(key, levels);
      }
      if (data.length < 1000) {
        levelsReady = true;
        break;
      }
    }
    fillNames([]);
  }

  function readLocal(): Marked[] {
    try {
      const parsed = JSON.parse(localStorage.getItem(LOCAL_KEY) ?? '[]') as Marked[];
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function writeLocal(rows: Marked[]) {
    localStorage.setItem(LOCAL_KEY, JSON.stringify(rows.slice(0, 30)));
  }

  function dash(score: string) {
    return score.replace(/-/g, '–');
  }

  function gamesLabel(count: number) {
    if (count === 1) return '1 Game';
    return `${count} Games`;
  }

  function paintRecent() {
    recentEl.replaceChildren();
    clearBtn.hidden = recent.length === 0;
    if (!recent.length) {
      const item = document.createElement('li');
      item.textContent = 'No scores yet.';
      recentEl.append(item);
      return;
    }
    for (const row of recent) {
      const item = document.createElement('li');
      const winner = row.winner === 'a' ? row.playerA : row.playerB;
      const loser = row.winner === 'a' ? row.playerB : row.playerA;
      const when = new Date(row.createdAt);
      const time = Number.isNaN(when.getTime())
        ? ''
        : when.toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
      const text = document.createElement('span');
      text.textContent = `${winner} beat ${loser} ${dash(row.score)}${time ? ` · ${time}` : ''}${row.local ? ' · this browser' : ''}`;
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'btn btn--ghost btn--sm';
      remove.textContent = 'Delete';
      remove.addEventListener('click', () => void removeMarked(row.id));
      item.append(text, remove);
      recentEl.append(item);
    }
  }

  function paintPrior() {
    priorEl.replaceChildren();
    const games = finishedGames(state);
    priorEl.hidden = games.length === 0 || phase === 'play';
    for (const game of games) {
      const line = document.createElement('p');
      line.className = 'prior-score';
      line.textContent = `${game.a}/${game.b}`;
      priorEl.append(line);
    }
  }

  function paintTape() {
    tapeEl.replaceChildren();
    const rallies = currentRallies(state);
    if (!rallies.length) return;
    const stem = gameStem(rallies);
    const body = document.createElement('div');
    body.className = 'stem-body';
    for (const mark of stem.rows) {
      const row = document.createElement('div');
      row.className = 'stem-row';
      const pip = document.createElement('span');
      pip.className = `pip${mark.kind === 'let' ? ' is-let' : ''}${mark.kind === 'stroke' ? ' is-stroke' : ''}`;
      pip.textContent = mark.text;
      const box = document.createElement('span');
      box.className = 'box-mark';
      box.textContent = mark.box;
      const cluster = document.createElement('span');
      cluster.className = mark.side === 'a' ? 'cluster cluster--a' : 'cluster cluster--b';
      if (mark.side === 'a') cluster.append(box, pip);
      else cluster.append(pip, box);
      const left = document.createElement('span');
      const right = document.createElement('span');
      const rail = document.createElement('span');
      rail.className = 'stem-rail';
      if (mark.side === 'a') left.append(cluster);
      else right.append(cluster);
      row.append(left, rail, right);
      const kind = mark.kind === 'let' ? 'Yes let' : mark.kind === 'stroke' ? 'Stroke' : 'Point';
      row.setAttribute('aria-label', `${kind}, ${mark.text}, from ${mark.box}`);
      body.append(row);
    }
    tapeEl.append(body);
    requestAnimationFrame(() => {
      const overflow = tapeEl.scrollHeight > tapeEl.clientHeight + 1;
      tapeEl.classList.toggle('is-overflow', overflow);
      if (overflow) tapeEl.scrollTop = tapeEl.scrollHeight;
    });
  }

  function paint() {
    syncBreak();
    const onCourt = currentGame(state);
    const won = gamesWon(state);
    const over = matchWinner(state);
    const onBreak = phase === 'next' || phase === 'rest';
    const serverName = names[state.server] || 'Player';
    const finished = finishedGames(state).length;
    gameNoEl.textContent = over ? 'Match' : `Game ${Math.min(5, finished + 1)}/5`;
    countsEl.hidden = won.a + won.b === 0;
    for (const side of ['a', 'b'] as const) {
      root.querySelector<HTMLElement>(`[data-name="${side}"]`)!.textContent = names[side];
      root.querySelector<HTMLElement>(`[data-points="${side}"]`)!.textContent = String(onCourt[side]);
      root.querySelector<HTMLElement>(`[data-games-label="${side}"]`)!.textContent = gamesLabel(won[side]);
      const serving = side === state.server && !over ? ` Serving from ${state.box}.` : '';
      const level = slText(names[side]);
      const label = `${names[side]}${level ? `, ${level}` : ''}, ${onCourt[side]}.${serving} ${over || saved || watching ? 'Match finished.' : 'Add a point.'}`;
      for (const button of root.querySelectorAll<HTMLButtonElement>(`[data-side="${side}"]`)) {
        button.disabled = Boolean(over) || saved || watching;
        button.classList.toggle('is-serving', button.classList.contains('pill') && side === state.server && !over);
        button.setAttribute('aria-label', label);
      }
    }
    paintLevels();
    serveWho.textContent = over ? 'Match finished' : `${serverName} serving`;
    boxToggle.textContent = state.box;
    boxToggle.classList.toggle('is-b', state.server === 'b');
    boxToggle.disabled = Boolean(over) || saved || watching;
    boxToggle.setAttribute('aria-label', `Service box ${state.box}`);
    handBtn.hidden = watching || !canChooseServer(state) || saved;
    handBtn.textContent = `${names[otherPlayer(state.server)] || 'Other player'} serves`;
    letBtn.disabled = Boolean(over) || saved || watching;
    strokeBtn.disabled = Boolean(over) || saved || watching;
    strokeBtn.setAttribute('aria-pressed', String(strokeArmed && !over && !saved));
    lineEl.textContent = dash(scoreLine(state));
    clockEl.hidden = onBreak || watching;
    clockEl.textContent = formatClock(elapsedMs());
    restBtn.hidden = !onBreak;
    if (phase === 'next') {
      restBtn.textContent = 'Next game';
      restBtn.setAttribute('aria-label', 'Next game');
    } else if (phase === 'rest') {
      const left = Math.max(0, Math.ceil((restUntil - performance.now()) / 1000));
      restBtn.textContent = `Rest ${left}`;
      restBtn.setAttribute('aria-label', `Rest ${left} seconds. Tap to start the next game.`);
    }
    undoBtn.disabled = watching || saved || !hasRallies(state);
    saveBtn.hidden = !over;
    saveBtn.disabled = saved;
    saveBtn.textContent = saved ? 'Saved' : editingId ? 'Save changes' : 'Save score';
    const called = markerCall(state);
    if (phase === 'next' || phase === 'rest') {
      callEl.textContent = 'Next game';
    } else if (over) {
      const winner = over === 'a' ? names.a : names.b;
      callEl.textContent = `${winner} wins ${dash(scoreLine(state))}`;
    } else if (strokeArmed) {
      callEl.textContent = 'Tap the player who is awarded the stroke.';
    } else if (called?.let) {
      callEl.textContent = `Yes let, ${called.server}–${called.receiver}`;
    } else if (called) {
      const note = called.note === 'ten-all' ? '10-all: a player must win by 2 points' : called.note === 'match-ball' ? 'Match ball' : called.note === 'game-ball' ? 'Game ball' : '';
      const stroke = called.stroke ? 'Stroke, ' : '';
      const lead = called.handOut ? 'Hand out, ' : '';
      callEl.textContent = note === '10-all: a player must win by 2 points' ? `${stroke}${lead}${note}` : `${stroke}${lead}${called.server}–${called.receiver}${note ? `, ${note}` : ''}`;
    } else {
      callEl.textContent = `${serverName} to serve, love-all.`;
    }
    if (watching && signedIn && watchMarker) {
      watchMarkerEl.hidden = false;
      watchMarkerEl.textContent = `Marked by ${watchMarker}`;
    } else {
      watchMarkerEl.hidden = true;
      watchMarkerEl.textContent = '';
    }
    paintPrior();
    paintTape();
    queueLive();
    announce();
    syncResult();
    paintResult();
  }

  function missingFunction(error: { code?: string; message?: string } | null) {
    const message = error?.message ?? '';
    return error?.code === 'PGRST202' || /could not find the function/i.test(message) || /schema cache/i.test(message);
  }

  function updatedAgo(iso: string) {
    const then = new Date(iso).getTime();
    if (Number.isNaN(then)) return '';
    const seconds = Math.max(0, Math.round((Date.now() - then) / 1000));
    if (seconds < 15) return 'Updated just now';
    if (seconds < 60) return `Updated ${seconds}s ago`;
    const minutes = Math.round(seconds / 60);
    return minutes === 1 ? 'Updated 1 min ago' : `Updated ${minutes} min ago`;
  }

  function displayName(name: string) {
    return signedIn ? name : publicPlayerName(name);
  }

  function paintCurrent() {
    currentEl.replaceChildren();
    if (currentNote.textContent) return;
    if (!currentRows.length) {
      const item = document.createElement('li');
      item.textContent = 'No matches are being marked right now.';
      currentEl.append(item);
      return;
    }
    for (const row of currentRows) {
      const item = document.createElement('li');
      const text = document.createElement('span');
      const when = updatedAgo(row.updatedAt);
      const markerBit = signedIn && row.marker ? ` · ${row.marker}` : '';
      text.textContent = `${displayName(row.playerA)} v ${displayName(row.playerB)} · ${dash(row.score) || '0–0'}${markerBit}${when ? ` · ${when}` : ''}`;
      const watch = document.createElement('a');
      watch.className = 'btn btn--ghost btn--sm';
      watch.href = `${base}/captains/watch/?match=${row.id}`;
      watch.textContent = 'Watch';
      item.append(text, watch);
      currentEl.append(item);
    }
  }

  function queueLive() {
    if (!shareLive || !signedIn || watching || !liveReady || board.hidden) return;
    window.clearTimeout(publishTimer);
    publishTimer = window.setTimeout(() => void sendLive(), 400);
  }

  async function sendLive() {
    if (!shareLive || !signedIn || watching || !liveReady || board.hidden) return;
    const { error } = await supabase.rpc('publish_live_match', {
      p_a: names.a,
      p_b: names.b,
      p_score: scoreLine(state) || '0-0',
      p_history: state,
    });
    if (error && missingFunction(error)) {
      liveReady = false;
      show('Live matches are not on the database yet. The score stays on this browser.');
      return;
    }
    if (error) show(error.message);
  }

  async function clearLive() {
    if (!signedIn || !liveReady) return;
    const { error } = await supabase.rpc('clear_live_match');
    if (error && missingFunction(error)) liveReady = false;
  }

  function watchStamp(row: LiveRow) {
    const restored = signedIn ? restoreMatch(row.history) : null;
    if (restored) return JSON.stringify(row.history);
    return `${displayName(row.playerA)}|${displayName(row.playerB)}|${row.score}|${signedIn ? row.marker ?? '' : ''}`;
  }

  function showPublicWatch(row: LiveRow) {
    root.querySelector<HTMLElement>('[data-public-a]')!.textContent = displayName(row.playerA);
    root.querySelector<HTMLElement>('[data-public-b]')!.textContent = displayName(row.playerB);
    root.querySelector<HTMLElement>('[data-public-score]')!.textContent = dash(row.score) || '0–0';
    const marker = signedIn ? row.marker : '';
    publicMarker.hidden = !marker;
    publicMarker.textContent = marker ? `Marked by ${marker}` : '';
    root.querySelector<HTMLElement>('[data-public-note]')!.hidden = signedIn;
    board.hidden = true;
    publicWatch.hidden = false;
    root.classList.add('is-playing', 'is-watching', 'is-public-watch');
    announce();
  }

  function currentSpoken() {
    if (!publicWatch.hidden) {
      const score = root.querySelector<HTMLElement>('[data-public-score]')?.textContent || '';
      return spokenScoreLine(score.replace(/–/g, '-'));
    }
    if (board.hidden || strokeArmed) return '';
    return spokenMark(state, names, phase === 'done' ? 'play' : phase);
  }

  function speak(text: string) {
    if (!sayScore || !text || !window.speechSynthesis) return;
    heard = text;
    const line = new SpeechSynthesisUtterance(text);
    line.lang = 'en-GB';
    line.rate = 0.95;
    window.speechSynthesis.cancel();
    window.speechSynthesis.speak(line);
  }

  function announce() {
    const text = currentSpoken();
    if (!text) return;
    if (!voiceArmed) {
      heard = text;
      voiceArmed = true;
      return;
    }
    if (text === heard) return;
    speak(text);
  }

  function applyWatched(row: LiveRow) {
    const restored = signedIn ? restoreMatch(row.history) : null;
    watching = true;
    watchId = row.id;
    watchedJson = watchStamp(row);
    saved = false;
    editingId = null;
    strokeArmed = false;
    setup.hidden = true;
    const url = new URL(location.href);
    url.searchParams.set('watch', String(row.id));
    history.replaceState(null, '', `${url.pathname}${url.search}`);
    if (!restored) {
      watchMarker = '';
      showPublicWatch(row);
      paintCurrent();
      return;
    }
    names = { a: row.playerA, b: row.playerB };
    state = restored;
    watchMarker = row.marker || '';
    breakForGames = finishedGames(state).length;
    phase = matchWinner(state) ? 'done' : 'play';
    publicWatch.hidden = true;
    board.hidden = false;
    root.classList.remove('is-public-watch');
    root.classList.add('is-playing', 'is-watching');
    paint();
    paintCurrent();
  }

  function openWatch(row: LiveRow) {
    applyWatched(row);
    board.scrollIntoView({ block: 'start' });
  }

  function leaveWatch() {
    watching = false;
    watchId = null;
    watchedJson = '';
    watchMarker = '';
    root.classList.remove('is-playing', 'is-watching', 'is-public-watch');
    board.hidden = true;
    publicWatch.hidden = true;
    setup.hidden = false;
    const url = new URL(location.href);
    url.searchParams.delete('watch');
    history.replaceState(null, '', `${url.pathname}${url.search}`);
    paintCurrent();
  }

  async function loadCurrent() {
    const { data, error } = await supabase.rpc('current_matches');
    if (error && missingFunction(error)) {
      currentNote.textContent = 'Live matches are not on the database yet.';
      currentEl.replaceChildren();
      return;
    }
    if (error) {
      currentNote.textContent = error.message;
      return;
    }
    currentNote.textContent = '';
    currentRows = Array.isArray(data) ? (data as LiveRow[]) : [];
    paintCurrent();
    if (!watching || watchId == null) return;
    const row = currentRows.find((item) => item.id === watchId);
    if (!row) {
      show('That match is no longer being shared.');
      leaveWatch();
      return;
    }
    if (watchStamp(row) !== watchedJson) applyWatched(row);
  }

  function resultHref() {
    if (!resultId) return '';
    return `${location.origin}${base}/captains/score/?result=${resultId}`;
  }

  function markerLabel() {
    return cardMarker || markerName;
  }

  function appendGameStem(parent: HTMLElement, rallies: ScoreState['games'][number], index: number) {
    const stem = gameStem(rallies);
    const game = document.createElement('section');
    game.className = 'stem';
    const heading = document.createElement('p');
    heading.className = 'stem-head';
    heading.textContent = `Game ${index + 1}`;
    const total = document.createElement('p');
    total.className = 'stem-score';
    total.textContent = `${stem.score.a}–${stem.score.b}`;
    const body = document.createElement('div');
    body.className = 'stem-body';
    for (const mark of stem.rows) {
      const row = document.createElement('div');
      row.className = 'stem-row';
      const pip = document.createElement('span');
      pip.className = `pip${mark.kind === 'let' ? ' is-let' : ''}${mark.kind === 'stroke' ? ' is-stroke' : ''}`;
      pip.textContent = mark.text;
      const box = document.createElement('span');
      box.className = 'box-mark';
      box.textContent = mark.box;
      const cluster = document.createElement('span');
      cluster.className = mark.side === 'a' ? 'cluster cluster--a' : 'cluster cluster--b';
      if (mark.side === 'a') cluster.append(box, pip);
      else cluster.append(pip, box);
      const left = document.createElement('span');
      const right = document.createElement('span');
      const rail = document.createElement('span');
      rail.className = 'stem-rail';
      if (mark.side === 'a') left.append(cluster);
      else right.append(cluster);
      row.append(left, rail, right);
      body.append(row);
    }
    game.append(heading, total, body);
    parent.append(game);
  }

  function paintResult() {
    const over = Boolean(matchWinner(state));
    const showCard = resultMode || (over && !watching);
    resultEl.hidden = !showCard;
    if (!showCard) return;
    const winner = matchWinner(state);
    root.querySelector<HTMLElement>('[data-result-a]')!.textContent = names.a;
    root.querySelector<HTMLElement>('[data-result-b]')!.textContent = names.b;
    const score = dash(scoreLine(state));
    const winnerName = winner === 'a' ? names.a : winner === 'b' ? names.b : '';
    root.querySelector<HTMLElement>('[data-result-score]')!.textContent = winnerName ? `${winnerName} wins ${score}` : score;
    resultSheet.replaceChildren();
    state.games.forEach((rallies, index) => {
      if (rallies.length) appendGameStem(resultSheet, rallies, index);
    });
    const who = markerLabel();
    root.querySelector<HTMLElement>('[data-result-marker]')!.textContent = who ? `Marked by ${who}` : 'Marked on Beds Squash';
    const href = resultHref();
    resultLinkRow.hidden = !href;
    resultCopy.hidden = !href;
    if (href) {
      resultLink.href = href;
      resultLink.textContent = href.replace(/^https?:\/\//, '');
    }
    if (!resultMode && !signedIn) resultNote.textContent = 'Sign in to publish a public link with your name on it.';
    else if (resultBlocked) resultNote.textContent = 'The public link is not on the database yet. You can still save the picture.';
    else if (resultPublishing && !resultId) resultNote.textContent = 'Publishing the public link…';
    else resultNote.textContent = '';
    if (showCard && !resultScrolled) {
      resultScrolled = true;
      requestAnimationFrame(() => resultEl.scrollIntoView({ block: 'nearest' }));
    }
    if (!showCard) resultScrolled = false;
  }

  function syncResult() {
    if (resultMode || watching) return;
    const over = Boolean(matchWinner(state));
    if (!over) {
      if (resultId) {
        const id = resultId;
        resultId = null;
        void supabase.rpc('withdraw_match_result', { p_id: id });
      }
      return;
    }
    if (signedIn && !editingId && !resultId && !resultPublishing && !resultBlocked) void publishResult();
  }

  async function publishResult() {
    const winner = matchWinner(state);
    if (!winner || !signedIn || resultId || resultPublishing) return;
    resultPublishing = true;
    paintResult();
    const { data, error } = await supabase.rpc('publish_match_result', {
      p_id: null,
      p_a: names.a,
      p_b: names.b,
      p_winner: winner,
      p_score: scoreLine(state),
      p_history: state,
    });
    resultPublishing = false;
    if (!matchWinner(state)) return;
    if (error && missingFunction(error)) {
      resultBlocked = true;
      paintResult();
      return;
    }
    if (error) {
      show(error.message);
      paintResult();
      return;
    }
    const id = (data as { id?: number } | null)?.id;
    if (typeof id === 'number') resultId = id;
    paintResult();
  }

  function drawResultCard() {
    const games = state.games.filter((game) => game.length);
    const stems = games.map((game) => gameStem(game));
    const maxRows = Math.max(1, ...stems.map((stem) => stem.rows.length));
    const colW = 210;
    const rowH = 34;
    const width = Math.max(720, 80 + Math.max(stems.length, 1) * colW);
    const height = 280 + maxRows * rowH + (resultId ? 150 : 110);
    const canvas = document.createElement('canvas');
    const scale = 2;
    canvas.width = width * scale;
    canvas.height = height * scale;
    const ctx = canvas.getContext('2d');
    if (!ctx) return canvas;
    ctx.scale(scale, scale);
    ctx.fillStyle = '#f6f3ee';
    ctx.fillRect(0, 0, width, height);
    ctx.fillStyle = '#0e2744';
    ctx.fillRect(0, 0, width, 18);
    ctx.fillStyle = '#0e2744';
    ctx.font = '700 22px "Barlow Condensed", "Arial Narrow", sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('BEDS SQUASH', width / 2, 58);
    ctx.font = '800 42px "Barlow Condensed", "Arial Narrow", sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText(names.a, 40, 120);
    ctx.textAlign = 'right';
    ctx.fillStyle = '#f15a22';
    ctx.fillText(names.b, width - 40, 120);
    ctx.fillStyle = '#163556';
    ctx.textAlign = 'center';
    ctx.font = '800 36px "Barlow Condensed", "Arial Narrow", sans-serif';
    const winner = matchWinner(state);
    const winnerName = winner === 'a' ? names.a : winner === 'b' ? names.b : '';
    const line = dash(scoreLine(state));
    ctx.fillText(winnerName ? `${winnerName} wins ${line}` : line, width / 2, 175);
    stems.forEach((stem, index) => {
      const x = 40 + index * colW;
      ctx.fillStyle = '#0e2744';
      ctx.font = '700 18px "Barlow Condensed", "Arial Narrow", sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(`Game ${index + 1}`, x + colW / 2 - 16, 230);
      ctx.fillStyle = '#e0a800';
      ctx.font = '800 22px "Barlow Condensed", "Arial Narrow", sans-serif';
      ctx.fillText(`${stem.score.a}–${stem.score.b}`, x + colW / 2 - 16, 256);
      stem.rows.forEach((mark, row) => {
        const y = 290 + row * rowH;
        const railX = x + colW / 2 - 16;
        ctx.strokeStyle = '#e0a800';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(railX, y - 14);
        ctx.lineTo(railX, y + 14);
        ctx.stroke();
        const pipX = mark.side === 'a' ? railX - 36 : railX + 36;
        ctx.beginPath();
        ctx.arc(pipX, y, 13, 0, Math.PI * 2);
        ctx.fillStyle = '#fff';
        ctx.fill();
        ctx.lineWidth = mark.kind === 'stroke' ? 3 : 2;
        ctx.strokeStyle = mark.kind === 'stroke' ? '#0e2744' : '#e0a800';
        ctx.stroke();
        ctx.fillStyle = '#111';
        ctx.font = '700 13px Inter, system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(mark.text, pipX, y);
        ctx.fillStyle = '#163556';
        ctx.font = '700 12px Inter, system-ui, sans-serif';
        ctx.fillText(mark.box, mark.side === 'a' ? pipX - 28 : pipX + 28, y);
        ctx.textBaseline = 'alphabetic';
      });
    });
    const foot = height - (resultId ? 90 : 50);
    ctx.fillStyle = '#163556';
    ctx.font = '700 20px Inter, system-ui, sans-serif';
    ctx.textAlign = 'center';
    const who = markerLabel();
    ctx.fillText(who ? `Marked by ${who}` : 'Marked on Beds Squash', width / 2, foot);
    if (resultId) {
      ctx.fillStyle = '#5c6d80';
      ctx.font = '16px Inter, system-ui, sans-serif';
      const href = resultHref().replace(/^https?:\/\//, '');
      ctx.fillText(href, width / 2, foot + 32);
    }
    return canvas;
  }

  async function savePicture() {
    const canvas = drawResultCard();
    const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob((file) => resolve(file), 'image/png'));
    if (!blob) return;
    const safe = `${names.a}-v-${names.b}`.replace(/[^\w.-]+/g, '-');
    const file = new File([blob], `${safe}.png`, { type: 'image/png' });
    const href = resultHref();
    if (navigator.canShare?.({ files: [file] })) {
      try {
        await navigator.share({ files: [file], title: `${names.a} v ${names.b}`, text: href || undefined });
        return;
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
      }
    }
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = file.name;
    link.click();
    URL.revokeObjectURL(url);
  }

  async function loadPublicResult(id: number) {
    const { data, error } = await supabase.rpc('match_result', { p_id: id });
    if (error && missingFunction(error)) {
      show('That public result is not on the database yet.');
      return;
    }
    if (error || !data) {
      show(error?.message || 'That result could not be opened.');
      return;
    }
    const row = data as { id: number; playerA: string; playerB: string; marker: string; history: unknown };
    const restored = restoreMatch(row.history);
    if (!restored) {
      show('That result could not be opened.');
      return;
    }
    names = { a: row.playerA, b: row.playerB };
    state = restored;
    cardMarker = row.marker;
    resultId = row.id;
    resultMode = true;
    setup.hidden = true;
    board.hidden = true;
    root.classList.add('is-result');
    paintResult();
  }

  function rememberLocal(row: Marked) {
    const rows = [row, ...readLocal().filter((item) => item.id !== row.id)];
    writeLocal(rows);
    recent = [...rows, ...recent.filter((item) => !item.local)];
    paintRecent();
  }

  setup.addEventListener('submit', (event) => {
    event.preventDefault();
    const a = cleanName(inputA.value);
    const b = cleanName(inputB.value);
    if (!a || !b) {
      show('Enter both names, using letters.');
      return;
    }
    if (a.toLowerCase() === b.toLowerCase()) {
      show('Pick two different players.');
      return;
    }
    names = { a, b };
    state = freshMatch();
    saved = false;
    editingId = null;
    strokeArmed = false;
    armSession();
    shareLive = root.querySelector<HTMLInputElement>('[data-share]')!.checked;
    watching = false;
    root.classList.remove('is-watching');
    if (!shareLive) void clearLive();
    if (shareLive && !signedIn) show('Sign in to let other people watch. This score stays on this browser.');
    else show('');
    setup.hidden = true;
    board.hidden = false;
    root.classList.add('is-playing');
    voiceArmed = false;
    heard = '';
    paint();
  });

  board.addEventListener('click', (event) => {
    if (watching) return;
    const target = event.target as HTMLElement;
    if (target.closest('[data-rest]')) return;
    const button = target.closest<HTMLButtonElement>('[data-side]');
    if (!button || button.disabled) return;
    const side = button.dataset.side === 'b' ? 'b' : 'a';
    state = strokeArmed ? addStroke(state, side) : addPoint(state, side);
    strokeArmed = false;
    saved = false;
    paint();
  });

  boxToggle.addEventListener('click', () => {
    if (boxToggle.disabled) return;
    state = setBox(state, state.box === 'R' ? 'L' : 'R');
    saved = false;
    paint();
  });

  restBtn.addEventListener('click', () => {
    if (phase === 'next') {
      phase = 'rest';
      restUntil = performance.now() + REST_MS;
      paint();
      return;
    }
    if (phase === 'rest') {
      phase = 'play';
      resetClock();
      paint();
    }
  });

  handBtn.addEventListener('click', () => {
    state = setServer(state, otherPlayer(state.server));
    saved = false;
    paint();
  });

  letBtn.addEventListener('click', () => {
    if (letBtn.disabled) return;
    strokeArmed = false;
    state = addLet(state);
    saved = false;
    paint();
  });

  strokeBtn.addEventListener('click', () => {
    if (strokeBtn.disabled) return;
    strokeArmed = !strokeArmed;
    paint();
  });

  async function removeMarked(id: Marked['id']) {
    if (!confirm('Remove this marked match?')) return;
    const localRows = readLocal().filter((row) => String(row.id) !== String(id));
    writeLocal(localRows);
    if (signedIn && typeof id === 'number') {
      const { error } = await supabase.rpc('delete_marked_match', { p_id: id });
      if (error && !missingFunction(error)) {
        show(error.message);
        return;
      }
    }
    recent = recent.filter((row) => String(row.id) !== String(id));
    paintRecent();
    show('Removed.');
  }

  clearBtn.addEventListener('click', async () => {
    if (!recent.length || !confirm('Remove every match you marked?')) return;
    writeLocal([]);
    if (signedIn) {
      const { error } = await supabase.rpc('clear_marked_matches');
      if (error && !missingFunction(error)) {
        show(error.message);
        return;
      }
    }
    recent = [];
    paintRecent();
    show('Cleared.');
  });

  undoBtn.addEventListener('click', () => {
    if (undoBtn.disabled) return;
    state = undoPoint(state);
    saved = false;
    paint();
  });

  root.querySelector<HTMLButtonElement>('[data-new]')!.addEventListener('click', () => {
    if (!saved && hasRallies(state) && !confirm('Leave this score without saving it?')) return;
    state = freshMatch();
    saved = false;
    editingId = null;
    strokeArmed = false;
    armSession();
    watching = false;
    watchId = null;
    resultId = null;
    resultBlocked = false;
    resultMode = false;
    resultScrolled = false;
    voiceArmed = false;
    heard = '';
    void clearLive();
    history.replaceState(null, '', location.pathname);
    board.hidden = true;
    setup.hidden = false;
    root.classList.remove('is-playing', 'is-watching', 'is-result');
    resultEl.hidden = true;
    show('');
    inputA.focus();
  });

  saveBtn.addEventListener('click', async () => {
    const games: Game[] = finishedGames(state);
    const winner = legalMatch(games);
    if (!winner || saved) return;
    saveBtn.disabled = true;
    const row: Marked = {
      id: editingId ?? `local-${Date.now()}`,
      playerA: names.a,
      playerB: names.b,
      winner,
      score: games.map((game) => `${game.a}-${game.b}`).join(', '),
      marker: 'You',
      createdAt: new Date().toISOString(),
      history: state,
      local: true,
    };
    if (!signedIn) {
      rememberLocal(row);
      saved = true;
      paint();
      show('Saved on this browser. Sign in to put it on the site.');
      return;
    }
    show('Saving…');
    const payload = { p_a: names.a, p_b: names.b, p_games: games, p_history: state };
    const savedCall = editingId
      ? supabase.rpc('admin_save_marked_match', { p_id: editingId, ...payload })
      : supabase.rpc('save_marked_match', payload);
    const { data, error } = await savedCall;
    if (error && missingFunction(error)) {
      rememberLocal(row);
      saved = true;
      paint();
      show('Saved on this browser. The shared list is not on the database yet.');
      void clearLive();
      return;
    }
    if (error || !data) {
      saveBtn.disabled = false;
      show(error?.message || 'That score could not be saved.');
      return;
    }
    const stored = data as Marked;
    recent = [stored, ...recent.filter((item) => item.id !== stored.id && item.id !== row.id)];
    paintRecent();
    saved = true;
    paint();
    show(editingId ? 'Saved. The admin list has this match.' : 'Saved. An admin can open it under Scores.');
    void clearLive();
  });

  window.setInterval(() => {
    if (board.hidden) return;
    const now = performance.now();
    if (phase === 'next' && now >= nextUntil) {
      phase = 'rest';
      restUntil = now + REST_MS;
      paint();
      return;
    }
    if (phase === 'rest') {
      if (now >= restUntil) {
        phase = 'play';
        resetClock();
        paint();
        return;
      }
      const left = Math.max(0, Math.ceil((restUntil - now) / 1000));
      const label = `Rest ${left}`;
      if (restBtn.textContent !== label) restBtn.textContent = label;
      return;
    }
    if (phase === 'play' && !watching) clockEl.textContent = formatClock(elapsedMs());
  }, 250);

  document.addEventListener('keydown', (event) => {
    if (board.hidden || watching) return;
    const target = event.target as HTMLElement | null;
    if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA')) return;
    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      state = addPoint(state, 'a');
      saved = false;
      paint();
    } else if (event.key === 'ArrowRight') {
      event.preventDefault();
      state = addPoint(state, 'b');
      saved = false;
      paint();
    } else if ((event.key === 'r' || event.key === 'l') && !saved) {
      event.preventDefault();
      state = setBox(state, event.key === 'l' ? 'L' : 'R');
      paint();
    } else if ((event.key === 'Backspace' || event.key === 'z') && !saved) {
      event.preventDefault();
      state = undoPoint(state);
      paint();
    }
  });

  for (const [input, side] of [[inputA, 'a'], [inputB, 'b']] as const) {
    input.addEventListener('focus', () => paintPicks(side));
    input.addEventListener('input', () => {
      paintLevels();
      paintPicks(side);
    });
  }
  document.addEventListener('pointerdown', (event) => {
    const target = event.target as HTMLElement | null;
    if (target?.closest('.picker')) return;
    paintPicks(null);
  });
  fillNames([]);
  paintRecent();
  void loadLevels();

  refreshBox.checked = refreshOn;
  for (const box of root.querySelectorAll<HTMLInputElement>('[data-say]')) box.checked = sayScore;
  for (const box of root.querySelectorAll<HTMLInputElement>('[data-say]')) {
    box.addEventListener('change', () => {
      sayScore = box.checked;
      for (const other of root.querySelectorAll<HTMLInputElement>('[data-say]')) other.checked = sayScore;
      localStorage.setItem('beds-say-score', sayScore ? '1' : '0');
      if (!sayScore) {
        window.speechSynthesis?.cancel();
        return;
      }
      if (!window.speechSynthesis) {
        show('This browser cannot read the score aloud.');
        return;
      }
      voiceArmed = true;
      heard = '';
      speak(currentSpoken() || 'The score will be read out.');
    });
  }
  refreshBox.addEventListener('change', () => {
    refreshOn = refreshBox.checked;
    localStorage.setItem('beds-live-refresh', refreshOn ? '1' : '0');
    if (refreshOn) void loadCurrent();
  });
  for (const box of root.querySelectorAll<HTMLInputElement>('[data-share]')) {
    box.addEventListener('change', () => {
      shareLive = box.checked;
      for (const other of root.querySelectorAll<HTMLInputElement>('[data-share]')) other.checked = shareLive;
      if (!shareLive) {
        void clearLive();
        return;
      }
      if (!signedIn) {
        show('Sign in to let other people watch.');
        return;
      }
      queueLive();
    });
  }
  backBtn.addEventListener('click', () => leaveWatch());
  root.querySelector<HTMLButtonElement>('[data-public-back]')!.addEventListener('click', () => leaveWatch());

  const { data } = await supabase.auth.getSession();
  signedIn = Boolean(data.session);
  signinEl.hidden = signedIn;
  if (!signedIn) {
    recent = readLocal();
    paintRecent();
  } else {
    const [nameResult, listResult] = await Promise.all([
      supabase.rpc('scoreboard_names'),
      supabase.rpc('marked_matches'),
    ]);
    const extra = Array.isArray(nameResult.data) ? (nameResult.data as string[]) : [];
    fillNames(extra);
    const { data: me } = await supabase.from('profiles').select('display_name').eq('id', data.session!.user.id).maybeSingle();
    const mine = me?.display_name || data.session?.user.user_metadata?.display_name;
    if (typeof mine === 'string' && mine.trim()) markerName = mine.trim();
    const shared = Array.isArray(listResult.data) ? (listResult.data as Marked[]) : [];
    const local = nameResult.error && missingFunction(nameResult.error) ? readLocal() : [];
    if (listResult.error && !missingFunction(listResult.error)) show(listResult.error.message);
    recent = [...shared, ...local.filter((row) => !shared.some((item) => item.score === row.score && item.playerA === row.playerA && item.playerB === row.playerB))];
    paintRecent();
    const editId = Number(new URLSearchParams(location.search).get('id'));
    if (editId) {
      const { data: match, error: matchError } = await supabase.rpc('admin_marked_match', { p_id: editId });
      const row = match as Marked | null;
      const restored = restoreMatch(row?.history);
      if (matchError || !row || !restored) {
        show(matchError?.message || 'That match could not be opened.');
      } else {
        names = { a: row.playerA, b: row.playerB };
        inputA.value = row.playerA;
        inputB.value = row.playerB;
        state = restored;
        editingId = editId;
        saved = false;
        armSession();
        setup.hidden = true;
        board.hidden = false;
        root.classList.add('is-playing');
        show('Editing this match. Undo a point to change the score, then save.');
        paint();
      }
    }
  }

  resultPic.addEventListener('click', () => void savePicture());
  resultCopy.addEventListener('click', async () => {
    const href = resultHref();
    if (!href) return;
    try {
      await navigator.clipboard.writeText(href);
      show('Link copied.');
    } catch {
      show(href);
    }
  });

  await loadCurrent();
  const params = new URLSearchParams(location.search);
  const resultParam = Number(params.get('result'));
  if (resultParam) {
    await loadPublicResult(resultParam);
  }
  const watchParam = Number(params.get('watch'));
  const editing = params.get('id');
  if (!resultParam && watchParam && !editing && !root.classList.contains('is-playing')) {
    location.replace(`${base}/captains/watch/?match=${watchParam}`);
  }
  window.setInterval(() => {
    if (refreshOn) void loadCurrent();
  }, 5000);
</script>

