---
import Base from '@/layouts/Base.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { url } from '@/lib/site';
---

<Base title="Match articles" description="Choose whether the daily league article publishes on its own." noindex>
  <section class="section">
    <div class="container articles" id="articles-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <h1>Match articles</h1>
      <p class="lede">
        One article a day, and only when a league match was played. Automatic publishing is on to start with.
        Switch to manual and a match waits here until you approve it. Open Edit to change the subject, summary and text.
        Archive takes it off the home page and files it under Match history. Delete takes it off the site. Nothing is emailed.
      </p>
      <p class="status" data-status role="status"></p>

      <div data-panel="signed-in" hidden>
        <p class="who" data-who></p>
        <p class="actions">
          <a class="btn btn--ghost btn--sm" href={url('/captains/admin/')}>Admin</a>
          <a class="btn btn--ghost btn--sm" href={url('/captains/profile/')}>Profile</a>
          <button class="btn btn--ghost btn--sm" type="button" data-sign-out>Sign out</button>
        </p>
        <p data-denied hidden>This account cannot change articles.</p>
        <div data-admin hidden>
          <form class="card" data-form="mode">
            <div class="card__body stack">
              <label>
                Publishing
                <select name="publication_mode" data-mode>
                  <option value="auto">Automatic</option>
                  <option value="manual">Manual — hold for approval</option>
                </select>
              </label>
              <button class="btn btn--primary" type="submit">Save</button>
            </div>
          </form>
          <h2>Recent articles</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Article</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody data-rows></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { loadAccount, noteActivity, privateStop, sendToLogin, stopMessage } from '@/lib/account';

  type Article = {
    id: number;
    article_on: string;
    title: string;
    summary: string | null;
    body: string | null;
    status: 'held' | 'approved' | 'published' | 'archived' | 'deleted';
    slug: string;
  };

  const root = document.getElementById('articles-app');
  if (!root) throw new Error('articles app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const signedIn = root.querySelector<HTMLElement>('[data-panel="signed-in"]')!;
  const denied = root.querySelector<HTMLElement>('[data-denied]')!;
  const admin = root.querySelector<HTMLElement>('[data-admin]')!;
  const rows = root.querySelector<HTMLElement>('[data-rows]')!;
  const mode = root.querySelector<HTMLSelectElement>('[data-mode]')!;
  const whoEl = root.querySelector<HTMLElement>('[data-who]')!;

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);

  root.querySelector('[data-sign-out]')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    await showSession();
  });

  root.querySelector<HTMLFormElement>('[data-form="mode"]')!.addEventListener('submit', async (event) => {
    event.preventDefault();
    statusEl.textContent = 'Saving…';
    const { error } = await supabase.rpc('set_article_publication_mode', { p_mode: mode.value });
    statusEl.textContent = error ? error.message : 'Saved.';
  });

  function visibleBody(body: string | null) {
    return (body ?? '').replace(/\n*<!-- match-picture: (?:upset|close) -->\s*$/, '').trim();
  }

  function pictureNote(body: string | null) {
    return (body ?? '').match(/\n*<!-- match-picture: (?:upset|close) -->\s*$/)?.[0]?.trim() ?? '';
  }

  function editField(label: string, hint: string, control: string, tag = 'Editable') {
    return `<label class="field"><span class="field__name">${label} <span class="field__tag">${tag}</span></span>${control}<span class="field__hint">${hint}</span></label>`;
  }

  function editor(article: Article) {
    const lead = article.status === 'published' || article.status === 'archived'
      ? 'Change the subject, summary and text in the boxes below. Save changes updates this article on the site.'
      : 'Change the subject, summary and text in the boxes below. Save changes keeps them. Approve publishes the article.';
    return `<tr data-editor-row="${article.id}" hidden><td colspan="4"><form class="stack editor" data-editor="${article.id}" data-picture="${escapeHtml(pictureNote(article.body))}">
      <p class="editor__lead">${lead}</p>
      ${editField('Subject', 'The heading on the news page.', `<input name="title" maxlength="180" value="${escapeHtml(article.title)}" />`)}
      ${editField('Summary', 'The short line under the heading.', `<input name="summary" maxlength="400" value="${escapeHtml(article.summary ?? '')}" />`, 'Optional')}
      ${editField('Content', 'The article text on the news page.', `<textarea name="body" maxlength="12000" rows="10">${escapeHtml(visibleBody(article.body))}</textarea>`)}
      <p class="actions"><button class="btn btn--primary btn--sm" type="submit">Save changes</button><button class="btn btn--ghost btn--sm" type="button" data-cancel>Cancel</button></p>
    </form></td></tr>`;
  }

  rows.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const edit = target.closest<HTMLButtonElement>('[data-edit]');
    if (edit?.dataset.edit) {
      const formRow = rows.querySelector<HTMLElement>(`[data-editor-row="${edit.dataset.edit}"]`);
      if (formRow) formRow.hidden = false;
      return;
    }
    const cancel = target.closest<HTMLButtonElement>('[data-cancel]');
    if (cancel) {
      const formRow = cancel.closest<HTMLElement>('[data-editor-row]');
      if (formRow) formRow.hidden = true;
      return;
    }
    const button = target.closest<HTMLButtonElement>('[data-approve]');
    if (button) {
      statusEl.textContent = 'Approving…';
      const { error } = await supabase.rpc('approve_match_article', { p_id: Number(button.dataset.approve) });
      statusEl.textContent = error ? error.message : 'Approved. It will be published on the next daily run.';
      if (!error) await showSession();
      return;
    }
    const placeButton = target.closest<HTMLButtonElement>('[data-place]');
    if (!placeButton?.dataset.place || !placeButton.dataset.id) return;
    const place = placeButton.dataset.place;
    const title = placeButton.dataset.title ?? 'this article';
    if (place === 'delete' && !window.confirm(`Remove “${title}” from the site? It leaves the home page and the news list.`)) return;
    const waiting = place === 'archive' ? 'Archiving…' : place === 'home' ? 'Putting it back…' : 'Deleting…';
    const done = place === 'archive'
      ? 'Archived. It is off the home page and filed under Match history.'
      : place === 'home'
        ? 'It is back on the home page.'
        : 'Deleted. It is off the site.';
    statusEl.textContent = waiting;
    const { error } = await supabase.rpc('set_match_article_place', {
      p_id: Number(placeButton.dataset.id),
      p_place: place,
    });
    statusEl.textContent = error ? error.message : done;
    if (!error) await showSession();
  });

  rows.addEventListener('submit', async (event) => {
    const form = (event.target as HTMLElement).closest<HTMLFormElement>('[data-editor]');
    if (!form?.dataset.editor) return;
    event.preventDefault();
    const data = new FormData(form);
    const title = String(data.get('title') ?? '').trim().replace(/\s+/g, ' ');
    const summary = String(data.get('summary') ?? '').trim().replace(/\s+/g, ' ');
    let body = String(data.get('body') ?? '').trim();
    if (title.length < 4 || title.length > 180) {
      statusEl.textContent = 'Add a subject of 4 to 180 characters.';
      return;
    }
    if (summary.length > 400) {
      statusEl.textContent = 'Keep the summary to 400 characters.';
      return;
    }
    if (body.length < 20 || body.length > 12000) {
      statusEl.textContent = 'Write the article.';
      return;
    }
    const picture = form.dataset.picture ?? '';
    if (picture) body = `${body}\n\n${picture}`;
    statusEl.textContent = 'Saving…';
    const { error } = await supabase.rpc('edit_match_article', {
      p_id: Number(form.dataset.editor),
      p_title: title,
      p_summary: summary || null,
      p_body: body,
    });
    if (error) {
      statusEl.textContent = error.message;
      return;
    }
    const formRow = form.closest<HTMLElement>('[data-editor-row]');
    if (formRow) formRow.hidden = true;
    const titleCell = rows.querySelector<HTMLElement>(`[data-title-for="${form.dataset.editor}"]`);
    if (titleCell) titleCell.textContent = title;
    statusEl.textContent = 'Saved.';
  });

  async function showSession() {
    const { data } = await supabase.auth.getSession();
    const session = data.session;
    signedIn.hidden = !session;
    admin.hidden = true;
    denied.hidden = true;
    if (!session) {
      sendToLogin();
      return;
    }
    whoEl.textContent = session.user.email ?? 'Signed in';
    const account = await loadAccount(supabase);
    if (account) {
      const stop = await privateStop(supabase, account);
      if (stop) {
        denied.hidden = false;
        denied.textContent = stopMessage(stop);
        return;
      }
    }
    const { data: profile } = await supabase.from('profiles').select('is_admin').eq('id', session.user.id).maybeSingle();
    const { data: membership } = await supabase
      .from('memberships')
      .select('role')
      .eq('profile_id', session.user.id)
      .eq('role', 'admin')
      .limit(1);
    const isAdmin = Boolean(profile?.is_admin) || Boolean(membership?.length);
    if (!isAdmin) {
      denied.hidden = false;
      denied.textContent = 'This account cannot change articles.';
      return;
    }
    void noteActivity(supabase);
    admin.hidden = false;
    const { data: settings, error: settingsError } = await supabase.from('article_settings').select('publication_mode').eq('id', 1).single();
    if (settingsError) statusEl.textContent = settingsError.message;
    else mode.value = settings.publication_mode;
    const { data: articles, error } = await supabase
      .from('match_articles')
      .select('id, article_on, title, summary, body, status, slug')
      .order('article_on', { ascending: false })
      .limit(30);
    if (error) {
      statusEl.textContent = error.message;
      return;
    }
    const placeLabel: Record<Article['status'], string> = {
      held: 'Waiting',
      approved: 'Approved',
      published: 'On the home page',
      archived: 'Match history',
      deleted: 'Removed',
    };
    rows.innerHTML = (articles as Article[]).map((article) => {
      const approve = article.status === 'held'
        ? `<button class="btn btn--ghost btn--sm" type="button" data-approve="${article.id}">Approve</button>`
        : '';
      const archive = article.status === 'published'
        ? `<button class="btn btn--ghost btn--sm" type="button" data-place="archive" data-id="${article.id}" data-title="${escapeHtml(article.title)}">Archive</button>`
        : '';
      const restore = article.status === 'archived'
        ? `<button class="btn btn--ghost btn--sm" type="button" data-place="home" data-id="${article.id}" data-title="${escapeHtml(article.title)}">Show on home</button>`
        : '';
      const remove = article.status === 'deleted'
        ? ''
        : `<button class="btn btn--ghost btn--sm" type="button" data-place="delete" data-id="${article.id}" data-title="${escapeHtml(article.title)}">Delete</button>`;
      const edit = article.status === 'deleted'
        ? ''
        : `<button class="btn btn--ghost btn--sm" type="button" data-edit="${article.id}">Edit</button>`;
      return `<tr><td>${escapeHtml(article.article_on)}</td><td data-title-for="${article.id}">${escapeHtml(article.title)}</td><td>${escapeHtml(placeLabel[article.status])}</td><td class="actions">${edit}${approve}${archive}${restore}${remove}</td></tr>${article.status === 'deleted' ? '' : editor(article)}`;
    }).join('') || '<tr><td colspan="4">No articles yet.</td></tr>';
  }

  showSession();
</script>

<style is:global>
  #articles-app {
    max-width: 52rem;
  }
  #articles-app .lede,
  #articles-app .who {
    color: var(--ink-200);
  }
  #articles-app .stack {
    display: grid;
    gap: 0.75rem;
  }
  #articles-app label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  #articles-app input,
  #articles-app select,
  #articles-app textarea {
    width: 100%;
    background: var(--ink-900);
    color: #fff;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.75rem;
    font: inherit;
  }
  #articles-app .editor {
    margin: 0.4rem 0 0.8rem;
    padding: 1rem;
    border: 2px solid var(--accent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg-card));
  }
  #articles-app .editor__lead {
    margin: 0;
    font-weight: 600;
  }
  #articles-app .field {
    display: grid;
    gap: 0.3rem;
  }
  #articles-app .field__name {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
  }
  #articles-app .field__tag {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  #articles-app .field__hint {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  #articles-app .editor input,
  #articles-app .editor textarea,
  html[data-theme='navy'] #articles-app .editor input,
  html[data-theme='navy'] #articles-app .editor textarea,
  html[data-theme='light'] #articles-app .editor input,
  html[data-theme='light'] #articles-app .editor textarea {
    background: #fff;
    color: #163556;
    color-scheme: light;
    border: 2px solid var(--accent);
  }
  #articles-app [hidden] {
    display: none !important;
  }
  #articles-app .status:empty {
    display: none;
  }
  #articles-app .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  #articles-app h2 {
    margin-top: 1.5rem;
  }
  #articles-app .table-wrap {
    overflow-x: auto;
  }
  #articles-app table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  #articles-app th,
  #articles-app td {
    text-align: left;
    vertical-align: middle;
    line-height: 1.25;
    padding: 0.2rem 0.4rem;
    border-bottom: 1px solid var(--border);
  }
</style>
