---
import Base from '@/layouts/Base.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { url } from '@/lib/site';
---

<Base title="Minigame mk2 scores" description="Remove a name from the Minigame mk2 high-score board." noindex>
  <section class="section">
    <div class="container scores-admin" id="minigame-admin" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <h1>Minigame mk2 scores</h1>
      <p class="lede">
        These names are on the <a href={url('/minigame/')}>Minigame mk2</a> high-score board.
        Remove a row to take that name and score off the board.
      </p>
      <p class="status" data-status role="status"></p>
      <div data-panel="signed-in" hidden>
        <p class="who" data-who></p>
        <p class="actions">
          <a class="btn btn--ghost btn--sm" href={url('/captains/admin/')}>Admin</a>
          <a class="btn btn--ghost btn--sm" href={url('/minigame/')}>Minigame mk2</a>
          <button class="btn btn--ghost btn--sm" type="button" data-sign-out>Sign out</button>
        </p>
        <p data-denied hidden>This account cannot change the minigame board.</p>
        <div data-admin hidden>
          <div class="overview-box">
            <table class="overview">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Score</th>
                  <th>When</th>
                  <th></th>
                </tr>
              </thead>
              <tbody data-rows></tbody>
            </table>
          </div>
          <nav class="pager" data-pager aria-label="Score pages" hidden>
            <button class="btn btn--ghost btn--sm" type="button" data-prev>Previous</button>
            <span data-page-label></span>
            <button class="btn btn--ghost btn--sm" type="button" data-next>Next</button>
          </nav>
          <h2>Disallowed initials</h2>
          <p class="hint">
            ASS, ARS, CUL, CUM, CUN, DIK, FAG, FAP, FUC, FUK, JAP, KKK, NIG, SEX, TIT and XXX are already stopped.
            Add any other initials that should stay off the board.
          </p>
          <form class="allow" data-block>
            <label>
              Initials
              <input name="block" required minlength="2" maxlength="3" autocomplete="off" />
            </label>
            <button class="btn btn--primary btn--sm" type="submit">Stop these initials</button>
          </form>
          <ul data-blocked></ul>
        </div>
      </div>
      <dialog data-confirm>
        <p data-confirm-line></p>
        <p class="actions">
          <button class="btn btn--primary btn--sm" type="button" data-confirm-yes>Remove it</button>
          <button class="btn btn--ghost btn--sm" type="button" data-confirm-no>Keep it</button>
        </p>
      </dialog>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { sendToLogin } from '@/lib/account';

  type Score = { id: number; player_name: string; score: number; created_at: string };

  const root = document.getElementById('minigame-admin');
  if (!root) throw new Error('minigame admin missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const signedIn = root.querySelector<HTMLElement>('[data-panel="signed-in"]')!;
  const denied = root.querySelector<HTMLElement>('[data-denied]')!;
  const admin = root.querySelector<HTMLElement>('[data-admin]')!;
  const whoEl = root.querySelector<HTMLElement>('[data-who]')!;
  const rowsEl = root.querySelector<HTMLElement>('[data-rows]')!;
  const pager = root.querySelector<HTMLElement>('[data-pager]')!;
  const pageLabel = root.querySelector<HTMLElement>('[data-page-label]')!;
  const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]')!;
  const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]')!;
  const blockedEl = root.querySelector<HTMLElement>('[data-blocked]')!;
  const blockForm = root.querySelector<HTMLFormElement>('[data-block]')!;
  const confirmDialog = root.querySelector<HTMLDialogElement>('[data-confirm]')!;
  const confirmLine = root.querySelector<HTMLElement>('[data-confirm-line]')!;
  const PAGE_SIZE = 15;
  let page = 0;
  let total = 0;
  let pendingId: number | null = null;

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);

  function when(value: string) {
    return new Date(value).toLocaleString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  function draw(scores: Score[]) {
    if (!scores.length) {
      rowsEl.innerHTML = '<tr class="empty"><td colspan="4">No scores on the board.</td></tr>';
      return;
    }
    rowsEl.innerHTML = scores
      .map(
        (row) => `<tr>
          <td>${escapeHtml(row.player_name)}</td>
          <td class="num">${row.score}</td>
          <td>${escapeHtml(when(row.created_at))}</td>
          <td><button class="btn btn--ghost btn--sm" type="button" data-remove="${row.id}" data-name="${escapeHtml(row.player_name)}" data-score="${row.score}">Remove</button></td>
        </tr>`,
      )
      .join('');
  }

  function drawPager() {
    const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    const show = total > PAGE_SIZE;
    pager.hidden = !show;
    if (!show) return;
    const start = page * PAGE_SIZE + 1;
    const end = Math.min(total, start + PAGE_SIZE - 1);
    pageLabel.textContent = `${start}–${end} of ${total}`;
    prevBtn.disabled = page <= 0;
    nextBtn.disabled = page >= pages - 1;
  }

  type Blocked = { id: number; initials: string };

  function drawBlocked(names: Blocked[]) {
    if (!names.length) {
      blockedEl.innerHTML = '<li class="empty">No extra initials are stopped.</li>';
      return;
    }
    blockedEl.innerHTML = names
      .map(
        (row) =>
          `<li><span>${escapeHtml(row.initials)}</span><button class="btn btn--ghost btn--sm" type="button" data-unblock="${row.id}">Allow</button></li>`,
      )
      .join('');
  }

  async function loadBlocked() {
    const { data, error } = await supabase
      .from('minigame_blocked_initials')
      .select('id, initials')
      .order('initials', { ascending: true });
    if (error) {
      statusEl.textContent = error.message;
      return;
    }
    drawBlocked((data ?? []) as Blocked[]);
  }

  async function loadScores() {
    const from = page * PAGE_SIZE;
    const { data, error, count } = await supabase
      .from('minigame_scores')
      .select('id, player_name, score, created_at', { count: 'exact' })
      .order('score', { ascending: false })
      .order('created_at', { ascending: true })
      .range(from, from + PAGE_SIZE - 1);
    if (error) {
      statusEl.textContent = error.message;
      return;
    }
    const rows = (data ?? []) as Score[];
    if (!rows.length && page > 0) {
      page = count != null ? Math.max(0, Math.ceil(count / PAGE_SIZE) - 1) : page - 1;
      await loadScores();
      return;
    }
    total = count ?? from + rows.length;
    draw(rows);
    drawPager();
  }

  prevBtn.addEventListener('click', () => {
    if (page <= 0) return;
    page -= 1;
    void loadScores();
  });

  nextBtn.addEventListener('click', () => {
    if ((page + 1) * PAGE_SIZE >= total) return;
    page += 1;
    void loadScores();
  });

  rowsEl.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove]');
    if (!button?.dataset.remove) return;
    pendingId = Number(button.dataset.remove);
    confirmLine.textContent = `Remove ${button.dataset.name} and the score of ${button.dataset.score} from the board?`;
    if (!confirmDialog.open) confirmDialog.showModal();
  });

  confirmDialog.querySelector('[data-confirm-no]')!.addEventListener('click', () => {
    pendingId = null;
    confirmDialog.close();
  });

  confirmDialog.querySelector('[data-confirm-yes]')!.addEventListener('click', async () => {
    const id = pendingId;
    pendingId = null;
    confirmDialog.close();
    if (id == null) return;
    statusEl.textContent = 'Removing…';
    const { error } = await supabase.rpc('delete_minigame_score', { p_id: id });
    statusEl.textContent = error ? error.message : 'Removed from the board.';
    if (!error) await loadScores();
  });

  blockForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const initials = String(new FormData(blockForm).get('block') ?? '').trim().toUpperCase();
    if (!/^[A-Z]{2,3}$/.test(initials)) {
      statusEl.textContent = 'Use two or three letters.';
      return;
    }
    statusEl.textContent = 'Stopping…';
    const { error } = await supabase.rpc('block_minigame_initials', { p_initials: initials });
    statusEl.textContent = error ? error.message : `${initials} is stopped.`;
    if (!error) {
      blockForm.reset();
      await loadBlocked();
    }
  });

  blockedEl.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-unblock]');
    if (!button?.dataset.unblock) return;
    statusEl.textContent = 'Allowing…';
    const { error } = await supabase.rpc('unblock_minigame_initials', { p_id: Number(button.dataset.unblock) });
    statusEl.textContent = error ? error.message : 'Those initials can be used.';
    if (!error) await loadBlocked();
  });

  root.querySelector('[data-sign-out]')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    await showSession();
  });

  async function showSession() {
    const { data } = await supabase.auth.getSession();
    const session = data.session;
    signedIn.hidden = !session;
    admin.hidden = true;
    denied.hidden = true;
    if (!session) {
      sendToLogin();
      return;
    }
    whoEl.textContent = session.user.email ?? 'Signed in';
    const { data: profile } = await supabase.from('profiles').select('is_admin').eq('id', session.user.id).maybeSingle();
    if (!profile?.is_admin) {
      denied.hidden = false;
      return;
    }
    admin.hidden = false;
    await Promise.all([loadScores(), loadBlocked()]);
  }

  void showSession();
</script>

<style>
  .scores-admin {
    max-width: 46rem;
  }
  .lede,
  .who {
    color: var(--ink-200);
  }
  .status:empty {
    display: none;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .overview-box {
    overflow-x: auto;
    margin-top: 1rem;
  }
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .pager span {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .pager button:disabled {
    opacity: 0.45;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.45rem 0.55rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  th {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .num {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  td:last-child,
  th:last-child {
    text-align: right;
    width: 1%;
    white-space: nowrap;
  }
  :global(tr.empty td) {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  dialog {
    background: var(--ink-800);
    color: var(--text);
    border: 1px solid var(--gold-500);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem;
    max-width: 24rem;
  }
  dialog::backdrop {
    background: rgba(0, 10, 24, 0.62);
  }
  dialog p:first-child {
    margin: 0 0 0.9rem;
  }
  h2 {
    margin: 1.6rem 0 0.4rem;
  }
  .hint {
    color: var(--ink-200);
    font-size: 0.9rem;
    margin-top: 0;
  }
  .allow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: end;
    margin: 0.8rem 0;
  }
  .allow label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  .allow input {
    background: var(--ink-900);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.55rem 0.7rem;
    font: inherit;
  }
  [data-blocked] {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  [data-blocked] :global(li) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
  }
  [data-blocked] :global(li.empty) {
    color: var(--text-muted);
    font-size: 0.85rem;
    border-bottom: 0;
  }
  [hidden] {
    display: none !important;
  }
</style>
