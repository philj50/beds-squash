---
import Base from '@/layouts/Base.astro';
import PasswordRules from '@/components/PasswordRules.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';

const captainsHref = `${import.meta.env.BASE_URL}captains/`;
const juniorEntriesHref = `${import.meta.env.BASE_URL}juniors/closed/entries/`;
const articlesHref = `${import.meta.env.BASE_URL}captains/admin/articles/`;
const shareHref = `${import.meta.env.BASE_URL}captains/admin/share/`;
const scoresHref = `${import.meta.env.BASE_URL}captains/admin/minigame/`;
---

<Base
  title="League lists and accounts"
  description="League Master clubs, captains and players, and the accounts that sign in."
  noindex
>
  <section class="section section--tight">
    <div class="container setup" id="setup-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <h1>Clubs and captains</h1>
      <p class="lede">
        Clubs, captains and player names come from League Master.
        Add the email we use for a player on <strong>LM Player</strong>.
        Club and captain emails are copied from League Master too.
        <strong>People</strong> turns an account on and sets the password.
        <strong>Admins</strong> is separate. Nothing is emailed.
      </p>
      <p class="status" data-status role="status"></p>

      <div data-panel="signed-in" hidden>
        <p class="who" data-who></p>
        <p class="actions">
          <a class="btn btn--ghost btn--sm" href={captainsHref}>Captain page</a>
          <a class="btn btn--ghost btn--sm" href={`${captainsHref}matches/`}>Matches</a>
          <a class="btn btn--ghost btn--sm" data-junior-link hidden href={juniorEntriesHref}>Junior entries</a>
          <a class="btn btn--ghost btn--sm" href={articlesHref}>Match articles</a>
          <a class="btn btn--ghost btn--sm" data-share-link hidden href={shareHref}>Shared content</a>
          <a class="btn btn--ghost btn--sm" data-scores-link hidden href={scoresHref}>Minigame scores</a>
          <a class="btn btn--ghost btn--sm" href={`${captainsHref}profile/`}>Profile</a>
          <button class="btn btn--ghost btn--sm" type="button" data-sign-out>Sign out</button>
        </p>
        <p data-denied hidden>This account cannot set up teams.</p>

        <div data-admin hidden>
          <nav class="admin-tabs" aria-label="Admin sections">
            <button type="button" data-tab-button="lm-clubs">LM Club</button>
            <button type="button" data-tab-button="lm-captains">LM Captain</button>
            <button type="button" data-tab-button="lm-players">LM Player</button>
            <button type="button" data-tab-button="accounts">People</button>
            <button type="button" data-tab-button="admins">Admins</button>
            <button type="button" data-tab-button="traffic">Traffic</button>
          </nav>

          <section class="admin-panel" data-tab="lm-clubs">
            <h2>LM Club</h2>
            <p class="muted small">Each club and its contact email are copied from League Master. Change them there. A matching login is a club captain.</p>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>Club</th>
                    <th>Contact</th>
                    <th>Email</th>
                    <th>Role</th>
                  </tr>
                </thead>
                <tbody data-lm-clubs></tbody>
              </table>
            </div>
          </section>

          <section class="admin-panel" data-tab="lm-captains" hidden>
            <h2>LM Captain</h2>
            <p class="muted small">Each team captain and their email are copied from League Master. Change them there. A matching login is a team captain.</p>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>Club</th>
                    <th>Team</th>
                    <th>Captain</th>
                    <th>Email</th>
                    <th>Role</th>
                  </tr>
                </thead>
                <tbody data-lm-captains></tbody>
              </table>
            </div>
          </section>

          <section class="admin-panel" data-tab="lm-players" hidden>
            <h2>LM Player</h2>
            <p class="muted small">Names come from the League Master nomination list. The email is the one we use here. Leave the box and it is saved. Nothing is sent to League Master. A matching login is a player.</p>
            <label class="directory-search">
              Search
              <input type="search" data-player-search placeholder="Club, team, player or email" autocomplete="off" />
            </label>
            <p class="muted small" data-directory-count></p>
            <div class="overview-box">
              <table class="overview directory">
                <thead>
                  <tr>
                    <th>Club</th>
                    <th class="col-team">Team</th>
                    <th>Player</th>
                    <th>Email</th>
                    <th>Role</th>
                  </tr>
                </thead>
                <tbody data-lm-players></tbody>
              </table>
            </div>
          </section>

          <section class="admin-panel" data-tab="accounts" hidden>
            <h2>People</h2>
            <p class="muted small">
              Create the login with the email already on LM Club, LM Captain or LM Player. The role is applied from that list.
              Set the first password and tell them yourself. Nothing is emailed. They change it on their profile.
              An inactive account cannot sign in.
            </p>
            <form class="card" data-form="create-account">
              <div class="card__body stack">
                <h3>Add a person</h3>
                <label>Name <input name="display_name" required minlength="2" maxlength="80" autocomplete="off" /></label>
                <label>
                  Email
                  <span class="pw-field">
                    <input name="email" type="email" required autocomplete="off" />
                    <button class="btn btn--ghost btn--sm" type="button" data-random-email>Random</button>
                  </span>
                </label>
                <label>
                  First password
                  <span class="pw-field">
                    <input name="password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" passwordrules="minlength: 12; required: lower; required: upper; required: digit; required: special;" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                  <PasswordRules />
                </label>
                <label>
                  Confirm password
                  <span class="pw-field">
                    <input name="confirm_password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                </label>
                <p class="muted small">The password has to meet every line above. They change it later on their profile.</p>
                <div class="actions">
                  <button class="btn btn--ghost btn--sm" type="button" data-suggest-password>Suggest a password</button>
                  <button class="btn btn--primary" type="submit">Create account</button>
                </div>
              </div>
            </form>
            <h3>Everyone</h3>
            <p class="muted small">Sorted by role, then by name. Last login is the last time they signed in with a password. A random email is only a login name.</p>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Club / team</th>
                    <th>Status</th>
                    <th>Last login</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody data-people></tbody>
              </table>
            </div>
            <form class="card" data-form="set-password" hidden>
              <div class="card__body stack">
                <h3>Set a new password for <span data-password-who></span></h3>
                <p class="muted small">They can change this later on their profile. Nothing is emailed.</p>
                <input type="hidden" name="user_id" data-password-user />
                <input type="hidden" name="email" data-password-email />
                <label>
                  New password
                  <span class="pw-field">
                    <input name="password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" passwordrules="minlength: 12; required: lower; required: upper; required: digit; required: special;" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                  <PasswordRules />
                </label>
                <label>
                  Confirm password
                  <span class="pw-field">
                    <input name="confirm_password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                </label>
                <div class="actions">
                  <button class="btn btn--ghost btn--sm" type="button" data-suggest-password>Suggest a password</button>
                  <button class="btn btn--primary btn--sm" type="submit">Save password</button>
                  <button class="btn btn--ghost btn--sm" type="button" data-cancel-password>Cancel</button>
                </div>
              </div>
            </form>
          </section>

          <section class="admin-panel" data-tab="admins" hidden>
            <h2>Admins</h2>
            <p class="muted small">
              Admins cover every club and team. The default admin cannot be deleted or turned off.
              League roles stay on the League Master tabs.
            </p>
            <form class="card" data-form="create-admin">
              <div class="card__body stack">
                <h3>Add an admin</h3>
                <label>Name <input name="display_name" required minlength="2" maxlength="80" autocomplete="off" /></label>
                <label>Email <input name="email" type="email" required autocomplete="off" /></label>
                <label>
                  First password
                  <span class="pw-field">
                    <input name="password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" passwordrules="minlength: 12; required: lower; required: upper; required: digit; required: special;" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                  <PasswordRules />
                </label>
                <label>
                  Confirm password
                  <span class="pw-field">
                    <input name="confirm_password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                </label>
                <div class="actions">
                  <button class="btn btn--ghost btn--sm" type="button" data-suggest-password>Suggest a password</button>
                  <button class="btn btn--primary" type="submit">Create admin</button>
                </div>
              </div>
            </form>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody data-admins></tbody>
              </table>
            </div>
            <form class="card" data-form="grant-admin">
              <div class="card__body stack">
                <h3>Make an existing person an admin</h3>
                <label>
                  Person
                  <select name="user_id" required data-grant-admin>
                    <option value="">Choose an account</option>
                  </select>
                </label>
                <button class="btn btn--primary btn--sm" type="submit">Make admin</button>
              </div>
            </form>
          </section>

          <section class="admin-panel" data-tab="traffic" hidden>
            <h2>Site traffic</h2>
            <p class="muted small">
              Page views are anonymous counts from public pages. Sign-ins record who logged in, and when. Admin and captain tools are not counted as page views.
            </p>
            <p class="muted small" data-traffic-status hidden role="status"></p>
            <div class="traffic-stats" data-traffic-stats hidden>
              <dl class="traffic-kpis">
                <div>
                  <dt>Page views (7 days)</dt>
                  <dd data-kpi="views-7">—</dd>
                </div>
                <div>
                  <dt>Sessions (7 days)</dt>
                  <dd data-kpi="sessions-7">—</dd>
                </div>
                <div>
                  <dt>Page views (30 days)</dt>
                  <dd data-kpi="views-30">—</dd>
                </div>
                <div>
                  <dt>Sessions (30 days)</dt>
                  <dd data-kpi="sessions-30">—</dd>
                </div>
                <div>
                  <dt>Sign-ins (7 days)</dt>
                  <dd data-kpi="signins-7">—</dd>
                </div>
                <div>
                  <dt>Sign-ins (30 days)</dt>
                  <dd data-kpi="signins-30">—</dd>
                </div>
              </dl>
              <h3>Last 30 days</h3>
              <div class="overview-box">
                <table class="overview traffic-table">
                  <thead>
                    <tr>
                      <th>Day</th>
                      <th>Page views</th>
                      <th>Sessions</th>
                    </tr>
                  </thead>
                  <tbody data-traffic-by-day></tbody>
                </table>
              </div>
              <h3>Top pages (30 days)</h3>
              <div class="overview-box">
                <table class="overview traffic-table">
                  <thead>
                    <tr>
                      <th>Path</th>
                      <th>Views</th>
                    </tr>
                  </thead>
                  <tbody data-traffic-top></tbody>
                </table>
              </div>
              <h3>Sign-ins (30 days)</h3>
              <div class="overview-box">
                <table class="overview traffic-table">
                  <thead>
                    <tr>
                      <th>When</th>
                      <th>Name</th>
                      <th>Email</th>
                    </tr>
                  </thead>
                  <tbody data-traffic-sign-ins></tbody>
                </table>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { bindPasswordRules, bindPasswordToggles, callManageAccounts, fetchAccountStates, fetchProtectedAdmin, fillSuggestedPassword, passwordIssue } from '@/lib/passwords';
  import { randomLoginEmail, sendToLogin } from '@/lib/account';

  type Person = { id: string; display_name: string; email: string | null; is_admin: boolean };
  type Club = { slug: string; name: string; contact_name: string | null; contact_email: string | null; leaguemaster_club_id?: string | null };
  type OrgTeam = {
    id: number;
    club_slug: string;
    name: string;
    division: string | null;
    leaguemaster_team_id: string | null;
    captain_name: string | null;
    captain_email: string | null;
    last_season: string | null;
  };
  type Membership = {
    id: number;
    profile_id: string;
    role: 'admin' | 'club_captain' | 'team_captain' | 'team_player';
    club_slug: string | null;
    team_id: number | null;
    profiles: { display_name: string; email: string | null } | { display_name: string; email: string | null }[] | null;
    teams: { name: string; division: string | null } | { name: string; division: string | null }[] | null;
  };
  const roleLabel: Record<Membership['role'], string> = {
    admin: 'Admin',
    club_captain: 'Club captain',
    team_captain: 'Team captain',
    team_player: 'Player',
  };
  const roleRank: Record<Membership['role'], number> = {
    admin: 0,
    club_captain: 1,
    team_captain: 2,
    team_player: 3,
  };
  type DirectoryRow = { club: string; team: string; teamId: number; name: string; email: string };

  const root = document.getElementById('setup-app');
  if (!root) throw new Error('setup app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const signedIn = root.querySelector<HTMLElement>('[data-panel="signed-in"]')!;
  const adminPanel = root.querySelector<HTMLElement>('[data-admin]')!;
  const denied = root.querySelector<HTMLElement>('[data-denied]')!;
  const juniorLink = root.querySelector<HTMLElement>('[data-junior-link]')!;
  const shareLink = root.querySelector<HTMLElement>('[data-share-link]')!;
  const scoresLink = root.querySelector<HTMLElement>('[data-scores-link]')!;
  const whoEl = root.querySelector<HTMLElement>('[data-who]')!;
  const lmClubsHost = root.querySelector<HTMLElement>('[data-lm-clubs]')!;
  const lmCaptainsHost = root.querySelector<HTMLElement>('[data-lm-captains]')!;
  const lmPlayersHost = root.querySelector<HTMLElement>('[data-lm-players]')!;
  const directoryCount = root.querySelector<HTMLElement>('[data-directory-count]')!;
  const playerSearch = root.querySelector<HTMLInputElement>('[data-player-search]')!;
  let directoryRows: DirectoryRow[] = [];
  const peopleHost = root.querySelector<HTMLElement>('[data-people]')!;
  const adminsHost = root.querySelector<HTMLElement>('[data-admins]')!;
  const grantAdmin = root.querySelector<HTMLSelectElement>('[data-grant-admin]')!;
  let protectedAdminId = '';
  const tabs = ['lm-clubs', 'lm-captains', 'lm-players', 'accounts', 'admins', 'traffic'] as const;
  type Tab = (typeof tabs)[number];
  const tabAlias: Record<string, Tab> = {
    overview: 'lm-clubs',
    clubs: 'lm-clubs',
    players: 'lm-players',
    roles: 'admins',
  };
  let trafficLoaded = false;
  const trafficStatus = root.querySelector<HTMLElement>('[data-traffic-status]')!;
  const trafficStats = root.querySelector<HTMLElement>('[data-traffic-stats]')!;
  const trafficByDay = root.querySelector<HTMLElement>('[data-traffic-by-day]')!;
  const trafficTop = root.querySelector<HTMLElement>('[data-traffic-top]')!;
  const trafficSignIns = root.querySelector<HTMLElement>('[data-traffic-sign-ins]')!;

  const formatDay = (iso: string) => {
    const d = new Date(`${iso}T12:00:00`);
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  };

  const formatWhen = (iso: string | null) => {
    if (!iso) return 'Not yet';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return 'Not yet';
    return d.toLocaleString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Europe/London',
    });
  };

  const loadTraffic = async () => {
    trafficStatus.hidden = false;
    trafficStatus.textContent = 'Loading traffic…';
    trafficStats.hidden = true;
    const { data, error } = await supabase.rpc('get_site_traffic_stats');
    if (error) {
      trafficStatus.textContent = error.message;
      return;
    }
    const stats = data as {
      total_7d: number;
      total_30d: number;
      sessions_7d: number;
      sessions_30d: number;
      sign_ins_7d?: number;
      sign_ins_30d?: number;
      by_day: { day: string; page_views: number; sessions: number }[];
      top_pages: { path: string; page_views: number }[];
      recent_sign_ins?: { signed_in_at: string; display_name: string; email: string }[];
    };
    root.querySelector('[data-kpi="views-7"]')!.textContent = String(stats.total_7d ?? 0);
    root.querySelector('[data-kpi="sessions-7"]')!.textContent = String(stats.sessions_7d ?? 0);
    root.querySelector('[data-kpi="views-30"]')!.textContent = String(stats.total_30d ?? 0);
    root.querySelector('[data-kpi="sessions-30"]')!.textContent = String(stats.sessions_30d ?? 0);
    root.querySelector('[data-kpi="signins-7"]')!.textContent = String(stats.sign_ins_7d ?? 0);
    root.querySelector('[data-kpi="signins-30"]')!.textContent = String(stats.sign_ins_30d ?? 0);
    const days = stats.by_day ?? [];
    trafficByDay.innerHTML =
      days.length === 0
        ? '<tr><td colspan="3">No data yet. Views appear after visitors browse public pages.</td></tr>'
        : days
            .map(
              (row) =>
                `<tr><td>${escapeHtml(formatDay(row.day))}</td><td>${row.page_views}</td><td>${row.sessions}</td></tr>`,
            )
            .join('');
    const top = stats.top_pages ?? [];
    trafficTop.innerHTML =
      top.length === 0
        ? '<tr><td colspan="2">No data yet.</td></tr>'
        : top
            .map((row) => `<tr><td><code>${escapeHtml(row.path)}</code></td><td>${row.page_views}</td></tr>`)
            .join('');
    const signIns = stats.recent_sign_ins ?? [];
    trafficSignIns.innerHTML =
      signIns.length === 0
        ? '<tr><td colspan="3">No sign-ins yet. A row appears when someone logs in.</td></tr>'
        : signIns
            .map(
              (row) =>
                `<tr><td>${escapeHtml(formatWhen(row.signed_in_at))}</td><td>${escapeHtml(row.display_name)}</td><td>${escapeHtml(row.email || '—')}</td></tr>`,
            )
            .join('');
    trafficStatus.hidden = true;
    trafficStats.hidden = false;
    trafficLoaded = true;
  };

  const showTab = (tab: Tab) => {
    for (const panel of root.querySelectorAll<HTMLElement>('[data-tab]')) panel.hidden = panel.dataset.tab !== tab;
    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-tab-button]')) {
      button.setAttribute('aria-current', button.dataset.tabButton === tab ? 'page' : 'false');
    }
    history.replaceState(null, '', `#${tab}`);
    if (tab === 'traffic' && !trafficLoaded) void loadTraffic();
  };

  root.addEventListener('click', (event) => {
    const tabButton = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tab-button]');
    if (!tabButton?.dataset.tabButton) return;
    const tab = tabAlias[tabButton.dataset.tabButton] ?? (tabButton.dataset.tabButton as Tab);
    if (tabs.includes(tab)) showTab(tab);
  });

  let clubs: Club[] = [];
  let orgTeams: OrgTeam[] = [];

  const setStatus = (message: string) => {
    statusEl.textContent = message;
  };

  const createAccountForm = root.querySelector<HTMLFormElement>('[data-form="create-account"]')!;
  const createAdminForm = root.querySelector<HTMLFormElement>('[data-form="create-admin"]')!;
  const setPasswordForm = root.querySelector<HTMLFormElement>('[data-form="set-password"]')!;
  const passwordWho = root.querySelector<HTMLElement>('[data-password-who]')!;
  const passwordUser = root.querySelector<HTMLInputElement>('[data-password-user]')!;
  const passwordEmail = root.querySelector<HTMLInputElement>('[data-password-email]')!;
  bindPasswordToggles(root);
  bindPasswordRules(root);
  createAccountForm.querySelector<HTMLButtonElement>('[data-random-email]')!.addEventListener('click', () => {
    const input = createAccountForm.querySelector<HTMLInputElement>('[name="email"]');
    if (!input) return;
    input.value = randomLoginEmail();
    input.focus();
    input.select();
  });
  root.querySelectorAll<HTMLButtonElement>('[data-suggest-password]').forEach((button) => {
    button.addEventListener('click', () => {
      const form = button.closest('form');
      if (form) fillSuggestedPassword(form);
    });
  });

  const passwordsMatch = (form: HTMLFormElement) => {
    const data = new FormData(form);
    const password = String(data.get('password') ?? '');
    const confirm = String(data.get('confirm_password') ?? '');
    const email = String(data.get('email') ?? '');
    if (password !== confirm) return 'The passwords do not match.';
    return passwordIssue(password, email);
  };

  createAccountForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(createAccountForm);
    const issue = passwordsMatch(createAccountForm);
    if (issue) {
      setStatus(issue);
      return;
    }
    setStatus('Creating account…');
    const message = await callManageAccounts(supabase, {
      action: 'create',
      display_name: String(data.get('display_name') ?? '').trim(),
      email: String(data.get('email') ?? '').trim(),
      password: String(data.get('password') ?? ''),
    });
    if (message) {
      setStatus(message);
      return;
    }
    await supabase.rpc('apply_lm_roles');
    createAccountForm.reset();
    setStatus('Account created. Their role follows the League Master email. Tell them the email and password. Nothing was emailed.');
    await showSession();
  });

  createAdminForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(createAdminForm);
    const issue = passwordsMatch(createAdminForm);
    if (issue) {
      setStatus(issue);
      return;
    }
    setStatus('Creating admin…');
    const message = await callManageAccounts(supabase, {
      action: 'create',
      display_name: String(data.get('display_name') ?? '').trim(),
      email: String(data.get('email') ?? '').trim(),
      password: String(data.get('password') ?? ''),
      role: 'admin',
    });
    if (message) {
      setStatus(message);
      return;
    }
    createAdminForm.reset();
    setStatus('Admin created. Tell them the email and password. Nothing was emailed.');
    await showSession();
  });

  root.querySelector<HTMLFormElement>('[data-form="grant-admin"]')!.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!grantAdmin.value) return;
    setStatus('Granting admin…');
    const message = await callManageAccounts(supabase, {
      action: 'set-admin',
      user_id: grantAdmin.value,
      is_admin: true,
    });
    if (message) {
      setStatus(message);
      return;
    }
    setStatus('Admin access granted.');
    await showSession();
  });

  setPasswordForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const issue = passwordsMatch(setPasswordForm);
    if (issue) {
      setStatus(issue);
      return;
    }
    setStatus('Saving password…');
    const message = await callManageAccounts(supabase, {
      action: 'set-password',
      user_id: passwordUser.value,
      password: String(new FormData(setPasswordForm).get('password') ?? ''),
    });
    if (message) {
      setStatus(message);
      return;
    }
    setPasswordForm.hidden = true;
    setPasswordForm.reset();
    setStatus(`Password updated for ${passwordWho.textContent}. Nothing was emailed.`);
  });

  root.querySelector('[data-cancel-password]')!.addEventListener('click', () => {
    setPasswordForm.hidden = true;
    setPasswordForm.reset();
  });

  peopleHost.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const openPassword = target.closest<HTMLButtonElement>('[data-open-password]');
    if (openPassword) {
      const userId = openPassword.dataset.openPassword!;
      const email = openPassword.dataset.passwordEmail ?? '';
      passwordWho.textContent = openPassword.dataset.passwordName || 'this account';
      setPasswordForm.hidden = false;
      setPasswordForm.reset();
      setPasswordForm.querySelectorAll<HTMLButtonElement>('[data-toggle-password]').forEach((button) => {
        button.textContent = 'Show';
      });
      passwordUser.value = userId;
      passwordEmail.value = email;
      setPasswordForm.querySelector<HTMLInputElement>('[name="password"]')?.focus();
      return;
    }
    const removePerson = target.closest<HTMLButtonElement>('[data-delete-person]');
    if (removePerson) {
      if (removePerson.dataset.deletePerson === protectedAdminId) {
        setStatus('The default admin cannot be deleted.');
        return;
      }
      const who = removePerson.dataset.personName || 'this person';
      if (!window.confirm(`Delete ${who}? They will no longer be able to sign in.`)) return;
      setStatus('Deleting account…');
      const message = await callManageAccounts(supabase, {
        action: 'delete',
        user_id: removePerson.dataset.deletePerson,
      });
      if (message) {
        setStatus(message);
        return;
      }
      setStatus(`${who} deleted.`);
      await showSession();
      return;
    }
    const randomEmail = target.closest<HTMLButtonElement>('[data-random-email-for]');
    if (randomEmail) {
      const who = randomEmail.dataset.personName || 'this person';
      const email = randomLoginEmail();
      if (!window.confirm(`Set a random login email for ${who}? They will sign in as ${email}. The address they use now will stop working. Nothing is emailed.`)) return;
      setStatus('Saving email…');
      const message = await callManageAccounts(supabase, {
        action: 'set-email',
        user_id: randomEmail.dataset.randomEmailFor,
        email,
      });
      if (message) {
        setStatus(message);
        return;
      }
      setStatus(`Login email for ${who} is now ${email}. Tell them that address. Nothing was emailed.`);
      await showSession();
      return;
    }
    const setActive = target.closest<HTMLButtonElement>('[data-set-active]');
    if (setActive) {
      const who = setActive.dataset.personName || 'this person';
      const active = setActive.dataset.activeNext === 'true';
      if (!active && !window.confirm(`Make ${who} inactive? They cannot sign in until you turn the account back on.`)) return;
      setStatus(active ? 'Turning the account on…' : 'Turning the account off…');
      const message = await callManageAccounts(supabase, {
        action: 'set-active',
        user_id: setActive.dataset.setActive,
        active,
      });
      if (message) {
        setStatus(message);
        return;
      }
      setStatus(active ? `${who} can sign in.` : `${who} is inactive.`);
      await showSession();
      return;
    }
    const setAdmin = target.closest<HTMLButtonElement>('[data-set-admin]');
    if (!setAdmin) return;
    if (setAdmin.dataset.setAdmin === protectedAdminId && setAdmin.dataset.adminNext === 'false') {
      setStatus('The default admin cannot lose admin access.');
      return;
    }
    const makingAdmin = setAdmin.dataset.adminNext === 'true';
    setStatus(makingAdmin ? 'Granting admin…' : 'Removing admin…');
    const message = await callManageAccounts(supabase, {
      action: 'set-admin',
      user_id: setAdmin.dataset.setAdmin,
      is_admin: makingAdmin,
    });
    if (message) {
      setStatus(message);
      return;
    }
    setStatus(makingAdmin ? 'Admin access granted.' : 'Admin access removed.');
    await showSession();
  });

  adminsHost.addEventListener('click', async (event) => {
    const setAdmin = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-set-admin]');
    if (!setAdmin || setAdmin.dataset.adminNext !== 'false') return;
    if (setAdmin.dataset.setAdmin === protectedAdminId) {
      setStatus('The default admin cannot lose admin access.');
      return;
    }
    setStatus('Removing admin…');
    const message = await callManageAccounts(supabase, {
      action: 'set-admin',
      user_id: setAdmin.dataset.setAdmin,
      is_admin: false,
    });
    if (message) {
      setStatus(message);
      return;
    }
    setStatus('Admin access removed.');
    await showSession();
  });

  root.querySelector('[data-sign-out]')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    await showSession();
  });

  const SEASON = 'Winter 2026/27';

  async function showSession() {
    const { data } = await supabase.auth.getSession();
    const session = data.session;
    signedIn.hidden = !session;
    if (!session) {
      adminPanel.hidden = true;
      denied.hidden = true;
      juniorLink.hidden = true;
      shareLink.hidden = true;
      scoresLink.hidden = true;
      sendToLogin();
      return;
    }

    const { data: me, error: meError } = await supabase
      .from('profiles')
      .select('display_name, is_admin')
      .eq('id', session.user.id)
      .maybeSingle();
    if (meError) {
      setStatus(meError.message);
      return;
    }
    const label = me?.display_name || session.user.email;
    whoEl.textContent = `Signed in as ${label}`;
    const allowed = Boolean(me?.is_admin);
    adminPanel.hidden = !allowed;
    denied.hidden = allowed;
    juniorLink.hidden = !allowed;
    shareLink.hidden = !allowed;
    scoresLink.hidden = !allowed;
    if (!allowed) return;

    if (location.hash.slice(1) === 'traffic' && !trafficLoaded) void loadTraffic();

    await supabase.rpc('apply_lm_roles');

    const [
      { data: people, error: peopleError },
      accountStates,
      { data: clubRows, error: clubError },
      { data: orgRows, error: orgError },
      { data: roleRows, error: roleError },
      { data: nomRows, error: nomError },
      { data: contactRows, error: contactError },
    ] = await Promise.all([
      supabase.from('profiles').select('id, display_name, email, is_admin').order('display_name', { ascending: true }),
      fetchAccountStates(supabase),
      supabase.from('clubs').select('slug, name, contact_name, contact_email, leaguemaster_club_id').order('name', { ascending: true }),
      supabase.from('teams').select('id, club_slug, name, division, leaguemaster_team_id, captain_name, captain_email, last_season').order('name', { ascending: true }),
      supabase.from('memberships').select('id, profile_id, role, club_slug, team_id, profiles(display_name, email), teams(name, division)').order('role', { ascending: true }),
      supabase.from('nominations').select('team_id, player_name, period, position, season').eq('season', SEASON),
      supabase.from('lm_player_contacts').select('id, team_id, player_name, email'),
    ]);
    if (peopleError || clubError || orgError || roleError) {
      setStatus(peopleError?.message || clubError?.message || orgError?.message || roleError?.message || 'Could not load the lists.');
      return;
    }
    if (nomError || contactError) setStatus(nomError?.message || contactError?.message || 'Could not load players.');

    clubs = (clubRows ?? []) as Club[];
    orgTeams = (orgRows ?? []) as OrgTeam[];
    const accounts = (people ?? []) as Person[];
    const stateById = new Map((accountStates ?? []).map((state) => [state.id, state]));
    const memberships = (roleRows ?? []) as Membership[];
    const winterTeams = orgTeams.filter((team) => team.last_season === SEASON && team.leaguemaster_team_id);
    const clubNames = new Map(clubs.map((club) => [club.slug, club.name]));
    const leagueClubs = clubs.filter((club) => club.leaguemaster_club_id || winterTeams.some((team) => team.club_slug === club.slug));
    const dash = '—';
    lmClubsHost.innerHTML = leagueClubs.length
      ? leagueClubs
          .map(
            (club) =>
              `<tr><td>${escapeHtml(club.name)}</td><td>${escapeHtml(club.contact_name || dash)}</td><td>${escapeHtml(club.contact_email || dash)}</td><td>Club</td></tr>`,
          )
          .join('')
      : `<tr><td colspan="4">No clubs copied from League Master yet.</td></tr>`;
    const captainRows = winterTeams
      .slice()
      .sort((a, b) => (clubNames.get(a.club_slug) || '').localeCompare(clubNames.get(b.club_slug) || '', 'en') || a.name.localeCompare(b.name, 'en'));
    lmCaptainsHost.innerHTML = captainRows.length
      ? captainRows
          .map(
            (team) =>
              `<tr><td>${escapeHtml(clubNames.get(team.club_slug) || dash)}</td><td>${escapeHtml(team.division ? `${team.name} · ${team.division}` : team.name)}</td><td>${escapeHtml(team.captain_name || dash)}</td><td>${escapeHtml(team.captain_email || dash)}</td><td>Captain</td></tr>`,
          )
          .join('')
      : `<tr><td colspan="5">No captains copied from League Master yet.</td></tr>`;

    const contacts = (contactError ? [] : contactRows ?? []) as { team_id: number; player_name: string; email: string | null }[];
    const nominations = (nomError ? [] : nomRows ?? []) as { team_id: number; player_name: string; period: number; position: number }[];
    const byPlayer = new Map<string, { team_id: number; player_name: string; period: number; position: number }>();
    for (const nom of nominations) {
      const key = `${nom.team_id}:${nom.player_name.toLowerCase()}`;
      const prev = byPlayer.get(key);
      if (!prev || nom.period > prev.period || (nom.period === prev.period && nom.position < prev.position)) byPlayer.set(key, nom);
    }
    directoryRows = [...byPlayer.values()]
      .map((nom) => {
        const team = orgTeams.find((item) => item.id === nom.team_id);
        const contact = contacts.find((item) => item.team_id === nom.team_id && item.player_name.toLowerCase() === nom.player_name.toLowerCase());
        const teamLabel = team ? (team.division ? `${team.name} · ${team.division}` : team.name) : 'Team';
        return {
          club: clubNames.get(team?.club_slug ?? '') || dash,
          team: teamLabel,
          teamId: nom.team_id,
          name: nom.player_name,
          email: contact?.email || '',
        };
      })
      .sort((a, b) => a.club.localeCompare(b.club, 'en') || a.team.localeCompare(b.team, 'en') || a.name.localeCompare(b.name, 'en'));
    paintDirectory();


    const fetchedAdmin = await fetchProtectedAdmin(supabase);
    const onlyAdmin = accounts.filter((person) => person.is_admin);
    protectedAdminId = fetchedAdmin || (onlyAdmin.length === 1 ? onlyAdmin[0].id : '');
    const selfId = session.user.id;
    const one = (value: { display_name?: string; email?: string | null; name?: string; division?: string | null } | { display_name?: string; email?: string | null; name?: string; division?: string | null }[] | null) =>
      Array.isArray(value) ? value[0] : value;
    const whereFor = (membership: Membership) => {
      const team = one(membership.teams);
      const club = clubs.find((item) => item.slug === membership.club_slug);
      if (team) return `${team.name}${team.division ? `, ${team.division}` : ''}`;
      if (club) return club.name;
      return membership.role === 'admin' ? 'All clubs' : '—';
    };
    const rolesFor = (personId: string) =>
      memberships
        .filter((membership) => membership.profile_id === personId)
        .sort((a, b) => roleRank[a.role] - roleRank[b.role] || whereFor(a).localeCompare(whereFor(b), 'en'));
    const personRank = (person: Person) => {
      if (person.is_admin || person.id === protectedAdminId) return 0;
      const roles = rolesFor(person.id);
      return roles.length ? Math.min(...roles.map((membership) => roleRank[membership.role])) : 4;
    };
    const sortedAccounts = accounts.slice().sort((a, b) => {
      const byRole = personRank(a) - personRank(b);
      if (byRole) return byRole;
      return (a.display_name || a.email || '').localeCompare(b.display_name || b.email || '', 'en');
    });
    peopleHost.replaceChildren(
      ...(sortedAccounts.length
        ? sortedAccounts.map((person) => {
            const row = document.createElement('tr');
            const name = person.display_name || 'Unnamed';
            const roles = rolesFor(person.id);
            const isDefault = person.id === protectedAdminId;
            const roleText = [
              person.is_admin || isDefault ? 'Admin' : '',
              ...roles.filter((membership) => membership.role !== 'admin').map((membership) => roleLabel[membership.role]),
            ].filter(Boolean);
            const placeText = person.is_admin || isDefault
              ? 'All clubs'
              : roles.map((membership) => whereFor(membership)).filter((place) => place !== '—').join('; ') || '—';
            const state = stateById.get(person.id);
            const active = state ? state.active : true;
            const deleteButton = protectedAdminId && !isDefault
              ? `<button class="btn btn--ghost btn--sm" type="button" data-delete-person="${person.id}" data-person-name="${escapeHtml(name)}">Delete</button>`
              : '';
            const randomButton = isDefault
              ? ''
              : `<button class="btn btn--ghost btn--sm" type="button" data-random-email-for="${person.id}" data-person-name="${escapeHtml(name)}">Random email</button>`;
            const activeButton = isDefault || person.id === selfId
              ? ''
              : `<button class="btn btn--ghost btn--sm" type="button" data-set-active="${person.id}" data-active-next="${active ? 'false' : 'true'}" data-person-name="${escapeHtml(name)}">${active ? 'Make inactive' : 'Make active'}</button>`;
            const statusText = !state
              ? '—'
              : active
                ? 'Active'
                : '<span class="pill">Inactive</span>';
            row.innerHTML =
              `<td>${escapeHtml(name)}${person.id === selfId ? ' <span class="muted">(you)</span>' : ''}${isDefault ? ' <span class="pill">Default admin</span>' : ''}</td>` +
              `<td>${escapeHtml(person.email || '—')}</td>` +
              `<td>${escapeHtml(roleText.join(', ') || 'No role yet')}</td>` +
              `<td>${escapeHtml(placeText)}</td>` +
              `<td>${statusText}</td>` +
              `<td>${escapeHtml(state ? formatWhen(state.last_sign_in_at) : '—')}</td>` +
              `<td class="col-action col-action--wrap">` +
              `<button class="btn btn--ghost btn--sm" type="button" data-open-password="${person.id}" data-password-name="${escapeHtml(name)}" data-password-email="${escapeHtml(person.email || '')}">Set password</button> ` +
              `${randomButton} ${activeButton}` +
              (deleteButton ? ` ${deleteButton}` : '') +
              `</td>`;
            return row;
          })
        : [Object.assign(document.createElement('tr'), { innerHTML: '<td colspan="7">No accounts yet.</td>' })]),
    );

    const adminRows = sortedAccounts.filter((person) => person.is_admin || person.id === protectedAdminId);
    adminsHost.innerHTML = adminRows.length
      ? adminRows
          .map((person) => {
            const name = person.display_name || 'Unnamed';
            const locked = person.id === protectedAdminId;
            const remove = locked
              ? '<span class="muted">Kept</span>'
              : `<button class="btn btn--ghost btn--sm" type="button" data-set-admin="${person.id}" data-admin-next="false" data-person-name="${escapeHtml(name)}">Remove admin</button>`;
            return `<tr><td>${escapeHtml(name)}${locked ? ' <span class="pill">Default admin</span>' : ''}</td><td>${escapeHtml(person.email || '—')}</td><td class="col-action">${remove}</td></tr>`;
          })
          .join('')
      : '<tr><td colspan="3">No admins yet.</td></tr>';
    const grantCurrent = grantAdmin.value;
    grantAdmin.replaceChildren(new Option('Choose an account', ''));
    for (const person of accounts) {
      if (person.is_admin || person.id === protectedAdminId) continue;
      grantAdmin.append(new Option(person.display_name || person.email || 'Unnamed', person.id));
    }
    if ([...grantAdmin.options].some((option) => option.value === grantCurrent)) grantAdmin.value = grantCurrent;
  }

  function paintDirectory() {
    const query = playerSearch.value.trim().toLowerCase();
    const shown = directoryRows.filter((row) =>
      !query || [row.club, row.team, row.name, row.email].some((value) => value.toLowerCase().includes(query)),
    );
    const withEmail = directoryRows.filter((row) => row.email).length;
    directoryCount.textContent = query
      ? `${shown.length} of ${directoryRows.length} players`
      : `${directoryRows.length} players · ${withEmail} with an email`;
    const html: string[] = [];
    let index = 0;
    while (index < shown.length) {
      const club = shown[index].club;
      let clubCount = 1;
      while (index + clubCount < shown.length && shown[index + clubCount].club === club) clubCount += 1;
      for (let teamIndex = 0; teamIndex < clubCount; ) {
        const team = shown[index + teamIndex].team;
        let teamCount = 1;
        while (teamIndex + teamCount < clubCount && shown[index + teamIndex + teamCount].team === team) teamCount += 1;
        for (let playerIndex = 0; playerIndex < teamCount; playerIndex += 1) {
          const row = shown[index + teamIndex + playerIndex];
          const clubCell = teamIndex === 0 && playerIndex === 0 ? `<td class="col-club" rowspan="${clubCount}">${escapeHtml(club)}</td>` : '';
          const teamCell = playerIndex === 0 ? `<td class="col-team" rowspan="${teamCount}">${escapeHtml(team)}</td>` : '';
          const marker = teamIndex === 0 && playerIndex === 0 ? ' class="club-start"' : playerIndex === 0 ? ' class="team-start"' : '';
          html.push(
            `<tr${marker}>${clubCell}${teamCell}<td>${escapeHtml(row.name)}</td>` +
              `<td><input data-player-email="${row.teamId}" data-player-name="${escapeHtml(row.name)}" data-saved="${escapeHtml(row.email)}" aria-label="Email for ${escapeHtml(row.name)}" type="email" value="${escapeHtml(row.email)}" autocomplete="off" /></td>` +
              `<td>Player</td></tr>`,
          );
        }
        teamIndex += teamCount;
      }
      index += clubCount;
    }
    lmPlayersHost.innerHTML = html.length
      ? html.join('')
      : `<tr><td colspan="5">${directoryRows.length ? 'No players match that search.' : 'No players on the League Master nomination list yet.'}</td></tr>`;
  }

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
  }

  playerSearch.addEventListener('input', () => paintDirectory());

  lmPlayersHost.addEventListener('focusout', async (event) => {
    const input = (event.target as HTMLElement).closest<HTMLInputElement>('[data-player-email]');
    if (!input) return;
    const email = input.value.trim().toLowerCase();
    if (email === (input.dataset.saved ?? '')) return;
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setStatus('Enter a valid email, or leave it blank.');
      return;
    }
    const teamId = Number(input.dataset.playerEmail);
    const name = input.dataset.playerName || '';
    setStatus('Saving email…');
    const { data: existing } = await supabase
      .from('lm_player_contacts')
      .select('id')
      .eq('team_id', teamId)
      .eq('player_name', name)
      .maybeSingle();
    const { error } = existing
      ? await supabase.from('lm_player_contacts').update({ email: email || null }).eq('id', existing.id)
      : await supabase.from('lm_player_contacts').insert({ team_id: teamId, player_name: name, email: email || null });
    if (error) {
      setStatus(error.message);
      return;
    }
    await supabase.rpc('apply_lm_roles');
    input.dataset.saved = email;
    setStatus(`Email saved for ${name}. Their login role follows that address.`);
  });

  const rawTab = location.hash.slice(1);
  const startTab = tabAlias[rawTab] ?? (rawTab as Tab);
  showTab(tabs.includes(startTab) ? startTab : 'lm-clubs');
  showSession();
</script>

