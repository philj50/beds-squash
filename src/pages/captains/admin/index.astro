  root.querySelector('[data-generate-password]')!.addEventListener('click', () => {
    const card = memberCards.find((item) => item.key === passwordCardKey);
    const email = card?.email.trim().toLowerCase() ?? '';
    const password = suggestPassword();
    const issue = passwordIssue(password, email);
    passwordDialogError.textContent = issue ?? '';
    if (issue) return;
    passwordDialogValue.value = password;
    passwordDialogValue.focus();
    passwordDialogValue.select();
  });
  const passwordMessage = (card: MemberCard, password: string) => {
    const lines = [`Player: ${card.name}`, `Login: ${card.email.trim()}`, `Password: ${password}`];
    if (passwordMustChange.checked) lines.push('Please change this password the next time you sign in.');
    return lines.join('\n');
  };
  root.querySelector('[data-copy-dialog-password]')!.addEventListener('click', async () => {
    const card = memberCards.find((item) => item.key === passwordCardKey);
    const password = passwordDialogValue.value;
    if (!card || !password) {
      passwordDialogError.textContent = 'Generate a password first.';
      return;
    }
    const details = passwordMessage(card, password);
    try {
      await navigator.clipboard.writeText(details);
      passwordDialogError.textContent = 'Player, login and password copied. Paste them into an email.';
    } catch {
      passwordDialogValue.focus();
      passwordDialogValue.select();
      passwordDialogError.textContent = details;
    }
  });
  root.querySelector('[data-apply-password]')!.addEventListener('click', async () => {
    const card = memberCards.find((item) => item.key === passwordCardKey);
    if (!card || !viewerIsAdmin || card.protectedAccount) return;
    const email = card.email.trim().toLowerCase();
    const password = passwordDialogValue.value;
    if (!email) {
      passwordDialogError.textContent = 'Add an email on the row before setting a password.';
      return;
    }
    if (!password) {
      passwordDialogError.textContent = 'Generate a password first.';
      return;
    }
    const issue = passwordIssue(password, email);
    if (issue) {
      passwordDialogError.textContent = issue;
      return;
    }
    const mustChange = passwordMustChange.checked;
    passwordDialogError.textContent = card.profileId ? 'Setting the password…' : 'Creating the login…';
    const message = card.profileId
      ? await callManageAccounts(supabase, {
          action: 'set-password',
          user_id: card.profileId,
          password,
          must_change_password: mustChange,
        })
      : await createLogin(card, email, password, mustChange);
    if (message) {
      passwordDialogError.textContent = message;
      return;
    }
    if (!card.profileId) {
      await supabase.rpc('sync_website_player_emails');
      await supabase.rpc('apply_lm_roles');
    }
    passwordDialogError.textContent = 'Password set. Copy the player, login and password. Nothing was emailed.';
    setStatus(`Password set for ${card.name}. Copy the details and tell them. Nothing was emailed.`);
    await showSession();
  });

  async function createLogin(card: MemberCard, email: string, password: string, mustChange: boolean) {
    const body = { action: 'create', display_name: card.name, email, password, must_change_password: mustChange };
    const message = await callManageAccounts(supabase, body);
    if (message !== 'Choose a club.' && message !== 'Choose a role.') return message;
    if (!card.teamId) return 'This player has no team, so the login could not be created.';
    return callManageAccounts(supabase, { ...body, role: 'team_player', team_id: card.teamId });
  }

  root.querySelector('[data-cancel-password]')!.addEventListener('click', () => {
    setPasswordForm.hidden = true;
    setPasswordForm.reset();
  });

  const onAccountAction = async (event: Event) => {
    const target = event.target as HTMLElement;
    const openRoles = target.closest<HTMLButtonElement>('[data-open-role-pop]');
    if (openRoles?.dataset.openRolePop) {
      const card = memberCards.find((item) => item.key === openRoles.dataset.openRolePop);
      if (!card) return;
      if (openRoleKey === card.key && !rolePop.hidden) {
        void closeRolePop();
        return;
      }
      if (!rolePop.hidden) await closeRolePop();
      openRoleKey = card.key;
      rolePopDirty = false;
      paintRolePop(card);
      placeRolePop(openRoles);
      return;
    }
    const resetPassword = target.closest<HTMLButtonElement>('[data-reset-password]');
    if (resetPassword?.dataset.resetPassword) {
      const card = memberCards.find((item) => item.key === resetPassword.dataset.resetPassword);
      if (!card || !viewerIsAdmin || card.protectedAccount) return;
      const email = card.email.trim();
      if (!email) {
        setStatus('Add an email address.');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.toLowerCase())) {
        setStatus('Enter a valid email address.');
        return;
      }
      passwordCardKey = card.key;
      passwordDialogWho.textContent = card.name;
      passwordDialogLogin.textContent = card.email.trim();
      passwordDialogValue.value = '';
      passwordDialogError.textContent = '';
      passwordMustChange.checked = true;
      passwordDialog.showModal();
      return;
    }
    const openPassword = target.closest<HTMLButtonElement>('[data-open-password]');
    if (openPassword) {
      const userId = openPassword.dataset.openPassword!;
      const email = openPassword.dataset.passwordEmail ?? '';
      passwordWho.textContent = openPassword.dataset.passwordName || 'this account';
      setPasswordForm.hidden = false;
      setPasswordForm.reset();
      setPasswordForm.querySelectorAll<HTMLButtonElement>('[data-toggle-password]').forEach((button) => {
        button.textContent = 'Show';
      });
      passwordUser.value = userId;
      passwordEmail.value = email;
      setPasswordForm.querySelector<HTMLInputElement>('[name="password"]')?.focus();
      return;
    }
    const removePerson = target.closest<HTMLButtonElement>('[data-delete-person]');
    if (removePerson) {
      if (!viewerIsAdmin) {
        setStatus('Only an admin can delete an account.');
        return;
      }
      if (removePerson.dataset.deletePerson === protectedAdminId) {
        setStatus('The county admin cannot be deleted.');
        return;
      }
      const who = removePerson.dataset.personName || 'this person';
      if (!window.confirm(`Delete the login for ${who}? Their League Master record stays.`)) return;
      setStatus('Deleting account…');
      const message = await callManageAccounts(supabase, {
        action: 'delete',
        user_id: removePerson.dataset.deletePerson,
      });
      if (message) {
        setStatus(message);
        return;
      }
      setStatus(`${who} deleted.`);
      await showSession();
      return;
    }
    const setActive = target.closest<HTMLButtonElement>('[data-set-active]');
    if (setActive) {
      if (!viewerIsAdmin) {
        setStatus('Only an admin can change whether an account is active.');
        return;
      }
      const who = setActive.dataset.personName || 'this person';
      const active = setActive.dataset.activeNext === 'true';
      const userId = setActive.dataset.setActive ?? '';
      setStatus(active ? 'Turning the account on…' : 'Turning the account off…');
      let message = await callManageAccounts(supabase, {
        action: 'set-active',
        user_id: userId,
        active,
      });
      if (message === 'Unknown action.') {
        const { error } = await supabase.rpc('set_account_active', { p_user_id: userId, p_active: active });
        message = error
          ? /set_account_active|schema cache/i.test(error.message)
            ? 'Active changes are not on the database yet. Run the set_account_active SQL, then try again.'
            : error.message
          : null;
      }
      const card = memberCards.find((item) => item.profileId === userId);
      if (message) {
        setStatus(message);
        setActive.title = message;
        if (card) {
          card.statusHtml = message;
          openMore.add(card.key);
        }
        paintMembers();
        return;
      }
      if (userId) activityChoice.set(userId, active);
      if (card) {
        card.active = active;
        card.statusHtml = active ? 'Active' : 'Inactive';
      }
      paintMembers();
      setStatus(active ? `${who} is active.` : `${who} is inactive.`);
      await showSession();
      return;
    }
    const removeGroup = target.closest<HTMLButtonElement>('[data-group-remove]');
    if (removeGroup) {
      const who = removeGroup.dataset.personName || 'this person';
      const slug = removeGroup.dataset.groupSlug || '';
      setStatus('Updating groups…');
      const { error } = await supabase.from('group_members').delete().eq('profile_id', removeGroup.dataset.groupRemove!).eq('group_slug', slug);
      if (error) {
        setStatus(error.message);
        return;
      }
      setStatus(`${who} removed from ${groupTitle.get(slug) ?? slug}.`);
      await showSession();
      return;
    }
    const setAdmin = target.closest<HTMLButtonElement>('[data-set-admin]');
    if (!setAdmin) return;
    if (setAdmin.dataset.setAdmin === protectedAdminId && setAdmin.dataset.adminNext === 'false') {
      setStatus('The county admin cannot lose admin access.');
      return;
    }
    const makingAdmin = setAdmin.dataset.adminNext === 'true';
    setStatus(makingAdmin ? 'Granting admin…' : 'Removing admin…');
    const message = await callManageAccounts(supabase, {
      action: 'set-admin',
      user_id: setAdmin.dataset.setAdmin,
      is_admin: makingAdmin,
    });
    if (message) {
      setStatus(message);
      return;
    }
    setStatus(makingAdmin ? 'Admin access granted.' : 'Admin access removed.');
    await showSession();
  };
  const openMore = new Set<string>();
  membersHost.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const more = target.closest<HTMLButtonElement>('[data-toggle-more]');
    if (more) {
      const key = more.dataset.toggleMore ?? '';
      const detail = [...membersHost.querySelectorAll<HTMLElement>('[data-member-detail]')].find((row) => row.dataset.memberDetail === key);
      const open = Boolean(detail?.hidden);
      if (detail) detail.hidden = !open;
      more.setAttribute('aria-expanded', String(open));
      more.textContent = open ? '−' : '+';
      if (open) openMore.add(key);
      else openMore.delete(key);
      return;
    }
    const useContact = target.closest<HTMLButtonElement>('[data-use-contact]');
    if (useContact) {
      const key = useContact.dataset.rowKey ?? '';
      const field = useContact.dataset.useContact ?? '';
      const card = memberCards.find((item) => item.key === key);
      if (!card || !viewerIsAdmin || card.protectedAccount) return;
      const fieldInput = (name: string) =>
        [...membersHost.querySelectorAll<HTMLInputElement>('[data-row-field]')].find((item) => item.dataset.rowField === name && item.dataset.rowKey === key);
      const chosen = useContact.dataset.useValue ?? '';
      const current = (name: string) => fieldInput(name)?.value ?? '';
      const email = (field === 'email' ? chosen : current('email')).trim().toLowerCase();
      const es = current('es').trim();
      const phone = (field === 'phone' ? chosen : current('phone')).trim();
      const input = field === 'email' || field === 'phone' ? fieldInput(field) : undefined;
      if (input) input.value = field === 'email' ? email : phone;
      void saveMemberDetails(card, email, es, phone, false);
      return;
    }
    if (target.closest('[data-open-role-pop], [data-set-active], [data-delete-person], [data-reset-password]')) {
      void onAccountAction(event);
      return;
    }
    if (target.closest('input, button, a, textarea, select')) return;
    const row = target.closest<HTMLElement>('[data-member-key]');
    if (!row?.dataset.memberKey) return;
    selectedMemberKey = row.dataset.memberKey;
    paintMembers();
  });
  rolePopOptions.addEventListener('change', () => {
    rolePopDirty = true;
  });
  document.addEventListener('click', (event) => {
    if (rolePop.hidden) return;
    const target = event.target as Node;
    if (rolePop.contains(target)) return;
    if ((event.target as HTMLElement).closest?.('[data-open-role-pop]')) return;
    void closeRolePop();
  });
  membersHost.addEventListener('focusout', (event) => {
    const input = event.target as HTMLInputElement;
    if (!input.matches?.('[data-row-field]')) return;
    const key = input.dataset.rowKey ?? '';
    const next = event.relatedTarget;
    if (next instanceof HTMLElement && next.dataset.rowKey === key) return;
    const card = memberCards.find((item) => item.key === key);
    if (!card || !viewerIsAdmin || card.protectedAccount) return;
    const fieldInput = (field: string) =>
      [...membersHost.querySelectorAll<HTMLInputElement>('[data-row-field]')].find((item) => item.dataset.rowField === field && item.dataset.rowKey === key);
    const valueOf = (field: string) => fieldInput(field)?.value ?? '';
    const email = valueOf('email').trim().toLowerCase();
    const emailInput = fieldInput('email');
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      emailInput?.setAttribute('aria-invalid', 'true');
      setStatus('Enter a valid email address.');
      return;
    }
    emailInput?.removeAttribute('aria-invalid');
    if (emailInput) emailInput.defaultValue = emailInput.value;
    const es = valueOf('es').trim();
    const phone = valueOf('phone').trim();
    if (email === card.email.trim().toLowerCase() && es === card.es && phone === card.phone) return;
    void saveMemberDetails(card, email, es, phone, false);
  });

  root.querySelector('[data-sign-out]')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
