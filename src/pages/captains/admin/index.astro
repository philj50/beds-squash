---
import Base from '@/layouts/Base.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';

const captainsHref = `${import.meta.env.BASE_URL}captains/`;
---

<Base
  title="Team setup"
  description="Match Bedfordshire squash teams to captain accounts."
  noindex
>
  <section class="section">
    <div class="container setup" id="setup-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <p class="test-flag">Test mode. This page is not linked from the public site.</p>
      <h1>Team setup</h1>
      <p class="lede">
        Add a team and the email the captain will register with. When they create an account on the
        <a href={captainsHref}>captain page</a> with that email, the team appears for them and they can add players.
      </p>
      <p class="status" data-status role="status"></p>

      <div data-panel="signed-out">
        <form class="card" data-form="sign-in">
          <div class="card__body stack">
            <label>Email <input name="email" type="email" required autocomplete="email" /></label>
            <label>Password <input name="password" type="password" required autocomplete="current-password" /></label>
            <button class="btn btn--primary" type="submit">Sign in</button>
          </div>
        </form>
      </div>

      <div data-panel="signed-in" hidden>
        <p class="who" data-who></p>
        <p class="actions">
          <a class="btn btn--ghost btn--sm" href={captainsHref}>Captain page</a>
          <button class="btn btn--ghost btn--sm" type="button" data-sign-out>Sign out</button>
        </p>
        <p data-denied hidden>This account cannot set up teams.</p>

        <div data-admin hidden>
          <form class="card" data-form="new">
            <div class="card__body stack">
              <h2>Add a team</h2>
              <label>Team name <input name="name" required minlength="2" maxlength="80" placeholder="Club Towers 1" /></label>
              <label>
                Captain email
                <input name="captain_email" type="email" required list="captain-emails" placeholder="name@example.com" />
              </label>
              <datalist id="captain-emails" data-emails></datalist>
              <p class="muted small">Use the email they will register with. They can register before or after you add the team.</p>
              <button class="btn btn--primary" type="submit">Add team</button>
            </div>
          </form>

          <h2>Teams</h2>
          <div data-teams></div>

          <h2>Registered accounts</h2>
          <ul class="people" data-people></ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';

  type Person = { id: string; display_name: string; email: string | null; is_admin: boolean };
  type Squad = {
    id: number;
    name: string;
    captain_email: string;
    captain_id: string | null;
    profiles: { display_name: string } | { display_name: string }[] | null;
  };

  const root = document.getElementById('setup-app');
  if (!root) throw new Error('setup app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const signedOut = root.querySelector<HTMLElement>('[data-panel="signed-out"]')!;
  const signedIn = root.querySelector<HTMLElement>('[data-panel="signed-in"]')!;
  const adminPanel = root.querySelector<HTMLElement>('[data-admin]')!;
  const denied = root.querySelector<HTMLElement>('[data-denied]')!;
  const teamsHost = root.querySelector<HTMLElement>('[data-teams]')!;
  const peopleHost = root.querySelector<HTMLElement>('[data-people]')!;
  const emailList = root.querySelector<HTMLDataListElement>('[data-emails]')!;

  const setStatus = (message: string) => {
    statusEl.textContent = message;
  };

  const friendly = (error: { code?: string; message: string }) =>
    error.code === '23505' ? 'That captain already has a team with this name.' : error.message;

  root.querySelector<HTMLFormElement>('[data-form="sign-in"]')!.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(event.currentTarget as HTMLFormElement);
    setStatus('Signing in…');
    const { error } = await supabase.auth.signInWithPassword({
      email: String(data.get('email')),
      password: String(data.get('password')),
    });
    setStatus(error ? error.message : '');
    if (!error) await showSession();
  });

  root.querySelector('[data-sign-out]')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    await showSession();
  });

  root.querySelector<HTMLFormElement>('[data-form="new"]')!.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    setStatus('Saving team…');
    const { error } = await supabase.from('captain_squads').insert({
      name: String(data.get('name')).trim(),
      captain_email: String(data.get('captain_email')).trim(),
    });
    if (error) {
      setStatus(friendly(error));
      return;
    }
    form.reset();
    setStatus('Team saved.');
    await showSession();
  });

  teamsHost.addEventListener('submit', async (event) => {
    const form = event.target as HTMLFormElement;
    if (!form.matches('[data-form="team"]')) return;
    event.preventDefault();
    const data = new FormData(form);
    setStatus('Saving team…');
    const { error } = await supabase
      .from('captain_squads')
      .update({
        name: String(data.get('name')).trim(),
        captain_email: String(data.get('captain_email')).trim(),
      })
      .eq('id', Number(form.dataset.id));
    if (error) {
      setStatus(friendly(error));
      return;
    }
    setStatus('Team saved.');
    await showSession();
  });

  teamsHost.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove]');
    if (!button) return;
    const name = button.dataset.teamName || 'this team';
    if (!window.confirm(`Remove ${name}? Players on it will be removed too.`)) return;
    const { error } = await supabase.from('captain_squads').delete().eq('id', Number(button.dataset.remove));
    if (error) {
      setStatus(error.message);
      return;
    }
    setStatus('Team removed.');
    await showSession();
  });

  function matchedName(squad: Squad) {
    const profile = Array.isArray(squad.profiles) ? squad.profiles[0] : squad.profiles;
    return profile?.display_name ?? null;
  }

  async function showSession() {
    const { data } = await supabase.auth.getSession();
    const session = data.session;
    signedOut.hidden = Boolean(session);
    signedIn.hidden = !session;
    if (!session) {
      adminPanel.hidden = true;
      denied.hidden = true;
      return;
    }

    const { data: me, error: meError } = await supabase
      .from('profiles')
      .select('display_name, is_admin')
      .eq('id', session.user.id)
      .maybeSingle();
    if (meError) {
      setStatus(meError.message);
      return;
    }
    const label = me?.display_name || session.user.email;
    root.querySelector('[data-who]')!.textContent = `Signed in as ${label}`;
    const allowed = Boolean(me?.is_admin);
    adminPanel.hidden = !allowed;
    denied.hidden = allowed;
    if (!allowed) return;

    const [{ data: squads, error: squadError }, { data: people, error: peopleError }] = await Promise.all([
      supabase
        .from('captain_squads')
        .select('id, name, captain_email, captain_id, profiles(display_name)')
        .order('name', { ascending: true }),
      supabase.from('profiles').select('id, display_name, email, is_admin').order('display_name', { ascending: true }),
    ]);
    if (squadError || peopleError) {
      setStatus(squadError?.message || peopleError?.message || 'Could not load teams.');
      return;
    }

    const teamRows = (squads ?? []) as Squad[];
    const accounts = (people ?? []) as Person[];

    emailList.replaceChildren(
      ...accounts.flatMap((person) => {
        if (!person.email) return [];
        const option = document.createElement('option');
        option.value = person.email;
        option.label = person.display_name;
        return [option];
      }),
    );

    teamsHost.replaceChildren(
      ...teamRows.map((squad) => {
        const card = document.createElement('article');
        card.className = 'card';
        const who = matchedName(squad);
        const state = who
          ? `Matched to ${escapeHtml(who)}`
          : 'Waiting for this email to register';
        card.innerHTML = `
          <form data-form="team" data-id="${squad.id}">
            <div class="card__body stack">
              <p class="${who ? 'matched' : 'waiting'}">${state}</p>
              <label>Team name <input name="name" required minlength="2" maxlength="80" value="${escapeHtml(squad.name)}" /></label>
              <label>Captain email <input name="captain_email" type="email" required list="captain-emails" value="${escapeHtml(squad.captain_email)}" /></label>
              <div class="actions">
                <button class="btn btn--primary btn--sm" type="submit">Save</button>
                <button class="btn btn--ghost btn--sm" type="button" data-remove="${squad.id}" data-team-name="${escapeHtml(squad.name)}">Remove</button>
              </div>
            </div>
          </form>`;
        return card;
      }),
    );
    if (teamRows.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'muted';
      empty.textContent = 'No teams yet.';
      teamsHost.replaceChildren(empty);
    }

    peopleHost.replaceChildren(
      ...accounts.map((person) => {
        const item = document.createElement('li');
        const email = person.email?.toLowerCase() ?? '';
        const teams = teamRows.filter((squad) => squad.captain_email === email).map((squad) => squad.name);
        const teamText = teams.length ? teams.join(', ') : 'No team yet';
        item.innerHTML =
          `<strong>${escapeHtml(person.display_name || 'Unnamed')}</strong>` +
          `${person.is_admin ? ' <span class="pill">Admin</span>' : ''}` +
          `<span class="muted"> ${escapeHtml(person.email || 'No email')}</span>` +
          `<span class="muted"> — ${escapeHtml(teamText)}</span>`;
        return item;
      }),
    );
  }

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
  }

  showSession();
</script>

<style>
  .setup {
    max-width: 720px;
  }
  .test-flag {
    border: 1px solid var(--gold-500);
    color: var(--gold-400);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    margin: 0 0 1.25rem;
  }
  .lede {
    color: var(--ink-200);
  }
  .status:empty {
    display: none;
  }
  .status {
    margin: 1rem 0;
    color: var(--gold-400);
  }
  .stack {
    display: grid;
    gap: 0.75rem;
  }
  label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  input {
    width: 100%;
    background: var(--ink-900);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.75rem;
    font: inherit;
  }
  .small {
    font-size: 0.85rem;
    margin: 0;
  }
  .who {
    margin-bottom: 0.5rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }
  .card .actions {
    margin: 0;
  }
  [data-teams] {
    display: grid;
    gap: 1rem;
    margin: 0 0 1.5rem;
  }
  .matched,
  .waiting {
    margin: 0;
    font-size: 0.9rem;
  }
  .matched {
    color: var(--gold-400);
  }
  .waiting {
    color: var(--ink-200);
  }
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .people li {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border);
  }
  .pill {
    display: inline-block;
    border: 1px solid var(--gold-500);
    color: var(--gold-400);
    border-radius: 999px;
    padding: 0 0.45rem;
    font-size: 0.75rem;
    vertical-align: middle;
  }
</style>
