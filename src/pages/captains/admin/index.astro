<script>
  import { createClient } from '@supabase/supabase-js';
  import { bindPasswordRules, bindPasswordToggles, callManageAccounts, fetchAccountStates, fillSuggestedPassword, passwordIssue, suggestPassword } from '@/lib/passwords';
  import { loadAccount, noteActivity, privateStop, sendToLogin, stopMessage, type Account } from '@/lib/account';
  import { ENTRY_GROUPS } from '@/lib/junior-age';
  import { compareCellText, sortMarkupRows, watchSortableTables } from '@/lib/table-sort';
  import { gameStem, unpackLiveScore } from '@/lib/scoreboard';

  type Person = { id: string; display_name: string; email: string | null; is_admin: boolean };
  type Club = { slug: string; name: string; contact_name: string | null; contact_email: string | null; leaguemaster_club_id?: string | null };
  type OrgTeam = {
    id: number;
    club_slug: string;
    name: string;
    division: string | null;
    leaguemaster_team_id: string | null;
    captain_name: string | null;
    captain_email: string | null;
    last_season: string | null;
  };
  type Membership = {
    id: number;
    profile_id: string;
    role: 'admin' | 'club_captain' | 'team_captain' | 'team_player';
    club_slug: string | null;
    team_id: number | null;
    profiles: { display_name: string; email: string | null } | { display_name: string; email: string | null }[] | null;
    teams: { name: string; division: string | null } | { name: string; division: string | null }[] | null;
  };
  const roleRank: Record<Membership['role'], number> = {
    admin: 0,
    club_captain: 1,
    team_captain: 2,
    team_player: 3,
  };
  const rankFor = (role: string) => roleRank[role as Membership['role']] ?? 4;
  type RoleCatalog = { slug: string; name: string; position: number };
  type GroupCatalog = { slug: string; name: string; role_slug: string; source: string; managed: boolean; position: number };
  type GroupMember = { profile_id: string | null; person_name: string; place: string | null; group_slug: string };
  const groupTitle = new Map<string, string>();
  type DirectoryRow = { club: string; team: string; teamId: number; name: string; email: string };

  const setupApp = document.getElementById('setup-app');
  if (!setupApp) throw new Error('setup app missing');
  const root: HTMLElement = setupApp;
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const signedIn = root.querySelector<HTMLElement>('[data-panel="signed-in"]')!;
  const workspace = root.querySelector<HTMLElement>('[data-workspace]')!;
  const juniorLink = root.querySelector<HTMLElement>('[data-junior-link]')!;
  const shareLink = root.querySelector<HTMLElement>('[data-share-link]')!;
  const scoresLink = root.querySelector<HTMLElement>('[data-scores-link]')!;
  const whoEl = root.querySelector<HTMLElement>('[data-who]')!;
  const memberSearch = root.querySelector<HTMLInputElement>('[data-member-search]')!;
  const memberGroup = root.querySelector<HTMLSelectElement>('[data-member-group]')!;
  const memberPlace = root.querySelector<HTMLSelectElement>('[data-member-place]')!;
  const memberCount = root.querySelector<HTMLElement>('[data-member-count]')!;
  const membersHost = root.querySelector<HTMLElement>('[data-group-members]')!;
  const groupNote = root.querySelector<HTMLElement>('[data-group-note]')!;
  const passwordDialog = root.querySelector<HTMLDialogElement>('[data-password-dialog]')!;
  const passwordDialogWho = root.querySelector<HTMLElement>('[data-password-dialog-who]')!;
  const passwordDialogLogin = root.querySelector<HTMLElement>('[data-password-dialog-login]')!;
  const passwordDialogError = root.querySelector<HTMLElement>('[data-password-dialog-error]')!;
  const passwordDialogValue = root.querySelector<HTMLInputElement>('[data-password-dialog-value]')!;
  const passwordMustChange = root.querySelector<HTMLInputElement>('[data-password-must-change]')!;
  const rolePop = root.querySelector<HTMLElement>('[data-role-pop]')!;
  const rolePopWho = root.querySelector<HTMLElement>('[data-role-pop-who]')!;
  const rolePopOptions = root.querySelector<HTMLElement>('[data-role-pop-options]')!;
  const createName = root.querySelector<HTMLInputElement>('[data-create-name]')!;
  const createEmail = root.querySelector<HTMLInputElement>('[data-create-email]')!;
  let listedGroups: GroupMember[] = [];
  let directoryRows: DirectoryRow[] = [];
  type PersonContact = { playerId: number; teamId: number | null; name: string; email: string; es: string; phone: string };
  let personContacts: PersonContact[] = [];
  type ContactOffer = { source: string; value: string };
  type MemberCard = {
    key: string;
    name: string;
    profileName: string;
    label: string;
    profileId: string | null;
    email: string;
    emailSource: string;
    emailOffers: ContactOffer[];
    es: string;
    phone: string;
    phoneSource: string;
    phoneOffers: ContactOffer[];
    place: string;
    teams: string;
    groupSlugs: string[];
    groupNames: string;
    roleNames: string;
    isAdmin: boolean;
    squadIds: number[];
    teamId: number | null;
    teamName: string;
    statusHtml: string;
    lastLogin: string;
    protectedAccount: boolean;
    active: boolean;
  };
  let memberCards: MemberCard[] = [];
  let selectedMemberKey = '';
  let signedInIds = new Set<string>();
  let accountStatesReady = false;
  const USER_PAGE = 25;
  let memberSort: { col: number; dir: 1 | -1 } | null = null;
  let memberPage = 0;
  let pinMember = false;
  const usersPager = root.querySelector<HTMLElement>('[data-users-pager]')!;
  const usersRange = root.querySelector<HTMLElement>('[data-users-range]')!;
  const usersPrev = root.querySelector<HTMLButtonElement>('[data-users-prev]')!;
  const usersNext = root.querySelector<HTMLButtonElement>('[data-users-next]')!;
  let passwordCardKey = '';
  let openRoleKey = '';
  let rolePopDirty = false;
  const activityChoice = new Map<string, boolean>();
  let groupCatalogLive: GroupCatalog[] = [];
  let roleCatalogLive: RoleCatalog[] = [];
  let protectedAdminId = '';
  const siteTabs = ['site-club', 'site-team', 'site-player', 'site-sl'] as const;
  const tabs = [...siteTabs, 'juniors', 'beds-closed', 'scores', 'members', 'permissions-groups', 'permissions-roles', 'links', 'traffic', 'database', 'integrations'] as const;
  type Tab = (typeof tabs)[number];
  const tabAlias: Record<string, Tab> = {
    overview: 'members',
    clubs: 'members',
    players: 'members',
    accounts: 'members',
    people: 'members',
    activities: 'members',
    admins: 'members',
    'lm-clubs': 'members',
    'lm-captains': 'members',
    'lm-players': 'site-player',
    groups: 'permissions-groups',
    roles: 'permissions-roles',
    users: 'members',
    config: 'database',
    database: 'database',
    integrations: 'integrations',
  };
  const groupFromHash: Record<string, string> = {
    'lm-clubs': 'lm_club_captains',
    clubs: 'lm_club_captains',
    'lm-captains': 'lm_team_captains',
    'lm-players': 'lm_players',
    players: 'lm_players',
  };
  let openingGroup = groupFromHash[location.hash.slice(1)] ?? '';
  let trafficLoaded = false;
  let databaseLoaded = false;
  let integrationsLoaded = false;
  let bedsClosedLoaded = false;
  let scoresLoaded = false;
  const databaseStatus = root.querySelector<HTMLElement>('[data-database-status]')!;
  const databasePanel = root.querySelector<HTMLElement>('[data-database]')!;
  const databaseCharts = root.querySelector<HTMLElement>('[data-database-charts]')!;
  const databaseTables = root.querySelector<HTMLElement>('[data-database-tables]')!;
  const trafficStatus = root.querySelector<HTMLElement>('[data-traffic-status]')!;
  const trafficStats = root.querySelector<HTMLElement>('[data-traffic-stats]')!;
  const trafficByDay = root.querySelector<HTMLElement>('[data-traffic-by-day]')!;
  const trafficTop = root.querySelector<HTMLElement>('[data-traffic-top]')!;
  const trafficPages = root.querySelector<HTMLElement>('[data-traffic-pages]')!;
  const trafficSignIns = root.querySelector<HTMLElement>('[data-traffic-sign-ins]')!;
  const trafficMembers = root.querySelector<HTMLElement>('[data-traffic-members]')!;
  const trafficVisitors = root.querySelector<HTMLElement>('[data-traffic-visitors]')!;
  const TRAFFIC_PAGE = 10;
  const trafficListPage: Record<string, number> = { visitors: 0, 'by-day': 0, pages: 0, top: 0, members: 0, 'sign-ins': 0 };
  const trafficSort: Record<string, { col: number; dir: 1 | -1 } | undefined> = {};
  const paintTrafficList = (key: string, rows: string[], body: HTMLElement, empty: string) => {
    const sort = trafficSort[key];
    rows = sort ? sortMarkupRows(rows, sort.col, sort.dir) : rows;
    const pager = root.querySelector<HTMLElement>(`[data-traffic-pager="${key}"]`)!;
    const range = pager.querySelector<HTMLElement>('[data-traffic-range]')!;
    const prev = pager.querySelector<HTMLButtonElement>('[data-traffic-prev]')!;
    const next = pager.querySelector<HTMLButtonElement>('[data-traffic-next]')!;
    if (rows.length === 0) {
      body.innerHTML = empty;
      pager.hidden = true;
      return;
    }
    const pageCount = Math.max(1, Math.ceil(rows.length / TRAFFIC_PAGE));
    if (trafficListPage[key] > pageCount - 1) trafficListPage[key] = pageCount - 1;
    if (trafficListPage[key] < 0) trafficListPage[key] = 0;
    const start = trafficListPage[key] * TRAFFIC_PAGE;
    const pageRows = rows.slice(start, start + TRAFFIC_PAGE);
    body.innerHTML = pageRows.join('');
    pager.hidden = rows.length <= TRAFFIC_PAGE;
    range.textContent = `${start + 1}–${start + pageRows.length} of ${rows.length}`;
    prev.disabled = trafficListPage[key] <= 0;
    next.disabled = trafficListPage[key] >= pageCount - 1;
  };
  let trafficVisitorsHtml: string[] = [];
  let trafficDaysHtml: string[] = [];
  let trafficPagesHtml: string[] = [];
  let trafficTopHtml: string[] = [];
  let trafficMembersHtml: string[] = [];
  let trafficSignInsHtml: string[] = [];
  const paintTrafficLists = () => {
    paintTrafficList('visitors', trafficVisitorsHtml, trafficVisitors, '<tr><td colspan="7">No visitors yet today.</td></tr>');
    paintTrafficList('by-day', trafficDaysHtml, trafficByDay, '<tr><td colspan="3">No data yet. Views appear after visitors browse public pages.</td></tr>');
    paintTrafficList('pages', trafficPagesHtml, trafficPages, '<tr><td colspan="3">No hits yet. Each page adds a row after someone opens it.</td></tr>');
    paintTrafficList('top', trafficTopHtml, trafficTop, '<tr><td colspan="2">No data yet.</td></tr>');
    paintTrafficList('members', trafficMembersHtml, trafficMembers, '<tr><td colspan="5">No signed-in visits yet. A row appears when someone who is logged in opens a page.</td></tr>');
    paintTrafficList('sign-ins', trafficSignInsHtml, trafficSignIns, '<tr><td colspan="5">No activity yet. A row appears when someone uses a signed-in page.</td></tr>');
  };
  trafficStats.addEventListener('click', (event) => {
    const expand = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-traffic-expand]');
    if (expand) {
      const detail = [...trafficStats.querySelectorAll<HTMLElement>('[data-traffic-detail]')].find((row) => row.dataset.trafficDetail === expand.dataset.trafficExpand);
      const open = Boolean(detail?.hidden);
      if (detail) detail.hidden = !open;
      expand.setAttribute('aria-expanded', String(open));
      expand.textContent = open ? '−' : '+';
      return;
    }
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-traffic-prev], [data-traffic-next]');
    const key = button?.closest<HTMLElement>('[data-traffic-pager]')?.dataset.trafficPager ?? '';
    if (!button || !(key in trafficListPage)) return;
    trafficListPage[key] += button.hasAttribute('data-traffic-next') ? 1 : -1;
    paintTrafficLists();
  });
  trafficStats.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-open-traffic-user]');
    const name = button?.dataset.openTrafficUser ?? '';
    if (!name) return;
    memberSearch.value = name;
    memberPage = 0;
    showTab('members');
    paintMembers();
  });

  const formatDay = (iso: string) => {
    const d = new Date(`${iso}T12:00:00`);
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  };

  const formatWhen = (iso: string | null) => {
    if (!iso) return 'Not yet';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return 'Not yet';
    return d.toLocaleString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Europe/London',
    });
  };

  const describeBrowser = (agent: string) => {
    if (!agent) return '—';
    if (/googlebot/i.test(agent)) return 'Googlebot';
    if (/bingbot/i.test(agent)) return 'Bingbot';
    if (/bot|crawler|spider|slurp|facebookexternalhit/i.test(agent)) return 'Bot';
    const browser = /Edg\//.test(agent)
      ? 'Edge'
      : /OPR\/|Opera/.test(agent)
        ? 'Opera'
        : /Chrome\/|CriOS\//.test(agent)
          ? 'Chrome'
          : /Firefox\/|FxiOS\//.test(agent)
            ? 'Firefox'
            : /Safari\//.test(agent)
              ? 'Safari'
              : 'Other browser';
    const device = /iPhone/.test(agent) ? 'iPhone' : /iPad/.test(agent) ? 'iPad' : /Android/.test(agent) ? 'Android' : /Windows/.test(agent) ? 'Windows' : /Mac OS X/.test(agent) ? 'Mac' : /Linux/.test(agent) ? 'Linux' : '';
    return device ? `${browser} · ${device}` : browser;
  };

  const cameFrom = (referrer: string) => {
    if (!referrer) return '—';
    try {
      const host = new URL(referrer).hostname.replace(/^www\./, '');
      if (!host || host === location.hostname || host === 'philj50.github.io') return 'This site';
      return host;
    } catch {
      return '—';
    }
  };

  const trafficExpandButton = (key: string, label: string) =>
    `<button type="button" class="row-more" data-traffic-expand="${escapeHtml(key)}" aria-expanded="false" aria-label="${escapeHtml(label)}">+</button>`;

  const groupTrafficAccounts = <T extends { display_name: string; email: string }>(rows: T[]) => {
    const groups: { key: string; name: string; email: string; rows: T[] }[] = [];
    const index = new Map<string, number>();
    for (const row of rows) {
      const key = (row.email || row.display_name || 'unknown').trim().toLowerCase();
      const at = index.get(key);
      if (at === undefined) {
        index.set(key, groups.length);
        groups.push({ key, name: row.display_name, email: row.email, rows: [row] });
      } else {
        groups[at].rows.push(row);
      }
    }
    return groups;
  };

  const loadTraffic = async () => {
    trafficStatus.hidden = false;
    trafficStatus.textContent = 'Loading traffic…';
    trafficStats.hidden = true;
    const { data, error } = await supabase.rpc('get_site_traffic_stats');
    if (error) {
      trafficStatus.textContent = error.message;
      return;
    }
    const stats = data as {
      total_7d: number;
      total_30d: number;
      sessions_7d: number;
      sessions_30d: number;
      sign_ins_7d?: number;
      sign_ins_30d?: number;
      by_day: { day: string; page_views: number; sessions: number }[];
      top_pages: { path: string; page_views: number }[];
      page_hits?: { path: string; hits: number; signed_in_hits: number }[];
      signed_in_views?: { viewed_at: string; path: string; display_name: string; email: string; client_ip?: string }[];
      recent_sign_ins?: { signed_in_at: string; display_name: string; email: string }[];
      visitors_today?: {
        display_name: string;
        email: string;
        hits: number;
        sessions?: number;
        names?: string[];
        client_ip?: string;
        user_agent?: string;
        referrer?: string;
        language?: string;
        last_seen: string;
        pages?: { path: string; hits: number }[];
      }[];
    };
    root.querySelector('[data-kpi="views-7"]')!.textContent = String(stats.total_7d ?? 0);
    root.querySelector('[data-kpi="sessions-7"]')!.textContent = String(stats.sessions_7d ?? 0);
    root.querySelector('[data-kpi="views-30"]')!.textContent = String(stats.total_30d ?? 0);
    root.querySelector('[data-kpi="sessions-30"]')!.textContent = String(stats.sessions_30d ?? 0);
    root.querySelector('[data-kpi="signins-7"]')!.textContent = String(stats.sign_ins_7d ?? 0);
    root.querySelector('[data-kpi="signins-30"]')!.textContent = String(stats.sign_ins_30d ?? 0);
    trafficVisitorsHtml = (stats.visitors_today ?? []).map((row, index) => {
      const id = `today:${index}`;
      const names = (row.names ?? []).map((name) => name.trim()).filter(Boolean);
      const singleName = names.length === 1 ? names[0] : names.length === 0 && row.email ? row.display_name : '';
      const who = singleName
        ? `<button type="button" class="count-button" data-open-traffic-user="${escapeHtml(singleName)}">${escapeHtml(singleName)}</button>`
        : escapeHtml(names.length > 1 ? names.join(', ') : row.display_name || 'Not signed in');
      const pages = (row.pages ?? [])
        .map((page) => `<tr><td><code>${escapeHtml(page.path)}</code></td><td>${page.hits}</td></tr>`)
        .join('');
      const browsers = (row.sessions ?? 1) > 1 ? `<p class="muted small">${row.sessions} browsers${row.client_ip ? ' on this address' : ''}</p>` : '';
      const language = row.language ? `<p class="muted small">Language ${escapeHtml(row.language)}</p>` : '';
      return `<tr><td class="row-action">${trafficExpandButton(id, `Pages for ${row.display_name || 'this visitor'}`)}</td><td>${who}</td><td data-traffic-count>${row.hits}</td><td>${escapeHtml(row.client_ip || '—')}</td><td>${escapeHtml(describeBrowser(row.user_agent || ''))}</td><td>${escapeHtml(cameFrom(row.referrer || ''))}</td><td>${escapeHtml(formatWhen(row.last_seen))}</td></tr><tr data-traffic-detail="${escapeHtml(id)}" hidden><td colspan="7">${browsers}<table class="traffic-records"><thead><tr><th>Page</th><th>Hits</th></tr></thead><tbody>${pages || '<tr><td colspan="2">No pages stored.</td></tr>'}</tbody></table>${language}</td></tr>`;
    });
    trafficDaysHtml = (stats.by_day ?? []).map(
      (row) => `<tr><td>${escapeHtml(formatDay(row.day))}</td><td>${row.page_views}</td><td>${row.sessions}</td></tr>`,
    );
    trafficPagesHtml = (stats.page_hits ?? []).map(
      (row) => `<tr><td><code>${escapeHtml(row.path)}</code></td><td>${row.hits}</td><td>${row.signed_in_hits}</td></tr>`,
    );
    trafficTopHtml = (stats.top_pages ?? []).map(
      (row) => `<tr><td><code>${escapeHtml(row.path)}</code></td><td>${row.page_views}</td></tr>`,
    );
    trafficMembersHtml = groupTrafficAccounts(stats.signed_in_views ?? []).map((group) => {
      const id = `visits:${group.key}`;
      const latest = group.rows[0];
      const records = group.rows
        .map(
          (row) =>
            `<tr><td>${escapeHtml(formatWhen(row.viewed_at))}</td><td>${escapeHtml(row.client_ip || '—')}</td><td><code>${escapeHtml(row.path)}</code></td></tr>`,
        )
        .join('');
