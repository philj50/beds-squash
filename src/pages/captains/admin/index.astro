---
import Base from '@/layouts/Base.astro';
import ChangePassword from '@/components/ChangePassword.astro';
import PasswordRules from '@/components/PasswordRules.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { url } from '@/lib/site';

const captainsHref = url('/captains/');
const juniorEntriesHref = url('/juniors/closed/entries/');
const articlesHref = url('/captains/admin/articles/');
const shareHref = url('/captains/admin/share/');
const scoresHref = url('/captains/admin/minigame/');
---

<Base
  title="Administration"
  description="League Master lists, SquashLevels, and the club, team and player details for this website."
  noindex
>
  <section class="section section--tight">
    <div class="container setup" id="setup-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <h1>Administration</h1>
      <p class="lede">
        <strong>League Master</strong> is the club, captain and player list copied from League Master.
        <strong>SquashLevels</strong> shows levels for those players: a club sees each player’s level and team, and a player sees their own level and the full history.
        <strong>This website</strong> is Club, Team and Player, plus People and Admins for an administrator.
        A club captain sees their club. A team captain sees their team, and their club as read-only, not the other teams.
        A player sees their profile, their League Master line, and the team and club they play for.
        Nothing is emailed.
      </p>
      <p class="status" data-status role="status"></p>

      <div data-panel="signed-in" hidden>
        <p class="who" data-who></p>
        <p class="actions">
          <a class="btn btn--ghost btn--sm" href={captainsHref}>Squad</a>
          <a class="btn btn--ghost btn--sm" href={`${captainsHref}matches/`}>Matches</a>
          <a class="btn btn--ghost btn--sm" data-junior-link hidden href={juniorEntriesHref}>Junior entries</a>
          <a class="btn btn--ghost btn--sm" href={articlesHref}>Match articles</a>
          <a class="btn btn--ghost btn--sm" data-share-link hidden href={shareHref}>Shared content</a>
          <a class="btn btn--ghost btn--sm" data-scores-link hidden href={scoresHref}>Minigame scores</a>
          <button class="btn btn--ghost btn--sm" type="button" data-lm-only data-tab-button="traffic" hidden>Traffic</button>
          <a class="btn btn--ghost btn--sm" href={`${captainsHref}profile/`}>Profile</a>
          <button class="btn btn--ghost btn--sm" type="button" data-sign-out>Sign out</button>
        </p>
        <div data-workspace hidden>
          <nav class="admin-tabs" aria-label="Administration">
            <span class="tab-group" data-lm-only>
              <span class="tab-label">League Master</span>
              <span class="tab-buttons">
                <button type="button" data-tab-button="lm-clubs">LM Club</button>
                <button type="button" data-tab-button="lm-captains">LM Captain</button>
                <button type="button" data-tab-button="lm-players">LM Player</button>
              </span>
            </span>
            <span class="tab-group">
              <span class="tab-label">SquashLevels</span>
              <span class="tab-buttons">
                <button type="button" data-tab-button="site-sl">SL</button>
              </span>
            </span>
            <span class="tab-group">
              <span class="tab-label">This website</span>
              <span class="tab-buttons">
                <button type="button" data-tab-button="site-club">Club</button>
                <button type="button" data-tab-button="site-team">Team</button>
                <button type="button" data-tab-button="site-player">Player</button>
                <button type="button" data-lm-only data-tab-button="accounts">People</button>
                <button type="button" data-lm-only data-tab-button="admins">Admins</button>
              </span>
            </span>
          </nav>

          <section class="admin-panel" data-tab="site-club">
            <h2>Club</h2>
            <p class="muted small" data-site-club-note></p>
            <div data-site-club></div>
          </section>

          <section class="admin-panel" data-tab="site-team" hidden>
            <h2>Team</h2>
            <p class="muted small" data-site-team-note></p>
            <div data-site-team></div>
          </section>

          <section class="admin-panel" data-tab="site-player" hidden>
            <h2>Player</h2>
            <p class="muted small" data-site-player-note></p>
            <form class="card" data-form="own-name">
              <div class="card__body stack">
                <label>
                  Name
                  <input name="display_name" data-own-name required minlength="2" maxlength="80" autocomplete="name" />
                </label>
                <p class="muted small">This is the name on your account for this website.</p>
                <p class="muted small">Email <strong data-own-email></strong></p>
                <button class="btn btn--primary btn--sm" type="submit">Save name</button>
              </div>
            </form>
            <ChangePassword />
            <div class="site-facts" data-own-facts></div>
            <div data-site-player-list></div>
          </section>

          <section class="admin-panel" data-tab="site-sl" hidden>
            <h2>SquashLevels</h2>
            <p class="muted small" data-site-sl-note></p>
            <div data-site-sl></div>
          </section>

          <section class="admin-panel" data-tab="lm-clubs" data-lm-only hidden>
            <h2>LM Club</h2>
            <p class="muted small">Each club and its contact email are copied from League Master. Change them there. A matching login is a club captain.</p>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>Club</th>
                    <th>Contact</th>
                    <th>Email</th>
                    <th>Role</th>
                  </tr>
                </thead>
                <tbody data-lm-clubs></tbody>
              </table>
            </div>
          </section>

          <section class="admin-panel" data-tab="lm-captains" data-lm-only hidden>
            <h2>LM Captain</h2>
            <p class="muted small">Each team captain and their email are copied from League Master. Change them there. A matching login is a team captain.</p>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>Club</th>
                    <th>Team</th>
                    <th>Captain</th>
                    <th>Email</th>
                    <th>Role</th>
                  </tr>
                </thead>
                <tbody data-lm-captains></tbody>
              </table>
            </div>
          </section>

          <section class="admin-panel" data-tab="lm-players" data-lm-only hidden>
            <h2>LM Player</h2>
            <p class="muted small">Names come from the League Master nomination list. The email is the one saved on the Player tab. If that record has an email, it is the one shown here. Nothing on this list is typed, and nothing is sent back to League Master. A matching login is a player.</p>
            <label class="directory-search">
              Search
              <input type="search" data-player-search placeholder="Club, team, player or email" autocomplete="off" />
            </label>
            <p class="muted small" data-directory-count></p>
            <div class="overview-box">
              <table class="overview directory">
                <thead>
                  <tr>
                    <th>Club</th>
                    <th class="col-team">Team</th>
                    <th>Player</th>
                    <th>Email</th>
                    <th>Role</th>
                  </tr>
                </thead>
                <tbody data-lm-players></tbody>
              </table>
            </div>
          </section>

          <section class="admin-panel" data-tab="accounts" data-lm-only hidden>
            <h2>People</h2>
            <p class="muted small">
              Create the login with the email already on LM Club, LM Captain, or Player. The role is applied from that list.
              Set the first password and tell them yourself. Nothing is emailed. They change it on their profile.
              An inactive account cannot sign in.
            </p>
            <div class="people-split">
            <form class="card" data-form="create-account">
              <div class="card__body stack">
                <h3>Add a person</h3>
                <label>Name <input name="display_name" required minlength="2" maxlength="80" autocomplete="off" /></label>
                <label>
                  Email
                  <span class="pw-field">
                    <input name="email" type="email" required autocomplete="off" />
                    <button class="btn btn--ghost btn--sm" type="button" data-random-email>Random</button>
                  </span>
                </label>
                <label>
                  First password
                  <span class="pw-field">
                    <input name="password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                  <PasswordRules />
                </label>
                <label>
                  Confirm password
                  <span class="pw-field">
                    <input name="confirm_password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                </label>
                <p class="muted small">The password has to meet every line above. They change it later on their profile.</p>
                <div class="actions">
                  <button class="btn btn--ghost btn--sm" type="button" data-suggest-password>Suggest a password</button>
                  <button class="btn btn--primary" type="submit">Create account</button>
                </div>
              </div>
            </form>
            <div class="activity-list">
              <h3>Activities</h3>
              <p class="muted small">Each role includes everything above it. A person with two roles can do both.</p>
              <article class="card">
                <div class="card__body">
                  <h3>Player</h3>
                  <ul>
                    <li>See their profile, and change their name and password.</li>
                    <li>See their own matches and mark whether they can play.</li>
                    <li>Send a photo, video, link or article. An admin publishes it before it appears on the site.</li>
                  </ul>
                </div>
              </article>
              <article class="card">
                <div class="card__body">
                  <h3>Team captain</h3>
                  <p class="muted small">Everything a player can do, for their own team, plus:</p>
                  <ul>
                    <li>See the players on their team and set each player's email on the Player tab.</li>
                    <li>See who is in, maybe, or out.</li>
                    <li>Set the playing order for a match.</li>
                  </ul>
                </div>
              </article>
              <article class="card">
                <div class="card__body">
                  <h3>Club captain</h3>
                  <p class="muted small">Everything a team captain can do, for every team at their club.</p>
                </div>
              </article>
              <article class="card">
                <div class="card__body">
                  <h3>Admin</h3>
                  <p class="muted small">Everything a club captain can do, for every club, plus:</p>
                  <ul>
                    <li>The League Master lists, People accounts, and Admins.</li>
                    <li>Site traffic and sign-ins.</li>
                    <li>Publish shared photos and articles, match reports, minigame scores, and junior entries.</li>
                  </ul>
                </div>
              </article>
            </div>
            </div>
            <h3>Everyone</h3>
            <p class="muted small">Sorted by role, then by name. Last login is the last time they signed in with a password. A random email is only a login name.</p>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Club / team</th>
                    <th>Status</th>
                    <th>Last login</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody data-people></tbody>
              </table>
            </div>
            <form class="card" data-form="set-password" hidden>
              <div class="card__body stack">
                <h3>Set a new password for <span data-password-who></span></h3>
                <p class="muted small">They can change this later on their profile. Nothing is emailed.</p>
                <input type="hidden" name="user_id" data-password-user />
                <input type="hidden" name="email" data-password-email />
                <label>
                  New password
                  <span class="pw-field">
                    <input name="password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                  <PasswordRules />
                </label>
                <label>
                  Confirm password
                  <span class="pw-field">
                    <input name="confirm_password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                </label>
                <div class="actions">
                  <button class="btn btn--ghost btn--sm" type="button" data-suggest-password>Suggest a password</button>
                  <button class="btn btn--primary btn--sm" type="submit">Save password</button>
                  <button class="btn btn--ghost btn--sm" type="button" data-cancel-password>Cancel</button>
                </div>
              </div>
            </form>
          </section>

          <section class="admin-panel" data-tab="admins" data-lm-only hidden>
            <h2>Admins</h2>
            <p class="muted small">
              Admins cover every club and team. The county admin cannot be deleted or turned off.
              League roles stay on the League Master tabs.
            </p>
            <form class="card" data-form="create-admin">
              <div class="card__body stack">
                <h3>Add an admin</h3>
                <label>Name <input name="display_name" required minlength="2" maxlength="80" autocomplete="off" /></label>
                <label>Email <input name="email" type="email" required autocomplete="off" /></label>
                <label>
                  First password
                  <span class="pw-field">
                    <input name="password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                  <PasswordRules />
                </label>
                <label>
                  Confirm password
                  <span class="pw-field">
                    <input name="confirm_password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                </label>
                <div class="actions">
                  <button class="btn btn--ghost btn--sm" type="button" data-suggest-password>Suggest a password</button>
                  <button class="btn btn--primary" type="submit">Create admin</button>
                </div>
              </div>
            </form>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody data-admins></tbody>
              </table>
            </div>
            <form class="card" data-form="grant-admin">
              <div class="card__body stack">
                <h3>Make an existing person an admin</h3>
                <label>
                  Person
                  <select name="user_id" required data-grant-admin>
                    <option value="">Choose an account</option>
                  </select>
                </label>
                <button class="btn btn--primary btn--sm" type="submit">Make admin</button>
              </div>
            </form>
          </section>

          <section class="admin-panel" data-tab="traffic" data-lm-only hidden>
            <h2>Site traffic</h2>
            <p class="muted small">
              Page views are anonymous counts from public pages, including the minigame. Sign-ins record who logged in, and when. Admin and captain tools, and switching these tabs, are not counted as page views.
            </p>
            <p class="muted small" data-traffic-status hidden role="status"></p>
            <div class="traffic-stats" data-traffic-stats hidden>
              <dl class="traffic-kpis">
                <div>
                  <dt>Page views (7 days)</dt>
                  <dd data-kpi="views-7">—</dd>
                </div>
                <div>
                  <dt>Sessions (7 days)</dt>
                  <dd data-kpi="sessions-7">—</dd>
                </div>
                <div>
                  <dt>Page views (30 days)</dt>
                  <dd data-kpi="views-30">—</dd>
                </div>
                <div>
                  <dt>Sessions (30 days)</dt>
                  <dd data-kpi="sessions-30">—</dd>
                </div>
                <div>
                  <dt>Sign-ins (7 days)</dt>
                  <dd data-kpi="signins-7">—</dd>
                </div>
                <div>
                  <dt>Sign-ins (30 days)</dt>
                  <dd data-kpi="signins-30">—</dd>
                </div>
              </dl>
              <h3>Last 30 days</h3>
              <div class="overview-box">
                <table class="overview traffic-table">
                  <thead>
                    <tr>
                      <th>Day</th>
                      <th>Page views</th>
                      <th>Sessions</th>
                    </tr>
                  </thead>
                  <tbody data-traffic-by-day></tbody>
                </table>
              </div>
              <h3>Top pages (30 days)</h3>
              <div class="overview-box">
                <table class="overview traffic-table">
                  <thead>
                    <tr>
                      <th>Path</th>
                      <th>Views</th>
                    </tr>
                  </thead>
                  <tbody data-traffic-top></tbody>
                </table>
              </div>
              <h3>Sign-ins (30 days)</h3>
              <div class="overview-box">
                <table class="overview traffic-table">
                  <thead>
                    <tr>
                      <th>When</th>
                      <th>Name</th>
                      <th>Email</th>
                    </tr>
                  </thead>
                  <tbody data-traffic-sign-ins></tbody>
                </table>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { bindPasswordRules, bindPasswordToggles, callManageAccounts, fetchAccountStates, fetchProtectedAdmin, fillSuggestedPassword, passwordIssue } from '@/lib/passwords';
  import { loadAccount, randomLoginEmail, saveDisplayName, sendToLogin, type Account } from '@/lib/account';

  type Person = { id: string; display_name: string; email: string | null; is_admin: boolean };
  type Club = { slug: string; name: string; contact_name: string | null; contact_email: string | null; leaguemaster_club_id?: string | null };
  type OrgTeam = {
    id: number;
    club_slug: string;
    name: string;
    division: string | null;
    leaguemaster_team_id: string | null;
    captain_name: string | null;
    captain_email: string | null;
    last_season: string | null;
  };
  type Membership = {
    id: number;
    profile_id: string;
    role: 'admin' | 'club_captain' | 'team_captain' | 'team_player';
    club_slug: string | null;
    team_id: number | null;
    profiles: { display_name: string; email: string | null } | { display_name: string; email: string | null }[] | null;
    teams: { name: string; division: string | null } | { name: string; division: string | null }[] | null;
  };
  const roleLabel: Record<Membership['role'], string> = {
    admin: 'Admin',
    club_captain: 'Club captain',
    team_captain: 'Team captain',
    team_player: 'Player',
  };
  const roleRank: Record<Membership['role'], number> = {
    admin: 0,
    club_captain: 1,
    team_captain: 2,
    team_player: 3,
  };
  type DirectoryRow = { club: string; team: string; teamId: number; name: string; email: string };

  const root = document.getElementById('setup-app');
  if (!root) throw new Error('setup app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const signedIn = root.querySelector<HTMLElement>('[data-panel="signed-in"]')!;
  const workspace = root.querySelector<HTMLElement>('[data-workspace]')!;
  const juniorLink = root.querySelector<HTMLElement>('[data-junior-link]')!;
  const shareLink = root.querySelector<HTMLElement>('[data-share-link]')!;
  const scoresLink = root.querySelector<HTMLElement>('[data-scores-link]')!;
  const whoEl = root.querySelector<HTMLElement>('[data-who]')!;
  const lmClubsHost = root.querySelector<HTMLElement>('[data-lm-clubs]')!;
  const lmCaptainsHost = root.querySelector<HTMLElement>('[data-lm-captains]')!;
  const lmPlayersHost = root.querySelector<HTMLElement>('[data-lm-players]')!;
  const directoryCount = root.querySelector<HTMLElement>('[data-directory-count]')!;
  const playerSearch = root.querySelector<HTMLInputElement>('[data-player-search]')!;
  let directoryRows: DirectoryRow[] = [];
  const peopleHost = root.querySelector<HTMLElement>('[data-people]')!;
  const adminsHost = root.querySelector<HTMLElement>('[data-admins]')!;
  const grantAdmin = root.querySelector<HTMLSelectElement>('[data-grant-admin]')!;
  let protectedAdminId = '';
  const siteTabs = ['site-club', 'site-team', 'site-player', 'site-sl'] as const;
  const tabs = [...siteTabs, 'lm-clubs', 'lm-captains', 'lm-players', 'accounts', 'admins', 'traffic'] as const;
  type Tab = (typeof tabs)[number];
  const tabAlias: Record<string, Tab> = {
    overview: 'lm-clubs',
    clubs: 'lm-clubs',
    players: 'lm-players',
    roles: 'admins',
    activities: 'accounts',
  };
  let trafficLoaded = false;
  const trafficStatus = root.querySelector<HTMLElement>('[data-traffic-status]')!;
  const trafficStats = root.querySelector<HTMLElement>('[data-traffic-stats]')!;
  const trafficByDay = root.querySelector<HTMLElement>('[data-traffic-by-day]')!;
  const trafficTop = root.querySelector<HTMLElement>('[data-traffic-top]')!;
  const trafficSignIns = root.querySelector<HTMLElement>('[data-traffic-sign-ins]')!;

  const formatDay = (iso: string) => {
    const d = new Date(`${iso}T12:00:00`);
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  };

  const formatWhen = (iso: string | null) => {
    if (!iso) return 'Not yet';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return 'Not yet';
    return d.toLocaleString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Europe/London',
    });
  };

  const loadTraffic = async () => {
    trafficStatus.hidden = false;
    trafficStatus.textContent = 'Loading traffic…';
    trafficStats.hidden = true;
    const { data, error } = await supabase.rpc('get_site_traffic_stats');
    if (error) {
      trafficStatus.textContent = error.message;
      return;
    }
    const stats = data as {
      total_7d: number;
      total_30d: number;
      sessions_7d: number;
      sessions_30d: number;
      sign_ins_7d?: number;
      sign_ins_30d?: number;
      by_day: { day: string; page_views: number; sessions: number }[];
      top_pages: { path: string; page_views: number }[];
      recent_sign_ins?: { signed_in_at: string; display_name: string; email: string }[];
    };
    root.querySelector('[data-kpi="views-7"]')!.textContent = String(stats.total_7d ?? 0);
    root.querySelector('[data-kpi="sessions-7"]')!.textContent = String(stats.sessions_7d ?? 0);
    root.querySelector('[data-kpi="views-30"]')!.textContent = String(stats.total_30d ?? 0);
    root.querySelector('[data-kpi="sessions-30"]')!.textContent = String(stats.sessions_30d ?? 0);
    root.querySelector('[data-kpi="signins-7"]')!.textContent = String(stats.sign_ins_7d ?? 0);
    root.querySelector('[data-kpi="signins-30"]')!.textContent = String(stats.sign_ins_30d ?? 0);
    const days = stats.by_day ?? [];
    trafficByDay.innerHTML =
      days.length === 0
        ? '<tr><td colspan="3">No data yet. Views appear after visitors browse public pages.</td></tr>'
        : days
            .map(
              (row) =>
                `<tr><td>${escapeHtml(formatDay(row.day))}</td><td>${row.page_views}</td><td>${row.sessions}</td></tr>`,
            )
            .join('');
    const top = stats.top_pages ?? [];
    trafficTop.innerHTML =
      top.length === 0
        ? '<tr><td colspan="2">No data yet.</td></tr>'
        : top
            .map((row) => `<tr><td><code>${escapeHtml(row.path)}</code></td><td>${row.page_views}</td></tr>`)
            .join('');
    const signIns = stats.recent_sign_ins ?? [];
    trafficSignIns.innerHTML =
      signIns.length === 0
        ? '<tr><td colspan="3">No sign-ins yet. A row appears when someone logs in.</td></tr>'
        : signIns
            .map(
              (row) =>
