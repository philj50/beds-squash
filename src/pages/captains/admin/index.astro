  type ClosedEntry = {
    year: number;
    grade: string;
    forename: string;
    surname: string;
    email: string;
    telephone: string;
    payment_status: string;
  };
  type ClosedProfile = { id: string; display_name: string | null; email: string | null };
  let bedsEntries: ClosedEntry[] = [];
  let bedsProfiles: ClosedProfile[] = [];
  let bedsYear = 0;

  const paintBedsEntries = () => {
    const body = root.querySelector<HTMLElement>('[data-beds-rows]')!;
    const count = root.querySelector<HTMLElement>('[data-beds-count]')!;
    const yearList = root.querySelector<HTMLElement>('[data-beds-years]')!;
    const query = (root.querySelector<HTMLInputElement>('[data-beds-search]')?.value || '').trim().toLowerCase();
    const years = [...new Set([...bedsEntries.map((entry) => entry.year).filter(Boolean), 2027, 2026])].sort((a, b) => b - a);
    if (bedsYear && !years.includes(bedsYear)) bedsYear = 0;
    yearList.innerHTML = [
      `<li><button type="button" data-beds-year="" aria-pressed="${bedsYear ? 'false' : 'true'}">All</button></li>`,
      ...years.map(
        (year) =>
          `<li><button type="button" data-beds-year="${year}" aria-pressed="${bedsYear === year ? 'true' : 'false'}">${year}</button></li>`,
      ),
    ].join('');
    const chosen = bedsYear ? bedsEntries.filter((entry) => entry.year === bedsYear) : bedsEntries;
    const people = new Map<string, { name: string; email: string; telephone: string; years: number[]; grades: string[]; paid: number; rows: number }>();
    for (const entry of chosen) {
      const email = entry.email.trim().toLowerCase();
      const name = `${entry.forename} ${entry.surname}`.replace(/\s+/g, ' ').trim();
      const key = email || name.toLowerCase();
      if (!key) continue;
      const person = people.get(key) ?? { name, email: entry.email.trim(), telephone: '', years: [], grades: [], paid: 0, known: 0, rows: 0 };
      if (!person.name && name) person.name = name;
      if (!person.telephone && entry.telephone.trim()) person.telephone = entry.telephone.trim();
      if (entry.year && !person.years.includes(entry.year)) person.years.push(entry.year);
      const grade = entry.grade.trim();
      if (grade && !person.grades.includes(grade)) person.grades.push(grade);
      person.rows += 1;
      if (entry.payment_status.trim()) person.known += 1;
      if (entry.payment_status.trim().toLowerCase() === 'succeeded') person.paid += 1;
      people.set(key, person);
    }
    const loginFor = (email: string) => {
      const profile = bedsProfiles.find((person) => (person.email || '').trim().toLowerCase() === email.trim().toLowerCase());
      if (!profile) return 'Not linked';
      const label = (profile.display_name || '').trim() || 'Login';
      return `<span class="pill">Linked</span> ${escapeHtml(label)}`;
    };
    const paidLabel = (person: { paid: number; known: number; rows: number }) => {
      if (!person.known) return '—';
      if (!person.rows || person.paid === 0) return 'Not paid';
      if (person.paid === person.rows) return 'Paid';
      return 'Part paid';
    };
    const shown = [...people.values()].filter((person) => {
      if (!query) return true;
      return [person.name, person.email, person.telephone, person.grades.join(' '), person.years.join(' ')].some((value) => value.toLowerCase().includes(query));
    });
    body.innerHTML = shown.length
      ? shown
          .map((person) => {
            const tags = person.years.length
              ? `<ul class="tag-list">${person.years
                  .slice()
                  .sort((a, b) => b - a)
                  .map((year) => `<li>${year}</li>`)
                  .join('')}</ul>`
              : '—';
            return `<tr><td>${escapeHtml(person.name || '—')}</td><td>${tags}</td><td>${escapeHtml(person.grades.join(', ') || '—')}</td><td>${escapeHtml(person.email || '—')}</td><td>${escapeHtml(person.telephone || '—')}</td><td>${paidLabel(person)}</td><td>${loginFor(person.email)}</td></tr>`;
          })
          .join('')
      : `<tr><td colspan="7">${people.size ? 'No entries match that search.' : 'No entries yet.'}</td></tr>`;
    const noun = (total: number) => (total === 1 ? 'person' : 'people');
    const yearLabel = bedsYear ? String(bedsYear) : years.length ? years.join(' and ') : 'This';
    count.textContent = query ? `${shown.length} of ${people.size} ${noun(people.size)}` : `${yearLabel}: ${people.size} ${noun(people.size)}`;
  };

  const loadBedsClosed = async () => {
    const status = root.querySelector<HTMLElement>('[data-beds-status]')!;
    const list = root.querySelector<HTMLElement>('[data-beds-list]')!;
    status.hidden = false;
    list.hidden = true;
    if (!viewerIsAdmin) {
      status.textContent = 'Only an admin can see the entry list.';
      bedsClosedLoaded = true;
      return;
    }
    status.textContent = 'Loading the entry list…';
    const [{ data, error }, profiles] = await Promise.all([
      supabase
        .from('beds_closed_entries')
        .select('year,grade,forename,surname,email,telephone,payment_status')
        .order('year', { ascending: false })
        .order('surname')
        .order('forename')
        .order('grade'),
      supabase.from('profiles').select('id, display_name, email'),
    ]);
    if (error) {
      status.textContent = /beds_closed_entries|schema cache/i.test(error.message)
        ? 'The entry list is not on the database yet.'
        : error.message;
      return;
    }
    bedsEntries = (data ?? []) as ClosedEntry[];
    if (!bedsEntries.some((entry) => entry.year === 2027)) {
      const published = JSON.parse(document.getElementById('beds-closed-2027')?.textContent || '[]') as { grade?: string; name?: string }[];
      for (const entry of published) {
        const parts = String(entry.name || '').trim().split(/\s+/).filter(Boolean);
        const surname = parts.pop() || '';
        if (!surname) continue;
        bedsEntries.push({
          year: 2027,
          grade: String(entry.grade || ''),
          forename: parts.join(' '),
          surname,
          email: '',
          telephone: '',
          payment_status: '',
        });
      }
    }
    bedsProfiles = (profiles.data ?? []) as ClosedProfile[];
    paintBedsEntries();
    status.hidden = true;
    list.hidden = false;
    bedsClosedLoaded = true;
  };

