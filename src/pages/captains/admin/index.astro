  const loadDatabase = async () => {
    databaseStatus.hidden = false;
    databaseStatus.textContent = 'Loading the database…';
    databasePanel.hidden = true;
    const { data, error } = await supabase.rpc('admin_database_report');
    const report = data as {
      database_bytes?: number;
      tables?: { name: string; rows: number; bytes: number; newest: string | null }[];
      series?: { label: string; points: { week: string; n: number }[] }[];
    } | null;
    const missing = Boolean(
      error && (error.code === 'PGRST202' || /schema cache|Could not find the function|admin_database_report/i.test(error.message)),
    );
    if (error || !report || !Array.isArray(report.tables)) {
      databaseStatus.textContent = missing
        ? 'The database report is not on the database yet. Apply the latest migration, then reload.'
        : error?.message || 'The database report did not come back.';
      return;
    }
    const tables = report.tables;
    const rowCount = tables.reduce((sum, table) => sum + Number(table.rows || 0), 0);
    const bytes = Number(report.database_bytes ?? tables.reduce((sum, table) => sum + Number(table.bytes || 0), 0));
    const formatBytes = (value: number) => {
      if (!Number.isFinite(value) || value < 0) return '—';
      if (value < 1024) return `${Math.round(value)} B`;
      if (value < 1024 * 1024) {
        const kb = value / 1024;
        return `${kb.toFixed(kb < 10 ? 1 : 0)} KB`;
      }
      const mb = value / (1024 * 1024);
      return `${mb.toFixed(mb < 10 ? 1 : 0)} MB`;
    };
    const formatCount = (value: number) => Number(value || 0).toLocaleString('en-GB');
    const setKpi = (name: string, value: string) => {
      const el = root.querySelector<HTMLElement>(`[data-kpi="${name}"]`);
      if (el) el.textContent = value;
    };
    setKpi('db-tables', formatCount(tables.length));
    setKpi('db-rows', formatCount(rowCount));
    setKpi('db-size', formatBytes(bytes));
    const growthChart = (series: { label: string; points: { week: string; n: number }[] }) => {
      const points = (series.points ?? []).map((point) => ({ week: String(point.week), n: Number(point.n) || 0 }));
      if (points.length < 2 || points.every((point) => point.n === 0)) return '';
      const width = 640;
      const height = 180;
      const pad = { l: 40, r: 12, t: 12, b: 28 };
      const max = Math.max(...points.map((point) => point.n), 1);
      const innerW = width - pad.l - pad.r;
      const innerH = height - pad.t - pad.b;
      const xAt = (index: number) => pad.l + (index / (points.length - 1)) * innerW;
      const yAt = (value: number) => pad.t + ((max - value) / max) * innerH;
      const line = points.map((point, index) => `${index === 0 ? 'M' : 'L'}${xAt(index).toFixed(1)},${yAt(point.n).toFixed(1)}`).join(' ');
      const area = `${line} L${xAt(points.length - 1).toFixed(1)},${(pad.t + innerH).toFixed(1)} L${xAt(0).toFixed(1)},${(pad.t + innerH).toFixed(1)} Z`;
      const weekLabel = (iso: string) => {
        const date = new Date(`${iso.slice(0, 10)}T12:00:00`);
        if (Number.isNaN(date.getTime())) return iso;
        return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
      };
      const label = escapeHtml(series.label);
      return `<figure class="db-chart"><figcaption>${label} <span>${formatCount(points[points.length - 1].n)} this week</span></figcaption><svg viewBox="0 0 ${width} ${height}" role="img" aria-label="${label} each week"><line x1="${pad.l}" y1="${(pad.t + innerH).toFixed(1)}" x2="${width - pad.r}" y2="${(pad.t + innerH).toFixed(1)}" stroke="#c5d6e8" stroke-opacity="0.35" /><text x="${pad.l - 6}" y="${(pad.t + 10).toFixed(1)}" text-anchor="end" fill="#c5d6e8" font-size="11">${formatCount(max)}</text><path d="${area}" fill="#f15a22" fill-opacity="0.18" /><path d="${line}" fill="none" stroke="#f15a22" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" /><text x="${xAt(0).toFixed(1)}" y="${height - 8}" text-anchor="start" fill="#c5d6e8" font-size="11">${weekLabel(points[0].week)}</text><text x="${xAt(points.length - 1).toFixed(1)}" y="${height - 8}" text-anchor="end" fill="#c5d6e8" font-size="11">${weekLabel(points[points.length - 1].week)}</text></svg></figure>`;
    };
    const charts = (report.series ?? []).map(growthChart).filter(Boolean).join('');
    databaseCharts.innerHTML = charts || '<p class="muted small">No new rows in the last six months.</p>';
    databaseTables.innerHTML = tables
      .map(
        (table) =>
          `<tr><td><code>${escapeHtml(table.name)}</code></td><td>${formatCount(Number(table.rows) || 0)}</td><td>${formatBytes(Number(table.bytes) || 0)}</td><td>${escapeHtml(formatWhen(table.newest))}</td></tr>`,
      )
      .join('');
    databaseStatus.hidden = true;
    databasePanel.hidden = false;
    databaseLoaded = true;
  };

