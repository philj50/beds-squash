  const passwordsMatch = (form: HTMLFormElement) => {
    const data = new FormData(form);
    const password = String(data.get('password') ?? '');
    const confirm = String(data.get('confirm_password') ?? '');
    const email = String(data.get('email') ?? '');
    if (password !== confirm) return 'The passwords do not match.';
    return passwordIssue(password, email);
  };

  createAccountForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!viewerIsAdmin) {
      setStatus('Only an admin can create an account.');
      return;
    }
    const data = new FormData(createAccountForm);
    const issue = passwordsMatch(createAccountForm);
    if (issue) {
      setStatus(issue);
      return;
    }
    setStatus('Creating account…');
    const message = await callManageAccounts(supabase, {
      action: 'create',
      display_name: String(data.get('display_name') ?? '').trim(),
      email: String(data.get('email') ?? '').trim(),
      password: String(data.get('password') ?? ''),
    });
    if (message) {
      setStatus(message);
      return;
    }
    await supabase.rpc('sync_website_player_emails');
    await supabase.rpc('apply_lm_roles');
    createAccountForm.reset();
    setStatus('Login created. Tell them the email and password. Nothing was emailed.');
    await showSession();
  });

  setPasswordForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const issue = passwordsMatch(setPasswordForm);
    if (issue) {
      setStatus(issue);
      return;
    }
    setStatus('Saving password…');
    const message = await callManageAccounts(supabase, {
      action: 'set-password',
      user_id: passwordUser.value,
      password: String(new FormData(setPasswordForm).get('password') ?? ''),
    });
    if (message) {
      setStatus(message);
      return;
    }
    setPasswordForm.hidden = true;
    setPasswordForm.reset();
    setStatus(`Password updated for ${passwordWho.textContent}. Nothing was emailed.`);
