---
import Base from '@/layouts/Base.astro';
import PasswordRules from '@/components/PasswordRules.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { url } from '@/lib/site';

const captainsHref = url('/captains/');
const juniorEntriesHref = url('/juniors/closed/entries/');
const articlesHref = url('/captains/admin/articles/');
const shareHref = url('/captains/admin/share/');
const scoresHref = url('/captains/admin/minigame/');
---

<Base
  title="Administration"
  description="League Master lists, SquashLevels, website groups, and the club, team and player details."
  noindex
>
  <section class="section section--tight">
    <div class="container setup" id="setup-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <h1>Administration</h1>
      <p class="lede">
        <strong>League Master</strong> lists club captains, team captains, and players. Those lists are read only. The next import replaces names, emails, and England Squash numbers. Phone stays on this website.
        <strong>Juniors</strong> lists the Junior County Closed entries submitted on this website. <strong>Beds Closed</strong> will be used later.
        <strong>SquashLevels</strong> shows each player’s level.
        <strong>Permissions</strong> is Users, Groups, and Roles, and only an admin sees it. Users is every League Master player. Update the email, ES number, and phone there, and change the password, turn the account off, or delete it when a login exists. A group gives one role. League Master fills the club, team, and player groups. Someone in those groups who is on SquashLevels also receives SL Player.
        <strong>Links</strong> joins a League Master player to their SquashLevels name when the names differ.
        A club captain sees their club. A team captain sees their team. A player sees their own row. Nothing is emailed.
      </p>
      <p class="status" data-status role="status"></p>

      <div data-panel="signed-in" hidden>
        <p class="who" data-who></p>
        <p class="actions">
          <a class="btn btn--ghost btn--sm" href={captainsHref}>Squad</a>
          <a class="btn btn--ghost btn--sm" href={`${captainsHref}matches/`}>Matches</a>
          <a class="btn btn--ghost btn--sm" data-junior-link hidden href={juniorEntriesHref}>Junior entries</a>
          <a class="btn btn--ghost btn--sm" href={articlesHref}>Match articles</a>
          <a class="btn btn--ghost btn--sm" data-share-link hidden href={shareHref}>Shared content</a>
          <a class="btn btn--ghost btn--sm" data-scores-link hidden href={scoresHref}>Minigame mk2 scores</a>
          <button class="btn btn--ghost btn--sm" type="button" data-lm-only data-tab-button="traffic" hidden>Traffic</button>
          <a class="btn btn--ghost btn--sm" href={`${captainsHref}profile/`}>Profile</a>
          <button class="btn btn--ghost btn--sm" type="button" data-sign-out>Sign out</button>
        </p>
        <div data-workspace hidden>
          <nav class="admin-tabs" aria-label="Administration">
            <span class="tab-group">
              <span class="tab-label">League Master</span>
              <span class="tab-buttons">
                <button type="button" data-tab-button="site-club">Club</button>
                <button type="button" data-tab-button="site-team">Team</button>
                <button type="button" data-tab-button="site-player">Player</button>
              </span>
            </span>
            <span class="tab-group" data-juniors-nav hidden>
              <span class="tab-label">Juniors</span>
              <span class="tab-buttons">
                <button type="button" data-tab-button="juniors">Juniors</button>
              </span>
            </span>
            <span class="tab-group" data-beds-nav hidden>
              <span class="tab-label">Beds Closed</span>
              <span class="tab-buttons">
                <button type="button" data-tab-button="beds-closed">Players</button>
              </span>
            </span>
            <span class="tab-group">
              <span class="tab-label">SquashLevels</span>
              <span class="tab-buttons">
                <button type="button" data-tab-button="site-sl">SL</button>
              </span>
            </span>
            <span class="tab-group" data-lm-only>
              <span class="tab-label">Permissions</span>
              <span class="tab-buttons">
                <button type="button" data-lm-only data-tab-button="members">Users</button>
                <button type="button" data-lm-only data-tab-button="permissions-groups">Groups</button>
                <button type="button" data-lm-only data-tab-button="permissions-roles">Roles</button>
              </span>
            </span>
            <span class="tab-group" data-lm-only>
              <span class="tab-label">Links</span>
              <span class="tab-buttons">
                <button type="button" data-tab-button="links">Links</button>
              </span>
            </span>
          </nav>

          <section class="admin-panel" data-tab="site-club">
            <h2>Club</h2>
            <p class="muted small" data-site-club-note></p>
            <div data-site-club></div>
          </section>

          <section class="admin-panel" data-tab="site-team" hidden>
            <h2>Team</h2>
            <p class="muted small" data-site-team-note></p>
            <div data-site-team></div>
          </section>

          <section class="admin-panel" data-tab="site-player" hidden>
            <h2>Player</h2>
            <p class="muted small" data-site-player-note></p>
            <p class="muted small">Signed in as <strong data-own-name></strong>. Email <strong data-own-email></strong>. Name and password are changed on your profile.</p>
            <div class="site-facts" data-own-facts></div>
            <div data-site-player-list></div>
          </section>

          <section class="admin-panel" data-tab="juniors" hidden>
            <h2>Juniors</h2>
            <p class="muted small">Junior County Closed entries submitted on this website, with the details from the entry form.</p>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>Player</th>
                    <th>Date of birth</th>
                    <th>Age group</th>
                    <th>Section</th>
                    <th>Club</th>
                    <th>Parent</th>
                    <th>Parent email</th>
                    <th>Parent phone</th>
                    <th>Emergency</th>
                    <th>Emergency phone</th>
                    <th>Notes</th>
                  </tr>
                </thead>
                <tbody data-juniors-people></tbody>
              </table>
            </div>
          </section>

          <section class="admin-panel" data-tab="beds-closed" hidden>
            <h2>Beds Closed</h2>
            <p class="muted small">Beds Closed will be used later.</p>
          </section>

          <section class="admin-panel" data-tab="site-sl" hidden>
            <h2>SquashLevels</h2>
            <p class="muted small" data-site-sl-note></p>
            <div data-site-sl></div>
          </section>

          <section class="admin-panel" data-tab="members" data-lm-only hidden>
            <h2>Users</h2>
            <p class="muted small">
              Every player from League Master. Update the email, ES number, and mobile in the row. Roles adds website roles. Password sets a password you can copy. Nothing is emailed.
            </p>
            <p class="muted small" data-group-note>Filled from League Master. Each person has the LM Player role.</p>
            <div class="member-tools">
              <label class="directory-search">
                Search
                <input type="search" data-member-search placeholder="Name, team or email" autocomplete="off" />
              </label>
            </div>
            <p class="muted small" data-member-count></p>
            <div class="card" data-role-picker hidden>
              <div class="card__body stack">
                <h3 data-role-picker-who></h3>
                <p class="muted small">Choose the roles to add. League Master and SquashLevels roles stay as they are.</p>
                <div class="role-choices" data-role-options></div>
                <div class="actions member-actions">
                  <button class="btn btn--primary btn--sm" type="button" data-save-roles>Save roles</button>
                </div>
              </div>
            </div>
            <div class="card" data-reset-password hidden>
              <div class="card__body stack">
                <h3>Password for <span data-reset-who></span></h3>
                <p class="muted small">Copy this and tell them. Nothing was emailed. It is not shown again after you leave this page.</p>
                <label>
                  Password
                  <input type="text" readonly data-reset-value autocomplete="off" />
                </label>
                <div class="actions member-actions">
                  <button class="btn btn--primary btn--sm" type="button" data-copy-password>Copy</button>
                </div>
              </div>
            </div>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Team</th>
                    <th>Email</th>
                    <th>ES number</th>
                    <th>Mobile</th>
                    <th>Roles</th>
                    <th>Active</th>
                    <th>Password</th>
                    <th>Delete</th>
                    <th>Status</th>
                    <th>Last login</th>
                  </tr>
                </thead>
                <tbody data-users data-group-members></tbody>
              </table>
            </div>
            <form class="card" data-form="create-account" hidden>
              <div class="card__body stack">
                <h3>Create the login</h3>
                <p class="muted small">Only an admin can create a login. Set the first password and tell them yourself. Nothing is emailed.</p>
                <label>Name <input name="display_name" data-create-name required minlength="2" maxlength="80" autocomplete="off" /></label>
                <label>Email <input name="email" type="email" required data-create-email autocomplete="off" /></label>
                <label>
                  First password
                  <span class="pw-field">
                    <input name="password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                  <PasswordRules />
                </label>
                <label>
                  Confirm password
                  <span class="pw-field">
                    <input name="confirm_password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                </label>
                <div class="actions member-actions">
                  <button class="btn btn--ghost btn--sm" type="button" data-suggest-password>Suggest a password</button>
                  <button class="btn btn--primary btn--sm" type="submit">Create login</button>
                </div>
              </div>
            </form>
            <form class="card" data-form="set-password" hidden>
              <div class="card__body stack">
                <h3>Set a new password for <span data-password-who></span></h3>
                <p class="muted small">They can change this later on their profile. Nothing is emailed.</p>
                <input type="hidden" name="user_id" data-password-user />
                <input type="hidden" name="email" data-password-email />
                <label>
                  New password
                  <span class="pw-field">
                    <input name="password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                  <PasswordRules />
                </label>
                <label>
                  Confirm password
                  <span class="pw-field">
                    <input name="confirm_password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
                    <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
                  </span>
                </label>
                <div class="actions member-actions">
                  <button class="btn btn--ghost btn--sm" type="button" data-suggest-password>Suggest a password</button>
                  <button class="btn btn--primary btn--sm" type="submit">Save password</button>
                  <button class="btn btn--ghost btn--sm" type="button" data-cancel-password>Cancel</button>
                </div>
              </div>
            </form>
          </section>

          <section class="admin-panel" data-tab="permissions-groups" data-lm-only hidden>
            <h2>Groups</h2>
            <p class="muted small">
              Each group gives one role. The number of people opens the list. Choose a person to update the email, ES number, and phone, and to use the account actions.
            </p>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>Group</th>
                    <th>Gives</th>
                    <th>Filled from</th>
                    <th>People</th>
                  </tr>
                </thead>
                <tbody data-permission-groups></tbody>
              </table>
            </div>
            <div data-group-people hidden>
              <h3 data-group-people-title></h3>
              <div class="overview-box">
                <table class="overview">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Place</th>
                    </tr>
                  </thead>
                  <tbody data-group-people-rows></tbody>
                </table>
              </div>
            </div>
          </section>

          <section class="admin-panel" data-tab="permissions-roles" data-lm-only hidden>
            <h2>Roles</h2>
            <p class="muted small">A role is the permission its group gives. There is no separate list of people on a role.</p>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>Role</th>
                    <th>Given by</th>
                  </tr>
                </thead>
                <tbody data-permission-roles></tbody>
              </table>
            </div>
          </section>

          <section class="admin-panel" data-tab="links" data-lm-only hidden>
            <h2>Links</h2>
            <p class="muted small">
              Steve Davies is first. Under him are names already linked where the SquashLevels name is not an exact match. Everyone else has no exact SquashLevels name. Type the name exactly as it appears on SquashLevels. A stored record is used when that name is already here. Otherwise the player is fetched from SquashLevels. Remove a link when it is wrong.
            </p>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>LM Player</th>
                    <th>SL</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody data-links></tbody>
              </table>
            </div>
          </section>

          <section class="admin-panel" data-tab="traffic" data-lm-only hidden>
            <h2>Site traffic</h2>
            <p class="muted small">
              Page views are anonymous counts from public pages, including Minigame mk2. Sign-ins record who logged in, and when. Admin and captain tools, and switching these tabs, are not counted as page views.
            </p>
            <p class="muted small" data-traffic-status hidden role="status"></p>
            <div class="traffic-stats" data-traffic-stats hidden>
              <dl class="traffic-kpis">
                <div>
                  <dt>Page views (7 days)</dt>
                  <dd data-kpi="views-7">—</dd>
                </div>
                <div>
                  <dt>Sessions (7 days)</dt>
                  <dd data-kpi="sessions-7">—</dd>
                </div>
                <div>
                  <dt>Page views (30 days)</dt>
                  <dd data-kpi="views-30">—</dd>
                </div>
                <div>
                  <dt>Sessions (30 days)</dt>
                  <dd data-kpi="sessions-30">—</dd>
                </div>
                <div>
                  <dt>Sign-ins (7 days)</dt>
                  <dd data-kpi="signins-7">—</dd>
                </div>
                <div>
                  <dt>Sign-ins (30 days)</dt>
                  <dd data-kpi="signins-30">—</dd>
                </div>
              </dl>
              <h3>Last 30 days</h3>
              <div class="overview-box">
                <table class="overview traffic-table">
                  <thead>
                    <tr>
                      <th>Day</th>
                      <th>Page views</th>
                      <th>Sessions</th>
                    </tr>
                  </thead>
                  <tbody data-traffic-by-day></tbody>
                </table>
              </div>
              <h3>Top pages (30 days)</h3>
              <div class="overview-box">
                <table class="overview traffic-table">
                  <thead>
                    <tr>
                      <th>Path</th>
                      <th>Views</th>
                    </tr>
                  </thead>
                  <tbody data-traffic-top></tbody>
                </table>
              </div>
              <h3>Sign-ins (30 days)</h3>
              <div class="overview-box">
                <table class="overview traffic-table">
                  <thead>
                    <tr>
                      <th>When</th>
                      <th>Name</th>
                      <th>Email</th>
                    </tr>
                  </thead>
                  <tbody data-traffic-sign-ins></tbody>
                </table>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { bindPasswordRules, bindPasswordToggles, callManageAccounts, fetchAccountStates, fillSuggestedPassword, passwordIssue, suggestPassword } from '@/lib/passwords';
  import { loadAccount, sendToLogin, type Account } from '@/lib/account';

  type Person = { id: string; display_name: string; email: string | null; is_admin: boolean };
  type Club = { slug: string; name: string; contact_name: string | null; contact_email: string | null; leaguemaster_club_id?: string | null };
  type OrgTeam = {
    id: number;
    club_slug: string;
    name: string;
    division: string | null;
    leaguemaster_team_id: string | null;
    captain_name: string | null;
    captain_email: string | null;
    last_season: string | null;
  };
  type Membership = {
    id: number;
    profile_id: string;
    role: 'admin' | 'club_captain' | 'team_captain' | 'team_player';
    club_slug: string | null;
    team_id: number | null;
    profiles: { display_name: string; email: string | null } | { display_name: string; email: string | null }[] | null;
    teams: { name: string; division: string | null } | { name: string; division: string | null }[] | null;
  };
  const roleRank: Record<Membership['role'], number> = {
    admin: 0,
    club_captain: 1,
    team_captain: 2,
    team_player: 3,
  };
  const rankFor = (role: string) => roleRank[role as Membership['role']] ?? 4;
  type RoleCatalog = { slug: string; name: string; position: number };
  type GroupCatalog = { slug: string; name: string; role_slug: string; source: string; managed: boolean; position: number };
  type GroupMember = { profile_id: string | null; person_name: string; place: string | null; group_slug: string };
  const groupTitle = new Map<string, string>();
  type DirectoryRow = { club: string; team: string; teamId: number; name: string; email: string };

  const root = document.getElementById('setup-app');
  if (!root) throw new Error('setup app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const signedIn = root.querySelector<HTMLElement>('[data-panel="signed-in"]')!;
  const workspace = root.querySelector<HTMLElement>('[data-workspace]')!;
  const juniorLink = root.querySelector<HTMLElement>('[data-junior-link]')!;
  const shareLink = root.querySelector<HTMLElement>('[data-share-link]')!;
  const scoresLink = root.querySelector<HTMLElement>('[data-scores-link]')!;
  const whoEl = root.querySelector<HTMLElement>('[data-who]')!;
  const memberSearch = root.querySelector<HTMLInputElement>('[data-member-search]')!;
  const memberCount = root.querySelector<HTMLElement>('[data-member-count]')!;
  const membersHost = root.querySelector<HTMLElement>('[data-group-members]')!;
  const groupNote = root.querySelector<HTMLElement>('[data-group-note]')!;
  const rolePicker = root.querySelector<HTMLElement>('[data-role-picker]')!;
  const rolePickerWho = root.querySelector<HTMLElement>('[data-role-picker-who]')!;
  const roleOptions = root.querySelector<HTMLElement>('[data-role-options]')!;
  const resetPasswordPanel = root.querySelector<HTMLElement>('[data-reset-password]')!;
  const resetWho = root.querySelector<HTMLElement>('[data-reset-who]')!;
  const resetValue = root.querySelector<HTMLInputElement>('[data-reset-value]')!;
  const createName = root.querySelector<HTMLInputElement>('[data-create-name]')!;
  const createEmail = root.querySelector<HTMLInputElement>('[data-create-email]')!;
  let listedGroups: GroupMember[] = [];
  let directoryRows: DirectoryRow[] = [];
  type PersonContact = { playerId: number; teamId: number | null; name: string; email: string; es: string; phone: string };
  let personContacts: PersonContact[] = [];
  type MemberCard = {
    key: string;
    name: string;
    profileName: string;
    label: string;
    profileId: string | null;
    email: string;
    es: string;
    phone: string;
    place: string;
    teams: string;
    groupSlugs: string[];
    groupNames: string;
    roleNames: string;
    isAdmin: boolean;
    squadIds: number[];
    teamId: number | null;
    teamName: string;
    statusHtml: string;
    lastLogin: string;
    protectedAccount: boolean;
    active: boolean;
  };
  let memberCards: MemberCard[] = [];
  let selectedMemberKey = '';
  let selectedRoleKey = '';
  let groupCatalogLive: GroupCatalog[] = [];
  let roleCatalogLive: RoleCatalog[] = [];
  let protectedAdminId = '';
  const siteTabs = ['site-club', 'site-team', 'site-player', 'site-sl'] as const;
  const tabs = [...siteTabs, 'juniors', 'beds-closed', 'members', 'permissions-groups', 'permissions-roles', 'links', 'traffic'] as const;
  type Tab = (typeof tabs)[number];
  const tabAlias: Record<string, Tab> = {
    overview: 'members',
    clubs: 'members',
    players: 'members',
    accounts: 'members',
    people: 'members',
    activities: 'members',
    admins: 'members',
    'lm-clubs': 'members',
    'lm-captains': 'members',
    'lm-players': 'site-player',
    groups: 'permissions-groups',
    roles: 'permissions-roles',
    users: 'members',
  };
  const groupFromHash: Record<string, string> = {
    'lm-clubs': 'lm_club_captains',
    clubs: 'lm_club_captains',
    'lm-captains': 'lm_team_captains',
    'lm-players': 'lm_players',
    players: 'lm_players',
  };
  let openingGroup = groupFromHash[location.hash.slice(1)] ?? '';
  let trafficLoaded = false;
  const trafficStatus = root.querySelector<HTMLElement>('[data-traffic-status]')!;
  const trafficStats = root.querySelector<HTMLElement>('[data-traffic-stats]')!;
  const trafficByDay = root.querySelector<HTMLElement>('[data-traffic-by-day]')!;
  const trafficTop = root.querySelector<HTMLElement>('[data-traffic-top]')!;
  const trafficSignIns = root.querySelector<HTMLElement>('[data-traffic-sign-ins]')!;

  const formatDay = (iso: string) => {
    const d = new Date(`${iso}T12:00:00`);
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  };

  const formatWhen = (iso: string | null) => {
    if (!iso) return 'Not yet';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return 'Not yet';
    return d.toLocaleString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Europe/London',
    });
  };

  const loadTraffic = async () => {
    trafficStatus.hidden = false;
    trafficStatus.textContent = 'Loading traffic…';
    trafficStats.hidden = true;
    const { data, error } = await supabase.rpc('get_site_traffic_stats');
    if (error) {
      trafficStatus.textContent = error.message;
      return;
    }
    const stats = data as {
      total_7d: number;
      total_30d: number;
      sessions_7d: number;
      sessions_30d: number;
      sign_ins_7d?: number;
      sign_ins_30d?: number;
      by_day: { day: string; page_views: number; sessions: number }[];
      top_pages: { path: string; page_views: number }[];
      recent_sign_ins?: { signed_in_at: string; display_name: string; email: string }[];
    };
    root.querySelector('[data-kpi="views-7"]')!.textContent = String(stats.total_7d ?? 0);
    root.querySelector('[data-kpi="sessions-7"]')!.textContent = String(stats.sessions_7d ?? 0);
    root.querySelector('[data-kpi="views-30"]')!.textContent = String(stats.total_30d ?? 0);
    root.querySelector('[data-kpi="sessions-30"]')!.textContent = String(stats.sessions_30d ?? 0);
    root.querySelector('[data-kpi="signins-7"]')!.textContent = String(stats.sign_ins_7d ?? 0);
    root.querySelector('[data-kpi="signins-30"]')!.textContent = String(stats.sign_ins_30d ?? 0);
    const days = stats.by_day ?? [];
    trafficByDay.innerHTML =
      days.length === 0
        ? '<tr><td colspan="3">No data yet. Views appear after visitors browse public pages.</td></tr>'
        : days
            .map(
              (row) =>
                `<tr><td>${escapeHtml(formatDay(row.day))}</td><td>${row.page_views}</td><td>${row.sessions}</td></tr>`,
            )
            .join('');
    const top = stats.top_pages ?? [];
    trafficTop.innerHTML =
      top.length === 0
        ? '<tr><td colspan="2">No data yet.</td></tr>'
        : top
            .map((row) => `<tr><td><code>${escapeHtml(row.path)}</code></td><td>${row.page_views}</td></tr>`)
            .join('');
    const signIns = stats.recent_sign_ins ?? [];
    trafficSignIns.innerHTML =
      signIns.length === 0
        ? '<tr><td colspan="3">No sign-ins yet. A row appears when someone logs in.</td></tr>'
        : signIns
            .map(
              (row) =>
                `<tr><td>${escapeHtml(formatWhen(row.signed_in_at))}</td><td>${escapeHtml(row.display_name)}</td><td>${escapeHtml(row.email || '—')}</td></tr>`,
            )
            .join('');
    trafficStatus.hidden = true;
    trafficStats.hidden = false;
    trafficLoaded = true;
  };

  let viewerIsAdmin = false;
  let viewerSeesJuniors = false;
  let viewerSeesBeds = false;
  let viewerId = '';
  const allowedTabs = (): readonly Tab[] => {
    const next = [...siteTabs] as Tab[];
    if (viewerSeesJuniors) next.push('juniors');
    if (viewerSeesBeds) next.push('beds-closed');
    if (viewerIsAdmin) next.push('members', 'permissions-groups', 'permissions-roles', 'links', 'traffic');
    return next;
  };

  const showTab = (tab: Tab) => {
    const next = allowedTabs().includes(tab) ? tab : viewerIsAdmin ? 'members' : 'site-club';
    for (const panel of root.querySelectorAll<HTMLElement>('[data-tab]')) panel.hidden = panel.dataset.tab !== next;
    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-tab-button]')) {
      button.setAttribute('aria-current', button.dataset.tabButton === next ? 'page' : 'false');
    }
    history.replaceState(null, '', `#${next}`);
    if (next === 'traffic' && !trafficLoaded) void loadTraffic();
  };

  root.addEventListener('click', (event) => {
    const tabButton = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tab-button]');
    if (!tabButton?.dataset.tabButton) return;
    const tab = tabAlias[tabButton.dataset.tabButton] ?? (tabButton.dataset.tabButton as Tab);
    if (tabs.includes(tab) && allowedTabs().includes(tab)) showTab(tab);
  });

  let clubs: Club[] = [];
  let orgTeams: OrgTeam[] = [];

  const setStatus = (message: string) => {
    statusEl.textContent = message;
  };

  const createAccountForm = root.querySelector<HTMLFormElement>('[data-form="create-account"]')!;
  const setPasswordForm = root.querySelector<HTMLFormElement>('[data-form="set-password"]')!;
  const passwordWho = root.querySelector<HTMLElement>('[data-password-who]')!;
  const passwordUser = root.querySelector<HTMLInputElement>('[data-password-user]')!;
  const passwordEmail = root.querySelector<HTMLInputElement>('[data-password-email]')!;
  bindPasswordToggles(root);
  bindPasswordRules(root);
  root.querySelectorAll<HTMLButtonElement>('[data-suggest-password]').forEach((button) => {
    button.addEventListener('click', () => {
      const form = button.closest('form');
      if (form) fillSuggestedPassword(form);
    });
  });

  const passwordsMatch = (form: HTMLFormElement) => {
    const data = new FormData(form);
    const password = String(data.get('password') ?? '');
    const confirm = String(data.get('confirm_password') ?? '');
    const email = String(data.get('email') ?? '');
    if (password !== confirm) return 'The passwords do not match.';
    return passwordIssue(password, email);
  };

  createAccountForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!viewerIsAdmin) {
      setStatus('Only an admin can create an account.');
      return;
    }
    const data = new FormData(createAccountForm);
    const issue = passwordsMatch(createAccountForm);
    if (issue) {
      setStatus(issue);
      return;
    }
    setStatus('Creating account…');
    const message = await callManageAccounts(supabase, {
      action: 'create',
      display_name: String(data.get('display_name') ?? '').trim(),
      email: String(data.get('email') ?? '').trim(),
      password: String(data.get('password') ?? ''),
    });
    if (message) {
      setStatus(message);
      return;
    }
    await supabase.rpc('sync_website_player_emails');
    await supabase.rpc('apply_lm_roles');
    createAccountForm.reset();
    setStatus('Login created. Tell them the email and password. Nothing was emailed.');
    await showSession();
  });

  setPasswordForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const issue = passwordsMatch(setPasswordForm);
    if (issue) {
      setStatus(issue);
      return;
    }
    setStatus('Saving password…');
    const message = await callManageAccounts(supabase, {
      action: 'set-password',
      user_id: passwordUser.value,
      password: String(new FormData(setPasswordForm).get('password') ?? ''),
    });
    if (message) {
      setStatus(message);
      return;
    }
    setPasswordForm.hidden = true;
    setPasswordForm.reset();
    setStatus(`Password updated for ${passwordWho.textContent}. Nothing was emailed.`);
  });

  root.querySelector('[data-save-roles]')!.addEventListener('click', async () => {
    const card = memberCards.find((item) => item.key === selectedRoleKey);
    if (!card?.profileId || !viewerIsAdmin) return;
    setStatus('Saving roles…');
    const boxes = [...roleOptions.querySelectorAll<HTMLInputElement>('[data-role-slug]')];
    for (const box of boxes) {
      const slug = box.dataset.roleSlug ?? '';
      const want = box.checked;
      if (slug === 'admins') {
        const has = card.isAdmin || card.groupSlugs.includes('admins');
        if (want === has) continue;
        if (!want && (card.protectedAccount || card.profileId === viewerId)) {
          setStatus('That admin access stays as it is.');
          return;
        }
        const message = await callManageAccounts(supabase, { action: 'set-admin', user_id: card.profileId, is_admin: want });
        if (message) {
          setStatus(message);
          return;
        }
        continue;
      }
      if (want === card.groupSlugs.includes(slug)) continue;
      const message = await callManageAccounts(supabase, { action: 'set-group', user_id: card.profileId, group_slug: slug, member: want });
      if (message) {
        setStatus(message);
        return;
      }
    }
    rolePicker.hidden = true;
    setStatus(`Roles saved for ${card.name}.`);
    await showSession();
  });
  root.querySelector('[data-copy-password]')!.addEventListener('click', async () => {
    const password = resetValue.value;
    if (!password) return;
    try {
      await navigator.clipboard.writeText(password);
      setStatus('Password copied.');
    } catch {
      resetValue.focus();
      resetValue.select();
      setStatus('Select the password and copy it.');
    }
  });

  root.querySelector('[data-cancel-password]')!.addEventListener('click', () => {
    setPasswordForm.hidden = true;
    setPasswordForm.reset();
  });

  const onAccountAction = async (event: Event) => {
    const target = event.target as HTMLElement;
    const openRoles = target.closest<HTMLButtonElement>('[data-open-roles]');
    if (openRoles?.dataset.openRoles) {
      const card = memberCards.find((item) => item.key === openRoles.dataset.openRoles);
      if (!card) return;
      if (!card.profileId) {
        rolePicker.hidden = true;
        setStatus(`Set a password for ${card.name} before adding roles.`);
        return;
      }
      selectedRoleKey = card.key;
      paintRolePicker(card);
      rolePicker.hidden = false;
      rolePicker.scrollIntoView({ block: 'nearest' });
      return;
    }
    const resetPassword = target.closest<HTMLButtonElement>('[data-reset-password]');
    if (resetPassword?.dataset.resetPassword) {
      const card = memberCards.find((item) => item.key === resetPassword.dataset.resetPassword);
      if (!card || !viewerIsAdmin || card.protectedAccount) return;
      const email = card.email.trim().toLowerCase();
      if (!email) {
        setStatus(`Add an email for ${card.name} before setting a password.`);
        return;
      }
      const password = suggestPassword();
      const issue = passwordIssue(password, email);
      if (issue) {
        setStatus(issue);
        return;
      }
      setStatus(card.profileId ? 'Setting a password…' : 'Creating the login…');
      const message = card.profileId
        ? await callManageAccounts(supabase, { action: 'set-password', user_id: card.profileId, password })
        : await callManageAccounts(supabase, { action: 'create', display_name: card.name, email, password });
      if (message) {
        setStatus(message);
        return;
      }
      if (!card.profileId) {
        await supabase.rpc('sync_website_player_emails');
        await supabase.rpc('apply_lm_roles');
      }
      resetWho.textContent = card.name;
      resetValue.value = password;
      resetPasswordPanel.hidden = false;
      resetPasswordPanel.scrollIntoView({ block: 'nearest' });
      resetValue.focus();
      resetValue.select();
      setStatus(`Password set for ${card.name}. Copy it and tell them. Nothing was emailed.`);
      await showSession();
      return;
    }
    const openPassword = target.closest<HTMLButtonElement>('[data-open-password]');
    if (openPassword) {
      const userId = openPassword.dataset.openPassword!;
      const email = openPassword.dataset.passwordEmail ?? '';
      passwordWho.textContent = openPassword.dataset.passwordName || 'this account';
      setPasswordForm.hidden = false;
      setPasswordForm.reset();
      setPasswordForm.querySelectorAll<HTMLButtonElement>('[data-toggle-password]').forEach((button) => {
        button.textContent = 'Show';
      });
      passwordUser.value = userId;
      passwordEmail.value = email;
      setPasswordForm.querySelector<HTMLInputElement>('[name="password"]')?.focus();
      return;
    }
    const removePerson = target.closest<HTMLButtonElement>('[data-delete-person]');
    if (removePerson) {
      if (!viewerIsAdmin) {
        setStatus('Only an admin can delete an account.');
        return;
      }
      if (removePerson.dataset.deletePerson === protectedAdminId) {
        setStatus('The county admin cannot be deleted.');
        return;
      }
      const who = removePerson.dataset.personName || 'this person';
      if (!window.confirm(`Delete ${who}? They will no longer be able to sign in.`)) return;
      setStatus('Deleting account…');
      const message = await callManageAccounts(supabase, {
        action: 'delete',
        user_id: removePerson.dataset.deletePerson,
      });
      if (message) {
        setStatus(message);
        return;
      }
      setStatus(`${who} deleted.`);
      await showSession();
      return;
    }
    const setActive = target.closest<HTMLButtonElement>('[data-set-active]');
    if (setActive) {
      if (!viewerIsAdmin) {
        setStatus('Only an admin can change whether an account is active.');
        return;
      }
      const who = setActive.dataset.personName || 'this person';
      const active = setActive.dataset.activeNext === 'true';
      if (!active && !window.confirm(`Make ${who} inactive? They cannot sign in until you turn the account back on.`)) return;
      setStatus(active ? 'Turning the account on…' : 'Turning the account off…');
      const message = await callManageAccounts(supabase, {
        action: 'set-active',
        user_id: setActive.dataset.setActive,
        active,
      });
      if (message) {
        setStatus(message);
        return;
      }
      setStatus(active ? `${who} can sign in.` : `${who} is inactive.`);
      await showSession();
      return;
    }
    const removeGroup = target.closest<HTMLButtonElement>('[data-group-remove]');
    if (removeGroup) {
      const who = removeGroup.dataset.personName || 'this person';
      const slug = removeGroup.dataset.groupSlug || '';
      setStatus('Updating groups…');
      const { error } = await supabase.from('group_members').delete().eq('profile_id', removeGroup.dataset.groupRemove!).eq('group_slug', slug);
      if (error) {
        setStatus(error.message);
        return;
      }
      setStatus(`${who} removed from ${groupTitle.get(slug) ?? slug}.`);
      await showSession();
      return;
    }
    const setAdmin = target.closest<HTMLButtonElement>('[data-set-admin]');
    if (!setAdmin) return;
    if (setAdmin.dataset.setAdmin === protectedAdminId && setAdmin.dataset.adminNext === 'false') {
      setStatus('The county admin cannot lose admin access.');
      return;
    }
    const makingAdmin = setAdmin.dataset.adminNext === 'true';
    setStatus(makingAdmin ? 'Granting admin…' : 'Removing admin…');
    const message = await callManageAccounts(supabase, {
      action: 'set-admin',
      user_id: setAdmin.dataset.setAdmin,
      is_admin: makingAdmin,
    });
    if (message) {
      setStatus(message);
      return;
    }
    setStatus(makingAdmin ? 'Admin access granted.' : 'Admin access removed.');
    await showSession();
  };
  membersHost.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-open-roles], [data-set-active], [data-delete-person], [data-reset-password]')) {
      void onAccountAction(event);
      return;
    }
    if (target.closest('input, button, a, textarea, select')) return;
    const row = target.closest<HTMLElement>('[data-member-key]');
    if (!row?.dataset.memberKey) return;
    selectedMemberKey = row.dataset.memberKey;
    paintMembers();
  });
  membersHost.addEventListener('focusout', (event) => {
    const input = event.target as HTMLInputElement;
    if (!input.matches?.('[data-row-field]')) return;
    const row = input.closest('tr');
    const next = event.relatedTarget;
    if (row && next instanceof Node && row.contains(next)) return;
    const card = memberCards.find((item) => item.key === (input.dataset.rowKey ?? ''));
    if (!card || !viewerIsAdmin || card.protectedAccount) return;
    const valueOf = (field: string) => row?.querySelector<HTMLInputElement>(`[data-row-field="${field}"]`)?.value ?? '';
    const email = valueOf('email').trim().toLowerCase();
    const es = valueOf('es').trim();
    const phone = valueOf('phone').trim();
    if (email === card.email.trim().toLowerCase() && es === card.es && phone === card.phone) return;
    void saveMemberDetails(card, email, es, phone, false);
  });

  root.querySelector('[data-sign-out]')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    await showSession();
  });

  const SEASON = 'Winter 2026/27';

  type Mine = { role: string; club_slug: string | null; team_id: number | null };
  type SitePlayer = {
    id: number;
    display_name: string;
    email: string | null;
    phone: string | null;
    england_squash_id: string | null;
  };
  type SiteSquad = { id: number; name: string; team_id: number | null; squad_players: SitePlayer[] | null };
  type SiteRow = {
    playerId: number;
    teamId: number | null;
    clubSlug: string;
    club: string;
    team: string;
    name: string;
    email: string;
    es: string;
    phone: string;
    locked: boolean;
    emailLocked: boolean;
    role: string;
  };
  const clubNote = root.querySelector<HTMLElement>('[data-site-club-note]')!;
  const teamNote = root.querySelector<HTMLElement>('[data-site-team-note]')!;
  const playerNote = root.querySelector<HTMLElement>('[data-site-player-note]')!;
  const siteClubHost = root.querySelector<HTMLElement>('[data-site-club]')!;
  const siteTeamHost = root.querySelector<HTMLElement>('[data-site-team]')!;
  const ownName = root.querySelector<HTMLElement>('[data-own-name]')!;
  const ownEmail = root.querySelector<HTMLElement>('[data-own-email]')!;
  const ownFacts = root.querySelector<HTMLElement>('[data-own-facts]')!;
  const playerListHost = root.querySelector<HTMLElement>('[data-site-player-list]')!;
  type WebsitePlayer = { teamId: number; name: string; email: string; playerId: number };
  let websitePlayers: WebsitePlayer[] = [];
  const slNote = root.querySelector<HTMLElement>('[data-site-sl-note]')!;
  const slHost = root.querySelector<HTMLElement>('[data-site-sl]')!;
  type SlPlayer = { id: number; display_name: string; current_level: number | null; updated_at: string | null };
  type SlRating = { recorded_on: string; level: number; kind: string | null; squashlevels_match_id?: string | null };

  const levelText = (n: number | null) => (n == null ? '—' : n.toLocaleString('en-GB'));
  const nameKey = (value: string) => value.trim().toLowerCase().replace(/\s+/g, ' ');
  const permissionGroupsHost = root.querySelector<HTMLElement>('[data-permission-groups]')!;
  const permissionRolesHost = root.querySelector<HTMLElement>('[data-permission-roles]')!;
  const groupPeoplePanel = root.querySelector<HTMLElement>('[data-group-people]')!;
  const groupPeopleTitle = root.querySelector<HTMLElement>('[data-group-people-title]')!;
  const groupPeopleRows = root.querySelector<HTMLElement>('[data-group-people-rows]')!;
  let openGroupSlug = '';
  const filledFrom = (group: GroupCatalog) => {
    if (!group.managed) return 'This website';
    if (group.source === 'squashlevels') return 'SquashLevels';
    if (group.source === 'account') return 'Admin accounts';
    return 'League Master';
  };
  function paintPermissionCatalog(groupCatalog: GroupCatalog[], roleCatalog: RoleCatalog[], members: GroupMember[]) {
    permissionGroupsHost.innerHTML = groupCatalog.length
      ? groupCatalog
          .map((group) => {
            const role = roleCatalog.find((item) => item.slug === group.role_slug)?.name ?? group.role_slug;
            const people = members.filter((member) => member.group_slug === group.slug).length;
            return `<tr><td>${escapeHtml(group.name)}</td><td>${escapeHtml(role)}</td><td>${escapeHtml(filledFrom(group))}</td><td><button type="button" class="count-button" data-open-group="${escapeHtml(group.slug)}">${people}</button></td></tr>`;
          })
          .join('')
      : '<tr><td colspan="4">Groups are not on the database yet.</td></tr>';
    permissionRolesHost.innerHTML = roleCatalog.length
      ? roleCatalog
          .map((role) => {
            const given = groupCatalog.filter((group) => group.role_slug === role.slug).map((group) => group.name);
            return `<tr><td>${escapeHtml(role.name)}</td><td>${escapeHtml(given.join(', ') || 'No group')}</td></tr>`;
          })
          .join('')
      : '<tr><td colspan="2">Roles are not on the database yet.</td></tr>';
  }
  function paintGroupPeople() {
    const group = groupCatalogLive.find((item) => item.slug === openGroupSlug);
    const people = listedGroups
      .filter((member) => member.group_slug === openGroupSlug)
      .slice()
      .sort((a, b) => a.person_name.localeCompare(b.person_name, 'en'));
    if (!group || !people.length) {
      groupPeoplePanel.hidden = true;
      groupPeopleRows.innerHTML = '';
      return;
    }
    groupPeoplePanel.hidden = false;
    const role = roleCatalogLive.find((item) => item.slug === group.role_slug)?.name ?? group.name;
    groupPeopleTitle.textContent = `${group.name} · ${role}`;
    groupPeopleRows.innerHTML = people
      .map((member) => {
        const card = memberCards.find(
          (item) =>
            (member.profile_id && item.profileId === member.profile_id) ||
            nameKey(item.name) === nameKey(member.person_name) ||
            nameKey(item.profileName) === nameKey(member.person_name),
        );
        const key = card?.key ?? '';
        return `<tr><td><button type="button" class="count-button" data-open-person="${escapeHtml(key)}">${escapeHtml(member.person_name)}</button></td><td>${escapeHtml(member.place || '—')}</td></tr>`;
      })
      .join('');
  }
  permissionGroupsHost.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-open-group]');
    if (!button?.dataset.openGroup) return;
    openGroupSlug = openGroupSlug === button.dataset.openGroup ? '' : button.dataset.openGroup;
    paintGroupPeople();
  });
  groupPeopleRows.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-open-person]');
    if (!button?.dataset.openPerson) return;
    selectedMemberKey = button.dataset.openPerson;
    showTab('members');
    paintMembers();
    membersHost.querySelector(`[data-member-key="${CSS.escape(selectedMemberKey)}"]`)?.scrollIntoView({ block: 'nearest' });
  });
  const juniorsHost = root.querySelector<HTMLElement>('[data-juniors-people]')!;
  type JuniorEntry = {
    player_first_name: string;
    player_last_name: string;
    date_of_birth: string;
    age_category: string;
    draw: string;
    club: string;
    guardian_name: string;
    guardian_email: string;
    guardian_phone: string;
    emergency_name: string;
    emergency_phone: string;
    notes: string | null;
  };
  function paintJuniorEntries(entries: JuniorEntry[], problem = '') {
    if (problem) {
      juniorsHost.innerHTML = `<tr><td colspan="11">${escapeHtml(problem)}</td></tr>`;
      return;
    }
    const rows = entries.slice().sort((a, b) => a.player_last_name.localeCompare(b.player_last_name, 'en') || a.player_first_name.localeCompare(b.player_first_name, 'en'));
    juniorsHost.innerHTML = rows.length
      ? rows
          .map((entry) => {
            const born = entry.date_of_birth ? formatDay(entry.date_of_birth.slice(0, 10)) : '—';
            return `<tr><td>${escapeHtml(`${entry.player_first_name} ${entry.player_last_name}`.trim())}</td><td>${escapeHtml(born)}</td><td>${escapeHtml(entry.age_category || '—')}</td><td>${escapeHtml(entry.draw || '—')}</td><td>${escapeHtml(entry.club || '—')}</td><td>${escapeHtml(entry.guardian_name || '—')}</td><td>${escapeHtml(entry.guardian_email || '—')}</td><td>${escapeHtml(entry.guardian_phone || '—')}</td><td>${escapeHtml(entry.emergency_name || '—')}</td><td>${escapeHtml(entry.emergency_phone || '—')}</td><td>${escapeHtml(entry.notes || '—')}</td></tr>`;
          })
          .join('')
      : '<tr><td colspan="11">No junior entries yet.</td></tr>';
  }
  function paintMembers() {
    const query = memberSearch.value.trim().toLowerCase();
    groupNote.textContent = 'Filled from League Master. Each person has the LM Player role.';
    const players = memberCards.filter((card) => card.groupSlugs.includes('lm_players') || card.key === selectedMemberKey);
    const shown = players.filter((card) => {
      if (!query) return true;
      return [card.name, card.profileName, card.teams, card.place, card.email, card.groupNames, card.roleNames].some((value) => value.toLowerCase().includes(query));
    });
    memberCount.textContent = query ? `${shown.length} of ${players.length} players` : `${players.length} players`;
    const contactCell = (card: MemberCard, field: 'email' | 'es' | 'phone', value: string, label: string, type: string, placeholder: string) => {
      if (!viewerIsAdmin || card.protectedAccount) return escapeHtml(field === 'email' && card.protectedAccount ? 'BSCA' : value || '—');
      return `<input data-row-field="${field}" data-row-key="${escapeHtml(card.key)}" aria-label="${label} for ${escapeHtml(card.name)}" type="${type}" value="${escapeHtml(value)}" placeholder="${escapeHtml(placeholder)}" autocomplete="off" />`;
    };
    const actionButton = (label: string, attrs: string) => `<button class="btn btn--ghost btn--sm" type="button" ${attrs}>${label}</button>`;
    membersHost.innerHTML = shown.length
      ? shown
          .map((card) => {
            const selected = card.key === selectedMemberKey ? ' class="is-selected"' : '';
            const email = contactCell(card, 'email', card.protectedAccount ? '' : card.email, 'Email', 'email', 'Add an email');
            const es = contactCell(card, 'es', card.es, 'ES number', 'text', 'Add an ES number');
            const mobile = contactCell(card, 'phone', card.phone, 'Mobile', 'tel', 'Add a mobile number');
            const roles = actionButton('Roles', `data-open-roles="${escapeHtml(card.key)}" aria-label="Roles for ${escapeHtml(card.name)}"`);
            const active =
              viewerIsAdmin && card.profileId && !card.protectedAccount && card.profileId !== viewerId
                ? actionButton(
                    card.active ? 'Make inactive' : 'Make active',
                    `data-set-active="${card.profileId}" data-active-next="${card.active ? 'false' : 'true'}" data-person-name="${escapeHtml(card.name)}" aria-label="${card.active ? 'Make inactive' : 'Make active'} ${escapeHtml(card.name)}"`,
                  )
                : '—';
            const password = viewerIsAdmin && !card.protectedAccount ? actionButton('Password', `data-reset-password="${escapeHtml(card.key)}" aria-label="Password for ${escapeHtml(card.name)}"`) : '—';
            const remove =
              viewerIsAdmin && card.profileId && !card.protectedAccount
                ? actionButton('Delete', `data-delete-person="${card.profileId}" data-person-name="${escapeHtml(card.name)}" aria-label="Delete ${escapeHtml(card.name)}"`)
                : '—';
            return `<tr${selected} data-member-key="${escapeHtml(card.key)}"><td>${escapeHtml(card.label)}</td><td>${escapeHtml(card.teams || '—')}</td><td>${email}</td><td>${es}</td><td>${mobile}</td><td class="row-action">${roles}</td><td class="row-action">${active}</td><td class="row-action">${password}</td><td class="row-action">${remove}</td><td>${escapeHtml(card.statusHtml)}</td><td>${escapeHtml(card.lastLogin)}</td></tr>`;
          })
          .join('')
      : `<tr><td colspan="11">${players.length ? 'No players match that search.' : 'No League Master players yet.'}</td></tr>`;
    createAccountForm.hidden = true;
  }
  function paintRolePicker(card: MemberCard) {
    rolePickerWho.textContent = card.name;
    const choices = groupCatalogLive
      .filter((group) => group.slug === 'admins' || !group.managed)
      .slice()
      .sort((a, b) => a.position - b.position);
    roleOptions.innerHTML = choices.length
      ? choices
          .map((group) => {
            const role = roleCatalogLive.find((item) => item.slug === group.role_slug)?.name ?? group.name;
            const checked = group.slug === 'admins' ? card.isAdmin || card.groupSlugs.includes('admins') : card.groupSlugs.includes(group.slug);
            const locked = !card.profileId || (group.slug === 'admins' && (card.protectedAccount || card.profileId === viewerId));
            return `<label><input type="checkbox" data-role-slug="${escapeHtml(group.slug)}" ${checked ? 'checked' : ''} ${locked ? 'disabled' : ''} /> ${escapeHtml(role)}</label>`;
          })
          .join('')
      : '<p class="muted small">Roles are not on the database yet.</p>';
  }
  const looseKey = (value: string) =>
    value
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();

  const slChart = (points: SlRating[]) => {
    if (points.length < 2) return '';
    const width = 640;
    const height = 220;
    const pad = { l: 56, r: 16, t: 16, b: 36 };
    const levels = points.map((point) => point.level);
    let min = Math.min(...levels);
    let max = Math.max(...levels);
    if (min === max) {
      min -= 50;
      max += 50;
    }
    const padY = (max - min) * 0.08;
    min -= padY;
    max += padY;
    const innerW = width - pad.l - pad.r;
    const innerH = height - pad.t - pad.b;
    const xAt = (index: number) => pad.l + (index / (points.length - 1)) * innerW;
    const yAt = (level: number) => pad.t + ((max - level) / (max - min)) * innerH;
    const line = points.map((point, index) => `${index === 0 ? 'M' : 'L'}${xAt(index).toFixed(1)},${yAt(point.level).toFixed(1)}`).join(' ');
    const yTicks = [max, (max + min) / 2, min];
    const xTicks = [0, Math.floor((points.length - 1) / 2), points.length - 1];
    const dateLabel = (iso: string) => formatDay(iso);
    const anchor = (index: number) => (index === 0 ? 'start' : index === points.length - 1 ? 'end' : 'middle');
    return `<div class="sl-chart"><svg viewBox="0 0 ${width} ${height}" role="img" aria-label="Level after each match">
      ${yTicks
        .map((tick) => {
          const y = yAt(tick);
          return `<line x1="${pad.l}" y1="${y.toFixed(1)}" x2="${width - pad.r}" y2="${y.toFixed(1)}" stroke="#c5d6e8" stroke-opacity="0.25" /><text x="${pad.l - 8}" y="${(y + 4).toFixed(1)}" text-anchor="end" fill="#c5d6e8" font-size="12">${levelText(Math.round(tick))}</text>`;
        })
        .join('')}
      <path d="${line}" fill="none" stroke="#f2b705" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
      ${xTicks.map((index) => `<text x="${xAt(index).toFixed(1)}" y="${height - 10}" text-anchor="${anchor(index)}" fill="#c5d6e8" font-size="12">${dateLabel(points[index].recorded_on)}</text>`).join('')}
    </svg><p class="muted small">Level after each match.</p></div>`;
  };

  const isSelf = (account: Account, name: string, email: string | null) => {
    const mine = account.email.trim().toLowerCase();
    const theirs = (email ?? '').trim().toLowerCase();
    if (mine && theirs && mine === theirs) return true;
    const left = account.displayName.trim().toLowerCase();
    return Boolean(left) && left === name.trim().toLowerCase();
  };

  let slCatalog: SlPlayer[] = [];
  let slLinks: { id: number; lm_player_name: string | null; squashlevels_player_id: number | null }[] = [];
  let slByName = new Map<string, SlPlayer>();
  let slByLoose = new Map<string, SlPlayer>();

  const allSlPlayers = async () => {
    const rows: SlPlayer[] = [];
    for (let from = 0; ; from += 1000) {
      const { data, error } = await supabase
        .from('squashlevels_players')
        .select('id, display_name, current_level, updated_at')
        .order('id', { ascending: true })
        .range(from, from + 999);
      if (error) return { data: null as SlPlayer[] | null, error };
      const page = (data ?? []) as SlPlayer[];
      rows.push(...page);
      if (page.length < 1000) return { data: rows, error: null };
    }
  };

  const allSlNames = async () => {
    const rows: { name_key: string; player_id: number | null }[] = [];
    for (let from = 0; ; from += 1000) {
      const { data, error } = await supabase
        .from('squashlevels_names')
        .select('name_key, player_id')
        .eq('status', 'matched')
        .order('name_key', { ascending: true })
        .range(from, from + 999);
      if (error) return { data: null as { name_key: string; player_id: number | null }[] | null, error };
      const page = (data ?? []) as { name_key: string; player_id: number | null }[];
      rows.push(...page);
      if (page.length < 1000) return { data: rows, error: null };
    }
  };

  const slMatch = (lmName: string) => {
    const linkedTo = (player: SlPlayer | null | undefined) => {
      if (!player) return { player: null as SlPlayer | null, linked: false };
      return { player, linked: nameKey(player.display_name) !== nameKey(lmName) };
    };
    const link = slLinks.find((item) => item.lm_player_name && nameKey(item.lm_player_name) === nameKey(lmName) && item.squashlevels_player_id != null);
    if (link) return linkedTo(slCatalog.find((player) => player.id === link.squashlevels_player_id));
    const exact = slCatalog.find((player) => nameKey(player.display_name) === nameKey(lmName)) ?? slByName.get(nameKey(lmName));
    if (exact) return { player: exact, linked: false };
    return linkedTo(slByLoose.get(looseKey(lmName)));
  };

  const siteTable = (rows: SiteRow[], fields: 'all' | 'open' | 'none', showTeam: boolean) => {
    const box = (row: SiteRow, field: 'email' | 'es' | 'phone', value: string, label: string, type: string) =>
      `<input data-squad-field="${field}" data-squad-email="${row.playerId || ''}" data-team-id="${row.teamId ?? ''}" data-team-name="${escapeHtml(row.team)}" data-player-name="${escapeHtml(row.name)}" data-saved="${escapeHtml(value)}" aria-label="${label} for ${escapeHtml(row.name)}" type="${type}" value="${escapeHtml(value)}" autocomplete="off" />`;
    const body = rows
      .map((row) => {
        const detailsOpen = fields === 'all' || fields === 'open';
        const emailOpen = fields === 'all' || (fields === 'open' && !row.locked);
        const emailCell = row.emailLocked || !emailOpen ? escapeHtml(row.email || '—') : box(row, 'email', row.email, 'Email', 'email');
        const esCell = detailsOpen ? box(row, 'es', row.es, 'ES number', 'text') : escapeHtml(row.es || '—');
        const phoneCell = detailsOpen ? box(row, 'phone', row.phone, 'Phone', 'tel') : escapeHtml(row.phone || '—');
        const teamCell = showTeam ? `<td>${escapeHtml(row.team)}</td>` : '';
        const matched = slMatch(row.name);
        const slName = matched.player
          ? `${escapeHtml(matched.player.display_name)}${matched.linked ? ' <span class="pill">Linked</span>' : ''}`
          : '—';
        const slLevel = matched.player ? levelText(matched.player.current_level) : '—';
        return `<tr>${teamCell}<td>${escapeHtml(row.name)}</td><td>${slName}</td><td data-sl-level>${slLevel}</td><td>${emailCell}</td><td>${esCell}</td><td>${phoneCell}</td></tr>`;
      })
      .join('');
    const teamHead = showTeam ? '<th>Team</th>' : '';
    return `<div class="overview-box"><table class="overview"><thead><tr>${teamHead}<th>LM name</th><th>SL name</th><th>SL level</th><th>Email</th><th>ES number</th><th>Phone</th></tr></thead><tbody>${body}</tbody></table></div>`;
  };

  async function loadWebsite(account: Account) {
    ownName.textContent = account.displayName || '—';
    ownEmail.textContent = account.email || '—';
    const [{ data: mineRows }, { data: clubRows }, { data: teamRows }, { data: squadRows }, { data: nomRows }, contactResult, { data: slRows }, linkResult, profileResult, roleMembershipResult, nameResult] = await Promise.all([
      supabase.from('memberships').select('role, club_slug, team_id').eq('profile_id', account.userId),
      supabase.from('clubs').select('slug, name, contact_name, contact_email').order('name', { ascending: true }),
      supabase.from('teams').select('id, club_slug, name, division, captain_name, captain_email').order('name', { ascending: true }),
      supabase.from('captain_squads').select('id, name, team_id, squad_players(id, display_name, email, england_squash_id, phone)'),
      supabase.from('nominations').select('team_id, player_name, season').eq('season', SEASON),
      supabase.from('lm_player_contacts').select('team_id, player_name, email'),
      allSlPlayers(),
      supabase.from('player_links').select('id, profile_id, squashlevels_player_id, lm_player_name'),
      supabase.from('profiles').select('id, email, is_admin, display_name'),
      supabase.from('memberships').select('profile_id, role, club_slug, team_id'),
      allSlNames(),
    ]);
    const mine = (mineRows ?? []) as Mine[];
    const clubList = (clubRows ?? []) as { slug: string; name: string; contact_name: string | null; contact_email: string | null }[];
    const teamList = (teamRows ?? []) as {
      id: number;
      club_slug: string;
      name: string;
      division: string | null;
      captain_name: string | null;
      captain_email: string | null;
    }[];
    const squads = (squadRows ?? []) as SiteSquad[];
    const nominations = (nomRows ?? []) as { team_id: number; player_name: string }[];
    websitePlayers = [];
    personContacts = [];
    const slPlayers = (slRows ?? []) as SlPlayer[];
    slCatalog = slPlayers;
    slByName = new Map();
    slByLoose = new Map();
    for (const player of slPlayers) {
      const key = nameKey(player.display_name);
      if (!slByName.has(key)) slByName.set(key, player);
    }
    for (const stored of (nameResult.error ? [] : (nameResult.data ?? [])) as { name_key: string; player_id: number | null }[]) {
      if (stored.player_id == null || slByLoose.has(stored.name_key)) continue;
      const player = slPlayers.find((item) => item.id === stored.player_id);
      if (player) slByLoose.set(stored.name_key, player);
    }
    type PlayerLink = { id: number; profile_id: string | null; squashlevels_player_id: number | null; lm_player_name: string | null };
    const playerLinks = (linkResult.error ? [] : (linkResult.data ?? [])) as PlayerLink[];
    slLinks = playerLinks;
    type SiteProfile = { id: string; email: string | null; is_admin: boolean | null; display_name: string | null };
    const siteProfiles = (profileResult.error ? [] : (profileResult.data ?? [])) as SiteProfile[];
    type RoleMembership = { profile_id: string; role: string; club_slug: string | null; team_id: number | null };
    const roleMemberships = (roleMembershipResult.error ? [] : (roleMembershipResult.data ?? [])) as RoleMembership[];
    const emailToProfile = new Map<string, string>();
    for (const row of siteProfiles) {
      const email = (row.email ?? '').trim().toLowerCase();
      if (email) emailToProfile.set(email, row.id);
    }
    const levelFromLink = (link: PlayerLink | undefined) =>
      link?.squashlevels_player_id != null ? slPlayers.find((player) => player.id === link.squashlevels_player_id) : undefined;
    const levelFor = (row: SiteRow) => {
      const byLm = levelFromLink(playerLinks.find((link) => link.lm_player_name && nameKey(link.lm_player_name) === nameKey(row.name)));
      if (byLm) return byLm;
      const profileId = row.email ? emailToProfile.get(row.email.trim().toLowerCase()) : undefined;
      const byAccount = levelFromLink(playerLinks.find((link) => profileId && link.profile_id === profileId));
      if (byAccount) return byAccount;
      return slByName.get(nameKey(row.name)) ?? slByLoose.get(looseKey(row.name));
    };
    const clubBySlug = new Map(clubList.map((club) => [club.slug, club]));
    const teamById = new Map(teamList.map((team) => [team.id, team]));
    const sameText = (left: string, right: string | null) => {
      const theirs = nameKey(right ?? '');
      return Boolean(theirs) && nameKey(left) === theirs;
    };
    const lockedFromLm = (name: string, email: string, clubSlug: string, teamId: number | null) => {
      const club = clubBySlug.get(clubSlug);
      const team = teamId != null ? teamById.get(teamId) : undefined;
      const address = email.trim().toLowerCase();
      const clubEmail = (club?.contact_email ?? '').trim().toLowerCase();
      const captainEmail = (team?.captain_email ?? '').trim().toLowerCase();
      if (club && (sameText(name, club.contact_name) || (address && address === clubEmail))) return true;
      if (team && (sameText(name, team.captain_name) || (address && address === captainEmail))) return true;
      return false;
    };
    const profileFor = (name: string, email: string) => {
      const address = email.trim().toLowerCase();
      const byEmail = address ? siteProfiles.find((profile) => (profile.email ?? '').trim().toLowerCase() === address) : undefined;
      if (byEmail) return byEmail;
      const link = playerLinks.find((item) => item.profile_id && item.lm_player_name && nameKey(item.lm_player_name) === nameKey(name));
      return link?.profile_id ? siteProfiles.find((profile) => profile.id === link.profile_id) : undefined;
    };
    const roleFor = (name: string, email: string) => {
      const address = email.trim().toLowerCase();
      const profile = profileFor(name, email);
      const held = profile ? roleMemberships.filter((membership) => membership.profile_id === profile.id) : [];
      const codes: string[] = [];
      if (profile?.is_admin || (account.isAdmin && isSelf(account, name, email))) codes.push('A');
      const clubCaptain =
        held.some((membership) => membership.role === 'club_captain') ||
        clubList.some((club) => {
          const clubEmail = (club.contact_email ?? '').trim().toLowerCase();
          return sameText(name, club.contact_name) || Boolean(address && clubEmail && address === clubEmail);
        });
      if (clubCaptain) codes.push('C');
      const teamCaptain =
        held.some((membership) => membership.role === 'team_captain') ||
        teamList.some((team) => {
          const captainEmail = (team.captain_email ?? '').trim().toLowerCase();
          return sameText(name, team.captain_name) || Boolean(address && captainEmail && address === captainEmail);
        });
      if (teamCaptain) codes.push('T');
      codes.push('P');
      return codes.join(';');
    };
    const clubSlugs = new Set(mine.filter((row) => row.role === 'club_captain' && row.club_slug).map((row) => row.club_slug as string));
    const teamIds = new Set(mine.filter((row) => row.team_id != null).map((row) => row.team_id as number));
    const homeClubSlugs = new Set<string>(clubSlugs);
    for (const id of teamIds) {
      const team = teamById.get(id);
      if (team) homeClubSlugs.add(team.club_slug);
    }
    const hasClubRole = account.isAdmin || mine.some((row) => row.role === 'club_captain');
    const hasTeamRole = mine.some((row) => row.role === 'team_captain');
    const seesLeague = account.isAdmin || account.email.trim().toLowerCase() === 'county-admin@players.invalid';
    const rows: SiteRow[] = [];
    for (const squad of squads) {
      const team = squad.team_id != null ? teamById.get(squad.team_id) : undefined;
      const clubSlug = team?.club_slug ?? '';
      const club = clubBySlug.get(clubSlug);
      const teamLabel = team ? (team.division ? `${team.name} · ${team.division}` : team.name) : squad.name;
      for (const player of squad.squad_players ?? []) {
        personContacts.push({
          playerId: player.id,
          teamId: squad.team_id,
          name: player.display_name,
          email: player.email ?? '',
          es: player.england_squash_id ?? '',
          phone: player.phone ?? '',
        });
        if (squad.team_id != null) {
          websitePlayers.push({
            teamId: squad.team_id,
            name: player.display_name,
            email: player.email ?? '',
            playerId: player.id,
          });
        }
        rows.push({
          playerId: player.id,
          teamId: squad.team_id,
          clubSlug,
          club: club?.name ?? squad.name,
          team: teamLabel,
          name: player.display_name,
          email: player.email ?? '',
          es: player.england_squash_id ?? '',
          phone: player.phone ?? '',
          locked: lockedFromLm(player.display_name, player.email ?? '', clubSlug, squad.team_id),
          emailLocked: false,
          role: roleFor(player.display_name, player.email ?? ''),
        });
      }
    }
    const listed = new Set(rows.map((row) => `${row.teamId ?? ''}:${row.name.toLowerCase()}`));
    for (const nom of nominations) {
      const key = `${nom.team_id}:${nom.player_name.toLowerCase()}`;
      if (listed.has(key)) continue;
      listed.add(key);
      const team = teamById.get(nom.team_id);
      const club = team ? clubBySlug.get(team.club_slug) : undefined;
      rows.push({
        playerId: 0,
        teamId: nom.team_id,
        clubSlug: team?.club_slug ?? '',
        club: club?.name ?? 'Club',
        team: team ? (team.division ? `${team.name} · ${team.division}` : team.name) : 'Team',
        name: nom.player_name,
        email: '',
        es: '',
        phone: '',
        locked: lockedFromLm(nom.player_name, '', team?.club_slug ?? '', nom.team_id),
        emailLocked: false,
        role: roleFor(nom.player_name, ''),
      });
    }
    rows.sort((a, b) => a.club.localeCompare(b.club, 'en') || a.team.localeCompare(b.team, 'en') || a.name.localeCompare(b.name, 'en'));
    const visible = (row: SiteRow) => {
      if (seesLeague) return true;
      const onTeam = row.teamId != null && teamIds.has(row.teamId);
      const onClub = clubSlugs.has(row.clubSlug);
      if (account.playerOnly) return isSelf(account, row.name, row.email) && (onTeam || homeClubSlugs.has(row.clubSlug));
      return onClub || onTeam;
    };
    const clubRowsScoped = rows.filter((row) => visible(row));
    const teamRowsScoped = clubRowsScoped.filter((row) => seesLeague || hasClubRole || (row.teamId != null && teamIds.has(row.teamId)));
    const clubEditable = hasClubRole && !account.playerOnly;
    const readOnlyNote = ' This list is read only. It comes from League Master.';
    clubNote.textContent = 'Club captains from League Master.' + readOnlyNote;
    teamNote.textContent = 'Team captains from League Master.' + readOnlyNote;
    playerNote.textContent = (account.playerOnly
      ? 'Your own row. This list is read only.'
      : 'Every player from League Master. This list is read only.') + ' SquashLevels names that are not an exact match come from Links, and are marked Linked.';

    const clubsHere = clubList.filter((club) => (seesLeague ? true : hasClubRole ? clubSlugs.has(club.slug) : homeClubSlugs.has(club.slug)));
    const captainTable = (headers: string[], rows: string[][]) =>
      `<div class="overview-box"><table class="overview"><thead><tr>${headers.map((header) => `<th>${escapeHtml(header)}</th>`).join('')}</tr></thead><tbody>${rows
        .map((cells) => `<tr>${cells.map((cell) => `<td>${escapeHtml(cell || '—')}</td>`).join('')}</tr>`)
        .join('')}</tbody></table></div>`;
    const clubCaptains = clubsHere.filter((club) => club.contact_name);
    siteClubHost.innerHTML = clubCaptains.length
      ? captainTable(
          ['Club', 'Captain', 'Email'],
          clubCaptains.map((club) => [club.name, club.contact_name ?? '', club.contact_email ?? '']),
        )
      : '<p class="muted small">No club captains from League Master yet.</p>';

    const teamsHere = teamList.filter((team) => seesLeague || (hasClubRole ? clubsHere.some((club) => club.slug === team.club_slug) : teamIds.has(team.id)));
    const clubNameOf = (slug: string) => clubList.find((club) => club.slug === slug)?.name ?? slug;
    const teamCaptains = teamsHere.filter((team) => team.captain_name);
    siteTeamHost.innerHTML = teamCaptains.length
      ? captainTable(
          ['Club', 'Team', 'Captain', 'Email'],
          teamCaptains.map((team) => [clubNameOf(team.club_slug), team.division ? `${team.name} · ${team.division}` : team.name, team.captain_name ?? '', team.captain_email ?? '']),
        )
      : '<p class="muted small">No team captains from League Master yet.</p>';

    const playerContacts = (contactResult.error ? [] : (contactResult.data ?? [])) as { team_id: number; player_name: string; email: string | null }[];
    const addressOf = (value: string | null | undefined) => (value ?? '').trim().toLowerCase();
    const lmEmailFor = (row: SiteRow) => {
      const address = addressOf(row.email);
      if (!address) return '';
      const club = clubList.find((item) => addressOf(item.contact_email) === address);
      if (club?.contact_email) return club.contact_email.trim();
      const captain = teamList.find((item) => addressOf(item.captain_email) === address);
      if (captain?.captain_email) return captain.captain_email.trim();
      const contact = playerContacts.find((item) => addressOf(item.email) === address);
      return contact?.email?.trim() ?? '';
    };
    const playerRows = (account.playerOnly || seesLeague || clubEditable ? clubRowsScoped : teamRowsScoped).map((row) => {
      const fromLm = lmEmailFor(row);
      return fromLm ? { ...row, email: fromLm, emailLocked: true } : row;
    });
    playerListHost.innerHTML = playerRows.length ? siteTable(playerRows, 'none', true) : '<p class="muted small">No players on this list yet.</p>';

    const slScope = account.playerOnly ? clubRowsScoped.filter((row) => isSelf(account, row.name, row.email)) : clubRowsScoped;
    slNote.textContent = account.playerOnly
      ? 'Your SquashLevels record, and the full history.'
      : `${
          account.isAdmin
            ? 'SquashLevels for every player on this website, with their team.'
            : hasClubRole
              ? 'SquashLevels for the players at your club, with their team.'
              : 'SquashLevels for the players on your team.'
        } Linked marks a SquashLevels name that is not an exact match.`;
    const mineLink = playerLinks.find((link) => link.profile_id === account.userId);
    const selfSl =
      levelFromLink(mineLink) ??
      slByName.get(nameKey(account.displayName)) ??
      (slScope[0] ? slByName.get(nameKey(slScope[0].name)) : undefined);
    if (account.playerOnly) {
      const place = slScope.map((row) => `${row.team} · ${row.club}`).join('. ') || 'Your team is not set yet.';
      let historyHtml = '<p class="muted small">No SquashLevels history for this name yet.</p>';
      if (selfSl?.id) {
        const { data: ratingRows } = await supabase
          .from('squashlevels_ratings')
          .select('recorded_on, level, kind, squashlevels_match_id')
          .eq('player_id', selfSl.id)
          .order('recorded_on', { ascending: true })
          .order('squashlevels_match_id', { ascending: true })
          .limit(1000);
        const ratings = (ratingRows ?? []) as SlRating[];
        const after = ratings.filter((row) => row.kind === 'after');
        const points = (after.length ? after : ratings)
          .slice()
          .sort((a, b) => a.recorded_on.localeCompare(b.recorded_on) || String(a.squashlevels_match_id ?? '').localeCompare(String(b.squashlevels_match_id ?? '')));
        const newest = points.slice().reverse();
        const rowsHtml = newest.length
          ? newest
              .map((row, index) => {
                const older = newest[index + 1];
                const delta = older ? row.level - older.level : null;
                const change = delta == null || delta === 0 ? '—' : delta > 0 ? `+${delta}` : String(delta);
                return `<tr><td>${escapeHtml(formatDay(row.recorded_on))}</td><td>${levelText(row.level)}</td><td>${change}</td></tr>`;
              })
              .join('')
          : '<tr><td colspan="3">No history yet.</td></tr>';
        historyHtml = `${slChart(points)}<h3>History</h3><div class="overview-box sl-history"><table class="overview"><thead><tr><th>Date</th><th>Level</th><th>Change</th></tr></thead><tbody>${rowsHtml}</tbody></table></div>`;
      }
      slHost.innerHTML = `<article class="site-card"><h3>${escapeHtml(account.displayName || 'You')}</h3><p>${escapeHtml(place)}</p><p>Current level ${levelText(selfSl?.current_level ?? null)}${selfSl?.updated_at ? ` · updated ${escapeHtml(formatDay(selfSl.updated_at.slice(0, 10)))}` : ''}</p>${historyHtml}</article>`;
    } else {
      const body = slScope.length
        ? slScope
            .map((row) => {
              const level = levelFor(row);
              const updated = level?.updated_at ? formatDay(level.updated_at.slice(0, 10)) : '—';
              const linked = level != null && nameKey(level.display_name) !== nameKey(row.name);
              const playerCell = `${escapeHtml(row.name)}${linked ? ' <span class="pill">Linked</span>' : ''}`;
              return `<tr><td>${escapeHtml(row.club)}</td><td>${escapeHtml(row.team)}</td><td>${playerCell}</td><td>${levelText(level?.current_level ?? null)}</td><td>${escapeHtml(updated)}</td></tr>`;
            })
            .join('')
        : '<tr><td colspan="5">No players on this list yet.</td></tr>';
      slHost.innerHTML = `<div class="overview-box"><table class="overview"><thead><tr><th>Club</th><th>Team</th><th>Player</th><th>Level</th><th>Updated</th></tr></thead><tbody>${body}</tbody></table></div>`;
    }

    const linkedLm = mineLink?.lm_player_name ? nameKey(mineLink.lm_player_name) : '';
    const myNames = new Set(rows.filter((row) => isSelf(account, row.name, row.email)).map((row) => nameKey(row.name)));
    const selfRow = rows.find((row) => myNames.has(nameKey(row.name)));
    if (selfRow) {
      ownName.textContent = selfRow.name;
      whoEl.textContent = `Signed in as ${selfRow.name}`;
    }
    const myNominations = nominations.filter((row) => myNames.has(nameKey(row.player_name)) || isSelf(account, row.player_name, null) || (linkedLm && nameKey(row.player_name) === linkedLm));
    const lmHtml = myNominations.length
      ? `<ul>${myNominations
          .map((row) => {
            const team = teamById.get(row.team_id);
            const club = team ? clubBySlug.get(team.club_slug) : undefined;
            return `<li>${escapeHtml(club?.name ?? 'Club')} · ${escapeHtml(team?.name ?? 'Team')} · ${escapeHtml(row.player_name)}</li>`;
          })
          .join('')}</ul>`
      : '<p class="muted small">No League Master nomination matches your name.</p>';
    const teamFacts = account.isAdmin
      ? '<p class="muted small">Every team is on the Team tab.</p>'
      : hasClubRole
        ? '<p class="muted small">Every team at your club is on the Team tab.</p>'
        : teamIds.size
          ? teamList
              .filter((team) => teamIds.has(team.id))
              .map((team) => `<p>${escapeHtml(team.division ? `${team.name} · ${team.division}` : team.name)}${team.captain_name ? ` · Captain ${escapeHtml(team.captain_name)}` : ''}</p>`)
              .join('')
          : '<p class="muted small">No team on this account yet.</p>';
    const clubFacts = account.isAdmin
      ? '<p class="muted small">Every club is on the Club tab.</p>'
      : (account.playerOnly ? clubList.filter((club) => homeClubSlugs.has(club.slug)) : hasClubRole ? clubList.filter((club) => clubSlugs.has(club.slug)) : clubList.filter((club) => homeClubSlugs.has(club.slug)))
          .map((club) => `<p>${escapeHtml(club.name)}${club.contact_name ? ` · ${escapeHtml(club.contact_name)}` : ''}${club.contact_email ? ` · ${escapeHtml(club.contact_email)}` : ''}</p>`)
          .join('') || '<p class="muted small">No club on this account yet.</p>';
    ownFacts.innerHTML = `<h3>League Master</h3>${lmHtml}<h3>Team</h3>${teamFacts}<h3>Club</h3>${clubFacts}`;
  }

  const rememberWebsiteEmail = (teamId: number, name: string, email: string, playerId: number) => {
    const current = websitePlayers.find((player) => player.teamId === teamId && player.name.toLowerCase() === name.toLowerCase());
    if (current) {
      current.email = email;
      if (playerId) current.playerId = playerId;
    } else if (teamId) {
      websitePlayers.push({ teamId, name, email, playerId });
    }
    const listed = directoryRows.find((row) => row.teamId === teamId && row.name.toLowerCase() === name.toLowerCase());
    if (listed) listed.email = email;
    if (viewerIsAdmin) paintDirectory();
  };

  const ensureSquad = async (teamId: number, teamName: string) => {
    const { data: existing, error: readError } = await supabase.from('captain_squads').select('id').eq('team_id', teamId).limit(1).maybeSingle();
    if (readError) return { id: 0, error: readError.message };
    if (existing?.id) return { id: existing.id as number, error: '' };
    const { data: created, error } = await supabase.from('captain_squads').insert({ name: teamName, team_id: teamId }).select('id').single();
    if (error || !created) return { id: 0, error: error?.message || 'Could not add the team list.' };
    return { id: created.id as number, error: '' };
  };

  const savePlayerField = async (input: HTMLInputElement) => {
    const field = input.dataset.squadField;
    if (field !== 'email' && field !== 'es' && field !== 'phone') return;
    const raw = input.value.trim();
    const value = field === 'email' ? raw.toLowerCase() : raw;
    if (value === (input.dataset.saved ?? '')) return;
    if (field === 'email' && value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
      setStatus('Enter a valid email, or leave it blank.');
      return;
    }
    if (field === 'phone' && value && !/\d/.test(value)) {
      setStatus('Enter a phone number, or leave it blank.');
      return;
    }
    if (field === 'es' && value.length > 32) {
      setStatus('ES number is too long.');
      return;
    }
    const name = input.dataset.playerName || 'this player';
    const teamId = Number(input.dataset.teamId || 0);
    let playerId = Number(input.dataset.squadEmail || 0);
    const column = field === 'email' ? 'email' : field === 'es' ? 'england_squash_id' : 'phone';
    const stored = value || null;
    const label = field === 'email' ? 'Email' : field === 'es' ? 'ES number' : 'Phone';
    setStatus(`Saving ${label.toLowerCase()}…`);
    if (playerId) {
      const { error } = await supabase.from('squad_players').update({ [column]: stored }).eq('id', playerId);
      if (error) {
        setStatus(error.message);
        return;
      }
    } else {
      const squad = await ensureSquad(teamId, input.dataset.teamName || name);
      if (!squad.id) {
        setStatus(squad.error);
        return;
      }
      const { data: created, error } = await supabase
        .from('squad_players')
        .insert({ squad_id: squad.id, display_name: name, [column]: stored })
        .select('id')
        .single();
      if (error || !created) {
        setStatus(error?.message || `Could not save the ${label.toLowerCase()}.`);
        return;
      }
      playerId = created.id as number;
      const row = input.closest('tr');
      for (const box of row?.querySelectorAll<HTMLInputElement>('input') ?? []) box.dataset.squadEmail = String(playerId);
    }
    input.dataset.saved = value;
    if (field === 'email') {
      rememberWebsiteEmail(teamId, name, value, playerId);
      if (viewerIsAdmin) {
        await supabase.rpc('sync_website_player_emails');
        await supabase.rpc('apply_lm_roles');
      }
      setStatus(`Email saved for ${name}. League Master replaces the name, email, and ES number on the next import.`);
      return;
    }
    setStatus(`${label} saved for ${name}.`);
  };

  for (const host of [siteClubHost, siteTeamHost, playerListHost]) {
    host.addEventListener('focusout', (event) => {
      const input = (event.target as HTMLElement).closest<HTMLInputElement>('[data-squad-field]');
      if (input) void savePlayerField(input);
    });
  }

  playerListHost.addEventListener('submit', async (event) => {
    const form = (event.target as HTMLElement).closest<HTMLFormElement>('[data-form="add-player"]');
    if (!form || !viewerIsAdmin) return;
    event.preventDefault();
    const data = new FormData(form);
    const teamId = Number(data.get('team_id'));
    const name = String(data.get('display_name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim().toLowerCase();
    if (!teamId || name.length < 2) {
      setStatus('Choose a team and enter the player name.');
      return;
    }
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setStatus('Enter a valid email, or leave it blank.');
      return;
    }
    if (websitePlayers.some((player) => player.teamId === teamId && player.name.toLowerCase() === name.toLowerCase())) {
      setStatus(`${name} is already on that team. Set the email in the list.`);
      return;
    }
    setStatus('Adding player…');
    const teamLabel = form.querySelector('select')?.selectedOptions[0]?.textContent || 'Team';
    const squad = await ensureSquad(teamId, teamLabel);
    if (!squad.id) {
      setStatus(squad.error);
      return;
    }
    const { error } = await supabase.from('squad_players').insert({ squad_id: squad.id, display_name: name, email: email || null });
    if (error) {
      setStatus(error.message);
      return;
    }
    await supabase.rpc('sync_website_player_emails');
    await supabase.rpc('apply_lm_roles');
    setStatus(`${name} added on this website. League Master is unchanged.`);
    await showSession();
  });

  async function showSession() {
    const account = await loadAccount(supabase);
    signedIn.hidden = !account;
    if (!account) {
      workspace.hidden = true;
      juniorLink.hidden = true;
      shareLink.hidden = true;
      scoresLink.hidden = true;
      sendToLogin();
      return;
    }

    whoEl.textContent = `Signed in as ${account.displayName || account.email}`;
    viewerIsAdmin = account.isAdmin;
    viewerId = account.userId;
    viewerSeesJuniors = account.isAdmin || account.groups.some((group) => group.slug === 'junior_organisers');
    viewerSeesBeds = account.isAdmin || account.groups.some((group) => group.slug === 'bc_players');
    workspace.hidden = false;
    if (!root) return;
    for (const el of root.querySelectorAll<HTMLElement>('[data-lm-only]')) el.hidden = !account.isAdmin;
    const juniorsNav = root.querySelector<HTMLElement>('[data-juniors-nav]');
    const bedsNav = root.querySelector<HTMLElement>('[data-beds-nav]');
    if (juniorsNav) juniorsNav.hidden = !viewerSeesJuniors;
    if (bedsNav) bedsNav.hidden = !viewerSeesBeds;
    juniorLink.hidden = !viewerSeesJuniors;
    shareLink.hidden = !account.isAdmin;
    scoresLink.hidden = !account.isAdmin;
    const requested = tabAlias[location.hash.slice(1)] ?? (location.hash.slice(1) as Tab);
    const fallback: Tab = account.playerOnly ? 'site-player' : 'site-club';
    showTab((allowedTabs() as readonly string[]).includes(requested) ? requested : fallback);
    await loadWebsite(account);
    if (!account.isAdmin) return;

    if (location.hash.slice(1) === 'traffic' && !trafficLoaded) void loadTraffic();

    await supabase.rpc('sync_website_player_emails');
    await supabase.rpc('apply_lm_roles');
    await supabase.rpc('sync_permission_groups');

    const [
      { data: people, error: peopleError },
      accountStates,
      { data: clubRows, error: clubError },
      { data: orgRows, error: orgError },
      { data: roleRows, error: roleError },
      { data: nomRows, error: nomError },
      { data: contactRows, error: contactError },
      { data: groupRows, error: groupError },
      { data: groupCatalogRows, error: groupCatalogError },
      { data: permissionRows, error: permissionError },
      { data: juniorRows, error: juniorError },
    ] = await Promise.all([
      supabase.from('profiles').select('id, display_name, email, is_admin').order('display_name', { ascending: true }),
      fetchAccountStates(supabase),
      supabase.from('clubs').select('slug, name, contact_name, contact_email, leaguemaster_club_id').order('name', { ascending: true }),
      supabase.from('teams').select('id, club_slug, name, division, leaguemaster_team_id, captain_name, captain_email, last_season').order('name', { ascending: true }),
      supabase.from('memberships').select('id, profile_id, role, club_slug, team_id, profiles(display_name, email), teams(name, division)').order('role', { ascending: true }),
      supabase.from('nominations').select('team_id, player_name, period, position, season').eq('season', SEASON),
      supabase.from('lm_player_contacts').select('id, team_id, player_name, email'),
      supabase.from('group_members').select('profile_id, person_name, place, group_slug'),
      supabase.from('groups').select('slug, name, role_slug, source, managed, position').order('position'),
      supabase.from('roles').select('slug, name, position').order('position'),
      supabase.from('junior_entries').select('player_first_name, player_last_name, date_of_birth, age_category, draw, club, guardian_name, guardian_email, guardian_phone, emergency_name, emergency_phone, notes').order('player_last_name'),
    ]);
    if (peopleError || clubError || orgError || roleError) {
      setStatus(peopleError?.message || clubError?.message || orgError?.message || roleError?.message || 'Could not load the lists.');
      return;
    }
    if (nomError) setStatus(nomError.message);

    clubs = (clubRows ?? []) as Club[];
    orgTeams = (orgRows ?? []) as OrgTeam[];
    const accounts = (people ?? []) as Person[];
    const stateById = new Map((accountStates ?? []).map((state) => [state.id, state]));
    const memberships = (roleRows ?? []) as Membership[];
    const groupMembers = (groupError ? [] : groupRows ?? []) as GroupMember[];
    const groupCatalog = ((groupCatalogError ? [] : groupCatalogRows ?? []) as GroupCatalog[]).slice().sort((a, b) => a.position - b.position);
    const roleCatalog = ((permissionError ? [] : permissionRows ?? []) as RoleCatalog[]).slice().sort((a, b) => a.position - b.position);
    groupTitle.clear();
    for (const group of groupCatalog) groupTitle.set(group.slug, group.name);
    listedGroups = groupMembers;
    groupCatalogLive = groupCatalog;
    roleCatalogLive = roleCatalog;
    paintPermissionCatalog(groupCatalog, roleCatalog, groupMembers);
    paintJuniorEntries((juniorError ? [] : (juniorRows ?? [])) as JuniorEntry[], juniorError?.message ?? '');
    if (groupError || groupCatalogError || permissionError) groupNote.textContent = 'Groups are not on the database yet. Apply the groups migration, then reload.';
    const clubNames = new Map(clubs.map((club) => [club.slug, club.name]));
    const dash = '—';

    const contacts = (contactError ? [] : contactRows ?? []) as { team_id: number; player_name: string; email: string | null }[];
    const nominations = (nomError ? [] : nomRows ?? []) as { team_id: number; player_name: string; period: number; position: number }[];
    const byPlayer = new Map<string, { team_id: number; player_name: string; period: number; position: number }>();
    for (const nom of nominations) {
      const key = `${nom.team_id}:${nom.player_name.toLowerCase()}`;
      const prev = byPlayer.get(key);
      if (!prev || nom.period > prev.period || (nom.period === prev.period && nom.position < prev.position)) byPlayer.set(key, nom);
    }
    directoryRows = [...byPlayer.values()]
      .map((nom) => {
        const team = orgTeams.find((item) => item.id === nom.team_id);
        const contact = contacts.find((item) => item.team_id === nom.team_id && item.player_name.toLowerCase() === nom.player_name.toLowerCase());
        const website = websitePlayers.find((item) => item.teamId === nom.team_id && item.name.toLowerCase() === nom.player_name.toLowerCase());
        const teamLabel = team ? (team.division ? `${team.name} · ${team.division}` : team.name) : 'Team';
        return {
          club: clubNames.get(team?.club_slug ?? '') || dash,
          team: teamLabel,
          teamId: nom.team_id,
          name: nom.player_name,
          email: website ? website.email : contact?.email || '',
        };
      })
      .sort((a, b) => a.club.localeCompare(b.club, 'en') || a.team.localeCompare(b.team, 'en') || a.name.localeCompare(b.name, 'en'));

    const countyAdmin = accounts.find((person) => (person.email || '').toLowerCase() === 'county-admin@players.invalid');
    protectedAdminId = countyAdmin?.id || '';
    const selfId = account.userId;
    const one = (value: { display_name?: string; email?: string | null; name?: string; division?: string | null } | { display_name?: string; email?: string | null; name?: string; division?: string | null }[] | null) =>
      Array.isArray(value) ? value[0] : value;
    const whereFor = (membership: Membership) => {
      const team = one(membership.teams);
      const club = clubs.find((item) => item.slug === membership.club_slug);
      if (team) return `${team.name}${team.division ? `, ${team.division}` : ''}`;
      if (club) return club.name;
      return '—';
    };
    const clubsFor = (personId: string) => {
      const names = new Set<string>();
      for (const membership of rolesFor(personId)) {
        if (membership.club_slug) {
          const name = clubNames.get(membership.club_slug);
          if (name) names.add(name);
        }
        if (membership.team_id != null) {
          const team = orgTeams.find((item) => item.id === membership.team_id);
          const name = team ? clubNames.get(team.club_slug) : undefined;
          if (name) names.add(name);
        }
      }
      return [...names].sort((a, b) => a.localeCompare(b, 'en')).join('; ');
    };
    const rolesFor = (personId: string) =>
      memberships
        .filter((membership) => membership.profile_id === personId)
        .sort((a, b) => rankFor(a.role) - rankFor(b.role) || whereFor(a).localeCompare(whereFor(b), 'en'));
    const positionOf = (slug: string) => groupCatalog.find((group) => group.slug === slug)?.position ?? 99;
    const nameKey = (value: string) => value.trim().toLowerCase().replace(/\s+/g, ' ');
    const groupsFor = (person: Person) => {
      const key = nameKey(person.display_name || '');
      const seen = new Set<string>();
      return groupMembers
        .filter((group) => group.profile_id === person.id || (key !== '' && nameKey(group.person_name) === key))
        .sort((a, b) => positionOf(a.group_slug) - positionOf(b.group_slug) || a.group_slug.localeCompare(b.group_slug, 'en'))
        .filter((group) => {
          if (seen.has(group.group_slug)) return false;
          seen.add(group.group_slug);
          return true;
        });
    };
    const personRank = (person: Person) => {
      if (person.is_admin || person.id === protectedAdminId) return 0;
      const roles = rolesFor(person.id);
      return roles.length ? Math.min(...roles.map((membership) => rankFor(membership.role))) : 4;
    };
    const sortedAccounts = accounts.slice().sort((a, b) => {
      const byRole = personRank(a) - personRank(b);
      if (byRole) return byRole;
      return (a.display_name || a.email || '').localeCompare(b.display_name || b.email || '', 'en');
    });
    const permissionNames = (person: Person) => {
      const slugs = new Set(groupsFor(person).map((group) => group.group_slug));
      const names = roleCatalog
        .filter((role) => groupCatalog.some((group) => group.role_slug === role.slug && slugs.has(group.slug)))
        .map((role) => role.name);
      if (person.is_admin && !names.includes('Admin')) names.unshift('Admin');
      return names;
    };
    const contactFor = (name: string) => personContacts.filter((contact) => nameKey(contact.name) === nameKey(name));
    const emailFor = (name: string, profile: Person | null) => {
      if (profile?.id === protectedAdminId) return 'BSCA';
      if (profile?.email) return profile.email;
      const squad = contactFor(name).find((contact) => contact.email);
      if (squad?.email) return squad.email;
      const listed = directoryRows.find((row) => nameKey(row.name) === nameKey(name) && row.email);
      if (listed?.email) return listed.email;
      const club = clubs.find((item) => nameKey(item.contact_name || '') === nameKey(name) && item.contact_email);
      if (club?.contact_email) return club.contact_email;
      const team = orgTeams.find((item) => nameKey(item.captain_name || '') === nameKey(name) && item.captain_email);
      return team?.captain_email || '';
    };
    const placeFor = (name: string, profile: Person | null, groups: GroupMember[]) => {
      const fromGroups = [...new Set(groups.map((group) => group.place).filter((place): place is string => Boolean(place)))];
      if (fromGroups.length) return fromGroups.join('; ');
      if (profile && (profile.is_admin || profile.id === protectedAdminId)) return clubsFor(profile.id) || '—';
      const listed = directoryRows.filter((row) => nameKey(row.name) === nameKey(name));
      if (listed.length) return [...new Set(listed.map((row) => `${row.club} / ${row.team}`))].join('; ');
      if (profile) {
        const roles = rolesFor(profile.id);
        const places = roles.map((membership) => whereFor(membership)).filter((place) => place !== '—');
        if (places.length) return places.join('; ');
      }
      return '—';
    };
    const cards = new Map<string, MemberCard>();
    const addCard = (name: string, profile: Person | null, groups: GroupMember[]) => {
      const key = profile ? `id:${profile.id}` : `name:${nameKey(name)}`;
      if (!name && !profile) return;
      const lmName =
        groups.find((group) => group.group_slug === 'lm_players')?.person_name ||
        groups.find((group) => group.group_slug === 'lm_team_captains' || group.group_slug === 'lm_club_captains')?.person_name ||
        '';
      const display = lmName || profile?.display_name || name || 'Unnamed';
      const profileName = profile?.display_name || '';
      const contactNames = new Set(
        [display, name, ...groups.map((group) => group.person_name)].map((value) => nameKey(value || '')).filter(Boolean),
      );
      const contacts = personContacts.filter((contact) => contactNames.has(nameKey(contact.name)));
      const slugs = [...new Set(groups.map((group) => group.group_slug))];
      const roleNames = roleCatalog
        .filter((role) => groupCatalog.some((group) => group.role_slug === role.slug && slugs.includes(group.slug)))
        .map((role) => role.name);
      if (profile?.is_admin && !roleNames.includes('Admin')) roleNames.unshift('Admin');
      const state = profile ? stateById.get(profile.id) : undefined;
      const active = state ? state.active : true;
      const isDefault = (profile?.email || '').trim().toLowerCase() === 'county-admin@players.invalid';
      const listed = directoryRows.filter((row) => contactNames.has(nameKey(row.name)) && row.team);
      const fromPlaces = groups.flatMap((group) =>
        (group.place || '')
          .split(';')
          .map((part) => {
            const bits = part
              .split('/')
              .map((bit) => bit.trim())
              .filter(Boolean);
            return bits.length > 1 ? bits.slice(1).join(' / ') : '';
          })
          .filter(Boolean),
      );
      const teams = [...new Set(listed.length ? listed.map((row) => row.team) : fromPlaces)];
      cards.set(key, {
        key,
        name: display,
        profileName,
        label: `${display}${profile?.id === selfId ? ' (you)' : ''}${isDefault ? ' Default admin' : ''}`,
        profileId: profile?.id ?? null,
        email: emailFor(display, profile),
        es: contacts.find((contact) => contact.es)?.es || '',
        phone: contacts.find((contact) => contact.phone)?.phone || '',
        place: placeFor(display, profile, groups),
        teams: teams.join('; '),
        groupSlugs: slugs,
        groupNames: groups.map((group) => groupTitle.get(group.group_slug) ?? group.group_slug).filter((value, index, all) => all.indexOf(value) === index).join(', '),
        roleNames: roleNames.join(', '),
        isAdmin: Boolean(profile?.is_admin),
        squadIds: contacts.map((contact) => contact.playerId).filter((id) => id > 0),
        teamId: listed[0]?.teamId ?? contacts.find((contact) => contact.teamId)?.teamId ?? null,
        teamName: listed[0]?.team || '',
        statusHtml: !profile ? 'No login' : active ? 'Active' : 'Inactive',
        lastLogin: profile && state ? formatWhen(state.last_sign_in_at) : '—',
        protectedAccount: Boolean(isDefault),
        active,
      });
    };
    const groupedNames = new Set<string>();
    for (const group of groupMembers) {
      const profile = group.profile_id
        ? accounts.find((person) => person.id === group.profile_id) ?? null
        : accounts.find((person) => nameKey(person.display_name || '') === nameKey(group.person_name)) ?? null;
      const name = profile?.display_name || group.person_name;
      groupedNames.add(profile ? `id:${profile.id}` : `name:${nameKey(name)}`);
      const mine = groupMembers.filter((item) => (profile ? item.profile_id === profile.id || nameKey(item.person_name) === nameKey(name) : nameKey(item.person_name) === nameKey(group.person_name)));
      addCard(name, profile, mine);
    }
    for (const person of sortedAccounts) {
      if (cards.has(`id:${person.id}`)) continue;
      addCard(person.display_name || 'Unnamed', person, groupsFor(person));
    }
    memberCards = [...cards.values()].sort((a, b) => a.label.localeCompare(b.label, 'en'));
    openingGroup = '';
    if (selectedMemberKey && !memberCards.some((card) => card.key === selectedMemberKey)) {
      const named = memberCards.find((card) => nameKey(card.name) === nameKey(selectedMemberKey.replace(/^name:/, '')));
      selectedMemberKey = named?.key ?? '';
    }
    paintMembers();
    await paintLinks();
  }

  function paintDirectory() {
    paintMembers();
  }

  type LinkRow = { id: number; profile_id: string | null; squashlevels_player_id: number | null; lm_player_name: string | null };
  type SlNamed = { id: number; display_name: string; current_level: number | null };
  const linksHost = root.querySelector<HTMLElement>('[data-links]')!;
  let linkLevels: SlNamed[] = [];

  async function paintLinks() {
    const [linkResult, { data: slRows }, { data: nomRows }, nameResult] = await Promise.all([
      supabase.from('player_links').select('id, profile_id, squashlevels_player_id, lm_player_name').order('id'),
      allSlPlayers(),
      supabase.from('nominations').select('player_name').eq('season', SEASON),
      allSlNames(),
    ]);
    if (linkResult.error?.code === 'PGRST205') {
      setStatus('The links table is not on the database yet, so a typed name cannot be saved.');
    } else if (linkResult.error) {
      setStatus(linkResult.error.message);
    }
    const levels = (slRows ?? []) as SlNamed[];
    linkLevels = levels;
    const slNames = new Set(levels.map((player) => nameKey(player.display_name)));
    const names = new Map<string, string>();
    const addLmName = (value: string) => {
      const trimmed = value.trim();
      const key = nameKey(trimmed);
      if (key && !names.has(key)) names.set(key, trimmed);
    };
    for (const player of websitePlayers) addLmName(player.name);
    for (const row of (nomRows ?? []) as { player_name: string }[]) addLmName(row.player_name);
    const saved = (linkResult.error ? [] : (linkResult.data ?? [])) as LinkRow[];
    const linked = new Set(saved.map((row) => nameKey(row.lm_player_name ?? '')));
    const levelById = new Map(levels.map((player) => [player.id, player]));
    const storedByKey = new Map<string, SlNamed>();
    for (const stored of (nameResult.error ? [] : (nameResult.data ?? [])) as { name_key: string; player_id: number | null }[]) {
      if (stored.player_id == null || storedByKey.has(stored.name_key)) continue;
      const player = levelById.get(stored.player_id);
      if (player) storedByKey.set(stored.name_key, player);
    }
    const slText = (player: SlNamed | undefined) => (player ? `${player.display_name} · ${levelText(player.current_level)}` : '—');
    const savedLevel = (row: LinkRow) => (row.squashlevels_player_id != null ? levelById.get(row.squashlevels_player_id) : undefined);
    const savedIsExact = (row: LinkRow) => {
      const level = savedLevel(row);
      return Boolean(level) && nameKey(level!.display_name) === nameKey(row.lm_player_name ?? '');
    };
    const savedHtmlFor = (row: LinkRow) => {
      const lm = row.lm_player_name?.trim() || '—';
      return `<tr><td>${escapeHtml(lm)}</td><td>${escapeHtml(slText(savedLevel(row)))}</td><td><button class="btn btn--ghost btn--sm" type="button" data-unlink="${row.id}">Unlink</button></td></tr>`;
    };
    const shown = new Set<string>();
    const steveSaved = saved.find((row) => nameKey(row.lm_player_name ?? '') === 'steve davies');
    const placed: string[] = [];
    if (steveSaved) {
      placed.push(savedHtmlFor(steveSaved));
      shown.add('steve davies');
    }
    const otherSaved = saved
      .filter((row) => {
        const key = nameKey(row.lm_player_name ?? '');
        return Boolean(key) && !shown.has(key) && !savedIsExact(row);
      })
      .sort((a, b) => (a.lm_player_name ?? '').localeCompare(b.lm_player_name ?? '', 'en'));
    for (const row of otherSaved) {
      placed.push(savedHtmlFor(row));
      shown.add(nameKey(row.lm_player_name ?? ''));
    }
    for (const name of [...names.values()].sort((a, b) => a.localeCompare(b, 'en'))) {
      const key = nameKey(name);
      if (shown.has(key) || linked.has(key)) continue;
      const player = storedByKey.get(looseKey(name));
      if (!player || nameKey(player.display_name) === key) continue;
      placed.push(`<tr><td>${escapeHtml(name)}</td><td>${escapeHtml(slText(player))}</td><td></td></tr>`);
      shown.add(key);
    }
    const suggestions: { lm: string; sl: string }[] = [];
    const steve = [...names.values()].find((name) => nameKey(name) === 'steve davies');
    if (steve && !shown.has('steve davies')) suggestions.push({ lm: steve, sl: 'Steven Davies' });
    for (const name of [...names.values()].sort((a, b) => a.localeCompare(b, 'en'))) {
      const key = nameKey(name);
      if (shown.has(key) || key === 'steve davies' || linked.has(key) || slNames.has(key)) continue;
      suggestions.push({ lm: name, sl: '' });
    }
    const lmNames = [...names.values()].sort((a, b) => a.localeCompare(b, 'en'));
    const suggestionHtml = suggestions
      .map((row) => {
        const options = lmNames
          .map((name) => `<option value="${escapeHtml(name)}"${name === row.lm ? ' selected' : ''}>${escapeHtml(name)}</option>`)
          .join('');
        return `<tr>
          <td><select data-link-lm aria-label="LM Player">${options}</select></td>
          <td><input data-link-sl aria-label="SL" value="${escapeHtml(row.sl)}" autocomplete="off" /></td>
          <td><button class="btn btn--primary btn--sm" type="button" data-link-save>Link</button></td>
        </tr>`;
      })
      .join('');
    const exactSaved = saved
      .filter((row) => {
        const key = nameKey(row.lm_player_name ?? '');
        return Boolean(key) && !shown.has(key) && savedIsExact(row);
      })
      .map(savedHtmlFor)
      .join('');
    linksHost.innerHTML = placed.join('') + suggestionHtml + exactSaved || '<tr><td colspan="3">No links yet.</td></tr>';
  }

  linksHost.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-link-save]');
    if (!button) return;
    const row = button.closest('tr');
    const lmName = row?.querySelector<HTMLSelectElement>('[data-link-lm]')?.value.trim() ?? '';
    const typed = row?.querySelector<HTMLInputElement>('[data-link-sl]')?.value.trim() ?? '';
    if (!lmName || !typed) {
      setStatus('Choose an LM Player and type an SL name.');
      return;
    }
    const stored = linkLevels.filter((player) => nameKey(player.display_name) === nameKey(typed) && player.current_level != null);
    if (stored.length > 1) {
      setStatus(`More than one SquashLevels player is called ${typed}.`);
      return;
    }
    let squashlevelsPlayerId = stored[0]?.id;
    if (!squashlevelsPlayerId) {
      setStatus('Looking up that SquashLevels player…');
      const { data: lookedUp, error: lookupError } = await supabase.functions.invoke('squashlevels-link', {
        body: { name: typed },
      });
      if (lookupError) {
        let message = lookupError.message;
        const context = (lookupError as { context?: Response }).context;
        if (context && typeof context.json === 'function') {
          try {
            const payload = (await context.json()) as { error?: string };
            if (payload?.error) message = payload.error;
          } catch {
            /* The function body was not JSON. */
          }
        }
        if (/failed to send a request|relay error|failed to fetch|not found/i.test(message)) {
          message = `No stored SquashLevels player is called ${typed}, and the live lookup is not reachable yet.`;
        }
        setStatus(message);
        return;
      }
      const found = lookedUp as { id?: number; error?: string } | null;
      if (!found?.id) {
        setStatus(found?.error || `No SquashLevels player is called ${typed}.`);
        return;
      }
      squashlevelsPlayerId = found.id;
    }
    setStatus('Saving link…');
    const { error } = await supabase.from('player_links').insert({
      squashlevels_player_id: squashlevelsPlayerId,
      lm_player_name: lmName,
    });
    if (error) {
      setStatus(
        error.code === 'PGRST205'
          ? 'The links table is not on the database yet, so a typed name cannot be saved.'
          : error.code === '23505'
            ? 'One of those records is already linked. Unlink it first.'
            : error.message,
      );
      return;
    }
    setStatus('Link saved.');
    await showSession();
  });

  root.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-unlink]');
    if (!button?.dataset.unlink) return;
    setStatus('Removing link…');
    const { error } = await supabase.from('player_links').delete().eq('id', Number(button.dataset.unlink));
    if (error) {
      setStatus(error.message);
      return;
    }
    setStatus('Link removed.');
    await showSession();
  });

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
  }

  memberSearch.addEventListener('input', () => paintMembers());
  async function saveMemberDetails(card: MemberCard, email: string, es: string, phone: string, updateGroups: boolean) {
    if (!viewerIsAdmin) {
      setStatus('Only an admin can change a player.');
      return;
    }
    if (!card.protectedAccount && email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setStatus('Enter a valid email, or leave it blank.');
      return;
    }
    if (phone && !/\d/.test(phone)) {
      setStatus('Enter a phone number, or leave it blank.');
      return;
    }
    if (es.length > 32) {
      setStatus('ES number is too long.');
      return;
    }
    setStatus('Saving details…');
    if (card.profileId && !card.protectedAccount && email !== card.email.trim().toLowerCase()) {
      const message = await callManageAccounts(supabase, { action: 'set-email', user_id: card.profileId, email });
      if (message) {
        setStatus(message);
        return;
      }
    }
    const stored = { email: email || null, england_squash_id: es || null, phone: phone || null };
    if (card.squadIds.length) {
      const { error } = await supabase.from('squad_players').update(stored).in('id', card.squadIds);
      if (error) {
        setStatus(error.message);
        return;
      }
    } else if (card.teamId) {
      const squad = await ensureSquad(card.teamId, card.teamName || card.name);
      if (!squad.id) {
        setStatus(squad.error);
        return;
      }
      const { error } = await supabase.from('squad_players').insert({ squad_id: squad.id, display_name: card.name, ...stored });
      if (error) {
        setStatus(error.message);
        return;
      }
    }
    const [{ data: clubRows }, { data: teamRows }] = await Promise.all([
      supabase.from('clubs').select('slug, contact_name'),
      supabase.from('teams').select('id, captain_name'),
    ]);
    const sameName = (value: string | null) => (value ?? '').trim().toLowerCase().replace(/\s+/g, ' ') === card.name.trim().toLowerCase().replace(/\s+/g, ' ');
    const clubSlugs = ((clubRows ?? []) as { slug: string; contact_name: string | null }[]).filter((club) => sameName(club.contact_name)).map((club) => club.slug);
    const teamIdsToUpdate = ((teamRows ?? []) as { id: number; captain_name: string | null }[]).filter((team) => sameName(team.captain_name)).map((team) => team.id);
    if (clubSlugs.length) await supabase.from('clubs').update({ contact_email: email || null }).in('slug', clubSlugs);
    if (teamIdsToUpdate.length) await supabase.from('teams').update({ captain_email: email || null }).in('id', teamIdsToUpdate);
    if (viewerIsAdmin) {
      await supabase.rpc('sync_website_player_emails');
      await supabase.rpc('apply_lm_roles');
    }
    if (updateGroups && card.profileId) {
      const wanted = new Map(
        [...root.querySelectorAll<HTMLInputElement>('[data-user-group]')].map((box) => [box.dataset.userGroup ?? '', box.checked]),
      );
      const has = (slug: string) => card.groupSlugs.includes(slug);
      if (Boolean(wanted.get('admins')) !== has('admins')) {
        if (card.protectedAccount || card.profileId === viewerId) {
          setStatus('That admin access stays as it is.');
          return;
        }
        const message = await callManageAccounts(supabase, { action: 'set-admin', user_id: card.profileId, is_admin: Boolean(wanted.get('admins')) });
        if (message) {
          setStatus(message);
          return;
        }
      }
      for (const slug of ['junior_organisers', 'bc_players']) {
        if (Boolean(wanted.get(slug)) === has(slug)) continue;
        const message = await callManageAccounts(supabase, {
          action: 'set-group',
          user_id: card.profileId,
          group_slug: slug,
          member: Boolean(wanted.get(slug)),
        });
        if (message) {
          setStatus(message);
          return;
        }
      }
    }
    setStatus(`Details saved for ${card.name}. League Master replaces the name, email, and ES number on the next import. Phone stays on this website.`);
    await showSession();
  }

  showSession();
</script>

