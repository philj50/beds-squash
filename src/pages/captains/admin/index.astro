      supabase.rpc('admin_integration_accounts'),
    ]);
    const report = reportResult.data as { tables?: { name: string; rows: number; bytes: number }[] } | null;
    const tables = Array.isArray(report?.tables) ? report.tables : [];
    const accounts = new Map<string, string>();
    const accountRows = accountResult.data as { slug?: string; account?: string }[] | null;
    if (Array.isArray(accountRows)) {
      for (const row of accountRows) {
        if (row.slug && row.account) accounts.set(row.slug, row.account);
      }
    }
    const formatBytes = (value: number) => {
      if (!Number.isFinite(value) || value <= 0) return '—';
