    const stats = data as {
      total_7d: number;
      total_30d: number;
      sessions_7d: number;
      sessions_30d: number;
      sign_ins_7d?: number;
      sign_ins_30d?: number;
      by_day: { day: string; page_views: number; sessions: number }[];
