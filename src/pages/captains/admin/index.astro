  function fillFilter(select: HTMLSelectElement, choices: { value: string; label: string }[], allLabel: string) {
    const current = select.value;
    const next = ['', ...choices.map((choice) => choice.value)];
    const same =
      select.options.length === next.length &&
      next.every((value, index) => select.options[index]?.value === value) &&
      choices.every((choice, index) => select.options[index + 1]?.textContent === choice.label);
    if (same) return;
    select.innerHTML = [`<option value="">${escapeHtml(allLabel)}</option>`, ...choices.map((choice) => `<option value="${escapeHtml(choice.value)}">${escapeHtml(choice.label)}</option>`)].join('');
    select.value = next.includes(current) ? current : '';
  }
  const contactFieldName = (raw: string) => {
