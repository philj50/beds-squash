  async function placeInDraw(id: number, back: boolean) {
    if (!viewerSeesJuniors) return;
    const entry = juniorEntriesLive.find((item) => item.id === id);
    if (!entry) return;
    const mates = planFor(entry.age_category, entry.draw).members;
    const same = juniorEntriesLive.filter((item) => mates.some((member) => member.age === item.age_category && member.section === item.draw));
    if (back) {
      const removed = entry.draw_position;
      if (removed == null) return;
      entry.draw_position = null;
      for (const item of same) {
        if (item.draw_position != null && item.draw_position > removed) item.draw_position -= 1;
      }
    } else if (entry.draw_position == null) {
      entry.draw_position = same.reduce((max, item) => Math.max(max, item.draw_position ?? 0), 0) + 1;
    } else return;
    paintJuniorEntries(juniorEntriesLive);
    const { error } = await supabase.rpc(back ? 'return_junior_draw' : 'place_junior_draw', { p_id: id });
