  };

  // A stored address is offered only on the row being edited. The other email
  // boxes stay locked so the browser cannot copy that address down the column.
  const holdEmailColumn = (current: HTMLInputElement) => {
    protectedEmail = current;
    for (const input of emailInputs()) {
      const open = input === current;
      input.readOnly = !open;
      input.autocomplete = open ? 'email' : 'one-time-code';
    }
    scrubOtherEmails(current);
  };

  const releaseEmailColumn = () => {
    protectedEmail = null;
    for (const input of emailInputs()) {
      input.readOnly = false;
      input.autocomplete = 'one-time-code';
    }
  };

  const watchEmails = () => {
    if (emailWatch) return;
    const tick = () => {
      const active = isEmailInput(document.activeElement) ? document.activeElement : null;
      scrubOtherEmails(active ?? protectedEmail);
      if (active) {
        emailWatch = window.requestAnimationFrame(tick);
        return;
      }
      emailWatchFrames -= 1;
      if (emailWatchFrames > 0) {
        emailWatch = window.requestAnimationFrame(tick);
        return;
      }
      emailWatch = 0;
      releaseEmailColumn();
    };
    emailWatch = window.requestAnimationFrame(tick);
  };

