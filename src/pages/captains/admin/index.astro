      if (placeFilter && !card.teams.split(';').map((part) => part.trim()).includes(placeFilter)) return false;
      if (!query) return true;
      return [card.name, card.profileName, card.teams, card.place, card.email, card.groupNames, card.roleNames].some((value) => value.toLowerCase().includes(query));
    });
    const narrowed = Boolean(query || groupFilter || placeFilter);
