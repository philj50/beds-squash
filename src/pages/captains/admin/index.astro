  function rememberPlan(plan: JuniorDrawPlan) {
    const keys = new Set(plan.members.map(memberKey));
    const kept = juniorDrawPlans.flatMap((existing) => {
      const rest = existing.members.filter((member) => !keys.has(memberKey(member)));
      if (rest.length === existing.members.length) return [existing];
      return rest.length ? [{ ...existing, members: rest }] : [];
    });
    juniorDrawPlans = [...kept, plan];
  }
