---
import Base from '@/layouts/Base.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';

const captainsHref = `${import.meta.env.BASE_URL}captains/`;
---

<Base
  title="Clubs and captains"
  description="Edit club contacts and team captain emails."
  noindex
>
  <section class="section">
    <div class="container setup" id="setup-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <p class="test-flag">Test mode. This page is not linked from the public site.</p>
      <h1>Clubs and captains</h1>
      <p class="lede">
        Each club has a contact you can edit, then the captain for each of its Winter 2026/27 teams.
        Saving does not send a message. When a captain registers on the <a href={captainsHref}>captain page</a>, their team appears for them.
      </p>
      <p class="status" data-status role="status"></p>

      <div data-panel="signed-out">
        <form class="card" data-form="sign-in">
          <div class="card__body stack">
            <label>Email <input name="email" type="email" required autocomplete="email" /></label>
            <label>Password <input name="password" type="password" required autocomplete="current-password" /></label>
            <button class="btn btn--primary" type="submit">Sign in</button>
          </div>
        </form>
      </div>

      <div data-panel="signed-in" hidden>
        <p class="who" data-who></p>
        <p class="actions">
          <a class="btn btn--ghost btn--sm" href={captainsHref}>Captain page</a>
          <button class="btn btn--ghost btn--sm" type="button" data-sign-out>Sign out</button>
        </p>
        <p data-denied hidden>This account cannot set up teams.</p>

        <div data-admin hidden>
          <nav class="admin-tabs" aria-label="Admin sections">
            <button type="button" data-tab-button="overview">Overview</button>
            <button type="button" data-tab-button="clubs">Clubs</button>
            <button type="button" data-tab-button="accounts">Accounts</button>
            <button type="button" data-tab-button="roles">Roles</button>
          </nav>

          <section class="admin-panel" data-tab="overview">
            <h2>Overview</h2>
            <p class="muted small">Every club, its contact, and the captain of each Winter 2026/27 team. Choose a club name to edit it.</p>
            <div class="overview-box">
              <table class="overview">
                <thead>
                  <tr>
                    <th>Club</th>
                    <th>Club contact</th>
                    <th class="col-team">Team</th>
                    <th class="col-division">Division</th>
                    <th>Team captain</th>
                  </tr>
                </thead>
                <tbody data-overview></tbody>
              </table>
            </div>
          </section>

          <section class="admin-panel" data-tab="clubs" hidden>
            <h2>Clubs</h2>
            <nav class="club-menu" aria-label="Clubs" data-club-menu></nav>
            <p class="muted small">Leave a field blank if you do not have it yet. Saving does not send a message.</p>
            <div data-teams></div>
            <form class="card" data-form="new-club" data-club-panel="new" hidden>
              <div class="card__body stack">
                <h3>Add a club</h3>
                <label>Club name <input name="name" required minlength="2" maxlength="80" autocomplete="off" /></label>
                <label>Contact name <input name="contact_name" maxlength="80" autocomplete="off" /></label>
                <label>Contact email <input name="contact_email" type="email" autocomplete="off" /></label>
                <button class="btn btn--primary" type="submit">Add club</button>
              </div>
            </form>
          </section>

          <section class="admin-panel" data-tab="accounts" hidden>
            <h2>Registered accounts</h2>
            <ul class="people" data-people></ul>
          </section>

          <section class="admin-panel" data-tab="roles" hidden>
          <h2>Roles</h2>
          <p class="muted small">
            Admin covers every club and team. A club captain covers every team at that club. A team captain covers the players on that team. Anyone without an account is the public.
          </p>
          <form class="card" data-form="role">
            <div class="card__body stack">
              <label>
                Person
                <select name="profile_id" required data-role-person>
                  <option value="">Choose an account</option>
                </select>
              </label>
              <label>
                Role
                <select name="role" required data-role-level>
                  <option value="admin">Admin</option>
                  <option value="club_captain">Club captain</option>
                  <option value="team_captain">Team captain</option>
                  <option value="team_player">Team player</option>
                </select>
              </label>
              <label data-role-club-field hidden>
                Club
                <select name="club_slug" data-role-club>
                  <option value="">Choose a club</option>
                </select>
              </label>
              <label data-role-team-field hidden>
                Team
                <select name="team_id" data-role-team>
                  <option value="">Choose a team</option>
                </select>
              </label>
              <button class="btn btn--primary" type="submit">Add role</button>
            </div>
          </form>
          <ul class="people" data-roles></ul>
          </section>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';

  type Person = { id: string; display_name: string; email: string | null; is_admin: boolean };
  type Club = { slug: string; name: string; contact_name: string | null; contact_email: string | null };
  type OrgTeam = {
    id: number;
    club_slug: string;
    name: string;
    division: string | null;
    leaguemaster_team_id: string | null;
    captain_email: string | null;
    last_season: string | null;
  };
  type Membership = {
    id: number;
    role: 'admin' | 'club_captain' | 'team_captain' | 'team_player';
    club_slug: string | null;
    team_id: number | null;
    profiles: { display_name: string; email: string | null } | { display_name: string; email: string | null }[] | null;
    teams: { name: string; division: string | null } | { name: string; division: string | null }[] | null;
  };
  const roleLabel: Record<Membership['role'], string> = {
    admin: 'Admin',
    club_captain: 'Club captain',
    team_captain: 'Team captain',
    team_player: 'Team player',
  };
  type Squad = {
    id: number;
    name: string;
    captain_email: string;
    captain_id: string | null;
    leaguemaster_team_id: string | null;
    team_id: number | null;
    profiles: { display_name: string } | { display_name: string }[] | null;
  };

  const root = document.getElementById('setup-app');
  if (!root) throw new Error('setup app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const signedOut = root.querySelector<HTMLElement>('[data-panel="signed-out"]')!;
  const signedIn = root.querySelector<HTMLElement>('[data-panel="signed-in"]')!;
  const adminPanel = root.querySelector<HTMLElement>('[data-admin]')!;
  const denied = root.querySelector<HTMLElement>('[data-denied]')!;
  const teamsHost = root.querySelector<HTMLElement>('[data-teams]')!;
  const overviewHost = root.querySelector<HTMLElement>('[data-overview]')!;
  const clubMenu = root.querySelector<HTMLElement>('[data-club-menu]')!;
  const peopleHost = root.querySelector<HTMLElement>('[data-people]')!;
  const rolesHost = root.querySelector<HTMLElement>('[data-roles]')!;
  const rolePerson = root.querySelector<HTMLSelectElement>('[data-role-person]')!;
  const roleLevel = root.querySelector<HTMLSelectElement>('[data-role-level]')!;
  const roleClubField = root.querySelector<HTMLElement>('[data-role-club-field]')!;
  const roleTeamField = root.querySelector<HTMLElement>('[data-role-team-field]')!;
  const roleClub = root.querySelector<HTMLSelectElement>('[data-role-club]')!;
  const roleTeam = root.querySelector<HTMLSelectElement>('[data-role-team]')!;
  const newClubForm = root.querySelector<HTMLFormElement>('[data-form="new-club"]')!;
  const tabs = ['overview', 'clubs', 'accounts', 'roles'] as const;
  type Tab = (typeof tabs)[number];
  let currentClub = '';

  const showTab = (tab: Tab) => {
    for (const panel of root.querySelectorAll<HTMLElement>('[data-tab]')) panel.hidden = panel.dataset.tab !== tab;
    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-tab-button]')) {
      button.setAttribute('aria-current', button.dataset.tabButton === tab ? 'page' : 'false');
    }
    history.replaceState(null, '', `#${tab}`);
  };

  const showClub = (slug: string) => {
    currentClub = slug;
    for (const card of teamsHost.querySelectorAll<HTMLElement>('[data-club-card]')) {
      card.hidden = card.dataset.clubCard !== slug;
    }
    newClubForm.hidden = slug !== 'new';
    for (const link of clubMenu.querySelectorAll<HTMLButtonElement>('[data-pick-club]')) {
      link.setAttribute('aria-current', link.dataset.pickClub === slug ? 'true' : 'false');
    }
  };

  root.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const tabButton = target.closest<HTMLButtonElement>('[data-tab-button]');
    if (tabButton) {
      showTab(tabButton.dataset.tabButton as Tab);
      return;
    }
    const pick = target.closest<HTMLButtonElement>('[data-pick-club]');
    if (pick) {
      showClub(pick.dataset.pickClub!);
      return;
    }
    const open = target.closest<HTMLButtonElement>('[data-open-club]');
    if (open) {
      showTab('clubs');
      showClub(open.dataset.openClub!);
    }
  });

  let clubs: Club[] = [];
  let orgTeams: OrgTeam[] = [];
  let squads: Squad[] = [];

  const setStatus = (message: string) => {
    statusEl.textContent = message;
  };

  const friendly = (error: { code?: string; message: string }) => {
    if (error.code === '23505' && error.message.includes('lm_team')) return 'That team is already added.';
    if (error.code === '23505') return 'That captain already has a team with this name.';
    return error.message;
  };

  root.querySelector<HTMLFormElement>('[data-form="sign-in"]')!.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(event.currentTarget as HTMLFormElement);
    setStatus('Signing in…');
    const { error } = await supabase.auth.signInWithPassword({
      email: String(data.get('email')),
      password: String(data.get('password')),
    });
    setStatus(error ? error.message : '');
    if (!error) await showSession();
  });

  const showRoleFields = () => {
    const role = roleLevel.value;
    roleClubField.hidden = role === 'admin';
    roleTeamField.hidden = role === 'admin' || role === 'club_captain';
    roleClub.required = role !== 'admin';
    roleTeam.required = role === 'team_captain' || role === 'team_player';
    const options = orgTeams.filter((team) => !roleClub.value || team.club_slug === roleClub.value);
    const current = roleTeam.value;
    roleTeam.replaceChildren(new Option('Choose a team', ''));
    for (const team of options) {
      const division = team.division ? ` — ${team.division}` : '';
      roleTeam.append(new Option(`${team.name}${division}`, String(team.id)));
    }
    if (options.some((team) => String(team.id) === current)) roleTeam.value = current;
  };

  roleLevel.addEventListener('change', showRoleFields);
  roleClub.addEventListener('change', showRoleFields);

  root.querySelector<HTMLFormElement>('[data-form="role"]')!.addEventListener('submit', async (event) => {
    event.preventDefault();
    const role = roleLevel.value as Membership['role'];
    const row: { profile_id: string; role: Membership['role']; club_slug?: string; team_id?: number } = {
      profile_id: rolePerson.value,
      role,
    };
    if (role === 'club_captain') row.club_slug = roleClub.value;
    if (role === 'team_captain' || role === 'team_player') row.team_id = Number(roleTeam.value);
    setStatus('Saving role…');
    const { error } = await supabase.from('memberships').insert(row);
    if (error) {
      setStatus(error.code === '23505' ? 'That person already has this role.' : error.message);
      return;
    }
    setStatus('Role saved.');
    await showSession();
  });

  rolesHost.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-role]');
    if (!button) return;
    const { error } = await supabase.from('memberships').delete().eq('id', Number(button.dataset.removeRole));
    if (error) {
      setStatus(error.message);
      return;
    }
    setStatus('Role removed.');
    await showSession();
  });

  root.querySelector('[data-sign-out]')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    await showSession();
  });

  const blank = (value: FormDataEntryValue | null) => {
    const text = String(value ?? '').trim();
    return text ? text : null;
  };

  const SEASON = 'Winter 2026/27';

  const slugify = (name: string) =>
    name
      .toLowerCase()
      .replace(/&/g, ' and ')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');

  const playerCount = async (squadId: number) => {
    const { count, error } = await supabase
      .from('squad_players')
      .select('id', { count: 'exact', head: true })
      .eq('squad_id', squadId);
    if (error) throw error;
    return count ?? 0;
  };

  newClubForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const slug = slugify(name);
    if (!slug) {
      setStatus('Give the club a name with letters or numbers.');
      return;
    }
    if (clubs.some((club) => club.slug === slug)) {
      setStatus(`${name} is already listed.`);
      return;
    }
    setStatus('Adding club…');
    const { error } = await supabase.from('clubs').insert({
      slug,
      name,
      contact_name: blank(data.get('contact_name')),
      contact_email: blank(data.get('contact_email'))?.toLowerCase() ?? null,
    });
    if (error) {
      setStatus(error.code === '23505' ? `${name} is already listed.` : error.message);
      return;
    }
    form.reset();
    setStatus(`${name} added.`);
    currentClub = slug;
    await showSession();
  });

  teamsHost.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const removeClub = target.closest<HTMLButtonElement>('[data-remove-club]');
    if (removeClub) {
      const club = clubs.find((item) => item.slug === removeClub.dataset.removeClub);
      if (!club) return;
      const teamCount = orgTeams.filter((team) => team.club_slug === club.slug).length;
      const teamNote = teamCount ? ` Its ${teamCount} team${teamCount === 1 ? '' : 's'}, their captains, players and roles go too.` : '';
      if (!window.confirm(`Remove ${club.name}?${teamNote}`)) return;
      setStatus('Removing club…');
      const { error } = await supabase.from('clubs').delete().eq('slug', club.slug);
      setStatus(error ? error.message : `${club.name} removed.`);
      if (!error) await showSession();
      return;
    }
    const removeTeam = target.closest<HTMLButtonElement>('[data-remove-team]');
    if (removeTeam) {
      const team = orgTeams.find((item) => item.id === Number(removeTeam.dataset.removeTeam));
      if (!team) return;
      const squad = squads.find((item) => item.team_id === team.id);
      let players = 0;
      if (squad) {
        try {
          players = await playerCount(squad.id);
        } catch (error) {
          setStatus((error as Error).message);
          return;
        }
      }
      const note = players ? ` Its ${players} player${players === 1 ? '' : 's'} and any roles go too.` : ' Any roles on it go too.';
      if (!window.confirm(`Remove ${team.name}?${note}`)) return;
      setStatus('Removing team…');
      const { error } = await supabase.from('teams').delete().eq('id', team.id);
      setStatus(error ? error.message : `${team.name} removed.`);
      if (!error) await showSession();
    }
  });

  teamsHost.addEventListener('submit', async (event) => {
    const form = event.target as HTMLFormElement;
    event.preventDefault();
    if (form.matches('[data-form="new-team"]')) {
      const club = clubs.find((item) => item.slug === form.dataset.club);
      if (!club) return;
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = blank(data.get('captain_email'))?.toLowerCase() ?? null;
      setStatus('Adding team…');
      const { data: inserted, error } = await supabase
        .from('teams')
        .insert({
          club_slug: club.slug,
          name,
          division: blank(data.get('division')),
          captain_email: email,
          last_season: SEASON,
        })
        .select('id')
        .single();
      if (error) {
        setStatus(error.code === '23505' ? `${club.name} already has a team called ${name}.` : error.message);
        return;
      }
      if (email && inserted) {
        const { error: squadError } = await supabase
          .from('captain_squads')
          .insert({ name, captain_email: email, team_id: inserted.id });
        if (squadError) {
          setStatus(friendly(squadError));
          return;
        }
      }
      form.reset();
      setStatus(`${name} added. Nothing was sent.`);
      await showSession();
      return;
    }
    if (form.matches('[data-form="club-contact"]')) {
      const club = clubs.find((item) => item.slug === form.dataset.club);
      if (!club) return;
      const data = new FormData(form);
      const contactEmail = blank(data.get('contact_email'))?.toLowerCase() ?? null;
      setStatus('Saving club contact…');
      const { error } = await supabase
        .from('clubs')
        .update({ contact_name: blank(data.get('contact_name')), contact_email: contactEmail })
        .eq('slug', club.slug);
      setStatus(error ? error.message : 'Club contact saved. Nothing was sent.');
      if (!error) await showSession();
      return;
    }
    if (!form.matches('[data-form="captain-email"]')) return;
    const team = orgTeams.find((item) => item.id === Number(form.dataset.teamId));
    if (!team) return;
    const email = blank(new FormData(form).get('captain_email'))?.toLowerCase() ?? null;
    const existing = squads.find((squad) => squad.team_id === team.id);
    if (!email && existing) {
      try {
        if (await playerCount(existing.id)) {
          setStatus(`${team.name} already has players, so the captain email was left in place.`);
          return;
        }
      } catch (error) {
        setStatus((error as Error).message);
        return;
      }
    }
    setStatus('Saving team captain…');
    const { error: teamError } = await supabase.from('teams').update({ captain_email: email }).eq('id', team.id);
    if (teamError) {
      setStatus(teamError.message);
      return;
    }
    if (email) {
      const { error } = existing
        ? await supabase.from('captain_squads').update({ captain_email: email, name: team.name }).eq('id', existing.id)
        : await supabase.from('captain_squads').insert({
            name: team.name,
            captain_email: email,
            leaguemaster_team_id: team.leaguemaster_team_id,
            team_id: team.id,
          });
      if (error) {
        setStatus(friendly(error));
        return;
      }
    } else if (existing) {
      const { error } = await supabase.from('captain_squads').delete().eq('id', existing.id);
      if (error) {
        setStatus(error.message);
        return;
      }
    }
    setStatus('Team captain saved. Nothing was sent.');
    await showSession();
  });

  function matchedName(squad: Squad) {
    const profile = Array.isArray(squad.profiles) ? squad.profiles[0] : squad.profiles;
    return profile?.display_name ?? null;
  }

  async function showSession() {
    const { data } = await supabase.auth.getSession();
    const session = data.session;
    signedOut.hidden = Boolean(session);
    signedIn.hidden = !session;
    if (!session) {
      adminPanel.hidden = true;
      denied.hidden = true;
      return;
    }

    const { data: me, error: meError } = await supabase
      .from('profiles')
      .select('display_name, is_admin')
      .eq('id', session.user.id)
      .maybeSingle();
    if (meError) {
      setStatus(meError.message);
      return;
    }
    const label = me?.display_name || session.user.email;
    root.querySelector('[data-who]')!.textContent = `Signed in as ${label}`;
    const allowed = Boolean(me?.is_admin);
    adminPanel.hidden = !allowed;
    denied.hidden = allowed;
    if (!allowed) return;

    const [
      { data: squadRows, error: squadError },
      { data: people, error: peopleError },
      { data: clubRows, error: clubError },
      { data: orgRows, error: orgError },
      { data: roleRows, error: roleError },
    ] = await Promise.all([
      supabase
        .from('captain_squads')
        .select('id, name, captain_email, captain_id, leaguemaster_team_id, team_id, profiles(display_name)')
        .order('name', { ascending: true }),
      supabase.from('profiles').select('id, display_name, email, is_admin').order('display_name', { ascending: true }),
      supabase.from('clubs').select('slug, name, contact_name, contact_email').order('name', { ascending: true }),
      supabase.from('teams').select('id, club_slug, name, division, leaguemaster_team_id, captain_email, last_season').order('name', { ascending: true }),
      supabase.from('memberships').select('id, role, club_slug, team_id, profiles(display_name, email), teams(name, division)').order('role', { ascending: true }),
    ]);
    if (squadError || peopleError || clubError || orgError || roleError) {
      setStatus(squadError?.message || peopleError?.message || clubError?.message || orgError?.message || roleError?.message || 'Could not load teams.');
      return;
    }

    clubs = (clubRows ?? []) as Club[];
    orgTeams = (orgRows ?? []) as OrgTeam[];
    squads = (squadRows ?? []) as Squad[];
    const teamRows = squads;
    const accounts = (people ?? []) as Person[];
    const memberships = (roleRows ?? []) as Membership[];
    const winterTeams = orgTeams.filter((team) => team.last_season === SEASON);

    const accountName = (email: string | null) => {
      if (!email) return '';
      const account = accounts.find((person) => person.email?.toLowerCase() === email.toLowerCase());
      return account?.display_name || '';
    };

    const dash = '—';
    const contactLine = (club: Club) =>
      [club.contact_name, club.contact_email].filter(Boolean).join(' · ') || dash;
    const clubLink = (club: Club) =>
      `<button class="link-button" type="button" data-open-club="${escapeHtml(club.slug)}">${escapeHtml(club.name)}</button>`;
    const groups = clubs.map((club) => {
      const clubTeams = winterTeams
        .filter((team) => team.club_slug === club.slug)
        .sort((a, b) => (a.division ?? '').localeCompare(b.division ?? '') || a.name.localeCompare(b.name));
      const rows =
        clubTeams.length === 0
          ? `<tr><td>${clubLink(club)}</td><td>${escapeHtml(contactLine(club))}</td><td class="col-team">${dash}</td><td class="col-division">${dash}</td><td>${dash}</td></tr>`
          : clubTeams
              .map((team, index) => {
                const lead =
                  index === 0
                    ? `<td rowspan="${clubTeams.length}">${clubLink(club)}</td><td rowspan="${clubTeams.length}">${escapeHtml(contactLine(club))}</td>`
                    : '';
                return `<tr>${lead}<td class="col-team">${escapeHtml(team.name)}</td><td class="col-division">${escapeHtml(team.division || dash)}</td><td>${escapeHtml(team.captain_email || dash)}</td></tr>`;
              })
              .join('');
      return rows.replace('<tr>', '<tr class="club-start">');
    });
    overviewHost.innerHTML = groups.join('') || `<tr><td colspan="5">No clubs yet.</td></tr>`;
    const pickButton = (slug: string, label: string) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.pickClub = slug;
      button.textContent = label;
      return button;
    };
    clubMenu.replaceChildren(
      ...clubs.map((club) => pickButton(club.slug, club.name)),
      pickButton('new', '+ Add a club'),
    );

    teamsHost.replaceChildren(
      ...clubs.map((club) => {
        const clubTeams = winterTeams
          .filter((team) => team.club_slug === club.slug)
          .sort((a, b) => (a.division ?? '').localeCompare(b.division ?? '') || a.name.localeCompare(b.name));
        const contactWho = accountName(club.contact_email);
        const contactState = !club.contact_email
          ? 'No club contact yet'
          : contactWho
            ? `Matched to ${contactWho}`
            : 'Saved. This address has not registered yet';
        const teamForms = clubTeams.length
          ? clubTeams.map((team) => {
              const squad = squads.find((item) => item.team_id === team.id);
              const who = squad ? matchedName(squad) : accountName(team.captain_email);
              const state = !team.captain_email
                ? 'No captain email yet'
                : who
                  ? `Matched to ${who}`
                  : 'Saved. This address has not registered yet';
              return `
                <form class="team-form stack" data-form="captain-email" data-team-id="${team.id}">
                  <h4>${escapeHtml(team.name)}</h4>
                  <p class="${who ? 'matched' : 'waiting'}">${escapeHtml(state)}${team.division ? ` · ${escapeHtml(team.division)}` : ''}</p>
                  <label>
                    Team captain email
                    <input type="email" name="captain_email" autocomplete="off" value="${escapeHtml(team.captain_email ?? '')}" />
                  </label>
                  <div class="actions">
                    <button class="btn btn--sm" type="submit">Save team captain</button>
                    <button class="btn btn--ghost btn--sm" type="button" data-remove-team="${team.id}">Remove team</button>
                  </div>
                </form>`;
            }).join('')
          : '<p class="muted small">No team in the winter league.</p>';
        const newTeam = `
          <form class="team-form stack" data-form="new-team" data-club="${escapeHtml(club.slug)}">
            <h4>Add a team</h4>
            <label>Team name <input name="name" required minlength="2" maxlength="80" autocomplete="off" placeholder="${escapeHtml(club.name)} ${clubTeams.length + 1}" /></label>
            <label>
              Division
              <select name="division">
                <option value="">Not set</option>
                <option>Division 1</option>
                <option>Division 2</option>
              </select>
            </label>
            <label>Team captain email <input type="email" name="captain_email" autocomplete="off" /></label>
            <div class="actions">
              <button class="btn btn--sm" type="submit">Add team</button>
            </div>
          </form>`;
        const card = document.createElement('article');
        card.className = 'card club';
        card.dataset.clubCard = club.slug;
        card.innerHTML = `
          <div class="card__body stack">
            <div class="club__head">
              <h3>${escapeHtml(club.name)}</h3>
              <button class="btn btn--ghost btn--sm" type="button" data-remove-club="${escapeHtml(club.slug)}">Remove club</button>
            </div>
            <form class="stack" data-form="club-contact" data-club="${escapeHtml(club.slug)}">
              <h4>Club contact</h4>
              <p class="${contactWho ? 'matched' : 'waiting'}">${escapeHtml(contactState)}</p>
              <label>
                Name
                <input name="contact_name" autocomplete="off" value="${escapeHtml(club.contact_name ?? '')}" />
              </label>
              <label>
                Email
                <input type="email" name="contact_email" autocomplete="off" value="${escapeHtml(club.contact_email ?? '')}" />
              </label>
              <div class="actions">
                <button class="btn btn--sm" type="submit">Save club contact</button>
              </div>
            </form>
            <h4>Team captains</h4>
            ${teamForms}
            ${newTeam}
          </div>`;
        return card;
      }),
    );

    if (currentClub !== 'new' && !clubs.some((club) => club.slug === currentClub)) currentClub = clubs[0]?.slug ?? 'new';
    showClub(currentClub);

    peopleHost.replaceChildren(
      ...accounts.map((person) => {
        const item = document.createElement('li');
        const email = person.email?.toLowerCase() ?? '';
        const teams = teamRows.filter((squad) => squad.captain_email === email).map((squad) => squad.name);
        const teamText = teams.length ? teams.join(', ') : 'No team yet';
        item.innerHTML =
          `<strong>${escapeHtml(person.display_name || 'Unnamed')}</strong>` +
          `${person.is_admin ? ' <span class="pill">Admin</span>' : ''}` +
          `<span class="muted"> ${escapeHtml(person.email || 'No email')}</span>` +
          `<span class="muted"> — ${escapeHtml(teamText)}</span>`;
        return item;
      }),
    );

    const chosenPerson = rolePerson.value;
    rolePerson.replaceChildren(new Option('Choose an account', ''));
    for (const person of accounts) {
      rolePerson.append(new Option(person.display_name || person.email || 'Unnamed', person.id));
    }
    if (accounts.some((person) => person.id === chosenPerson)) rolePerson.value = chosenPerson;

    const chosenClub = roleClub.value;
    roleClub.replaceChildren(new Option('Choose a club', ''));
    for (const club of clubs) roleClub.append(new Option(club.name, club.slug));
    if (clubs.some((club) => club.slug === chosenClub)) roleClub.value = chosenClub;
    showRoleFields();

    const one = (value: { display_name?: string; email?: string | null; name?: string; division?: string | null } | { display_name?: string; email?: string | null; name?: string; division?: string | null }[] | null) =>
      Array.isArray(value) ? value[0] : value;
    rolesHost.replaceChildren(
      ...memberships.map((membership) => {
        const person = one(membership.profiles);
        const team = one(membership.teams);
        const club = clubs.find((item) => item.slug === membership.club_slug);
        const where = team ? `${team.name}${team.division ? `, ${team.division}` : ''}` : club?.name ?? 'All clubs';
        const item = document.createElement('li');
        item.innerHTML =
          `<strong>${escapeHtml(roleLabel[membership.role])}</strong>` +
          `<span class="muted"> ${escapeHtml(person?.display_name || person?.email || 'Unknown')}</span>` +
          `<span class="muted"> — ${escapeHtml(where)}</span>` +
          ` <button class="btn btn--ghost btn--sm" type="button" data-remove-role="${membership.id}">Remove</button>`;
        return item;
      }),
    );
  }

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
  }

  const startTab = location.hash.slice(1) as Tab;
  showTab(tabs.includes(startTab) ? startTab : 'overview');
  showSession();
</script>

