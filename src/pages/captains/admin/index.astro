  type JuniorDrawMember = { age: string; section: string };
  type JuniorDrawPlan = { format: 'knockout' | 'round_robin'; court: string; start: string; members: JuniorDrawMember[] };
  let juniorDrawKey = '';
  let juniorDrawPublished = false;
  let juniorDrawPlans: JuniorDrawPlan[] = [];
  const memberKey = (member: JuniorDrawMember) => `${member.age}|${member.section}`;
  function planFor(age: string, section: string): JuniorDrawPlan {
    return (
      juniorDrawPlans.find((plan) => plan.members.some((member) => member.age === age && member.section === section)) ?? {
        format: 'knockout',
        court: '',
