  }
  function roleMenuChoices() {
    return groupCatalogLive
      .filter((group) => group.slug === 'admins' || !group.managed || LOCKED_ROLE_SLUGS.has(group.slug))
      .slice()
      .sort((a, b) => a.position - b.position);
  }
  function paintRolePop(card: MemberCard) {
    rolePopWho.textContent = card.name;
    rolePopOptions.innerHTML = roleMenuChoices()
      .map((group) => {
        const role = roleCatalogLive.find((item) => item.slug === group.role_slug)?.name ?? group.name;
        const checked = group.slug === 'admins' ? card.isAdmin || card.groupSlugs.includes('admins') : card.groupSlugs.includes(group.slug);
        const locked = LOCKED_ROLE_SLUGS.has(group.slug) || (group.slug === 'admins' && (!card.profileId || card.protectedAccount || card.profileId === viewerId));
        return `<label class="${locked ? 'is-locked' : ''}"><input type="checkbox" data-role-slug="${escapeHtml(group.slug)}" ${checked ? 'checked' : ''} ${locked ? 'disabled' : ''} /> ${roleMark(group.role_slug, role)}</label>`;
      })
      .join('');
  }
  function placeRolePop(anchor: HTMLElement) {
    rolePop.hidden = false;
    rolePop.style.maxHeight = '';
    rolePop.style.overflow = '';
    const rect = anchor.getBoundingClientRect();
    const width = rolePop.offsetWidth || 220;
    const height = rolePop.offsetHeight;
    const left = Math.max(8, Math.min(rect.left, window.innerWidth - width - 8));
    const fitsBelow = rect.bottom + 6 + height <= window.innerHeight - 8;
    rolePop.style.left = `${left}px`;
    rolePop.style.top = fitsBelow ? `${rect.bottom + 6}px` : `${Math.max(8, rect.top - 6 - height)}px`;
    const box = rolePop.getBoundingClientRect();
    if (box.bottom > window.innerHeight - 8 || box.top < 8) {
      rolePop.style.top = '8px';
      rolePop.style.maxHeight = `${window.innerHeight - 16}px`;
      rolePop.style.overflow = 'auto';
    }
  }
  async function closeRolePop() {
    if (rolePop.hidden) return;
    const key = openRoleKey;
    const wanted = new Set([...rolePopOptions.querySelectorAll<HTMLInputElement>('[data-role-slug]:checked')].map((box) => box.dataset.roleSlug ?? ''));
    const dirty = rolePopDirty;
    rolePop.hidden = true;
    openRoleKey = '';
    rolePopDirty = false;
    if (dirty && key) await saveRoleChoice(key, wanted);
  }
  async function saveRoleChoice(key: string, wanted: Set<string>) {
    const card = memberCards.find((item) => item.key === key);
    if (!card || !viewerIsAdmin) return;
    setStatus('Saving roles…');
    for (const group of websiteRoleChoices()) {
      const slug = group.slug;
      const want = wanted.has(slug);
      if (slug === 'admins') {
        const has = card.isAdmin || card.groupSlugs.includes('admins');
        if (want === has) continue;
        if (!card.profileId) {
          setStatus(`Set a password for ${card.name} before adding Admin.`);
          return;
        }
        if (!want && (card.protectedAccount || card.profileId === viewerId)) {
          setStatus('That admin access stays as it is.');
          return;
        }
        const message = await callManageAccounts(supabase, { action: 'set-admin', user_id: card.profileId, is_admin: want });
        if (message) {
          setStatus(message);
          return;
        }
        continue;
      }
      if (want === card.groupSlugs.includes(slug)) continue;
      const message = await callManageAccounts(
        supabase,
        card.profileId
          ? { action: 'set-group', user_id: card.profileId, person_name: card.name, group_slug: slug, member: want }
          : { action: 'set-group', person_name: card.name, group_slug: slug, member: want },
      );
      if (message) {
        setStatus(message);
        return;
      }
    }
    setStatus(`Roles saved for ${card.name}.`);
    await showSession();
  }
  const looseKey = (value: string) =>
    value
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();

  const slChart = (points: SlRating[]) => {
    if (points.length < 2) return '';
    const width = 640;
    const height = 220;
    const pad = { l: 56, r: 16, t: 16, b: 36 };
    const levels = points.map((point) => point.level);
    let min = Math.min(...levels);
    let max = Math.max(...levels);
    if (min === max) {
      min -= 50;
      max += 50;
    }
    const padY = (max - min) * 0.08;
    min -= padY;
    max += padY;
    const innerW = width - pad.l - pad.r;
    const innerH = height - pad.t - pad.b;
    const xAt = (index: number) => pad.l + (index / (points.length - 1)) * innerW;
    const yAt = (level: number) => pad.t + ((max - level) / (max - min)) * innerH;
    const line = points.map((point, index) => `${index === 0 ? 'M' : 'L'}${xAt(index).toFixed(1)},${yAt(point.level).toFixed(1)}`).join(' ');
    const yTicks = [max, (max + min) / 2, min];
    const xTicks = [0, Math.floor((points.length - 1) / 2), points.length - 1];
    const dateLabel = (iso: string) => formatDay(iso);
    const anchor = (index: number) => (index === 0 ? 'start' : index === points.length - 1 ? 'end' : 'middle');
    return `<div class="sl-chart"><svg viewBox="0 0 ${width} ${height}" role="img" aria-label="Level after each match">
      ${yTicks
        .map((tick) => {
          const y = yAt(tick);
          return `<line x1="${pad.l}" y1="${y.toFixed(1)}" x2="${width - pad.r}" y2="${y.toFixed(1)}" stroke="#c5d6e8" stroke-opacity="0.25" /><text x="${pad.l - 8}" y="${(y + 4).toFixed(1)}" text-anchor="end" fill="#c5d6e8" font-size="12">${levelText(Math.round(tick))}</text>`;
        })
        .join('')}
      <path d="${line}" fill="none" stroke="#f2b705" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
      ${xTicks.map((index) => `<text x="${xAt(index).toFixed(1)}" y="${height - 10}" text-anchor="${anchor(index)}" fill="#c5d6e8" font-size="12">${dateLabel(points[index].recorded_on)}</text>`).join('')}
    </svg><p class="muted small">Level after each match.</p></div>`;
  };

  const isSelf = (account: Account, name: string, email: string | null) => {
    const mine = account.email.trim().toLowerCase();
    const theirs = (email ?? '').trim().toLowerCase();
    if (mine && theirs && mine === theirs) return true;
    const left = account.displayName.trim().toLowerCase();
    return Boolean(left) && left === name.trim().toLowerCase();
  };

  let slCatalog: SlPlayer[] = [];
  let slLinks: { id: number; lm_player_name: string | null; squashlevels_player_id: number | null }[] = [];
  let slByName = new Map<string, SlPlayer>();
  let slByLoose = new Map<string, SlPlayer>();

  const allSlPlayers = async () => {
    const rows: SlPlayer[] = [];
    for (let from = 0; ; from += 1000) {
      const { data, error } = await supabase
        .from('squashlevels_players')
        .select('id, display_name, current_level, updated_at')
        .order('id', { ascending: true })
        .range(from, from + 999);
      if (error) return { data: null as SlPlayer[] | null, error };
      const page = (data ?? []) as SlPlayer[];
      rows.push(...page);
      if (page.length < 1000) return { data: rows, error: null };
    }
  };

  const allSlNames = async () => {
    const rows: { name_key: string; player_id: number | null }[] = [];
    for (let from = 0; ; from += 1000) {
      const { data, error } = await supabase
        .from('squashlevels_names')
        .select('name_key, player_id')
        .eq('status', 'matched')
        .order('name_key', { ascending: true })
        .range(from, from + 999);
      if (error) return { data: null as { name_key: string; player_id: number | null }[] | null, error };
      const page = (data ?? []) as { name_key: string; player_id: number | null }[];
      rows.push(...page);
      if (page.length < 1000) return { data: rows, error: null };
    }
  };

  const slMatch = (lmName: string) => {
    const linkedTo = (player: SlPlayer | null | undefined) => {
      if (!player) return { player: null as SlPlayer | null, linked: false };
      return { player, linked: nameKey(player.display_name) !== nameKey(lmName) };
    };
    const link = slLinks.find((item) => item.lm_player_name && nameKey(item.lm_player_name) === nameKey(lmName) && item.squashlevels_player_id != null);
    if (link) return linkedTo(slCatalog.find((player) => player.id === link.squashlevels_player_id));
    const exact = slCatalog.find((player) => nameKey(player.display_name) === nameKey(lmName)) ?? slByName.get(nameKey(lmName));
    if (exact) return { player: exact, linked: false };
    return linkedTo(slByLoose.get(looseKey(lmName)));
  };

  const siteTable = (rows: SiteRow[], fields: 'all' | 'open' | 'none', showTeam: boolean) => {
    const box = (row: SiteRow, field: 'email' | 'es' | 'phone', value: string, label: string, type: string) => {
      const emailField = field === 'email';
      return `<input data-squad-field="${field}" data-squad-email="${row.playerId || ''}" data-team-id="${row.teamId ?? ''}" data-team-name="${escapeHtml(row.team)}" data-player-name="${escapeHtml(row.name)}" data-saved="${escapeHtml(value)}" name="${contactFieldName(`${row.teamId ?? ''}:${row.playerId || row.name}:${field}`)}" aria-label="${label} for ${escapeHtml(row.name)}" type="${emailField ? 'text' : type}" value="${escapeHtml(value)}" autocomplete="${emailField ? 'one-time-code' : 'off'}"${emailField ? ' inputmode="email" autocapitalize="none" spellcheck="false"' : ''} />`;
    };
    const body = rows
      .map((row) => {
        const detailsOpen = fields === 'all' || fields === 'open';
        const emailOpen = fields === 'all' || (fields === 'open' && !row.locked);
        const emailCell = row.emailLocked || !emailOpen ? escapeHtml(row.email || '—') : box(row, 'email', row.email, 'Email', 'email');
        const esCell = detailsOpen ? box(row, 'es', row.es, 'ES number', 'text') : escapeHtml(row.es || '—');
        const phoneCell = detailsOpen ? box(row, 'phone', row.phone, 'Phone', 'tel') : escapeHtml(row.phone || '—');
        const teamCell = showTeam ? `<td>${escapeHtml(row.team)}</td>` : '';
        const matched = slMatch(row.name);
        const slName = matched.player
          ? `${escapeHtml(matched.player.display_name)}${matched.linked ? ' <span class="pill">Linked</span>' : ''}`
          : '—';
        const slLevel = matched.player ? levelText(matched.player.current_level) : '—';
        return `<tr>${teamCell}<td>${escapeHtml(row.name)}</td><td>${slName}</td><td data-sl-level>${slLevel}</td><td>${emailCell}</td><td>${esCell}</td><td>${phoneCell}</td></tr>`;
      })
      .join('');
    const teamHead = showTeam ? '<th>Team</th>' : '';
    return `<div class="overview-box"><table class="overview"><thead><tr>${teamHead}<th>LM name</th><th>SL name</th><th>SL level</th><th>Email</th><th>ES number</th><th>Phone</th></tr></thead><tbody>${body}</tbody></table></div>`;
  };

  async function loadWebsite(account: Account) {
    const [{ data: mineRows }, { data: clubRows }, { data: teamRows }, { data: squadRows }, { data: nomRows }, contactResult, { data: slRows }, linkResult, profileResult, roleMembershipResult, nameResult] = await Promise.all([
      supabase.from('memberships').select('role, club_slug, team_id').eq('profile_id', account.userId),
      supabase.from('clubs').select('slug, name, contact_name, contact_email').order('name', { ascending: true }),
      supabase.from('teams').select('id, club_slug, name, division, captain_name, captain_email').order('name', { ascending: true }),
      supabase.from('captain_squads').select('id, name, team_id, squad_players(id, display_name, email, england_squash_id, phone)'),
      supabase.from('nominations').select('team_id, player_name, season').eq('season', SEASON),
      supabase.from('lm_player_contacts').select('team_id, player_name, email'),
      allSlPlayers(),
      supabase.from('player_links').select('id, profile_id, squashlevels_player_id, lm_player_name'),
      supabase.from('profiles').select('id, email, is_admin, display_name'),
      supabase.from('memberships').select('profile_id, role, club_slug, team_id'),
      allSlNames(),
    ]);
    const mine = (mineRows ?? []) as Mine[];
    const clubList = (clubRows ?? []) as { slug: string; name: string; contact_name: string | null; contact_email: string | null }[];
    const teamList = (teamRows ?? []) as {
      id: number;
      club_slug: string;
      name: string;
      division: string | null;
      captain_name: string | null;
      captain_email: string | null;
    }[];
    const squads = (squadRows ?? []) as SiteSquad[];
    const nominations = (nomRows ?? []) as { team_id: number; player_name: string }[];
    websitePlayers = [];
    personContacts = [];
    const slPlayers = (slRows ?? []) as SlPlayer[];
    slCatalog = slPlayers;
    slByName = new Map();
    slByLoose = new Map();
    for (const player of slPlayers) {
      const key = nameKey(player.display_name);
      if (!slByName.has(key)) slByName.set(key, player);
    }
    for (const stored of (nameResult.error ? [] : (nameResult.data ?? [])) as { name_key: string; player_id: number | null }[]) {
      if (stored.player_id == null || slByLoose.has(stored.name_key)) continue;
      const player = slPlayers.find((item) => item.id === stored.player_id);
      if (player) slByLoose.set(stored.name_key, player);
    }
    type PlayerLink = { id: number; profile_id: string | null; squashlevels_player_id: number | null; lm_player_name: string | null };
    const playerLinks = (linkResult.error ? [] : (linkResult.data ?? [])) as PlayerLink[];
    slLinks = playerLinks;
    type SiteProfile = { id: string; email: string | null; is_admin: boolean | null; display_name: string | null };
    const siteProfiles = (profileResult.error ? [] : (profileResult.data ?? [])) as SiteProfile[];
    type RoleMembership = { profile_id: string; role: string; club_slug: string | null; team_id: number | null };
    const roleMemberships = (roleMembershipResult.error ? [] : (roleMembershipResult.data ?? [])) as RoleMembership[];
    const emailToProfile = new Map<string, string>();
    for (const row of siteProfiles) {
      const email = (row.email ?? '').trim().toLowerCase();
      if (email) emailToProfile.set(email, row.id);
    }
    const levelFromLink = (link: PlayerLink | undefined) =>
      link?.squashlevels_player_id != null ? slPlayers.find((player) => player.id === link.squashlevels_player_id) : undefined;
    const levelFor = (row: SiteRow) => {
      const byLm = levelFromLink(playerLinks.find((link) => link.lm_player_name && nameKey(link.lm_player_name) === nameKey(row.name)));
      if (byLm) return byLm;
      const profileId = row.email ? emailToProfile.get(row.email.trim().toLowerCase()) : undefined;
      const byAccount = levelFromLink(playerLinks.find((link) => profileId && link.profile_id === profileId));
      if (byAccount) return byAccount;
      return slByName.get(nameKey(row.name)) ?? slByLoose.get(looseKey(row.name));
    };
    const clubBySlug = new Map(clubList.map((club) => [club.slug, club]));
    const teamById = new Map(teamList.map((team) => [team.id, team]));
    const sameText = (left: string, right: string | null) => {
      const theirs = nameKey(right ?? '');
      return Boolean(theirs) && nameKey(left) === theirs;
    };
    const lockedFromLm = (name: string, email: string, clubSlug: string, teamId: number | null) => {
      const club = clubBySlug.get(clubSlug);
      const team = teamId != null ? teamById.get(teamId) : undefined;
      const address = email.trim().toLowerCase();
      const clubEmail = (club?.contact_email ?? '').trim().toLowerCase();
      const captainEmail = (team?.captain_email ?? '').trim().toLowerCase();
      if (club && (sameText(name, club.contact_name) || (address && address === clubEmail))) return true;
      if (team && (sameText(name, team.captain_name) || (address && address === captainEmail))) return true;
      return false;
    };
    const profileFor = (name: string, email: string) => {
      const address = email.trim().toLowerCase();
      const byEmail = address ? siteProfiles.find((profile) => (profile.email ?? '').trim().toLowerCase() === address) : undefined;
      if (byEmail) return byEmail;
      const link = playerLinks.find((item) => item.profile_id && item.lm_player_name && nameKey(item.lm_player_name) === nameKey(name));
      return link?.profile_id ? siteProfiles.find((profile) => profile.id === link.profile_id) : undefined;
    };
    const roleFor = (name: string, email: string) => {
      const address = email.trim().toLowerCase();
      const profile = profileFor(name, email);
      const held = profile ? roleMemberships.filter((membership) => membership.profile_id === profile.id) : [];
      const codes: string[] = [];
      if (profile?.is_admin || (account.isAdmin && isSelf(account, name, email))) codes.push('A');
      const clubCaptain =
        held.some((membership) => membership.role === 'club_captain') ||
        clubList.some((club) => {
          const clubEmail = (club.contact_email ?? '').trim().toLowerCase();
          return sameText(name, club.contact_name) || Boolean(address && clubEmail && address === clubEmail);
        });
      if (clubCaptain) codes.push('C');
      const teamCaptain =
        held.some((membership) => membership.role === 'team_captain') ||
        teamList.some((team) => {
          const captainEmail = (team.captain_email ?? '').trim().toLowerCase();
          return sameText(name, team.captain_name) || Boolean(address && captainEmail && address === captainEmail);
        });
      if (teamCaptain) codes.push('T');
      codes.push('P');
      return codes.join(';');
    };
    const clubSlugs = new Set(mine.filter((row) => row.role === 'club_captain' && row.club_slug).map((row) => row.club_slug as string));
    const teamIds = new Set(mine.filter((row) => row.team_id != null).map((row) => row.team_id as number));
    const homeClubSlugs = new Set<string>(clubSlugs);
    for (const id of teamIds) {
      const team = teamById.get(id);
      if (team) homeClubSlugs.add(team.club_slug);
    }
    const hasClubRole = account.isAdmin || mine.some((row) => row.role === 'club_captain');
    const hasTeamRole = mine.some((row) => row.role === 'team_captain');
    const seesLeague = account.isAdmin || account.email.trim().toLowerCase() === 'county-admin@players.invalid';
    const rows: SiteRow[] = [];
    for (const squad of squads) {
      const team = squad.team_id != null ? teamById.get(squad.team_id) : undefined;
      const clubSlug = team?.club_slug ?? '';
      const club = clubBySlug.get(clubSlug);
      const teamLabel = team ? (team.division ? `${team.name} · ${team.division}` : team.name) : squad.name;
      for (const player of squad.squad_players ?? []) {
        personContacts.push({
          playerId: player.id,
          teamId: squad.team_id,
          name: player.display_name,
          email: player.email ?? '',
          es: player.england_squash_id ?? '',
          phone: player.phone ?? '',
        });
        if (squad.team_id != null) {
          websitePlayers.push({
            teamId: squad.team_id,
            name: player.display_name,
            email: player.email ?? '',
            playerId: player.id,
          });
        }
        rows.push({
          playerId: player.id,
          teamId: squad.team_id,
          clubSlug,
          club: club?.name ?? squad.name,
          team: teamLabel,
          name: player.display_name,
          email: player.email ?? '',
          es: player.england_squash_id ?? '',
          phone: player.phone ?? '',
          locked: lockedFromLm(player.display_name, player.email ?? '', clubSlug, squad.team_id),
          emailLocked: false,
          role: roleFor(player.display_name, player.email ?? ''),
        });
      }
    }
    const listed = new Set(rows.map((row) => `${row.teamId ?? ''}:${row.name.toLowerCase()}`));
    for (const nom of nominations) {
      const key = `${nom.team_id}:${nom.player_name.toLowerCase()}`;
      if (listed.has(key)) continue;
      listed.add(key);
      const team = teamById.get(nom.team_id);
      const club = team ? clubBySlug.get(team.club_slug) : undefined;
      rows.push({
        playerId: 0,
        teamId: nom.team_id,
        clubSlug: team?.club_slug ?? '',
        club: club?.name ?? 'Club',
        team: team ? (team.division ? `${team.name} · ${team.division}` : team.name) : 'Team',
        name: nom.player_name,
        email: '',
        es: '',
        phone: '',
        locked: lockedFromLm(nom.player_name, '', team?.club_slug ?? '', nom.team_id),
        emailLocked: false,
        role: roleFor(nom.player_name, ''),
      });
    }
    rows.sort((a, b) => a.club.localeCompare(b.club, 'en') || a.team.localeCompare(b.team, 'en') || a.name.localeCompare(b.name, 'en'));
    const visible = (row: SiteRow) => {
      if (seesLeague) return true;
      const onTeam = row.teamId != null && teamIds.has(row.teamId);
      const onClub = clubSlugs.has(row.clubSlug);
      if (account.playerOnly) return isSelf(account, row.name, row.email) && (onTeam || homeClubSlugs.has(row.clubSlug));
      return onClub || onTeam;
    };
    const clubRowsScoped = rows.filter((row) => visible(row));
    const teamRowsScoped = clubRowsScoped.filter((row) => seesLeague || hasClubRole || (row.teamId != null && teamIds.has(row.teamId)));
    const clubEditable = hasClubRole && !account.playerOnly;
    const readOnlyNote = ' This list is read only. It comes from League Master.';
    clubNote.textContent = 'Club captains from League Master.' + readOnlyNote;
    teamNote.textContent = 'Team captains from League Master.' + readOnlyNote;
    playerNote.textContent = (account.playerOnly
      ? 'Your own row. This list is read only.'
      : 'Every player from League Master. This list is read only.') + ' SquashLevels names that are not an exact match come from Links, and are marked Linked.';

    const clubsHere = clubList.filter((club) => (seesLeague ? true : hasClubRole ? clubSlugs.has(club.slug) : homeClubSlugs.has(club.slug)));
    const captainTable = (headers: string[], rows: string[][]) =>
      `<div class="overview-box"><table class="overview"><thead><tr>${headers.map((header) => `<th>${escapeHtml(header)}</th>`).join('')}</tr></thead><tbody>${rows
        .map((cells) => `<tr>${cells.map((cell) => `<td>${escapeHtml(cell || '—')}</td>`).join('')}</tr>`)
        .join('')}</tbody></table></div>`;
    const clubCaptains = clubsHere.filter((club) => club.contact_name);
    siteClubHost.innerHTML = clubCaptains.length
      ? captainTable(
          ['Club', 'Captain', 'Email'],
          clubCaptains.map((club) => [club.name, club.contact_name ?? '', club.contact_email ?? '']),
        )
      : '<p class="muted small">No club captains from League Master yet.</p>';

    const teamsHere = teamList.filter((team) => seesLeague || (hasClubRole ? clubsHere.some((club) => club.slug === team.club_slug) : teamIds.has(team.id)));
    const clubNameOf = (slug: string) => clubList.find((club) => club.slug === slug)?.name ?? slug;
    const teamCaptains = teamsHere.filter((team) => team.captain_name);
    siteTeamHost.innerHTML = teamCaptains.length
      ? captainTable(
          ['Club', 'Team', 'Captain', 'Email'],
          teamCaptains.map((team) => [clubNameOf(team.club_slug), team.division ? `${team.name} · ${team.division}` : team.name, team.captain_name ?? '', team.captain_email ?? '']),
        )
      : '<p class="muted small">No team captains from League Master yet.</p>';

    const playerContacts = (contactResult.error ? [] : (contactResult.data ?? [])) as { team_id: number; player_name: string; email: string | null }[];
    const addressOf = (value: string | null | undefined) => (value ?? '').trim().toLowerCase();
    const lmEmailFor = (row: SiteRow) => {
      const address = addressOf(row.email);
      if (!address) return '';
      const club = clubList.find((item) => addressOf(item.contact_email) === address);
      if (club?.contact_email) return club.contact_email.trim();
      const captain = teamList.find((item) => addressOf(item.captain_email) === address);
      if (captain?.captain_email) return captain.captain_email.trim();
      const contact = playerContacts.find((item) => addressOf(item.email) === address);
      return contact?.email?.trim() ?? '';
    };
    const playerRows = (account.playerOnly || seesLeague || clubEditable ? clubRowsScoped : teamRowsScoped).map((row) => {
      const fromLm = lmEmailFor(row);
      return fromLm ? { ...row, email: fromLm, emailLocked: true } : row;
    });
    playerListHost.innerHTML = playerRows.length ? siteTable(playerRows, 'none', true) : '<p class="muted small">No players on this list yet.</p>';

    const slScope = account.playerOnly ? clubRowsScoped.filter((row) => isSelf(account, row.name, row.email)) : clubRowsScoped;
    slNote.textContent = account.playerOnly
      ? 'Your SquashLevels record, and the full history.'
      : `${
          account.isAdmin
            ? 'SquashLevels for every player on this website, with their team.'
            : hasClubRole
              ? 'SquashLevels for the players at your club, with their team.'
              : 'SquashLevels for the players on your team.'
        } Linked marks a SquashLevels name that is not an exact match.`;
    const mineLink = playerLinks.find((link) => link.profile_id === account.userId);
    const selfSl =
      levelFromLink(mineLink) ??
      slByName.get(nameKey(account.displayName)) ??
      (slScope[0] ? slByName.get(nameKey(slScope[0].name)) : undefined);
    if (account.playerOnly) {
      const place = slScope.map((row) => `${row.team} · ${row.club}`).join('. ') || 'Your team is not set yet.';
      let historyHtml = '<p class="muted small">No SquashLevels history for this name yet.</p>';
      if (selfSl?.id) {
        const { data: ratingRows } = await supabase
          .from('squashlevels_ratings')
          .select('recorded_on, level, kind, squashlevels_match_id')
          .eq('player_id', selfSl.id)
          .order('recorded_on', { ascending: true })
          .order('squashlevels_match_id', { ascending: true })
          .limit(1000);
        const ratings = (ratingRows ?? []) as SlRating[];
        const after = ratings.filter((row) => row.kind === 'after');
        const points = (after.length ? after : ratings)
          .slice()
          .sort((a, b) => a.recorded_on.localeCompare(b.recorded_on) || String(a.squashlevels_match_id ?? '').localeCompare(String(b.squashlevels_match_id ?? '')));
        const newest = points.slice().reverse();
        const rowsHtml = newest.length
          ? newest
              .map((row, index) => {
                const older = newest[index + 1];
                const delta = older ? row.level - older.level : null;
                const change = delta == null || delta === 0 ? '—' : delta > 0 ? `+${delta}` : String(delta);
                return `<tr><td>${escapeHtml(formatDay(row.recorded_on))}</td><td>${levelText(row.level)}</td><td>${change}</td></tr>`;
              })
              .join('')
          : '<tr><td colspan="3">No history yet.</td></tr>';
        historyHtml = `${slChart(points)}<h3>History</h3><div class="overview-box sl-history"><table class="overview"><thead><tr><th>Date</th><th>Level</th><th>Change</th></tr></thead><tbody>${rowsHtml}</tbody></table></div>`;
      }
      slHost.innerHTML = `<article class="site-card"><h3>${escapeHtml(account.displayName || 'You')}</h3><p>${escapeHtml(place)}</p><p>Current level ${levelText(selfSl?.current_level ?? null)}${selfSl?.updated_at ? ` · updated ${escapeHtml(formatDay(selfSl.updated_at.slice(0, 10)))}` : ''}</p>${historyHtml}</article>`;
    } else {
      const body = slScope.length
        ? slScope
            .map((row) => {
              const level = levelFor(row);
              const updated = level?.updated_at ? formatDay(level.updated_at.slice(0, 10)) : '—';
              const linked = level != null && nameKey(level.display_name) !== nameKey(row.name);
              const playerCell = `${escapeHtml(row.name)}${linked ? ' <span class="pill">Linked</span>' : ''}`;
              return `<tr><td>${escapeHtml(row.club)}</td><td>${escapeHtml(row.team)}</td><td>${playerCell}</td><td>${levelText(level?.current_level ?? null)}</td><td>${escapeHtml(updated)}</td></tr>`;
            })
            .join('')
        : '<tr><td colspan="5">No players on this list yet.</td></tr>';
      slHost.innerHTML = `<div class="overview-box"><table class="overview"><thead><tr><th>Club</th><th>Team</th><th>Player</th><th>Level</th><th>Updated</th></tr></thead><tbody>${body}</tbody></table></div>`;
    }

    const myNames = new Set(rows.filter((row) => isSelf(account, row.name, row.email)).map((row) => nameKey(row.name)));
    const selfRow = rows.find((row) => myNames.has(nameKey(row.name)));
    if (selfRow) whoEl.textContent = `Signed in as ${selfRow.name}`;
  }

  const rememberWebsiteEmail = (teamId: number, name: string, email: string, playerId: number) => {
    const current = websitePlayers.find((player) => player.teamId === teamId && player.name.toLowerCase() === name.toLowerCase());
    if (current) {
      current.email = email;
      if (playerId) current.playerId = playerId;
    } else if (teamId) {
      websitePlayers.push({ teamId, name, email, playerId });
    }
    const listed = directoryRows.find((row) => row.teamId === teamId && row.name.toLowerCase() === name.toLowerCase());
    if (listed) listed.email = email;
    if (viewerIsAdmin) paintDirectory();
  };

  const ensureSquad = async (teamId: number, teamName: string) => {
    const { data: existing, error: readError } = await supabase.from('captain_squads').select('id').eq('team_id', teamId).limit(1).maybeSingle();
    if (readError) return { id: 0, error: readError.message };
    if (existing?.id) return { id: existing.id as number, error: '' };
    const { data: created, error } = await supabase.from('captain_squads').insert({ name: teamName, team_id: teamId }).select('id').single();
    if (error || !created) return { id: 0, error: error?.message || 'Could not add the team list.' };
    return { id: created.id as number, error: '' };
  };

  const savePlayerField = async (input: HTMLInputElement) => {
    const field = input.dataset.squadField;
    if (field !== 'email' && field !== 'es' && field !== 'phone') return;
    const raw = input.value.trim();
    const value = field === 'email' ? raw.toLowerCase() : raw;
    if (value === (input.dataset.saved ?? '')) return;
    if (field === 'email' && value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
      setStatus('Enter a valid email, or leave it blank.');
      return;
    }
    if (field === 'phone' && value && !/\d/.test(value)) {
      setStatus('Enter a phone number, or leave it blank.');
      return;
    }
    if (field === 'es' && value.length > 32) {
      setStatus('ES number is too long.');
      return;
    }
    const name = input.dataset.playerName || 'this player';
    const teamId = Number(input.dataset.teamId || 0);
    let playerId = Number(input.dataset.squadEmail || 0);
    const column = field === 'email' ? 'email' : field === 'es' ? 'england_squash_id' : 'phone';
    const stored = value || null;
    const label = field === 'email' ? 'Email' : field === 'es' ? 'ES number' : 'Phone';
    setStatus(`Saving ${label.toLowerCase()}…`);
    if (playerId) {
      const { error } = await supabase.from('squad_players').update({ [column]: stored }).eq('id', playerId);
      if (error) {
        setStatus(error.message);
        return;
      }
    } else {
      const squad = await ensureSquad(teamId, input.dataset.teamName || name);
      if (!squad.id) {
        setStatus(squad.error);
        return;
      }
      const { data: created, error } = await supabase
        .from('squad_players')
        .insert({ squad_id: squad.id, display_name: name, [column]: stored })
        .select('id')
        .single();
      if (error || !created) {
        setStatus(error?.message || `Could not save the ${label.toLowerCase()}.`);
        return;
      }
      playerId = created.id as number;
      const row = input.closest('tr');
      for (const box of row?.querySelectorAll<HTMLInputElement>('input') ?? []) box.dataset.squadEmail = String(playerId);
    }
    input.dataset.saved = value;
    input.defaultValue = input.value;
    if (field === 'email') {
      rememberWebsiteEmail(teamId, name, value, playerId);
      if (viewerIsAdmin) {
        await supabase.rpc('sync_website_player_emails');
        await supabase.rpc('apply_lm_roles');
      }
      setStatus(`Email saved for ${name}. This website keeps it.`);
      return;
    }
    setStatus(`${label} saved for ${name}.`);
  };

  for (const host of [siteClubHost, siteTeamHost, playerListHost]) {
    host.addEventListener('focusout', (event) => {
      const input = (event.target as HTMLElement).closest<HTMLInputElement>('[data-squad-field]');
      if (input) void savePlayerField(input);
    });
  }

  playerListHost.addEventListener('submit', async (event) => {
    const form = (event.target as HTMLElement).closest<HTMLFormElement>('[data-form="add-player"]');
    if (!form || !viewerIsAdmin) return;
    event.preventDefault();
    const data = new FormData(form);
    const teamId = Number(data.get('team_id'));
    const name = String(data.get('display_name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim().toLowerCase();
    if (!teamId || name.length < 2) {
      setStatus('Choose a team and enter the player name.');
      return;
    }
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setStatus('Enter a valid email, or leave it blank.');
      return;
    }
    if (websitePlayers.some((player) => player.teamId === teamId && player.name.toLowerCase() === name.toLowerCase())) {
      setStatus(`${name} is already on that team. Set the email in the list.`);
      return;
    }
    setStatus('Adding player…');
    const teamLabel = form.querySelector('select')?.selectedOptions[0]?.textContent || 'Team';
    const squad = await ensureSquad(teamId, teamLabel);
    if (!squad.id) {
      setStatus(squad.error);
      return;
    }
    const { error } = await supabase.from('squad_players').insert({ squad_id: squad.id, display_name: name, email: email || null });
    if (error) {
      setStatus(error.message);
      return;
    }
    await supabase.rpc('sync_website_player_emails');
    await supabase.rpc('apply_lm_roles');
    setStatus(`${name} added on this website. League Master is unchanged.`);
    await showSession();
  });

  async function showSession() {
    const account = await loadAccount(supabase);
    signedIn.hidden = !account;
    if (!account) {
      workspace.hidden = true;
      juniorLink.hidden = true;
      shareLink.hidden = true;
      scoresLink.hidden = true;
      sendToLogin();
      return;
    }

    whoEl.textContent = `Signed in as ${account.displayName || account.email}`;
    const stop = await privateStop(supabase, account, { role: true });
    if (stop) {
      workspace.hidden = true;
      juniorLink.hidden = true;
      shareLink.hidden = true;
      scoresLink.hidden = true;
      setStatus(stopMessage(stop));
      return;
    }
    void noteActivity(supabase);
    viewerIsAdmin = account.isAdmin;
    viewerId = account.userId;
    viewerSeesJuniors = !account.playerOnly && (account.isAdmin || account.groups.some((group) => group.slug === 'junior_organisers'));
    viewerSeesBeds = account.isAdmin || account.groups.some((group) => group.slug === 'bc_players');
    workspace.hidden = false;
    for (const el of root.querySelectorAll<HTMLElement>('[data-lm-only]')) el.hidden = !account.isAdmin;
    const juniorsNav = root.querySelector<HTMLElement>('[data-juniors-nav]');
    const bedsNav = root.querySelector<HTMLElement>('[data-beds-nav]');
    if (juniorsNav) juniorsNav.hidden = !viewerSeesJuniors;
    if (bedsNav) bedsNav.hidden = !viewerSeesBeds;
    juniorLink.hidden = !viewerSeesJuniors;
    shareLink.hidden = !account.isAdmin;
    scoresLink.hidden = !account.isAdmin;
    const requested = tabAlias[location.hash.slice(1)] ?? (location.hash.slice(1) as Tab);
    const fallback: Tab = account.playerOnly ? 'site-player' : 'site-club';
    showTab((allowedTabs() as readonly string[]).includes(requested) ? requested : fallback);
    await loadWebsite(account);
    if (viewerSeesJuniors || account.isAdmin) await loadJuniorEntries();
    if (!account.isAdmin) return;

    if (location.hash.slice(1) === 'traffic' && !trafficLoaded) void loadTraffic();

    await supabase.rpc('sync_website_player_emails');
    await supabase.rpc('apply_lm_roles');
    await supabase.rpc('sync_permission_groups');

    const [
      { data: people, error: peopleError },
      accountStates,
      { data: clubRows, error: clubError },
      { data: orgRows, error: orgError },
      { data: roleRows, error: roleError },
      { data: nomRows, error: nomError },
      { data: contactRows, error: contactError },
      { data: groupRows, error: groupError },
      { data: groupCatalogRows, error: groupCatalogError },
      { data: permissionRows, error: permissionError },
      { data: signInRows },
      { data: closedRows, error: closedError },
    ] = await Promise.all([
      supabase.from('profiles').select('id, display_name, email, is_admin').order('display_name', { ascending: true }),
      fetchAccountStates(supabase),
      supabase.from('clubs').select('slug, name, contact_name, contact_email, leaguemaster_club_id').order('name', { ascending: true }),
      supabase.from('teams').select('id, club_slug, name, division, leaguemaster_team_id, captain_name, captain_email, last_season').order('name', { ascending: true }),
      supabase.from('memberships').select('id, profile_id, role, club_slug, team_id, profiles(display_name, email), teams(name, division)').order('role', { ascending: true }),
      supabase.from('nominations').select('team_id, player_name, period, position, season').eq('season', SEASON),
      supabase.from('lm_player_contacts').select('id, team_id, player_name, email'),
      supabase.from('group_members').select('profile_id, person_name, place, group_slug'),
      supabase.from('groups').select('slug, name, role_slug, source, managed, position').order('position'),
      supabase.from('roles').select('slug, name, position').order('position'),
      supabase.from('site_sign_ins').select('user_id, signed_in_at').order('signed_in_at', { ascending: false }).limit(1000),
      supabase.from('beds_closed_entries').select('forename, surname, email, telephone'),
    ]);
    if (peopleError || clubError || orgError || roleError) {
      setStatus(peopleError?.message || clubError?.message || orgError?.message || roleError?.message || 'Could not load the lists.');
      return;
    }
    if (nomError) setStatus(nomError.message);

    clubs = (clubRows ?? []) as Club[];
    orgTeams = (orgRows ?? []) as OrgTeam[];
    const accounts = (people ?? []) as Person[];
    const stateById = new Map((accountStates ?? []).map((state) => [state.id, state]));
    accountStatesReady = accountStates !== null;
    signedInIds = new Set((accountStates ?? []).filter((state) => state.last_sign_in_at).map((state) => state.id));
    const latestSignIn = new Map<string, string>();
    for (const row of (signInRows ?? []) as { user_id: string; signed_in_at: string }[]) {
      if (row.user_id && row.signed_in_at && !latestSignIn.has(row.user_id)) latestSignIn.set(row.user_id, row.signed_in_at);
    }
    for (const id of latestSignIn.keys()) signedInIds.add(id);
    const memberships = (roleRows ?? []) as Membership[];
    const groupMembers = (groupError ? [] : groupRows ?? []) as GroupMember[];
    const groupCatalog = ((groupCatalogError ? [] : groupCatalogRows ?? []) as GroupCatalog[]).slice().sort((a, b) => a.position - b.position);
    const roleCatalog = ((permissionError ? [] : permissionRows ?? []) as RoleCatalog[]).slice().sort((a, b) => a.position - b.position);
    groupTitle.clear();
    for (const group of groupCatalog) groupTitle.set(group.slug, group.name);
    listedGroups = groupMembers;
    groupCatalogLive = groupCatalog;
    roleCatalogLive = roleCatalog;
    paintPermissionCatalog(groupCatalog, roleCatalog, groupMembers);
    const juniorEntries = juniorEntriesLive;
    if (groupError || groupCatalogError || permissionError) groupNote.textContent = 'Groups are not on the database yet. Apply the groups migration, then reload.';
    const clubNames = new Map(clubs.map((club) => [club.slug, club.name]));
    const dash = '—';

    const contacts = (contactError ? [] : contactRows ?? []) as { team_id: number; player_name: string; email: string | null }[];
    const nominations = (nomError ? [] : nomRows ?? []) as { team_id: number; player_name: string; period: number; position: number }[];
    const byPlayer = new Map<string, { team_id: number; player_name: string; period: number; position: number }>();
    for (const nom of nominations) {
      const key = `${nom.team_id}:${nom.player_name.toLowerCase()}`;
      const prev = byPlayer.get(key);
      if (!prev || nom.period > prev.period || (nom.period === prev.period && nom.position < prev.position)) byPlayer.set(key, nom);
    }
    directoryRows = [...byPlayer.values()]
      .map((nom) => {
        const team = orgTeams.find((item) => item.id === nom.team_id);
        const contact = contacts.find((item) => item.team_id === nom.team_id && item.player_name.toLowerCase() === nom.player_name.toLowerCase());
        const website = websitePlayers.find((item) => item.teamId === nom.team_id && item.name.toLowerCase() === nom.player_name.toLowerCase());
        const teamLabel = team ? (team.division ? `${team.name} · ${team.division}` : team.name) : 'Team';
        return {
          club: clubNames.get(team?.club_slug ?? '') || dash,
          team: teamLabel,
          teamId: nom.team_id,
          name: nom.player_name,
          email: website ? website.email : contact?.email || '',
        };
      })
      .sort((a, b) => a.club.localeCompare(b.club, 'en') || a.team.localeCompare(b.team, 'en') || a.name.localeCompare(b.name, 'en'));

    const countyAdmin = accounts.find((person) => (person.email || '').toLowerCase() === 'county-admin@players.invalid');
    protectedAdminId = countyAdmin?.id || '';
    const selfId = account.userId;
    const one = (value: { display_name?: string; email?: string | null; name?: string; division?: string | null } | { display_name?: string; email?: string | null; name?: string; division?: string | null }[] | null) =>
      Array.isArray(value) ? value[0] : value;
    const whereFor = (membership: Membership) => {
      const team = one(membership.teams);
      const club = clubs.find((item) => item.slug === membership.club_slug);
      if (team) return `${team.name}${team.division ? `, ${team.division}` : ''}`;
      if (club) return club.name;
      return '—';
    };
    const clubsFor = (personId: string) => {
      const names = new Set<string>();
      for (const membership of rolesFor(personId)) {
        if (membership.club_slug) {
          const name = clubNames.get(membership.club_slug);
          if (name) names.add(name);
        }
        if (membership.team_id != null) {
          const team = orgTeams.find((item) => item.id === membership.team_id);
          const name = team ? clubNames.get(team.club_slug) : undefined;
          if (name) names.add(name);
        }
      }
      return [...names].sort((a, b) => a.localeCompare(b, 'en')).join('; ');
    };
    const rolesFor = (personId: string) =>
      memberships
        .filter((membership) => membership.profile_id === personId)
        .sort((a, b) => rankFor(a.role) - rankFor(b.role) || whereFor(a).localeCompare(whereFor(b), 'en'));
    const positionOf = (slug: string) => groupCatalog.find((group) => group.slug === slug)?.position ?? 99;
    const nameKey = (value: string) => value.trim().toLowerCase().replace(/\s+/g, ' ');
    if (!roleCatalog.some((role) => role.slug === 'jc_parent')) {
      roleCatalog.push({ slug: 'jc_parent', name: 'JC Parent', position: 7 });
      roleCatalog.sort((a, b) => a.position - b.position);
    }
    if (!groupCatalog.some((group) => group.slug === 'jc_parents')) {
      groupCatalog.push({ slug: 'jc_parents', name: 'JC Parents', role_slug: 'jc_parent', source: 'website', managed: false, position: 7 });
      groupCatalog.sort((a, b) => a.position - b.position);
    }
    groupTitle.set('jc_parents', groupCatalog.find((group) => group.slug === 'jc_parents')?.name ?? 'JC Parents');
    const seenJuniors = new Set<string>();
    const parents = new Map<string, { name: string; email: string; phone: string; places: Set<string> }>();
    for (const entry of juniorEntries) {
      const personName = `${entry.player_first_name ?? ''} ${entry.player_last_name ?? ''}`.replace(/\s+/g, ' ').trim();
      const key = nameKey(personName);
      if (key && !seenJuniors.has(key)) {
        seenJuniors.add(key);
        if (!groupMembers.some((member) => member.group_slug === 'jc_players' && nameKey(member.person_name) === key)) {
          const sameName = groupMembers.filter((member) => nameKey(member.person_name) === key);
          const known = sameName.find((member) => member.profile_id) ?? sameName[0];
          const profile =
            accounts.find((person) => nameKey(person.display_name || '') === key) ??
            (known?.profile_id ? accounts.find((person) => person.id === known.profile_id) ?? null : null);
          groupMembers.push({
            profile_id: profile?.id ?? known?.profile_id ?? null,
            person_name: profile?.display_name || known?.person_name || personName,
            place: known?.place ? null : (entry.club ?? '').trim() || null,
            group_slug: 'jc_players',
          });
        }
      }
      const parentName = (entry.guardian_name ?? '').replace(/\s+/g, ' ').trim() || (personName ? `Parent of ${personName}` : '');
      const parentKey = nameKey(parentName);
      if (!parentKey) continue;
      const club = (entry.club ?? '').trim();
      const email = (entry.guardian_email ?? '').trim();
      const phone = (entry.guardian_phone ?? '').trim();
      const parent = parents.get(parentKey);
      if (!parent) {
        parents.set(parentKey, { name: parentName, email, phone, places: new Set(club ? [club] : []) });
      } else {
        if (!parent.email && email) parent.email = email;
        if (!parent.phone && phone) parent.phone = phone;
        if (club) parent.places.add(club);
      }
    }
    for (const parent of parents.values()) {
      const key = nameKey(parent.name);
      if (groupMembers.some((member) => member.group_slug === 'jc_parents' && nameKey(member.person_name) === key)) continue;
      const sameName = groupMembers.filter((member) => nameKey(member.person_name) === key);
      const known = sameName.find((member) => member.profile_id) ?? sameName[0];
      const profile =
        accounts.find((person) => nameKey(person.display_name || '') === key) ??
        (known?.profile_id ? accounts.find((person) => person.id === known.profile_id) ?? null : null);
      const place = known?.place || [...parent.places].join('; ') || null;
      parent.name = profile?.display_name || known?.person_name || parent.name;
      groupMembers.push({
        profile_id: profile?.id ?? known?.profile_id ?? null,
        person_name: parent.name,
        place,
        group_slug: 'jc_parents',
      });
    }
    paintPermissionCatalog(groupCatalog, roleCatalog, groupMembers);
    const groupsFor = (person: Person) => {
      const key = nameKey(person.display_name || '');
      const seen = new Set<string>();
      return groupMembers
        .filter((group) => group.profile_id === person.id || (key !== '' && nameKey(group.person_name) === key))
        .sort((a, b) => positionOf(a.group_slug) - positionOf(b.group_slug) || a.group_slug.localeCompare(b.group_slug, 'en'))
        .filter((group) => {
          if (seen.has(group.group_slug)) return false;
          seen.add(group.group_slug);
          return true;
        });
    };
    const personRank = (person: Person) => {
      if (person.is_admin || person.id === protectedAdminId) return 0;
      const roles = rolesFor(person.id);
      return roles.length ? Math.min(...roles.map((membership) => rankFor(membership.role))) : 4;
    };
    const sortedAccounts = accounts.slice().sort((a, b) => {
      const byRole = personRank(a) - personRank(b);
      if (byRole) return byRole;
      return (a.display_name || a.email || '').localeCompare(b.display_name || b.email || '', 'en');
    });
    const permissionNames = (person: Person) => {
      const slugs = new Set(groupsFor(person).map((group) => group.group_slug));
      const names = roleCatalog
        .filter((role) => groupCatalog.some((group) => group.role_slug === role.slug && slugs.has(group.slug)))
        .map((role) => role.name);
      if (person.is_admin && !names.includes('Admin')) names.unshift('Admin');
      return names;
    };
    const contactFor = (name: string) => personContacts.filter((contact) => nameKey(contact.name) === nameKey(name));
    const closedByName = new Map<string, { emails: Map<string, string>; phones: Map<string, string> }>();
    const contactKey = (value: string, kind: 'email' | 'phone') => (kind === 'email' ? value.trim().toLowerCase() : value.replace(/\D/g, ''));
    const rememberClosed = (bucket: Map<string, string>, value: string, kind: 'email' | 'phone') => {
      const display = value.trim();
      const key = contactKey(display, kind);
      if (!key || bucket.has(key)) return;
      bucket.set(key, display);
    };
    if (!closedError) {
      for (const row of (closedRows ?? []) as { forename: string | null; surname: string | null; email: string | null; telephone: string | null }[]) {
        const key = nameKey(`${row.forename ?? ''} ${row.surname ?? ''}`);
        if (!key) continue;
        const person = closedByName.get(key) ?? { emails: new Map<string, string>(), phones: new Map<string, string>() };
        rememberClosed(person.emails, row.email ?? '', 'email');
        rememberClosed(person.phones, row.telephone ?? '', 'phone');
        if (person.emails.size || person.phones.size) closedByName.set(key, person);
      }
    }
    const emailFor = (name: string, profile: Person | null) => {
      if (profile?.id === protectedAdminId) return 'BSCA';
      if (profile?.email) return profile.email;
      const squad = contactFor(name).find((contact) => contact.email);
      if (squad?.email) return squad.email;
      const listed = directoryRows.find((row) => nameKey(row.name) === nameKey(name) && row.email);
      if (listed?.email) return listed.email;
      const club = clubs.find((item) => nameKey(item.contact_name || '') === nameKey(name) && item.contact_email);
      if (club?.contact_email) return club.contact_email;
      const team = orgTeams.find((item) => nameKey(item.captain_name || '') === nameKey(name) && item.captain_email);
      return team?.captain_email || '';
    };
    const knownFor = (names: Set<string>, profile: Person | null, kind: 'email' | 'phone') => {
      const found: ContactOffer[] = [];
      const add = (source: string, value: string | null | undefined) => {
        const display = (value ?? '').trim();
        if (!contactKey(display, kind) || contactKey(display, kind) === 'bsca') return;
        found.push({ source, value: display });
      };
      if (kind === 'email') {
        for (const contact of personContacts) if (names.has(nameKey(contact.name))) add('LM', contact.email);
        for (const row of directoryRows) if (names.has(nameKey(row.name))) add('LM', row.email);
        for (const name of names) for (const email of closedByName.get(name)?.emails.values() ?? []) add('BC', email);
        for (const club of clubs) if (names.has(nameKey(club.contact_name || ''))) add('Club', club.contact_email);
        for (const team of orgTeams) if (names.has(nameKey(team.captain_name || ''))) add('Team', team.captain_email);
        for (const parent of parents.values()) if (names.has(nameKey(parent.name))) add('Juniors', parent.email);
        if (profile?.email) add('Login', profile.email);
      } else {
        for (const contact of personContacts) if (names.has(nameKey(contact.name))) add('LM', contact.phone);
        for (const name of names) for (const phone of closedByName.get(name)?.phones.values() ?? []) add('BC', phone);
        for (const parent of parents.values()) if (names.has(nameKey(parent.name))) add('Juniors', parent.phone);
      }
      return found;
    };
    const sourceOrder = ['LM', 'BC', 'Club', 'Team', 'Juniors', 'Login', 'Website'];
    const sourceOf = (value: string, known: ContactOffer[], kind: 'email' | 'phone') => {
      const key = contactKey(value, kind);
      if (!key || key === 'bsca') return '';
      const tags = sourceOrder.filter((source) => source !== 'Login' && source !== 'Website' && known.some((item) => item.source === source && contactKey(item.value, kind) === key));
      if (!tags.length && known.some((item) => item.source === 'Login' && contactKey(item.value, kind) === key)) return 'Login';
      if (!tags.length) return 'Website';
      return tags.join(' ');
    };
    const offersOf = (value: string, known: ContactOffer[], kind: 'email' | 'phone') => {
      const key = contactKey(value, kind);
      const seen = new Set<string>();
      const offers: ContactOffer[] = [];
      for (const item of known) {
        const itemKey = contactKey(item.value, kind);
        if (!itemKey || itemKey === key) continue;
        const id = `${item.source}:${itemKey}`;
        if (seen.has(id)) continue;
        seen.add(id);
        offers.push(item);
      }
      return offers.sort((a, b) => sourceOrder.indexOf(a.source) - sourceOrder.indexOf(b.source) || a.value.localeCompare(b.value, 'en'));
    };
    const placeFor = (name: string, profile: Person | null, groups: GroupMember[]) => {
      const fromGroups = [...new Set(groups.map((group) => group.place).filter((place): place is string => Boolean(place)))];
      if (fromGroups.length) return fromGroups.join('; ');
      if (profile && (profile.is_admin || profile.id === protectedAdminId)) return clubsFor(profile.id) || '—';
      const listed = directoryRows.filter((row) => nameKey(row.name) === nameKey(name));
      if (listed.length) return [...new Set(listed.map((row) => `${row.club} / ${row.team}`))].join('; ');
      if (profile) {
        const roles = rolesFor(profile.id);
        const places = roles.map((membership) => whereFor(membership)).filter((place) => place !== '—');
        if (places.length) return places.join('; ');
      }
      return '—';
    };
    const cards = new Map<string, MemberCard>();
    const addCard = (name: string, profile: Person | null, groups: GroupMember[]) => {
      const key = profile ? `id:${profile.id}` : `name:${nameKey(name)}`;
      if (!name && !profile) return;
      const lmName =
        groups.find((group) => group.group_slug === 'lm_players')?.person_name ||
        groups.find((group) => group.group_slug === 'lm_team_captains' || group.group_slug === 'lm_club_captains')?.person_name ||
        '';
      const display = lmName || profile?.display_name || name || 'Unnamed';
      const profileName = profile?.display_name || '';
      const contactNames = new Set(
        [display, name, ...groups.map((group) => group.person_name)].map((value) => nameKey(value || '')).filter(Boolean),
      );
      const contacts = personContacts.filter((contact) => contactNames.has(nameKey(contact.name)));
      const slugs = [...new Set(groups.map((group) => group.group_slug))];
      const roleNames = roleCatalog
        .filter((role) => groupCatalog.some((group) => group.role_slug === role.slug && slugs.includes(group.slug)))
        .map((role) => role.name);
      if (profile?.is_admin && !roleNames.includes('Admin')) roleNames.unshift('Admin');
      const state = profile ? stateById.get(profile.id) : undefined;
      const authAt = state?.last_sign_in_at ?? null;
      const recordedAt = profile ? latestSignIn.get(profile.id) ?? null : null;
      const latest = [authAt, recordedAt].filter((value): value is string => Boolean(value)).sort().at(-1) ?? null;
      const chosen = profile ? activityChoice.get(profile.id) : undefined;
      if (profile && chosen !== undefined && state && state.active === chosen) activityChoice.delete(profile.id);
      const active = profile ? (activityChoice.get(profile.id) ?? (state ? state.active : true)) : true;
      const isDefault = (profile?.email || '').trim().toLowerCase() === 'county-admin@players.invalid';
      const listed = directoryRows.filter((row) => contactNames.has(nameKey(row.name)) && row.team);
      const fromPlaces = groups.flatMap((group) =>
        (group.place || '')
          .split(';')
          .map((part) => {
            const bits = part
              .split('/')
              .map((bit) => bit.trim())
              .filter(Boolean);
            return bits.length > 1 ? bits.slice(1).join(' / ') : bits[0] ?? '';
          })
          .filter(Boolean),
      );
      const teamNameOnly = (label: string) => label.split(' · ')[0].trim();
      const teams = [...new Set((listed.length ? listed.map((row) => row.team) : fromPlaces).map(teamNameOnly).filter(Boolean))];
      const email = emailFor(display, profile);
      const phone = contacts.find((contact) => contact.phone)?.phone || '';
      const knownEmails = knownFor(contactNames, profile, 'email');
      const knownPhones = knownFor(contactNames, profile, 'phone');
      cards.set(key, {
        key,
        name: display,
        profileName,
        label: `${display}${profile?.id === selfId ? ' (you)' : ''}${isDefault ? ' Default admin' : ''}`,
        profileId: profile?.id ?? null,
        email,
        emailSource: sourceOf(email, knownEmails, 'email'),
        emailOffers: offersOf(email, knownEmails, 'email'),
        es: contacts.find((contact) => contact.es)?.es || '',
        phone,
        phoneSource: sourceOf(phone, knownPhones, 'phone'),
        phoneOffers: offersOf(phone, knownPhones, 'phone'),
        place: placeFor(display, profile, groups),
        teams: teams.join('; '),
        groupSlugs: slugs,
        groupNames: groups.map((group) => groupTitle.get(group.group_slug) ?? group.group_slug).filter((value, index, all) => all.indexOf(value) === index).join(', '),
        roleNames: roleNames.join(', '),
        isAdmin: Boolean(profile?.is_admin),
        squadIds: contacts.map((contact) => contact.playerId).filter((id) => id > 0),
        teamId: listed[0]?.teamId ?? contacts.find((contact) => contact.teamId)?.teamId ?? null,
        teamName: listed[0]?.team || '',
        statusHtml: !profile ? 'No login' : active ? 'Active' : 'Inactive',
        lastLogin: !profile ? '—' : latest ? formatWhen(latest) : accountStatesReady ? 'Not yet' : 'Unavailable',
        protectedAccount: Boolean(isDefault),
        active,
      });
    };
    const groupedNames = new Set<string>();
    for (const group of groupMembers) {
      const profile = group.profile_id
        ? accounts.find((person) => person.id === group.profile_id) ?? null
        : accounts.find((person) => nameKey(person.display_name || '') === nameKey(group.person_name)) ?? null;
      const name = profile?.display_name || group.person_name;
      groupedNames.add(profile ? `id:${profile.id}` : `name:${nameKey(name)}`);
      const mine = groupMembers.filter((item) => (profile ? item.profile_id === profile.id || nameKey(item.person_name) === nameKey(name) : nameKey(item.person_name) === nameKey(group.person_name)));
      addCard(name, profile, mine);
    }
    for (const person of sortedAccounts) {
      if (cards.has(`id:${person.id}`)) continue;
      addCard(person.display_name || 'Unnamed', person, groupsFor(person));
    }
    for (const parent of parents.values()) {
      const card = [...cards.values()].find((item) => nameKey(item.name) === nameKey(parent.name) || nameKey(item.profileName) === nameKey(parent.name));
      if (!card) continue;
      const names = new Set([nameKey(card.name), nameKey(card.profileName)].filter(Boolean));
      if (!card.email.trim() && parent.email) {
        card.email = parent.email;
        const known = knownFor(names, null, 'email');
        card.emailSource = sourceOf(parent.email, known, 'email');
        card.emailOffers = offersOf(parent.email, known, 'email');
      }
      if (!card.phone.trim() && parent.phone) {
        card.phone = parent.phone;
        const known = knownFor(names, null, 'phone');
        card.phoneSource = sourceOf(parent.phone, known, 'phone');
        card.phoneOffers = offersOf(parent.phone, known, 'phone');
      }
    }
    const merged = new Map<string, MemberCard>();
    for (const card of cards.values()) {
      const key = nameKey(card.name);
      const previous = merged.get(key);
      if (!previous) {
        merged.set(key, card);
        continue;
      }
      const keep = previous.profileId ? previous : card.profileId ? card : previous;
      const other = keep === previous ? card : previous;
      keep.groupSlugs = [...new Set([...keep.groupSlugs, ...other.groupSlugs])];
      keep.teams = [...new Set(`${keep.teams}; ${other.teams}`.split(';').map((part) => part.trim()).filter(Boolean))].join('; ');
      if (!keep.email.trim() && other.email.trim()) {
        keep.email = other.email;
        keep.emailSource = other.emailSource;
        keep.emailOffers = other.emailOffers;
      }
      if (!keep.phone.trim() && other.phone.trim()) {
        keep.phone = other.phone;
        keep.phoneSource = other.phoneSource;
        keep.phoneOffers = other.phoneOffers;
      }
      if (!keep.es.trim() && other.es.trim()) keep.es = other.es;
      keep.roleNames = [...new Set(`${keep.roleNames}, ${other.roleNames}`.split(',').map((part) => part.trim()).filter(Boolean))].join(', ');
      merged.set(key, keep);
    }
    memberCards = [...merged.values()].sort((a, b) => a.label.localeCompare(b.label, 'en'));
    openingGroup = '';
    if (selectedMemberKey && !memberCards.some((card) => card.key === selectedMemberKey)) {
      const named = memberCards.find((card) => nameKey(card.name) === nameKey(selectedMemberKey.replace(/^name:/, '')));
      selectedMemberKey = named?.key ?? '';
    }
    paintMembers();
    await loadDifferences();
    await paintLinks();
  }

  function paintDirectory() {
    paintMembers();
  }

  type LinkRow = { id: number; profile_id: string | null; squashlevels_player_id: number | null; lm_player_name: string | null };
  type SlNamed = { id: number; display_name: string; current_level: number | null };
  const linksHost = root.querySelector<HTMLElement>('[data-links]')!;
  let linkLevels: SlNamed[] = [];

  async function paintLinks() {
    const [linkResult, { data: slRows }, { data: nomRows }, nameResult] = await Promise.all([
      supabase.from('player_links').select('id, profile_id, squashlevels_player_id, lm_player_name').order('id'),
      allSlPlayers(),
      supabase.from('nominations').select('player_name').eq('season', SEASON),
      allSlNames(),
    ]);
    if (linkResult.error?.code === 'PGRST205') {
      setStatus('The links table is not on the database yet, so a typed name cannot be saved.');
    } else if (linkResult.error) {
      setStatus(linkResult.error.message);
    }
    const levels = (slRows ?? []) as SlNamed[];
    linkLevels = levels;
    const slNames = new Set(levels.map((player) => nameKey(player.display_name)));
    const names = new Map<string, string>();
    const addLmName = (value: string) => {
      const trimmed = value.trim();
      const key = nameKey(trimmed);
      if (key && !names.has(key)) names.set(key, trimmed);
    };
    for (const player of websitePlayers) addLmName(player.name);
    for (const row of (nomRows ?? []) as { player_name: string }[]) addLmName(row.player_name);
    const saved = (linkResult.error ? [] : (linkResult.data ?? [])) as LinkRow[];
    const linked = new Set(saved.map((row) => nameKey(row.lm_player_name ?? '')));
    const levelById = new Map(levels.map((player) => [player.id, player]));
    const storedByKey = new Map<string, SlNamed>();
    for (const stored of (nameResult.error ? [] : (nameResult.data ?? [])) as { name_key: string; player_id: number | null }[]) {
      if (stored.player_id == null || storedByKey.has(stored.name_key)) continue;
      const player = levelById.get(stored.player_id);
      if (player) storedByKey.set(stored.name_key, player);
    }
    const slText = (player: SlNamed | undefined) => (player ? `${player.display_name} · ${levelText(player.current_level)}` : '—');
    const savedLevel = (row: LinkRow) => (row.squashlevels_player_id != null ? levelById.get(row.squashlevels_player_id) : undefined);
    const savedIsExact = (row: LinkRow) => {
      const level = savedLevel(row);
      return Boolean(level) && nameKey(level!.display_name) === nameKey(row.lm_player_name ?? '');
    };
    const savedHtmlFor = (row: LinkRow) => {
      const lm = row.lm_player_name?.trim() || '—';
      return `<tr><td>${escapeHtml(lm)}</td><td>${escapeHtml(slText(savedLevel(row)))}</td><td><button class="btn btn--ghost btn--sm" type="button" data-unlink="${row.id}">Unlink</button></td></tr>`;
    };
    const shown = new Set<string>();
    const steveSaved = saved.find((row) => nameKey(row.lm_player_name ?? '') === 'steve davies');
    const placed: string[] = [];
    if (steveSaved) {
      placed.push(savedHtmlFor(steveSaved));
      shown.add('steve davies');
    }
    const otherSaved = saved
      .filter((row) => {
        const key = nameKey(row.lm_player_name ?? '');
        return Boolean(key) && !shown.has(key) && !savedIsExact(row);
      })
      .sort((a, b) => (a.lm_player_name ?? '').localeCompare(b.lm_player_name ?? '', 'en'));
    for (const row of otherSaved) {
      placed.push(savedHtmlFor(row));
      shown.add(nameKey(row.lm_player_name ?? ''));
    }
    for (const name of [...names.values()].sort((a, b) => a.localeCompare(b, 'en'))) {
      const key = nameKey(name);
      if (shown.has(key) || linked.has(key)) continue;
      const player = storedByKey.get(looseKey(name));
      if (!player || nameKey(player.display_name) === key) continue;
      placed.push(`<tr><td>${escapeHtml(name)}</td><td>${escapeHtml(slText(player))}</td><td></td></tr>`);
      shown.add(key);
    }
    const suggestions: { lm: string; sl: string }[] = [];
    const steve = [...names.values()].find((name) => nameKey(name) === 'steve davies');
    if (steve && !shown.has('steve davies')) suggestions.push({ lm: steve, sl: 'Steven Davies' });
    for (const name of [...names.values()].sort((a, b) => a.localeCompare(b, 'en'))) {
      const key = nameKey(name);
      if (shown.has(key) || key === 'steve davies' || linked.has(key) || slNames.has(key)) continue;
      suggestions.push({ lm: name, sl: '' });
    }
    const lmNames = [...names.values()].sort((a, b) => a.localeCompare(b, 'en'));
    const suggestionHtml = suggestions
      .map((row) => {
        const options = lmNames
          .map((name) => `<option value="${escapeHtml(name)}"${name === row.lm ? ' selected' : ''}>${escapeHtml(name)}</option>`)
          .join('');
        return `<tr>
          <td><select data-link-lm aria-label="LM Player">${options}</select></td>
          <td><input data-link-sl aria-label="SL" value="${escapeHtml(row.sl)}" autocomplete="off" /></td>
          <td><button class="btn btn--primary btn--sm" type="button" data-link-save>Link</button></td>
        </tr>`;
      })
      .join('');
    const exactSaved = saved
      .filter((row) => {
        const key = nameKey(row.lm_player_name ?? '');
        return Boolean(key) && !shown.has(key) && savedIsExact(row);
      })
      .map(savedHtmlFor)
      .join('');
    linksHost.innerHTML = placed.join('') + suggestionHtml + exactSaved || '<tr><td colspan="3">No links yet.</td></tr>';
  }

  linksHost.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-link-save]');
    if (!button) return;
    const row = button.closest('tr');
    const lmName = row?.querySelector<HTMLSelectElement>('[data-link-lm]')?.value.trim() ?? '';
    const typed = row?.querySelector<HTMLInputElement>('[data-link-sl]')?.value.trim() ?? '';
    if (!lmName || !typed) {
      setStatus('Choose an LM Player and type an SL name.');
      return;
    }
    const stored = linkLevels.filter((player) => nameKey(player.display_name) === nameKey(typed) && player.current_level != null);
    if (stored.length > 1) {
      setStatus(`More than one SquashLevels player is called ${typed}.`);
      return;
    }
    let squashlevelsPlayerId = stored[0]?.id;
    if (!squashlevelsPlayerId) {
      setStatus('Looking up that SquashLevels player…');
      const { data: lookedUp, error: lookupError } = await supabase.functions.invoke('squashlevels-link', {
        body: { name: typed },
      });
      if (lookupError) {
        let message = lookupError.message;
        const context = (lookupError as { context?: Response }).context;
        if (context && typeof context.json === 'function') {
          try {
            const payload = (await context.json()) as { error?: string };
            if (payload?.error) message = payload.error;
          } catch {
            /* The function body was not JSON. */
          }
        }
        if (/failed to send a request|relay error|failed to fetch|not found/i.test(message)) {
          message = `No stored SquashLevels player is called ${typed}, and the live lookup is not reachable yet.`;
        }
        setStatus(message);
        return;
      }
      const found = lookedUp as { id?: number; error?: string } | null;
      if (!found?.id) {
        setStatus(found?.error || `No SquashLevels player is called ${typed}.`);
        return;
      }
      squashlevelsPlayerId = found.id;
    }
    setStatus('Saving link…');
    const { error } = await supabase.from('player_links').insert({
      squashlevels_player_id: squashlevelsPlayerId,
      lm_player_name: lmName,
    });
    if (error) {
      setStatus(
        error.code === 'PGRST205'
          ? 'The links table is not on the database yet, so a typed name cannot be saved.'
          : error.code === '23505'
            ? 'One of those records is already linked. Unlink it first.'
            : error.message,
      );
      return;
    }
    setStatus('Link saved.');
    await showSession();
  });

  root.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-unlink]');
    if (!button?.dataset.unlink) return;
    setStatus('Removing link…');
    const { error } = await supabase.from('player_links').delete().eq('id', Number(button.dataset.unlink));
    if (error) {
      setStatus(error.message);
      return;
    }
    setStatus('Link removed.');
    await showSession();
  });

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
  }

  function roleMark(slug: string, name: string) {
    return `<span class="role-name" data-role="${escapeHtml(slug)}">${escapeHtml(name)}</span>`;
  }

  memberSearch.addEventListener('input', () => {
    memberPage = 0;
    paintMembers();
  });
  memberGroup.addEventListener('change', () => {
    memberPage = 0;
    paintMembers();
  });
  memberPlace.addEventListener('change', () => {
    memberPage = 0;
    paintMembers();
  });
  usersPrev.addEventListener('click', () => {
    memberPage -= 1;
    paintMembers();
  });
  usersNext.addEventListener('click', () => {
    memberPage += 1;
    paintMembers();
  });
  async function saveMemberDetails(card: MemberCard, email: string, es: string, phone: string, updateGroups: boolean) {
    if (!viewerIsAdmin) {
      setStatus('Only an admin can change a player.');
      return;
    }
    if (!card.protectedAccount && email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setStatus('Enter a valid email address.');
      return;
    }
    if (phone && !/\d/.test(phone)) {
      setStatus('Enter a phone number, or leave it blank.');
      return;
    }
    if (es.length > 32) {
      setStatus('ES number is too long.');
      return;
    }
    setStatus('Saving details…');
    if (card.profileId && !card.protectedAccount && email !== card.email.trim().toLowerCase()) {
      if (!email) {
        const { error } = await supabase.rpc('clear_login_email', { p_user_id: card.profileId });
        if (error) {
          setStatus(error.message);
          return;
        }
      } else {
        const message = await callManageAccounts(supabase, { action: 'set-email', user_id: card.profileId, email });
        if (message) {
          setStatus(message);
          return;
        }
      }
    }
    const stored = { email: email || null, england_squash_id: es || null, phone: phone || null };
    const writeSquad = async (ids: number[]) => {
      if (!ids.length) return null;
      if (email && es) {
        const { error } = await supabase.from('squad_players').update(stored).in('id', ids);
        return error;
      }
      const { data: rows, error } = await supabase
        .from('squad_players')
        .select('id, lm_email, lm_england_squash_id, lm_email_kept, lm_es_kept')
        .in('id', ids);
      if (error) {
        const { error: fallback } = await supabase.from('squad_players').update(stored).in('id', ids);
        return fallback;
      }
      for (const row of rows ?? []) {
        const patch: Record<string, string | null> = { ...stored };
        if (!email) patch.lm_email_kept = row.lm_email_kept ?? row.lm_email ?? '';
        if (!es) patch.lm_es_kept = row.lm_es_kept ?? row.lm_england_squash_id ?? '';
        const { error: writeError } = await supabase.from('squad_players').update(patch).eq('id', row.id);
        if (writeError) return writeError;
      }
      return null;
    };
    if (card.squadIds.length) {
      const error = await writeSquad(card.squadIds);
      if (error) {
        setStatus(error.message);
        return;
      }
    } else if (card.teamId) {
      const squad = await ensureSquad(card.teamId, card.teamName || card.name);
      if (!squad.id) {
        setStatus(squad.error);
        return;
      }
      const { error } = await supabase.from('squad_players').insert({ squad_id: squad.id, display_name: card.name, ...stored });
      if (error) {
        setStatus(error.message);
        return;
      }
    }
    const [{ data: clubRows }, { data: teamRows }] = await Promise.all([
      supabase.from('clubs').select('slug, contact_name'),
      supabase.from('teams').select('id, captain_name'),
    ]);
    const sameName = (value: string | null) => (value ?? '').trim().toLowerCase().replace(/\s+/g, ' ') === card.name.trim().toLowerCase().replace(/\s+/g, ' ');
    const clubSlugs = ((clubRows ?? []) as { slug: string; contact_name: string | null }[]).filter((club) => sameName(club.contact_name)).map((club) => club.slug);
    const teamIdsToUpdate = ((teamRows ?? []) as { id: number; captain_name: string | null }[]).filter((team) => sameName(team.captain_name)).map((team) => team.id);
    if (clubSlugs.length) await supabase.from('clubs').update({ contact_email: email || null }).in('slug', clubSlugs);
    if (teamIdsToUpdate.length) await supabase.from('teams').update({ captain_email: email || null }).in('id', teamIdsToUpdate);
    if (viewerIsAdmin) {
      await supabase.rpc('sync_website_player_emails');
      await supabase.rpc('apply_lm_roles');
    }
    if (updateGroups && card.profileId) {
      const wanted = new Map(
        [...root.querySelectorAll<HTMLInputElement>('[data-user-group]')].map((box) => [box.dataset.userGroup ?? '', box.checked]),
      );
      const has = (slug: string) => card.groupSlugs.includes(slug);
      if (Boolean(wanted.get('admins')) !== has('admins')) {
        if (card.protectedAccount || card.profileId === viewerId) {
          setStatus('That admin access stays as it is.');
          return;
        }
        const message = await callManageAccounts(supabase, { action: 'set-admin', user_id: card.profileId, is_admin: Boolean(wanted.get('admins')) });
        if (message) {
          setStatus(message);
          return;
        }
      }
      for (const slug of ['junior_organisers', 'bc_players']) {
        if (Boolean(wanted.get(slug)) === has(slug)) continue;
        const message = await callManageAccounts(supabase, {
          action: 'set-group',
          user_id: card.profileId,
          group_slug: slug,
          member: Boolean(wanted.get(slug)),
        });
        if (message) {
          setStatus(message);
          return;
        }
      }
    }
    setStatus(`Details saved for ${card.name}. This website keeps the email, ES number, and phone.`);
    await showSession();
  }

  const differencesHost = root.querySelector<HTMLElement>('[data-differences]')!;
  const differenceRows = root.querySelector<HTMLElement>('[data-difference-rows]')!;
  type SnapshotPlayer = {
    id: number;
    display_name: string;
    email: string | null;
    england_squash_id: string | null;
    lm_email: string | null;
    lm_england_squash_id: string | null;
    lm_display_name: string | null;
    lm_email_kept: string | null;
    lm_es_kept: string | null;
    lm_name_kept: string | null;
  };
  let differencePlayers: SnapshotPlayer[] = [];
  const filled = (value: string | null | undefined) => Boolean((value ?? '').trim());
  const sameEmail = (left: string | null | undefined, right: string | null | undefined) => (left ?? '').trim().toLowerCase() === (right ?? '').trim().toLowerCase();
  const sameEs = (left: string | null | undefined, right: string | null | undefined) => (left ?? '').trim() === (right ?? '').trim();
  const differenceItems = (player: SnapshotPlayer) => {
    const items: { field: 'email' | 'es' | 'name'; label: string; website: string; lm: string }[] = [];
    if (filled(player.email) && filled(player.lm_email) && !sameEmail(player.email, player.lm_email) && !sameEmail(player.lm_email, player.lm_email_kept)) {
      items.push({ field: 'email', label: 'Email', website: (player.email ?? '').trim(), lm: (player.lm_email ?? '').trim() });
    }
    if (filled(player.england_squash_id) && filled(player.lm_england_squash_id) && !sameEs(player.england_squash_id, player.lm_england_squash_id) && !sameEs(player.lm_england_squash_id, player.lm_es_kept)) {
      items.push({ field: 'es', label: 'ES number', website: (player.england_squash_id ?? '').trim(), lm: (player.lm_england_squash_id ?? '').trim() });
    }
    if (filled(player.display_name) && filled(player.lm_display_name) && nameKey(player.display_name) !== nameKey(player.lm_display_name ?? '') && nameKey(player.lm_display_name ?? '') !== nameKey(player.lm_name_kept ?? '')) {
      items.push({ field: 'name', label: 'Name', website: player.display_name.trim(), lm: (player.lm_display_name ?? '').trim() });
    }
    return items;
  };
  function paintDifferences() {
    const rows = differencePlayers.flatMap((player) => differenceItems(player).map((item) => ({ player, item })));
    differencesHost.hidden = rows.length === 0;
    differenceRows.innerHTML = rows
      .map(({ player, item }) => {
        const keep = `Keep website ${item.label} for ${player.display_name}`;
        const take = `Use League Master ${item.label} for ${player.display_name}`;
        return `<tr><td>${escapeHtml(player.display_name)}</td><td>${escapeHtml(item.label)}</td><td>${escapeHtml(item.website)}</td><td>${escapeHtml(item.lm)}</td><td class="col-action col-action--wrap"><button class="btn btn--ghost btn--sm" type="button" data-keep-difference="${player.id}" data-difference-field="${item.field}">${escapeHtml(keep)}</button><button class="btn btn--primary btn--sm" type="button" data-take-difference="${player.id}" data-difference-field="${item.field}">${escapeHtml(take)}</button></td></tr>`;
      })
      .join('');
  }
  async function loadDifferences() {
    const { data, error } = await supabase
      .from('squad_players')
      .select('id, display_name, email, england_squash_id, lm_email, lm_england_squash_id, lm_display_name, lm_email_kept, lm_es_kept, lm_name_kept');
    if (error) {
      differencesHost.hidden = true;
      return;
    }
    differencePlayers = (data ?? []) as SnapshotPlayer[];
    paintDifferences();
  }
  async function chooseDifference(playerId: number, field: 'email' | 'es' | 'name', takeLm: boolean) {
    const player = differencePlayers.find((item) => item.id === playerId);
    if (!player || !viewerIsAdmin) return;
    const patch: Record<string, string | null> = {};
    const lmEmail = (player.lm_email ?? '').trim().toLowerCase();
    const lmEs = (player.lm_england_squash_id ?? '').trim();
    const lmName = (player.lm_display_name ?? '').trim();
    if (field === 'email') {
      patch.lm_email_kept = player.lm_email;
      if (takeLm) patch.email = lmEmail;
    } else if (field === 'es') {
      patch.lm_es_kept = player.lm_england_squash_id;
      if (takeLm) patch.england_squash_id = lmEs;
    } else {
      patch.lm_name_kept = player.lm_display_name;
      if (takeLm) patch.display_name = lmName;
    }
    const label = field === 'email' ? 'email' : field === 'es' ? 'ES number' : 'name';
    setStatus(takeLm ? `Saving the League Master ${label}…` : `Keeping the website ${label}…`);
    const { error } = await supabase.from('squad_players').update(patch).eq('id', playerId);
    if (error) {
      setStatus(error.message);
      return;
    }
    Object.assign(player, patch);
    if (takeLm) {
      const contact = personContacts.find((item) => item.playerId === playerId);
      for (const card of memberCards) {
        if (!card.squadIds.includes(playerId)) continue;
        if (field === 'email') card.email = lmEmail;
        if (field === 'es') card.es = lmEs;
        if (field === 'name') card.name = lmName;
      }
      if (contact) {
        if (field === 'email') contact.email = lmEmail;
        if (field === 'es') contact.es = lmEs;
        if (field === 'name') contact.name = lmName;
      }
      paintMembers();
    }
    paintDifferences();
    setStatus(takeLm ? `League Master ${label} saved for ${player.display_name}.` : `Website ${label} kept for ${player.display_name}.`);
  }
  if (setupApp) {
    watchSortableTables(setupApp, (table, column, direction) => {
      const body = table.tBodies[0];
      const trafficKey = body?.hasAttribute('data-traffic-visitors')
        ? 'visitors'
        : body?.hasAttribute('data-traffic-by-day')
          ? 'by-day'
          : body?.hasAttribute('data-traffic-pages')
            ? 'pages'
            : body?.hasAttribute('data-traffic-top')
              ? 'top'
              : body?.hasAttribute('data-traffic-members')
                ? 'members'
                : body?.hasAttribute('data-traffic-sign-ins')
                  ? 'sign-ins'
                  : '';
      if (trafficKey) {
        trafficSort[trafficKey] = { col: column, dir: direction };
        trafficListPage[trafficKey] = 0;
        paintTrafficLists();
        return true;
      }
      if (body === membersHost) {
        memberSort = { col: column, dir: direction };
        memberPage = 0;
        paintMembers();
        return true;
      }
      return false;
    });
  }
  differenceRows.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-keep-difference], [data-take-difference]');
    if (!button) return;
    const playerId = Number(button.dataset.keepDifference || button.dataset.takeDifference || 0);
    const field = button.dataset.differenceField;
    if (!playerId || (field !== 'email' && field !== 'es' && field !== 'name')) return;
    void chooseDifference(playerId, field, Boolean(button.dataset.takeDifference));
  });

  showSession();
</script>

