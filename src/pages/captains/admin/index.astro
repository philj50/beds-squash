  };

  const isEmailInput = (value: EventTarget | null): value is HTMLInputElement =>
    value instanceof HTMLInputElement && (value.dataset.rowField === 'email' || value.dataset.squadField === 'email');
  const emailInputs = () => root.querySelectorAll<HTMLInputElement>('input[data-row-field="email"], input[data-squad-field="email"]');
  let emailWatch = 0;
  let emailWatchFrames = 0;
  let protectedEmail: HTMLInputElement | null = null;

  const scrubOtherEmails = (keep: HTMLInputElement | null) => {
    for (const input of emailInputs()) {
      if (input === keep || input === protectedEmail) continue;
      if (input.value !== input.defaultValue) input.value = input.defaultValue;
