  function paintJuniorDraw(entries: JuniorEntry[]) {
    const host = root.querySelector<HTMLElement>('[data-junior-draw]')!;
    const pills = root.querySelector<HTMLElement>('[data-junior-draw-pills]')!;
    const sheet = root.querySelector<HTMLElement>('[data-junior-draw-sheet]')!;
    paintJuniorPublish();
    const placed = new Set<number>();
    const groups = ENTRY_GROUPS.map((category) => {
      const players = entries.filter((entry) => entry.age_category === category.age && entry.draw === category.draw);
      for (const entry of players) placed.add(entry.id);
      return { key: category.label, players };
    }).filter((group) => group.players.length);
    const leftover = entries.filter((entry) => !placed.has(entry.id));
    if (leftover.length) groups.push({ key: 'Other', players: leftover });
    if (!groups.length) {
      host.hidden = true;
      juniorDrawKey = '';
      pills.innerHTML = '';
      sheet.innerHTML = '';
      return;
    }
    host.hidden = false;
    if (!groups.some((group) => group.key === juniorDrawKey)) juniorDrawKey = groups[0].key;
    pills.innerHTML = groups
      .map(
        (group) =>
          `<li><button type="button" aria-pressed="${group.key === juniorDrawKey ? 'true' : 'false'}" data-junior-draw-key="${escapeHtml(group.key)}">${escapeHtml(group.key)} (${group.players.length})</button></li>`,
      )
      .join('');
    const group = groups.find((item) => item.key === juniorDrawKey) ?? groups[0];
    const category = ENTRY_GROUPS.find((item) => item.label === group.key);
    const plan = category ? planFor(category.age, category.draw) : null;
    const poolPlayers = plan
      ? entries.filter((entry) => plan.members.some((member) => member.age === entry.age_category && member.section === entry.draw))
      : group.players;
    const byName = (a: JuniorEntry, b: JuniorEntry) =>
      a.player_last_name.localeCompare(b.player_last_name, 'en') || a.player_first_name.localeCompare(b.player_first_name, 'en') || a.id - b.id;
    const waiting = poolPlayers.filter((entry) => entry.draw_position == null).sort(byName);
    const drawn = poolPlayers
      .filter((entry) => entry.draw_position != null)
      .sort((a, b) => (a.draw_position ?? 0) - (b.draw_position ?? 0) || a.id - b.id);
    const split = Math.ceil(poolPlayers.length / 2);
    const top = drawn.filter((entry) => (entry.draw_position ?? 0) <= split);
    const bottom = drawn.filter((entry) => (entry.draw_position ?? 0) > split);
    const line = (entry: JuniorEntry) => {
      const name = `${entry.player_first_name} ${entry.player_last_name}`.trim();
      const back = viewerSeesJuniors
        ? `<button class="btn btn--ghost btn--sm" type="button" data-draw-return="${entry.id}" aria-label="Put ${escapeHtml(name)} back">Put back</button>`
        : '';
      return `<li><span class="draw-slot">${entry.draw_position}</span><span>${escapeHtml(name)}</span><span class="muted">${escapeHtml(entry.club || '')}</span>${back}</li>`;
    };
    const half = (title: string, rows: JuniorEntry[], slots: number) => {
      const body = rows.length ? `<ol>${rows.map((entry) => line(entry)).join('')}</ol>` : `<p class="muted small">${slots ? 'Waiting for a name.' : 'Bye.'}</p>`;
      return `<section class="junior-half"><h4>${title}</h4>${body}</section>`;
    };
    const hat = viewerSeesJuniors
      ? `<div class="junior-hat"><h4>Still to draw</h4>${
          waiting.length
            ? `<ul>${waiting
                .map((entry) => {
                  const name = `${entry.player_first_name} ${entry.player_last_name}`.trim();
                  return `<li><button class="btn btn--ghost btn--sm" type="button" data-draw-place="${entry.id}" aria-label="Draw ${escapeHtml(name)}">${escapeHtml(name)}</button></li>`;
                })
                .join('')}</ul>`
            : '<p class="muted small">Everyone in this draw has been placed.</p>'
        }</div>`
      : '';
    const combineName = plan && plan.members.length > 1
      ? ENTRY_GROUPS.filter((item) => plan.members.some((member) => member.age === item.age && member.section === item.draw))
          .map((item) => item.label)
          .join(' and ')
      : '';
    const categoryBoxes = plan
      ? ENTRY_GROUPS.map((item) => {
          const checked = plan.members.some((member) => member.age === item.age && member.section === item.draw);
          const current = item.label === group.key;
          return `<label><input type="checkbox" data-draw-member="${escapeHtml(item.label)}"${checked ? ' checked' : ''}${current ? ' disabled' : ''} /> ${escapeHtml(item.label)}</label>`;
        }).join('')
      : '';
    const planBar = plan && viewerSeesJuniors
      ? `<div class="junior-plan">
          <div class="tag-list" role="group" aria-label="Draw type">
            <button type="button" class="btn btn--ghost btn--sm" aria-pressed="${plan.format === 'knockout' ? 'true' : 'false'}" data-draw-format="knockout">Knockout</button>
            <button type="button" class="btn btn--ghost btn--sm" aria-pressed="${plan.format === 'round_robin' ? 'true' : 'false'}" data-draw-format="round_robin">Round robin</button>
          </div>
          <label>Court at Towers <input data-draw-court maxlength="40" value="${escapeHtml(plan.court)}" placeholder="3" /></label>
          <label>Time at Towers <input type="time" data-draw-time value="${escapeHtml(plan.start)}" /></label>
        </div>
        <fieldset class="junior-categories"><legend>Categories in this draw</legend>${categoryBoxes}</fieldset>
        ${combineName ? `<p class="junior-combine-name">${escapeHtml(combineName)}</p>` : ''}`
      : '';
    const ties = drawn.flatMap((entry, index) =>
      drawn.slice(index + 1).map((other) => {
        const home = `${entry.player_first_name} ${entry.player_last_name}`.trim();
        const away = `${other.player_first_name} ${other.player_last_name}`.trim();
        return `<li>${escapeHtml(home)} v ${escapeHtml(away)}</li>`;
      }),
    );
    const roundRobin = `<section class="junior-half"><h4>Round robin</h4>${
      drawn.length ? `<ol>${drawn.map((entry) => line(entry)).join('')}</ol>` : '<p class="muted small">Waiting for a name.</p>'
    }${
      ties.length
        ? `<h4>Matches</h4><ol class="junior-ties">${ties.join('')}</ol>`
        : '<p class="muted small">Matches appear once two names are drawn.</p>'
    }</section>`;
    const sheetBody = plan?.format === 'round_robin'
      ? roundRobin
      : `<div class="junior-halves">${half('Top half', top, split)}${half('Bottom half', bottom, poolPlayers.length - split)}</div>`;
    sheet.innerHTML = `${planBar}${hat}${sheetBody}`;
  }
  async function loadJuniorEntries() {
    const columns = 'id, player_first_name, player_last_name, date_of_birth, age_category, draw, club, guardian_name, guardian_email, guardian_phone, emergency_name, emergency_phone, notes, show_name, draw_position';
    let result = await supabase.from('junior_entries').select(columns).order('player_last_name');
    if (result.error && /draw_position|schema cache/i.test(result.error.message)) {
      result = await supabase.from('junior_entries').select(columns.replace(', draw_position', '')).order('player_last_name');
    }
    juniorEntriesLive = (result.error ? [] : (result.data ?? [])) as JuniorEntry[];
    const published = await supabase.rpc('junior_draw_is_published');
    juniorDrawPublished = published.data === true;
    const plans = await supabase.rpc('junior_draw_plans');
    juniorDrawPlans = Array.isArray(plans.data)
      ? (plans.data as JuniorDrawPlan[]).filter(
          (plan) => (plan?.format === 'knockout' || plan?.format === 'round_robin') && Array.isArray(plan.members) && plan.members.length > 0,
        )
      : [];
    paintJuniorEntries(juniorEntriesLive, result.error?.message ?? '');
  }
  async function saveJuniorDrawPlan(format?: JuniorDrawPlan['format']) {
    if (!viewerSeesJuniors) return;
    const category = ENTRY_GROUPS.find((item) => item.label === juniorDrawKey);
    if (!category) return;
    const current = planFor(category.age, category.draw);
    const sheet = root.querySelector<HTMLElement>('[data-junior-draw-sheet]');
    const court = sheet?.querySelector<HTMLInputElement>('[data-draw-court]')?.value ?? current.court;
    const start = sheet?.querySelector<HTMLInputElement>('[data-draw-time]')?.value ?? current.start;
    const picked = new Set(
      [...(sheet?.querySelectorAll<HTMLInputElement>('[data-draw-member]:checked') ?? [])].map((input) => input.dataset.drawMember ?? ''),
    );
    picked.add(category.label);
    const members = ENTRY_GROUPS.filter((item) => picked.has(item.label)).map((item) => ({ age: item.age, section: item.draw }));
    const next: JuniorDrawPlan = { format: format ?? current.format, court: court.trim(), start, members };
    const sameMembers =
      current.members.length === members.length &&
      current.members.every((member) => members.some((item) => item.age === member.age && item.section === member.section));
    if (!sameMembers) {
      const removed = current.members.filter((member) => !members.some((item) => item.age === member.age && item.section === member.section));
      packPositions(juniorEntriesLive.filter((entry) => members.some((member) => member.age === entry.age_category && member.section === entry.draw)));
