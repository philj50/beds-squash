  function groupPeoplePlace(member: GroupMember, card: MemberCard | undefined) {
    if (member.group_slug !== 'jc_players' && member.group_slug !== 'jc_parents') return member.place || '—';
    const names = new Set<string>();
    const addName = (value: string | null | undefined) => {
      const key = nameKey(value ?? '');
      if (key) names.add(key);
    };
    addName(member.person_name);
    addName(card?.name);
    addName(card?.profileName);
    for (const other of listedGroups) {
      const otherKey = nameKey(other.person_name);
      if (!otherKey) continue;
      const sameProfile = Boolean(member.profile_id) && other.profile_id === member.profile_id;
      if (sameProfile || names.has(otherKey)) addName(other.person_name);
    }
    const samePerson = (other: GroupMember) => {
      const otherKey = nameKey(other.person_name);
      return (Boolean(member.profile_id) && other.profile_id === member.profile_id) || (otherKey !== '' && names.has(otherKey));
    };
    const isLm = (slug: string) => slug.startsWith('lm_') || groupCatalogLive.some((item) => item.slug === slug && item.source === 'leaguemaster');
    const lmParts = listedGroups.filter((other) => isLm(other.group_slug) && samePerson(other)).flatMap((other) => placeParts(other.place));
    const clubs =
      member.group_slug === 'jc_players'
        ? juniorEntriesLive
            .filter((entry) => names.has(nameKey(`${entry.player_first_name ?? ''} ${entry.player_last_name ?? ''}`)))
            .map((entry) => (entry.club ?? '').trim())
        : juniorEntriesLive.filter((entry) => names.has(nameKey(entry.guardian_name ?? ''))).map((entry) => (entry.club ?? '').trim());
    const juniorParts = clubs.some(Boolean) ? clubs.filter(Boolean) : placeParts(member.place);
    const seen = new Set<string>();
    const combined: string[] = [];
    for (const part of [...lmParts, ...juniorParts]) {
      const token = part.toLowerCase();
      if (seen.has(token)) continue;
      seen.add(token);
      combined.push(part);
    }
    return combined.join('; ') || '—';
  }
