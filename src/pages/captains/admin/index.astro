  type LiveStale = { id: number; playerA: string; playerB: string; score: string; marker: string; updatedAt: string };
  let staleRows: LiveStale[] = [];

  function liveLine(score: string) {
    return (unpackLiveScore(score).line || '0-0').replace(/-/g, '–');
  }

  function paintStaleMatches() {
    liveBody.replaceChildren();
    const staleCount = staleRows.filter((match) => Date.now() - new Date(match.updatedAt).getTime() >= 60 * 60 * 1000).length;
    liveClear.hidden = staleCount === 0;
    if (!staleRows.length) {
      const row = document.createElement('tr');
      const cell = document.createElement('td');
      cell.colSpan = 5;
      cell.textContent = 'No matches are in play.';
      row.append(cell);
      liveBody.append(row);
      return;
    }
    for (const match of staleRows) {
      const row = document.createElement('tr');
      const when = document.createElement('td');
      when.textContent = scoreWhen(match.updatedAt);
      const players = document.createElement('td');
      players.textContent = `${match.playerA} v ${match.playerB}`;
      const score = document.createElement('td');
      score.textContent = liveLine(match.score);
      const marker = document.createElement('td');
      marker.textContent = match.marker;
      const action = document.createElement('td');
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'btn btn--ghost btn--sm';
      remove.textContent = 'Clear';
      remove.addEventListener('click', () => void clearStaleMatch(match.id));
      action.append(remove);
      row.append(when, players, score, marker, action);
      liveBody.append(row);
    }
  }

  async function loadStaleMatches() {
    liveStatus.textContent = 'Loading matches in play…';
    const { data, error } = await supabase.rpc('admin_stale_live_matches');
    if (error) {
      const message = error.message ?? '';
      liveStatus.textContent = error.code === 'PGRST202' || /could not find the function/i.test(message) ? 'Stale matches are not on the database yet.' : message;
      staleRows = [];
      liveClear.hidden = true;
      liveBody.replaceChildren();
      return;
    }
    staleRows = (data ?? []) as LiveStale[];
    paintStaleMatches();
    liveStatus.textContent = '';
  }

  async function clearStaleMatch(id: number) {
    if (!confirm('Take this match off the list?')) return;
    liveStatus.textContent = 'Clearing…';
    const { error } = await supabase.rpc('admin_clear_stale_live_match', { p_id: id });
    if (error) {
      liveStatus.textContent = error.message;
      return;
    }
    liveStatus.textContent = 'Cleared.';
    await loadStaleMatches();
  }

  liveClear.addEventListener('click', async () => {
    if (!staleRows.length || !confirm('Take every stale match off the list?')) return;
    liveStatus.textContent = 'Clearing…';
    const { error } = await supabase.rpc('admin_clear_stale_live_matches');
    if (error) {
      liveStatus.textContent = error.message;
      return;
    }
    liveStatus.textContent = 'Cleared.';
    await loadStaleMatches();
  });

  function scoreWhen(value: string) {
    const when = new Date(value);
    return Number.isNaN(when.getTime()) ? '' : when.toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
  }

  function gamesFromHistory(row: MarkedRow) {
    const games = [];
    for (const rallies of row.history?.games ?? []) {
      const last = [...rallies].reverse().find((rally) => rally.winner === 'a' || rally.winner === 'b');
      if (last) games.push({ a: last.a, b: last.b });
    }
    return games;
  }

  function paintScoreTape(row: MarkedRow) {
    scoreTape.replaceChildren();
    const games = row.history?.games ?? [];
    const played = games.filter((rallies) => rallies.length);
    if (!played.length) {
      const empty = document.createElement('p');
      empty.textContent = 'This match has no rally list yet. Open Marking to mark the points.';
      scoreTape.append(empty);
      return;
    }
    games.forEach((rallies, index) => {
      if (!rallies.length) return;
      const stem = gameStem(rallies.map((rally) => ({ ...rally, choosing: Boolean(rally.choosing), handOut: Boolean(rally.handOut) })));
      const game = document.createElement('section');
      game.className = 'stem';
      const heading = document.createElement('p');
      heading.className = 'stem-head';
      const winner = stem.score.a === stem.score.b ? '' : stem.score.a > stem.score.b ? row.playerA : row.playerB;
      heading.textContent = winner ? `Game ${index + 1} – ${winner}` : `Game ${index + 1}`;
      const total = document.createElement('p');
      total.className = 'stem-score';
      total.textContent = `${stem.score.a} | ${stem.score.b}`;
      const body = document.createElement('div');
      for (const mark of stem.rows) {
        const line = document.createElement('div');
        line.className = 'stem-row';
        const pip = document.createElement('span');
        pip.className = `pip${mark.kind === 'let' ? ' is-let' : ''}${mark.kind === 'stroke' ? ' is-stroke' : ''}`;
        pip.textContent = mark.text;
        const box = document.createElement('span');
        box.className = 'box-mark';
        box.textContent = mark.box;
        const cluster = document.createElement('span');
        cluster.className = mark.side === 'a' ? 'cluster cluster--a' : 'cluster cluster--b';
        if (mark.side === 'a') cluster.append(box, pip);
        else cluster.append(pip, box);
        const left = document.createElement('span');
        const right = document.createElement('span');
        const rail = document.createElement('span');
        rail.className = 'stem-rail';
        if (mark.side === 'a') left.append(cluster);
        else right.append(cluster);
        line.append(left, rail, right);
        body.append(line);
      }
      game.append(heading, total, body);
      scoreTape.append(game);
    });
  }

  function paintMarkedMatches() {
    scoreBody.replaceChildren();
    if (!markedRows.length) {
      const row = document.createElement('tr');
      const cell = document.createElement('td');
      cell.colSpan = 5;
      cell.textContent = 'No marked matches yet.';
      row.append(cell);
      scoreBody.append(row);
      return;
    }
    for (const match of markedRows) {
      const row = document.createElement('tr');
      const when = document.createElement('td');
      when.textContent = scoreWhen(match.createdAt);
      const players = document.createElement('td');
      const winner = match.winner === 'a' ? match.playerA : match.playerB;
      const loser = match.winner === 'a' ? match.playerB : match.playerA;
      players.textContent = `${winner} beat ${loser}`;
      const score = document.createElement('td');
      score.textContent = match.score;
      const marker = document.createElement('td');
      marker.textContent = match.marker;
      const action = document.createElement('td');
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'btn btn--ghost btn--sm';
      button.textContent = 'Edit';
      button.addEventListener('click', () => void openMarkedMatch(match.id));
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'btn btn--ghost btn--sm';
      remove.textContent = 'Delete';
      remove.addEventListener('click', () => void deleteMarkedMatch(match.id));
      action.append(button, remove);
      row.append(when, players, score, marker, action);
      scoreBody.append(row);
    }
  }

  async function openMarkedMatch(id: number) {
    scoreStatus.textContent = 'Opening the match…';
    const { data, error } = await supabase.rpc('admin_marked_match', { p_id: id });
    if (error || !data) {
      scoreStatus.textContent = error?.message || 'That match could not be opened.';
      return;
    }
    editingMatch = data as MarkedRow;
    scoreNameA.value = editingMatch.playerA;
    scoreNameB.value = editingMatch.playerB;
    scoreOpen.href = `${scoreOpen.pathname}?id=${editingMatch.id}`;
    paintScoreTape(editingMatch);
    scoreEdit.hidden = false;
    scoreStatus.textContent = '';
  }

  async function loadMarkedMatches() {
    scoreStatus.textContent = 'Loading matches…';
    const { data, error } = await supabase.rpc('admin_marked_matches');
    if (error) {
      const message = error.message ?? '';
      scoreStatus.textContent = error.code === 'PGRST202' || /could not find the function/i.test(message) ? 'The score list is not on the database yet.' : message;
      scoresLoaded = true;
      return;
    }
    markedRows = (data ?? []) as MarkedRow[];
    paintMarkedMatches();
    scoreStatus.textContent = markedRows.length ? '' : 'No marked matches yet.';
    scoresLoaded = true;
  }

  scoreEdit.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!editingMatch) return;
    const games = gamesFromHistory(editingMatch);
    scoreStatus.textContent = 'Saving…';
    const { error } = await supabase.rpc('admin_save_marked_match', {
      p_id: editingMatch.id,
      p_a: scoreNameA.value,
      p_b: scoreNameB.value,
      p_games: games,
      p_history: editingMatch.history ?? {},
    });
    if (error) {
      scoreStatus.textContent = error.message;
      return;
    }
    scoreStatus.textContent = 'Saved.';
    scoresLoaded = false;
    await loadMarkedMatches();
  });

  async function deleteMarkedMatch(id: number) {
    if (!confirm('Remove this marked match?')) return;
    const { error } = await supabase.rpc('admin_delete_marked_match', { p_id: id });
    if (error) {
      scoreStatus.textContent = error.message;
      return;
    }
    if (editingMatch?.id === id) {
      editingMatch = null;
      scoreEdit.hidden = true;
    }
    scoresLoaded = false;
    await loadMarkedMatches();
  }

  root.querySelector<HTMLButtonElement>('[data-score-remove]')?.addEventListener('click', () => {
