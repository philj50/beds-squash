---
import Base from '@/layouts/Base.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { url } from '@/lib/site';
---

<Base title="Shared content" description="Publish photos, videos, links and articles sent in from the Share page." noindex>
  <section class="section">
    <div class="container share-admin" id="share-admin" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <h1>Shared content</h1>
      <p class="lede">
        People send photos, videos, links and articles from the <a href={url('/share/')}>Share</a> page.
        Nothing goes on the site until you publish it. Open Edit to change the sender, subject and content, then save.
        Publish is a separate button.
      </p>
      <p class="status" data-status role="status"></p>
      <div data-panel="signed-in" hidden>
        <p class="who" data-who></p>
        <p class="actions">
          <a class="btn btn--ghost btn--sm" href={url('/captains/admin/')}>Admin</a>
          <a class="btn btn--ghost btn--sm" href={url('/share/')}>Share page</a>
          <button class="btn btn--ghost btn--sm" type="button" data-sign-out>Sign out</button>
        </p>
        <p data-denied hidden>This account cannot publish shared content.</p>
        <div data-admin hidden>
          <h2>Waiting</h2>
          <div data-pending></div>
          <h2>On the site</h2>
          <div data-live></div>
          <h2>Add to the site</h2>
          <p class="hint">This goes on the site now, because you are publishing it. Videos can be up to 10 MB. Photos can be up to 8 MB.</p>
          <form class="card" data-form="add" novalidate>
            <div class="card__body stack">
              <label>Name <input name="credit" required minlength="2" maxlength="80" /></label>
              <fieldset>
                <legend>What are you adding?</legend>
                <div class="kinds">
                  <label><input type="radio" name="kind" value="photo" checked /> Photo</label>
                  <label><input type="radio" name="kind" value="video" /> Video</label>
                  <label><input type="radio" name="kind" value="link" /> Link</label>
                  <label><input type="radio" name="kind" value="article" /> Article</label>
                </div>
              </fieldset>
              <label data-for="photo video">Caption <input name="caption" maxlength="200" /></label>
              <div data-for="photo">
                <label>Photo <input name="photo" type="file" accept="image/jpeg,image/png,image/webp,image/gif" /></label>
              </div>
              <div data-for="video" hidden>
                <label>Video <input name="video" type="file" accept="video/mp4,video/webm,video/quicktime,.mp4,.webm,.mov" /></label>
              </div>
              <label data-for="link article" hidden>Title <input name="title" maxlength="140" /></label>
              <label data-for="link" hidden>Link <input name="url" type="text" inputmode="url" placeholder="https://" autocomplete="off" spellcheck="false" /></label>
              <label data-for="link" hidden>Note, optional <input name="note" maxlength="200" /></label>
              <label data-for="article" hidden>Summary, optional <input name="summary" maxlength="280" /></label>
              <label data-for="article" hidden>Article <textarea name="body" maxlength="8000" rows="6"></textarea></label>
              <button class="btn btn--primary" type="submit">Add to the site</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { loadAccount, noteActivity, privateStop, sendToLogin, stopMessage } from '@/lib/account';
  import {
    GALLERY_BODY_MAX,
    GALLERY_BODY_MIN,
    cleanLinkUrl,
    contentTypeFor,
    photoExtension,
    photoProblem,
    videoExtension,
    videoProblem,
  } from '@/lib/gallery-media';

  type Kind = 'photo' | 'video' | 'link' | 'article';
  type Item = {
    id: string;
    kind: Kind;
    credit: string;
    title: string | null;
    caption: string | null;
    body: string | null;
    storage_path: string | null;
    url: string | null;
    status: 'pending' | 'published';
    created_at: string;
  };

  const root = document.getElementById('share-admin');
  if (!root) throw new Error('share admin missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const signedIn = root.querySelector<HTMLElement>('[data-panel="signed-in"]')!;
  const denied = root.querySelector<HTMLElement>('[data-denied]')!;
  const admin = root.querySelector<HTMLElement>('[data-admin]')!;
  const whoEl = root.querySelector<HTMLElement>('[data-who]')!;
  const pendingEl = root.querySelector<HTMLElement>('[data-pending]')!;
  const liveEl = root.querySelector<HTMLElement>('[data-live]')!;
  const addForm = root.querySelector<HTMLFormElement>('[data-form="add"]')!;

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);

  const kindOf = () => (addForm.querySelector<HTMLInputElement>('input[name="kind"]:checked')?.value ?? 'photo') as Kind;

  function showKind() {
    const kind = kindOf();
    addForm.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => {
      el.hidden = !el.dataset.for!.split(' ').includes(kind);
    });
  }
  addForm.querySelectorAll('input[name="kind"]').forEach((input) => input.addEventListener('change', showKind));
  showKind();

  root.querySelector('[data-sign-out]')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    await showSession();
  });

  function preview(item: Item, signed: Map<string, string>) {
    if (item.kind === 'photo' && item.storage_path && signed.get(item.storage_path)) {
      return `<img src="${escapeHtml(signed.get(item.storage_path)!)}" alt="" />`;
    }
    if (item.kind === 'video' && item.storage_path && signed.get(item.storage_path)) {
      return `<video src="${escapeHtml(signed.get(item.storage_path)!)}" controls preload="metadata"></video>`;
    }
    if (item.url) return `<a href="${escapeHtml(item.url)}" target="_blank" rel="noopener">${escapeHtml(item.url)}</a>`;
    if (item.body) return `<p>${escapeHtml(item.body.slice(0, 280))}${item.body.length > 280 ? '…' : ''}</p>`;
    return '';
  }

  function editField(label: string, hint: string, control: string, tag = 'Editable') {
    return `<label class="field"><span class="field__name">${label} <span class="field__tag">${tag}</span></span>${control}<span class="field__hint">${hint}</span></label>`;
  }

  function editor(item: Item) {
    const lead = item.status === 'pending'
      ? 'Change the sender, subject and content in the boxes below. Save changes stores them. Publish puts this on the site.'
      : 'Change the sender, subject and content in the boxes below, then save. This is already on the site.';
    const publish = item.status === 'pending'
      ? `<button class="btn btn--ghost btn--sm editor__publish" type="button" data-publish="${item.id}">Publish</button>`
      : '';
    const actions = `<p class="actions editor__actions"><button class="btn btn--primary btn--sm" type="submit">Save changes</button>${publish}<button class="btn btn--ghost btn--sm" type="button" data-cancel>Cancel</button></p>`;
    const sender = editField(
      'Sender',
      'The name shown on the site. Use the photographer or author when that is someone else.',
      `<input name="credit" required minlength="2" maxlength="80" value="${escapeHtml(item.credit)}" autocomplete="name" />`,
    );
    const open = `<form class="stack editor" data-editor="${item.id}" data-kind="${item.kind}" hidden><p class="editor__lead">${lead}</p>${sender}`;
    if (item.kind === 'photo' || item.kind === 'video') {
      const fileLabel = item.kind === 'photo' ? 'Replace the photo' : 'Replace the video';
      const accept = item.kind === 'photo'
        ? 'image/jpeg,image/png,image/webp,image/gif'
        : 'video/mp4,video/webm,video/quicktime,.mp4,.webm,.mov';
      return `${open}
        ${editField('Subject', 'The caption shown with this photo or video.', `<input name="caption" maxlength="200" value="${escapeHtml(item.caption ?? '')}" />`)}
        ${editField(fileLabel, 'Leave this empty to keep the file already sent in.', `<input name="file" type="file" accept="${accept}" />`, 'Optional')}
        ${actions}
      </form>`;
    }
    if (item.kind === 'link') {
      return `${open}
        ${editField('Subject', 'The heading shown on the site.', `<input name="title" maxlength="140" value="${escapeHtml(item.title ?? '')}" />`)}
        ${editField('Link', 'Use an https address.', `<input name="url" type="text" inputmode="url" maxlength="500" value="${escapeHtml(item.url ?? '')}" autocomplete="off" spellcheck="false" />`)}
        ${editField('Content', 'A short note beside the address. Leave it blank if you have nothing to add.', `<input name="note" maxlength="200" value="${escapeHtml(item.caption ?? '')}" />`, 'Optional')}
        ${actions}
      </form>`;
    }
    return `${open}
      ${editField('Subject', 'The heading shown on the site.', `<input name="title" maxlength="140" value="${escapeHtml(item.title ?? '')}" />`)}
      ${editField('Summary', 'A short line under the heading.', `<input name="summary" maxlength="280" value="${escapeHtml(item.caption ?? '')}" />`, 'Optional')}
      ${editField('Content', 'The article text on the site.', `<textarea name="body" maxlength="8000" rows="8">${escapeHtml(item.body ?? '')}</textarea>`)}
      ${actions}
    </form>`;
  }

  function cards(items: Item[], signed: Map<string, string>) {
    if (!items.length) return '<p class="hint">Nothing here.</p>';
    return items
      .map((item) => {
        const when = new Date(item.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
        const heading = item.title || item.caption || item.kind;
        const publish = item.status === 'pending' ? `<button class="btn btn--primary btn--sm" type="button" data-publish="${item.id}">Publish</button>` : '';
        const edit = `<button class="btn btn--ghost btn--sm" type="button" data-edit="${item.id}">Edit</button>`;
        return `<article class="item" data-item="${item.id}"><div class="item__media">${preview(item, signed)}</div><div><p class="pill">${escapeHtml(item.kind)}</p><h3>${escapeHtml(heading)}</h3><p class="hint">${escapeHtml(item.credit)} · ${when}</p><p class="actions">${edit}${publish}<button class="btn btn--ghost btn--sm" type="button" data-delete="${item.id}">Delete</button></p>${editor(item)}</div></article>`;
      })
      .join('');
  }

  async function signedUrls(items: Item[]) {
    const paths = items.map((item) => item.storage_path).filter((path): path is string => Boolean(path));
    const signed = new Map<string, string>();
    if (!paths.length) return signed;
    try {
      const { data } = await supabase.storage.from('contributions').createSignedUrls(paths, 3600);
      for (const row of data ?? []) {
        if (row.path && row.signedUrl) signed.set(row.path, row.signedUrl);
      }
    } catch {
      return signed;
    }
    return signed;
  }

  async function loadItems() {
    const { data, error } = await supabase
      .from('contributions')
      .select('id, kind, credit, title, caption, body, storage_path, url, status, created_at')
      .order('created_at', { ascending: false })
      .limit(100);
    if (error) {
      statusEl.textContent = error.message;
      return;
    }
    const items = (data ?? []) as Item[];
    const signed = await signedUrls(items);
    const waiting = items.filter((item) => item.status === 'pending');
    const live = items.filter((item) => item.status === 'published');
    pendingEl.innerHTML = cards(waiting, signed);
    liveEl.innerHTML = cards(live, signed);
  }

  admin.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const edit = target.closest<HTMLButtonElement>('[data-edit]');
    const cancel = target.closest<HTMLButtonElement>('[data-cancel]');
    if (edit?.dataset.edit) {
      const form = admin.querySelector<HTMLElement>(`[data-editor="${edit.dataset.edit}"]`);
      if (form) form.hidden = false;
      return;
    }
    if (cancel) {
      const form = cancel.closest<HTMLElement>('[data-editor]');
      if (form) form.hidden = true;
      return;
    }
    const publish = target.closest<HTMLButtonElement>('[data-publish]');
    const remove = target.closest<HTMLButtonElement>('[data-delete]');
    if (publish?.dataset.publish) {
      const id = publish.dataset.publish;
      const form = publish.closest('[data-item]')?.querySelector<HTMLFormElement>('[data-editor]');
      if (form && !form.hidden) {
        const saved = await saveEditor(form);
        if (!saved) return;
      }
      statusEl.textContent = 'Publishing…';
      const { error } = await supabase.rpc('publish_contribution', { p_id: id });
      statusEl.textContent = error ? error.message : 'Published.';
      if (!error) await loadItems();
    }
    if (remove?.dataset.delete) {
      if (!confirm('Remove this from the queue and the site?')) return;
      statusEl.textContent = 'Removing…';
      const { data: path, error } = await supabase.rpc('delete_contribution', { p_id: remove.dataset.delete });
      if (!error && path) await supabase.storage.from('contributions').remove([path]);
      statusEl.textContent = error ? error.message : 'Removed.';
      if (!error) await loadItems();
    }
  });

  async function upload(file: File, ext: string) {
    const path = `incoming/${crypto.randomUUID()}.${ext}`;
    const { error } = await supabase.storage.from('contributions').upload(path, file, {
      contentType: contentTypeFor(ext),
      upsert: false,
    });
    if (error) throw error;
    return path;
  }

  async function saveEditor(form: HTMLFormElement) {
    const kind = (form.dataset.kind ?? 'article') as Kind;
    const data = new FormData(form);
    const credit = String(data.get('credit') ?? '').trim().replace(/\s+/g, ' ');
    let caption: string | null = null;
    let title: string | null = null;
    let body: string | null = null;
    let link: string | null = null;
    let storagePath: string | null = null;
    if (credit.length < 2 || credit.length > 80) {
      statusEl.textContent = 'Add a sender name, up to 80 characters.';
      return false;
    }
    if (kind === 'photo' || kind === 'video') {
      caption = String(data.get('caption') ?? '').trim();
      if (caption.length < 2 || caption.length > 200) {
        statusEl.textContent = 'Add a subject.';
        return false;
      }
      const file = data.get('file') as File | null;
      if (file && file.size > 0) {
        const problem = kind === 'photo' ? photoProblem(file) : videoProblem(file);
        if (problem) {
          statusEl.textContent = problem;
          return false;
        }
        const ext = kind === 'photo' ? photoExtension(file) : videoExtension(file);
        if (!ext) return false;
        statusEl.textContent = 'Uploading…';
        try {
          storagePath = await upload(file, ext);
        } catch (error) {
          statusEl.textContent = error instanceof Error ? error.message : 'The file did not upload.';
          return false;
        }
      }
    } else if (kind === 'link') {
      title = String(data.get('title') ?? '').trim();
      caption = String(data.get('note') ?? '').trim() || null;
      link = cleanLinkUrl(String(data.get('url') ?? ''));
      if (title.length < 2 || title.length > 140 || !link || (caption && caption.length > 200)) {
        statusEl.textContent = link ? 'Add a subject.' : 'Use an https link.';
        return false;
      }
    } else {
      title = String(data.get('title') ?? '').trim();
      caption = String(data.get('summary') ?? '').trim() || null;
      body = String(data.get('body') ?? '').trim();
      if (title.length < 4 || title.length > 140 || body.length < GALLERY_BODY_MIN || body.length > GALLERY_BODY_MAX || (caption && caption.length > 280)) {
        statusEl.textContent = 'Add a subject and write the content.';
        return false;
      }
    }
    statusEl.textContent = 'Saving…';
    const { data: oldPath, error } = await supabase.rpc('edit_contribution', {
      p_id: form.dataset.editor,
      p_credit: credit,
      p_caption: caption,
      p_title: title,
      p_body: body,
      p_url: link,
      p_storage_path: storagePath,
    });
    if (error && storagePath) await supabase.storage.from('contributions').remove([storagePath]);
    if (!error && typeof oldPath === 'string' && oldPath && oldPath !== storagePath) {
      await supabase.storage.from('contributions').remove([oldPath]);
    }
    statusEl.textContent = error ? error.message : 'Saved.';
    if (!error) await loadItems();
    return !error;
  }

  admin.addEventListener('submit', async (event) => {
    const form = (event.target as HTMLElement).closest<HTMLFormElement>('[data-editor]');
    if (!form?.dataset.editor) return;
    event.preventDefault();
    await saveEditor(form);
  });

  addForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(addForm);
    const kind = kindOf();
    const credit = String(data.get('credit') ?? '').trim();
    let caption: string | null = null;
    let title: string | null = null;
    let body: string | null = null;
    let storagePath: string | null = null;
    let link: string | null = null;
    if (kind === 'photo' || kind === 'video') {
      caption = String(data.get('caption') ?? '').trim();
      const file = data.get(kind) as File | null;
      if (caption.length < 2) {
        statusEl.textContent = 'Add a caption.';
        return;
      }
      if (!file || file.size === 0) {
        statusEl.textContent = kind === 'photo' ? 'Choose a photo.' : 'Choose a video.';
        return;
      }
      const problem = kind === 'photo' ? photoProblem(file) : videoProblem(file);
      if (problem) {
        statusEl.textContent = problem;
        return;
      }
      const ext = kind === 'photo' ? photoExtension(file) : videoExtension(file);
      if (!ext) return;
      statusEl.textContent = 'Uploading…';
      try {
        storagePath = await upload(file, ext);
      } catch (error) {
        statusEl.textContent = error instanceof Error ? error.message : 'The file did not upload.';
        return;
      }
    } else if (kind === 'link') {
      title = String(data.get('title') ?? '').trim();
      caption = String(data.get('note') ?? '').trim() || null;
      link = cleanLinkUrl(String(data.get('url') ?? ''));
      if (title.length < 2 || !link) {
        statusEl.textContent = link ? 'Add a title.' : 'Use an https link.';
        return;
      }
    } else {
      title = String(data.get('title') ?? '').trim();
      caption = String(data.get('summary') ?? '').trim() || null;
      body = String(data.get('body') ?? '').trim();
      if (title.length < 4 || body.length < GALLERY_BODY_MIN || body.length > GALLERY_BODY_MAX) {
        statusEl.textContent = 'Add a title and write the article.';
        return;
      }
    }
    statusEl.textContent = 'Adding…';
    const { error } = await supabase.rpc('add_contribution', {
      p_kind: kind,
      p_credit: credit,
      p_caption: caption,
      p_title: title,
      p_body: body,
      p_storage_path: storagePath,
      p_url: link,
    });
    statusEl.textContent = error ? error.message : 'Added. It is on the site.';
    if (!error) {
      addForm.reset();
      showKind();
      await loadItems();
    }
  });

  async function showSession() {
    const { data } = await supabase.auth.getSession();
    const session = data.session;
    signedIn.hidden = !session;
    admin.hidden = true;
    denied.hidden = true;
    if (!session) {
      sendToLogin();
      return;
    }
    whoEl.textContent = session.user.email ?? 'Signed in';
    const account = await loadAccount(supabase);
    if (account) {
      const stop = await privateStop(supabase, account);
      if (stop) {
        denied.hidden = false;
        denied.textContent = stopMessage(stop);
        return;
      }
    }
    const { data: profile } = await supabase.from('profiles').select('is_admin').eq('id', session.user.id).maybeSingle();
    if (!profile?.is_admin) {
      denied.hidden = false;
      denied.textContent = 'This account cannot publish shared content.';
      return;
    }
    void noteActivity(supabase);
    admin.hidden = false;
    await loadItems();
  }

  void showSession();
</script>

<style>
  .share-admin {
    max-width: 52rem;
  }
  .lede,
  .hint,
  .who {
    color: var(--ink-200);
  }
  .hint {
    font-size: 0.85rem;
  }
  .stack {
    display: grid;
    gap: 0.75rem;
  }
  label,
  fieldset {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }
  .kinds label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .kinds input {
    width: auto;
  }
  input,
  textarea {
    width: 100%;
    background: var(--ink-900);
    color: #fff;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.75rem;
    font: inherit;
  }
  .editor {
    margin-top: 0.85rem;
    padding: 1rem;
    border: 2px solid var(--accent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg-card));
  }
  .editor__lead {
    margin: 0;
    font-weight: 600;
  }
  .field__name {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
  }
  .field__tag {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .field__hint {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  .editor input:not([type='file']),
  .editor textarea,
  html[data-theme='navy'] .editor input:not([type='file']),
  html[data-theme='navy'] .editor textarea,
  html[data-theme='light'] .editor input:not([type='file']),
  html[data-theme='light'] .editor textarea {
    background: #fff;
    color: #163556;
    color-scheme: light;
    border: 2px solid var(--accent);
    box-shadow: inset 0 1px 0 rgba(241, 90, 34, 0.12);
  }
  .editor input:not([type='file']):focus,
  .editor textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .editor__actions {
    margin-top: 0.25rem;
  }
  .editor__publish,
  html[data-theme='navy'] .editor__publish,
  html[data-theme='light'] .editor__publish {
    border-color: var(--accent);
    color: var(--accent);
    background: #fff;
  }
  .status:empty {
    display: none;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  h2 {
    margin-top: 1.5rem;
  }
  .item {
    display: grid;
    gap: 0.6rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 700px) {
    .item {
      grid-template-columns: 12rem 1fr;
      align-items: start;
    }
  }
  .item h3 {
    margin: 0.25rem 0;
  }
  .item img,
  .item video {
    width: 100%;
    border-radius: var(--radius-sm);
    background: var(--ink-700);
  }
  .item a {
    overflow-wrap: anywhere;
  }
  [hidden] {
    display: none !important;
  }
</style>
