---
import Base from '@/layouts/Base.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
---

<Base
  title="Matches"
  description="Fixtures, availability and team selection for Bedfordshire squash captains."
  noindex
>
  <section class="section">
    <div class="container" id="match-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <h1>Matches</h1>
      <p class="lede">
        Fixtures come from League Master each morning. Switch between this season and last season, pick a match, mark who is in or out, then set the playing order. Nothing is emailed.
      </p>
      <p class="status" data-status role="status"></p>

      <div data-panel="signed-in" hidden>
        <p class="who" data-who></p>
        <p class="actions">
          <a class="btn btn--ghost btn--sm" data-squad-link href={`${import.meta.env.BASE_URL}captains/`}>Squad</a>
          <a class="btn btn--ghost btn--sm" data-admin-link hidden href={`${import.meta.env.BASE_URL}captains/admin/`}>Administration</a>
          <a class="btn btn--ghost btn--sm" href={`${import.meta.env.BASE_URL}captains/profile/`}>Profile</a>
          <button class="btn btn--ghost btn--sm" type="button" data-sign-out>Sign out</button>
        </p>

        <div class="card" data-unassigned hidden>
          <div class="card__body">
            <h2>No team yet</h2>
            <p class="muted">An admin matches your account to a team. When that is done your fixtures appear here.</p>
          </div>
        </div>

        <nav class="season-menu" data-season-menu aria-label="Season" hidden></nav>
        <nav class="team-menu" data-team-menu aria-label="Teams"></nav>

        <div class="layout" data-layout hidden>
          <aside class="fixture-list">
            <h2 class="h-small">Fixtures</h2>
            <ol class="fixtures" data-fixtures></ol>
          </aside>
          <section class="match" data-match></section>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { loadAccount, sendToLogin } from '@/lib/account';

  type Season = { id: number; name: string; starts_on: string | null };
  type Squad = { id: number; name: string; team_id: number | null };
  type LeagueTeam = { id: number; name: string; club_slug: string | null; team_id: number | null };
  type Fixture = {
    id: number;
    starts_at: string;
    status: string;
    home_points: number | null;
    away_points: number | null;
    home_games: number | null;
    away_games: number | null;
    home: LeagueTeam;
    away: LeagueTeam;
    divisions: { name: string; scoring: string | null } | null;
  };
  type Player = { id: number; display_name: string; email: string | null; phone: string | null };
  type Availability = { id: number; squad_player_id: number; status: 'in' | 'out' | 'maybe' };
  type Selection = { id: number; squad_player_id: number; position: number };
  type Rubber = { position: number; home_player: string | null; away_player: string | null; score: string | null; winner: string };
  type Nomination = { period: number; position: number; player_name: string };

  const root = document.getElementById('match-app');
  if (!root) throw new Error('match app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const signedIn = root.querySelector<HTMLElement>('[data-panel="signed-in"]')!;
  const unassigned = root.querySelector<HTMLElement>('[data-unassigned]')!;
  const adminLink = root.querySelector<HTMLElement>('[data-admin-link]')!;
  const seasonMenu = root.querySelector<HTMLElement>('[data-season-menu]')!;
  const teamMenu = root.querySelector<HTMLElement>('[data-team-menu]')!;
  const layout = root.querySelector<HTMLElement>('[data-layout]')!;
  const fixtureList = root.querySelector<HTMLElement>('[data-fixtures]')!;
  const matchHost = root.querySelector<HTMLElement>('[data-match]')!;

  const POSITIONS = 6;
  let userId = '';
  let seasons: Season[] = [];
  let currentSeason: Season | null = null;
  let squads: Squad[] = [];
  let clubNames = new Map<string, string>();
  let currentSquad: Squad | null = null;
  let fixtures: Fixture[] = [];
  let currentFixture: Fixture | null = null;
  let players: Player[] = [];
  let playerOnly = false;
  let canAddPlayers = false;
  let accountEmail = '';

  const setStatus = (message: string) => {
    statusEl.textContent = message;
  };
  const esc = (value: string | null | undefined) =>
    String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
  const fmtDate = (iso: string) =>
    new Date(iso).toLocaleString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
  const isPast = (fixture: Fixture) => new Date(fixture.starts_at).getTime() < Date.now() - 6 * 3600_000;
  const ours = (fixture: Fixture) => (fixture.home.team_id === currentSquad?.team_id ? 'home' : 'away');

  root.querySelector('[data-sign-out]')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    await showSession();
  });

  seasonMenu.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-pick-season]');
    if (!button || !currentSquad) return;
    const season = seasons.find((s) => s.id === Number(button.dataset.pickSeason));
    if (season) void pickSeason(season);
  });

  teamMenu.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-pick-squad]');
    if (!button) return;
    const squad = squads.find((s) => s.id === Number(button.dataset.pickSquad));
    if (squad) void pickSquad(squad);
  });

  fixtureList.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-pick-fixture]');
    if (!button) return;
    const fixture = fixtures.find((f) => f.id === Number(button.dataset.pickFixture));
    if (fixture) void pickFixture(fixture);
  });

  matchHost.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const availButton = target.closest<HTMLButtonElement>('[data-avail]');
    if (availButton && currentFixture) {
      await setAvailability(Number(availButton.dataset.player), availButton.dataset.avail as Availability['status'] | 'clear');
      return;
    }
    const nomButton = target.closest<HTMLButtonElement>('[data-add-nomination]');
    if (nomButton && currentSquad && canAddPlayers) {
      const { error } = await supabase
        .from('squad_players')
        .insert({ squad_id: currentSquad.id, display_name: nomButton.dataset.addNomination });
      if (error) setStatus(error.message);
      else await refreshMatch();
      return;
    }
    const clearButton = target.closest<HTMLButtonElement>('[data-clear-selection]');
    if (clearButton && currentFixture && currentSquad && !playerOnly) {
      const { error } = await supabase
        .from('selections')
        .delete()
        .eq('fixture_id', currentFixture.id)
        .eq('squad_id', currentSquad.id);
      if (error) setStatus(error.message);
      else await refreshMatch();
    }
  });

  matchHost.addEventListener('change', async (event) => {
    const select = (event.target as HTMLElement).closest<HTMLSelectElement>('[data-position]');
    if (!select || !currentFixture || !currentSquad || playerOnly) return;
    await setPosition(Number(select.dataset.position), select.value ? Number(select.value) : null);
  });

  matchHost.addEventListener('submit', async (event) => {
    const form = event.target as HTMLFormElement;
    if (!form.matches('[data-form="player"]') || !currentSquad || !canAddPlayers) return;
    event.preventDefault();
    const data = new FormData(form);
    const email = String(data.get('email') ?? '').trim();
    const { error } = await supabase.from('squad_players').insert({
      squad_id: currentSquad.id,
      display_name: String(data.get('display_name')).trim(),
      email: email || null,
    });
    if (error) {
      setStatus(error.message);
      return;
    }
    form.reset();
    await refreshMatch();
  });

  async function setAvailability(playerId: number, status: Availability['status'] | 'clear') {
    if (!currentFixture) return;
    if (playerOnly && !players.some((player) => player.id === playerId)) return;
    setStatus('Saving…');
    const { data: existing } = await supabase
      .from('availability')
      .select('id')
      .eq('fixture_id', currentFixture.id)
      .eq('squad_player_id', playerId)
      .maybeSingle();
    let error;
    if (status === 'clear') {
      if (existing) ({ error } = await supabase.from('availability').delete().eq('id', existing.id));
    } else if (existing) {
      ({ error } = await supabase.from('availability').update({ status, set_by: userId }).eq('id', existing.id));
    } else {
      ({ error } = await supabase
        .from('availability')
        .insert({ fixture_id: currentFixture.id, squad_player_id: playerId, status, set_by: userId }));
    }
    setStatus(error ? error.message : '');
    if (!error) await refreshMatch();
  }

  async function setPosition(playerId: number, position: number | null) {
    if (!currentFixture || !currentSquad || playerOnly) return;
    setStatus('Saving…');
    // Remove this player's existing slot and anyone already in the target slot.
    let query = supabase
      .from('selections')
      .delete()
      .eq('fixture_id', currentFixture.id)
      .eq('squad_id', currentSquad.id);
    query = position ? query.or(`squad_player_id.eq.${playerId},position.eq.${position}`) : query.eq('squad_player_id', playerId);
    let { error } = await query;
    if (!error && position) {
      ({ error } = await supabase.from('selections').insert({
        fixture_id: currentFixture.id,
        squad_id: currentSquad.id,
        squad_player_id: playerId,
        position,
      }));
    }
    setStatus(error ? error.message : '');
    if (!error) await refreshMatch();
  }

  async function showSession() {
    const account = await loadAccount(supabase);
    signedIn.hidden = !account;
    if (!account) {
      teamMenu.replaceChildren();
      layout.hidden = true;
      unassigned.hidden = true;
      playerOnly = false;
      sendToLogin();
      return;
    }
    userId = account.userId;
    playerOnly = account.playerOnly;
    canAddPlayers = account.isAdmin;
    accountEmail = account.email.toLowerCase();
    root!.querySelector('[data-who]')!.textContent = `Signed in as ${account.displayName || account.email}`;
    root!.querySelector('[data-squad-link]')!.textContent = account.playerOnly ? 'Your team' : 'Squad';
    adminLink.hidden = !account.isAdmin;

    const [squadResult, { data: clubRows }, { data: seasonRows }] = await Promise.all([
      supabase.from('captain_squads').select('id, name, team_id').not('team_id', 'is', null).order('name'),
      supabase.from('clubs').select('slug, name'),
      supabase.from('league_seasons').select('id, name, starts_on').order('starts_on', { ascending: false }),
    ]);
    let squadRows = squadResult.data;
    let squadError = squadResult.error;
    if (playerOnly && accountEmail && (squadError || !(squadRows ?? []).length)) {
      const { data: ownPlayers } = await supabase.from('squad_players').select('squad_id').ilike('email', accountEmail);
      const ids = [...new Set((ownPlayers ?? []).map((row: { squad_id: number }) => row.squad_id))];
      if (ids.length) {
        const { data: ownSquads, error: ownError } = await supabase
          .from('captain_squads')
          .select('id, name, team_id')
          .in('id', ids)
          .not('team_id', 'is', null);
        if (!ownError && ownSquads?.length) {
          squadRows = ownSquads;
          squadError = null;
        }
      }
    }
    if (squadError && !playerOnly) {
      setStatus(squadError.message);
      return;
    }
    squads = squadError ? [] : ((squadRows ?? []) as Squad[]);
    // The two latest seasons: this winter, then last winter as the worked example.
    seasons = ((seasonRows ?? []) as Season[]).slice(0, 2);
    clubNames = new Map((clubRows ?? []).map((c: { slug: string; name: string }) => [c.slug, c.name]));
    unassigned.hidden = squads.length > 0;
    layout.hidden = squads.length === 0;
    teamMenu.replaceChildren();
    teamMenu.hidden = squads.length < 2;
    for (const squad of squads) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'pill';
      button.dataset.pickSquad = String(squad.id);
      button.textContent = squad.name;
      teamMenu.append(button);
    }
    renderSeasonMenu();
    if (squads.length) {
      const hash = location.hash.replace('#', '');
      const [seasonPart, squadPart] = hash.split('/');
      const wantedSeason = seasons.find((s) => s.id === Number(seasonPart));
      const wantedSquad = Number(squadPart ?? seasonPart);
      // No choice in the link: open on last season, which is the worked example.
      currentSeason = wantedSeason ?? seasons[1] ?? seasons[0] ?? null;
      await pickSquad(squads.find((s) => s.id === wantedSquad) ?? squads[0]);
    }
  }

  function seasonLabel(season: Season, index: number) {
    if (index === 0) return 'This season';
    if (index === 1) return 'Last season';
    return season.name;
  }

  function renderSeasonMenu() {
    seasonMenu.replaceChildren();
    seasonMenu.hidden = seasons.length < 2;
    seasons.forEach((season, index) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'pill';
      button.dataset.pickSeason = String(season.id);
      button.innerHTML = `${esc(seasonLabel(season, index))} <span class="pill__sub">${esc(season.name)}</span>`;
      seasonMenu.append(button);
    });
    markSeason();
  }

  function markSeason() {
    seasonMenu.querySelectorAll<HTMLButtonElement>('[data-pick-season]').forEach((b) => {
      b.classList.toggle('pill--active', Number(b.dataset.pickSeason) === currentSeason?.id);
    });
  }

  async function pickSeason(season: Season) {
    currentSeason = season;
    markSeason();
    if (currentSquad) await pickSquad(currentSquad);
  }

  async function pickSquad(squad: Squad) {
    currentSquad = squad;
    history.replaceState(null, '', `#${currentSeason?.id ?? ''}/${squad.id}`);
    teamMenu.querySelectorAll<HTMLButtonElement>('[data-pick-squad]').forEach((b) => {
      b.classList.toggle('pill--active', Number(b.dataset.pickSquad) === squad.id);
    });
    let teamQuery = supabase.from('league_teams').select('id, divisions!inner(season_id)').eq('team_id', squad.team_id);
    if (currentSeason) teamQuery = teamQuery.eq('divisions.season_id', currentSeason.id);
    const { data: leagueTeams } = await teamQuery;
    const ids = (leagueTeams ?? []).map((t: { id: number }) => t.id);
    if (!ids.length) {
      fixtures = [];
      fixtureList.innerHTML = `<li class="muted">No fixtures for this team in ${esc(currentSeason?.name ?? 'this season')}.</li>`;
      matchHost.innerHTML = '';
      return;
    }
    const { data: rows, error } = await supabase
      .from('fixtures')
      .select(
        'id, starts_at, status, home_points, away_points, home_games, away_games, divisions (name, scoring), ' +
          'home:league_teams!fixtures_home_team_id_fkey (id, name, club_slug, team_id), ' +
          'away:league_teams!fixtures_away_team_id_fkey (id, name, club_slug, team_id)',
      )
      .or(`home_team_id.in.(${ids.join(',')}),away_team_id.in.(${ids.join(',')})`)
      .order('starts_at');
    if (error) {
      setStatus(error.message);
      return;
    }
    fixtures = (rows ?? []) as unknown as Fixture[];
    renderFixtureList();
    const next = fixtures.find((f) => !isPast(f)) ?? fixtures[fixtures.length - 1];
    if (next) await pickFixture(next);
    else matchHost.innerHTML = '<p class="muted">No fixtures yet.</p>';
  }

  function renderFixtureList() {
    fixtureList.innerHTML = fixtures
      .map((f) => {
        const side = ours(f);
        const opponent = side === 'home' ? f.away.name : f.home.name;
        const past = isPast(f);
        const score =
          f.status === 'played' && f.home_points != null
            ? ` <span class="score">${side === 'home' ? f.home_points : f.away_points}–${side === 'home' ? f.away_points : f.home_points}</span>`
            : '';
        return (
          `<li><button type="button" class="fixture${past ? ' fixture--past' : ''}${f.id === currentFixture?.id ? ' fixture--active' : ''}" data-pick-fixture="${f.id}">` +
          `<span class="fixture__date">${esc(fmtDate(f.starts_at))}</span>` +
          `<span class="fixture__who">${side === 'home' ? 'v' : 'at'} ${esc(opponent)}${score}</span>` +
          `${f.status !== 'scheduled' && f.status !== 'played' ? `<span class="tag">${esc(f.status)}</span>` : ''}` +
          `</button></li>`
        );
      })
      .join('');
  }

  async function pickFixture(fixture: Fixture) {
    currentFixture = fixture;
    renderFixtureList();
    await refreshMatch();
  }

  async function refreshMatch() {
    if (!currentFixture || !currentSquad) return;
    const fixture = currentFixture;
    const squad = currentSquad;
    const [playersRes, availRes, selRes, rubberRes, nomRes] = await Promise.all([
      supabase.from('squad_players').select('id, display_name, email, phone').eq('squad_id', squad.id).order('display_name'),
      supabase.from('availability').select('id, squad_player_id, status').eq('fixture_id', fixture.id),
      supabase.from('selections').select('id, squad_player_id, position').eq('fixture_id', fixture.id).eq('squad_id', squad.id),
      fixture.status === 'played'
        ? supabase.from('rubbers').select('position, home_player, away_player, score, winner').eq('fixture_id', fixture.id).order('position')
        : Promise.resolve({ data: [] as Rubber[] }),
      supabase
        .from('nominations')
        .select('period, position, player_name')
        .eq('team_id', squad.team_id)
        .eq('season', currentSeason?.name ?? '')
        .order('period')
        .order('position'),
    ]);
    players = (playersRes.data ?? []) as Player[];
    if (playerOnly) {
      players = players.filter((player) => (player.email ?? '').toLowerCase() === accountEmail);
    }
    const avail = new Map(((availRes.data ?? []) as Availability[]).map((a) => [a.squad_player_id, a.status]));
    const selected = new Map(((selRes.data ?? []) as Selection[]).map((s) => [s.squad_player_id, s.position]));
    const rubbers = (rubberRes.data ?? []) as Rubber[];
    const nominations = (nomRes.data ?? []) as Nomination[];

    const side = ours(fixture);
    const opponent = side === 'home' ? fixture.away : fixture.home;
    const venue = clubNames.get(fixture.home.club_slug ?? '') ?? fixture.home.name;
    const counts = { in: 0, out: 0, maybe: 0 };
    const mine = new Set(players.map((player) => player.id));
    for (const [id, status] of avail) {
      if (playerOnly && !mine.has(id)) continue;
      counts[status] += 1;
    }
    const order = [...selected.entries()].sort((a, b) => a[1] - b[1]);
    const nameOf = (id: number) => players.find((p) => p.id === id)?.display_name ?? '?';
    const known = new Set(players.map((p) => p.display_name.toLowerCase()));
    const missingNoms = nominations.filter((n, i, all) => !known.has(n.player_name.toLowerCase()) && all.findIndex((x) => x.player_name.toLowerCase() === n.player_name.toLowerCase()) === i);

    const rows = players
      .map((p) => {
        const status = avail.get(p.id);
        const pos = selected.get(p.id);
        const options = ['<option value="">–</option>']
          .concat(Array.from({ length: POSITIONS }, (_, i) => `<option value="${i + 1}"${pos === i + 1 ? ' selected' : ''}>${i + 1}</option>`))
          .join('');
        const btn = (value: Availability['status'], label: string) =>
          `<button type="button" class="avail avail--${value}${status === value ? ' avail--on' : ''}" data-avail="${value}" data-player="${p.id}">${label}</button>`;
        return (
          `<tr class="${status ? `row--${status}` : ''}">` +
          `<td class="name">${esc(p.display_name)}</td>` +
          `<td class="avail-cell">${btn('in', 'In')}${btn('maybe', 'Maybe')}${btn('out', 'Out')}` +
          `${status ? `<button type="button" class="avail avail--clear" data-avail="clear" data-player="${p.id}" title="Clear">×</button>` : ''}</td>` +
          (playerOnly
            ? ''
            : `<td><select class="pos" data-position="${p.id}" aria-label="Position for ${esc(p.display_name)}">${options}</select></td>`) +
          `</tr>`
        );
      })
      .join('');

    matchHost.innerHTML = `
      <header class="match__head">
        <p class="eyebrow">${esc(fixture.divisions?.name ?? '')}${fixture.divisions?.scoring ? ` · ${esc(fixture.divisions.scoring)}` : ''}</p>
        <h2>${esc(squad.name)} ${side === 'home' ? 'v' : 'at'} ${esc(opponent.name)}</h2>
        <p class="meta">${esc(fmtDate(fixture.starts_at))} · ${side === 'home' ? 'Home' : 'Away'} at ${esc(venue)}${
          fixture.status !== 'scheduled' ? ` · <span class="tag">${esc(fixture.status)}</span>` : ''
        }</p>
        ${
          fixture.status === 'played' && fixture.home_points != null
            ? `<p class="result">Result: ${esc(fixture.home.name)} ${fixture.home_points} – ${fixture.away_points} ${esc(fixture.away.name)}` +
              `${fixture.home_games != null ? ` <span class="muted">(games ${fixture.home_games}–${fixture.away_games})</span>` : ''}</p>`
            : ''
        }
      </header>
      ${
        rubbers.length
          ? `<table class="rubbers"><thead><tr><th>#</th><th>${esc(fixture.home.name)}</th><th>${esc(fixture.away.name)}</th><th>Score</th></tr></thead><tbody>${rubbers
              .map(
                (r) =>
                  `<tr><td>${r.position}</td><td class="${r.winner === 'home' ? 'won' : ''}">${esc(r.home_player)}</td>` +
                  `<td class="${r.winner === 'away' ? 'won' : ''}">${esc(r.away_player)}</td><td>${esc(r.score)}</td></tr>`,
              )
              .join('')}</tbody></table>`
          : ''
      }
      <div class="summary">
        <span class="chip chip--in">${counts.in} in</span>
        <span class="chip chip--maybe">${counts.maybe} maybe</span>
        <span class="chip chip--out">${counts.out} out</span>
        <span class="chip">${players.length - counts.in - counts.out - counts.maybe} no reply</span>
      </div>
      <table class="squad">
        <thead><tr><th>Player</th><th>Availability</th>${playerOnly ? '' : '<th>Order</th>'}</tr></thead>
        <tbody>${
          rows ||
          (playerOnly
            ? '<tr><td colspan="2" class="muted">Your captain has not added your email to this squad yet, so you cannot mark availability.</td></tr>'
            : '<tr><td colspan="3" class="muted">No players in this squad yet.</td></tr>')
        }</tbody>
      </table>
      ${
        playerOnly
          ? ''
          : `<div class="selection">
        <h3>Team for this match</h3>
        ${
          order.length
            ? `<ol class="team">${order.map(([id, pos]) => `<li><span class="num">${pos}</span> ${esc(nameOf(id))}</li>`).join('')}</ol>` +
              `<button type="button" class="btn btn--ghost btn--sm" data-clear-selection>Clear team</button>`
            : '<p class="muted">Use the Order column to pick who plays at each string.</p>'
        }
      </div>
      ${
        canAddPlayers
          ? `<details class="extras">
        <summary>Add players</summary>
        <form class="player-form" data-form="player">
          <label>Name <input name="display_name" required minlength="2" maxlength="80" /></label>
          <label>Email <input name="email" type="email" autocomplete="off" /></label>
          <button class="btn btn--primary btn--sm" type="submit">Add to squad</button>
        </form>
        ${
          missingNoms.length
            ? `<h4>On the League Master nomination list but not in your squad</h4><ul class="noms">${missingNoms
                .map(
                  (n) =>
                    `<li>${esc(n.player_name)} <span class="muted">P${n.period} #${n.position}</span> ` +
                    `<button type="button" class="btn btn--ghost btn--sm" data-add-nomination="${esc(n.player_name)}">Add</button></li>`,
                )
                .join('')}</ul>`
            : nominations.length
              ? '<p class="muted">Everyone on the League Master nomination list is already in this squad.</p>'
              : '<p class="muted">League Master has not published a nomination list for this team yet. Names are pulled in automatically when it does.</p>'
        }
      </details>`
          : ''
      }`
      }`;
  }

  showSession();
</script>

