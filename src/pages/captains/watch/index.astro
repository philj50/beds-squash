---
import Base from '@/layouts/Base.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { url } from '@/lib/site';
---

<Base
  title="Match commentary"
  description="Follow a squash match being marked on Beds Squash, and hear the score as it changes."
  noindex
  crumbs={[{ name: 'Match commentary', path: '/captains/watch/' }]}
>
  <section class="section">
    <div class="container watch" id="watch-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY} data-login={url('/login/')}>
      <h1>Match commentary</h1>
      <p class="lede">Choose a match that is being marked. The score updates as each point is entered. Tick Say the score to hear it.</p>
      <p class="ntfy">
        <a href="https://ntfy.sh/beds_commentary_1234" target="_blank" rel="noopener noreferrer">Subscribe on ntfy</a>
        for a note when a match goes on. The topic is beds_commentary_1234.
      </p>
      <p class="status" data-status role="status"></p>

      <div data-picker>
        <p class="current-note" data-empty></p>
        <ul class="matches" data-matches></ul>
      </div>

      <div class="live" data-live hidden>
        <p class="actions">
          <button class="btn btn--ghost btn--sm" type="button" data-back>Choose another match</button>
        </p>
        <div class="names">
          <p data-a></p>
          <p data-b></p>
        </div>
        <p class="points" data-points></p>
        <p class="clock" data-clock></p>
        <ul class="game-times" data-times></ul>
        <p class="call" data-call></p>
        <p class="marker" data-marker></p>
        <p class="updated" data-updated></p>
        <p class="note" data-note></p>
        <label class="say">
          <input type="checkbox" data-say />
          Say the score
        </label>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import {
    currentGame,
    currentRallies,
    finishedGames,
    liveMatchCurrent,
    matchWinner,
    publicPlayerName,
    restoreMatch,
    spokenMark,
    spokenPublicLine,
    unpackLiveScore,
  } from '@/lib/scoreboard';

  type LiveRow = {
    id: number;
    playerA: string;
    playerB: string;
    score: string;
    marker: string | null;
    updatedAt: string;
    history: unknown;
  };

  const root = document.getElementById('watch-app');
  if (!root) throw new Error('watch app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const picker = root.querySelector<HTMLElement>('[data-picker]')!;
  const list = root.querySelector<HTMLElement>('[data-matches]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  const live = root.querySelector<HTMLElement>('[data-live]')!;
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const sayBox = root.querySelector<HTMLInputElement>('[data-say]')!;

  let signedIn = false;
  let rows: LiveRow[] = [];
  let matchId: number | null = null;
  let stamp = '';
  let sayScore = localStorage.getItem('beds-say-score') === '1';
  let heard = '';
  let voiceArmed = false;
  let heardRestart = 0;
  let clockText = '';
  let clockAt = 0;
  let clockLive = false;
  sayBox.checked = sayScore;

  const shown = (name: string) => (signedIn ? name : publicPlayerName(name));
  const pretty = (score: string) => (score || '0-0').replace(/-/g, '–');

  function show(message: string) {
    statusEl.textContent = message;
  }

  function missingFunction(error: { code?: string; message?: string } | null) {
    const message = error?.message ?? '';
    return error?.code === 'PGRST202' || /could not find the function/i.test(message) || /schema cache/i.test(message);
  }

  function updatedAgo(iso: string) {
    const then = new Date(iso).getTime();
    if (Number.isNaN(then)) return '';
    const seconds = Math.max(0, Math.round((Date.now() - then) / 1000));
    if (seconds < 15) return 'Updated just now';
    if (seconds < 60) return `Updated ${seconds}s ago`;
    const minutes = Math.round(seconds / 60);
    return minutes === 1 ? 'Updated 1 min ago' : `Updated ${minutes} min ago`;
  }

  let speakTimer = 0;

  function speak(text: string, quietAfter = text) {
    if (!sayScore || !text || !window.speechSynthesis) return;
    heard = text;
    const synth = window.speechSynthesis;
    window.clearTimeout(speakTimer);
    synth.cancel();
    speakTimer = window.setTimeout(() => {
      if (!sayScore || heard !== text) return;
      heard = quietAfter;
      const line = new SpeechSynthesisUtterance(text);
      line.lang = 'en-GB';
      line.rate = 0.95;
      synth.resume();
      synth.speak(line);
    }, 80);
  }

  function announce(text: string) {
    if (!text) return;
    if (!voiceArmed) {
      heard = text;
      voiceArmed = true;
      return;
    }
    if (text === heard) return;
    speak(text);
  }

  function shownClock() {
    if (!clockText) return '';
    if (!clockLive) return clockText;
    const [minutes, seconds] = clockText.split(':').map((part) => Number(part) || 0);
    const total = minutes * 60 + seconds + Math.max(0, Math.floor((Date.now() - clockAt) / 1000));
    const nextMinutes = Math.floor(total / 60);
    const nextSeconds = total % 60;
    return `${String(nextMinutes).padStart(2, '0')}:${String(nextSeconds).padStart(2, '0')}`;
  }

  function paintClock() {
    const clock = root.querySelector<HTMLElement>('[data-clock]');
    if (!clock) return;
    const text = shownClock();
    clock.textContent = text ? `This game ${text}` : '';
  }

  function paintTimes(line: string, times: string[]) {
    const list = root.querySelector<HTMLElement>('[data-times]')!;
    const parts = line && line !== '0-0' ? line.split(',').map((part) => part.trim()).filter(Boolean) : [];
    list.replaceChildren();
    times.forEach((time, index) => {
      const item = document.createElement('li');
      const label = document.createElement('span');
      label.className = 'label';
      label.textContent = `Game ${index + 1}`;
      const score = document.createElement('span');
      score.className = 'game-score';
      score.textContent = (parts[index] || '').replace('-', '–');
      const taken = document.createElement('span');
      taken.className = 'time';
      taken.textContent = time;
      item.append(label, score, taken);
      list.append(item);
    });
  }

  function paintList() {
    live.hidden = true;
    picker.hidden = false;
    list.replaceChildren();
    if (!rows.length) {
      empty.textContent = empty.textContent || 'No matches are being marked right now.';
      return;
    }
    empty.textContent = '';
    for (const row of rows) {
      const item = document.createElement('li');
      const button = document.createElement('button');
      button.type = 'button';
      const players = document.createElement('span');
      players.textContent = `${shown(row.playerA)} v ${shown(row.playerB)}`;
      const score = document.createElement('span');
      score.textContent = pretty(unpackLiveScore(row.score).line);
      button.append(players, score);
      button.addEventListener('click', () => openMatch(row.id));
      item.append(button);
      list.append(item);
    }
  }

  function paintLive(row: LiveRow) {
    const names = { a: shown(row.playerA), b: shown(row.playerB) };
    const shared = unpackLiveScore(row.score || '0-0');
    const restored = signedIn ? restoreMatch(row.history) : null;
    const said = shared.call || spokenPublicLine(names.a, names.b, shared.line);
    const nextStamp = `${shared.line}|${shared.restart}|${said}|${restored ? JSON.stringify(restored) : `${names.a}|${names.b}`}`;
    const changed = nextStamp !== stamp;
    const restarting = voiceArmed && shared.restart !== heardRestart;
    stamp = nextStamp;
    heardRestart = shared.restart;
    picker.hidden = true;
    live.hidden = false;
    root.querySelector<HTMLElement>('[data-a]')!.textContent = names.a;
    root.querySelector<HTMLElement>('[data-b]')!.textContent = names.b;
    root.querySelector<HTMLElement>('[data-updated]')!.textContent = updatedAgo(row.updatedAt);
    clockText = shared.clock;
    clockAt = new Date(row.updatedAt).getTime() || Date.now();
    clockLive = Boolean(shared.clock);
    paintClock();
    paintTimes(shared.line, shared.times);
    const marker = root.querySelector<HTMLElement>('[data-marker]')!;
    const note = root.querySelector<HTMLElement>('[data-note]')!;
    const call = root.querySelector<HTMLElement>('[data-call]')!;
    const points = root.querySelector<HTMLElement>('[data-points]')!;
    if (!restored) {
      const parts = shared.line && shared.line !== '0-0' ? shared.line.split(',').map((part) => part.trim()).filter(Boolean) : [];
      const current = parts.length > shared.times.length ? parts[parts.length - 1] : '0-0';
      points.textContent = pretty(current).replace('–', ' – ');
      call.textContent = said;
      marker.textContent = '';
      note.replaceChildren();
      if (!signedIn) {
        const link = document.createElement('a');
        link.href = root.dataset.login || '/login/';
        link.textContent = 'Sign in';
        note.append(link, ' to see the full names and every point.');
      }
      if (restarting && shared.times.length) {
        speak(spokenPublicLine(names.a, names.b, shared.line), said);
        return;
      }
      if (changed) announce(said);
      return;
    }
    note.textContent = '';
    const score = currentGame(restored);
    points.textContent = `${score.a} – ${score.b}`;
    const winner = matchWinner(restored);
    const between = !winner && currentRallies(restored).length === 0 && finishedGames(restored).length > 0;
    const phase = winner ? 'done' : between ? 'next' : 'play';
    call.textContent = spokenMark(restored, names, phase);
    marker.textContent = row.marker ? `Marked by ${row.marker}` : '';
    if (restarting && finishedGames(restored).length) {
      speak(spokenMark(restored, names, 'next'), call.textContent);
      return;
    }
    if (changed) announce(call.textContent);
  }

  function openMatch(id: number) {
    matchId = id;
    stamp = '';
    voiceArmed = false;
    heard = '';
    heardRestart = 0;
    const url = new URL(location.href);
    url.searchParams.set('match', String(id));
    history.replaceState(null, '', `${url.pathname}${url.search}`);
    const row = rows.find((item) => item.id === id);
    if (row) paintLive(row);
    else show('That match is not being shared.');
  }

  function leaveMatch() {
    matchId = null;
    stamp = '';
    voiceArmed = false;
    const url = new URL(location.href);
    url.searchParams.delete('match');
    history.replaceState(null, '', url.pathname);
    window.speechSynthesis?.cancel();
    paintList();
  }

  async function loadRows() {
    const { data, error } = await supabase.rpc('current_matches');
    if (error && missingFunction(error)) {
      empty.textContent = 'Live matches are not on the database yet.';
      list.replaceChildren();
      return;
    }
    if (error) {
      show(error.message);
      return;
    }
    show('');
    rows = (Array.isArray(data) ? (data as LiveRow[]) : []).filter((row) => liveMatchCurrent(row.updatedAt));
    if (matchId) {
      const row = rows.find((item) => item.id === matchId);
      if (!row) {
        show('That match is no longer being shared.');
        leaveMatch();
        return;
      }
      paintLive(row);
      return;
    }
    empty.textContent = rows.length ? '' : 'No matches are being marked right now.';
    paintList();
  }

  sayBox.addEventListener('change', () => {
    sayScore = sayBox.checked;
    localStorage.setItem('beds-say-score', sayScore ? '1' : '0');
    if (!sayScore) {
      window.speechSynthesis?.cancel();
      return;
    }
    if (!window.speechSynthesis) {
      show('This browser cannot read the score aloud.');
      return;
    }
    voiceArmed = true;
    heard = '';
    const row = rows.find((item) => item.id === matchId);
    const shared = row ? unpackLiveScore(row.score || '0-0') : null;
    const text = root.querySelector('[data-call]')?.textContent
      || (row && shared ? shared.call || spokenPublicLine(shown(row.playerA), shown(row.playerB), shared.line) : '');
    speak(text || 'The score will be read out.');
  });

  root.querySelector('[data-back]')!.addEventListener('click', () => leaveMatch());

  const { data } = await supabase.auth.getSession();
  signedIn = Boolean(data.session);
  const requested = Number(new URLSearchParams(location.search).get('match'));
  if (requested) matchId = requested;
  await loadRows();
  window.setInterval(() => void loadRows(), 2000);
  window.setInterval(paintClock, 1000);
</script>

<style>
  .watch {
    max-width: 52rem;
  }
  .lede,
  .note,
  .updated,
  .status {
    color: var(--text-muted);
  }
  .status:empty,
  .note:empty,
  .call:empty,
  .marker:empty,
  .points:empty,
  .clock:empty,
  .updated:empty,
  .current-note:empty {
    display: none;
  }
  .matches {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .ntfy {
    margin: 0.35rem 0 0;
    font-weight: 700;
  }
  .ntfy a {
    font-weight: 800;
  }
  .matches :global(button) {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding: 1.15rem 1.2rem;
    background: #fff;
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    color: var(--text);
    font: inherit;
    font-size: clamp(1.35rem, 3.4vw, 1.85rem);
    font-weight: 800;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
  }
  .matches :global(button:hover) {
    border-color: #f15a22;
  }
  .matches :global(span:last-child) {
    color: #e0a800;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1;
  }
  .names {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .names p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 8vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
  }
  .names p:first-child {
    color: #0e2744;
  }
  .names p:last-child {
    color: #f15a22;
    text-align: right;
  }
  .points,
  .call {
    margin: 0.35rem 0 0;
    text-align: center;
    font-weight: 800;
  }
  .points {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 14vw, 6.5rem);
    line-height: 1;
  }
  .call {
    font-size: clamp(1.55rem, 4.6vw, 2.35rem);
    line-height: 1.25;
  }
  .clock {
    margin: 0.2rem 0 0;
    text-align: center;
    color: var(--text-muted);
    font-weight: 700;
  }
  .game-times {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }
  .game-times:empty {
    display: none;
  }
  .game-times :global(li) {
    min-width: 5.4rem;
    padding: 0.45rem 0.7rem 0.5rem;
    background: #fff;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    text-align: center;
  }
  .game-times :global(.label),
  .game-times :global(.time) {
    display: block;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .game-times :global(.game-score) {
    display: block;
    margin: 0.1rem 0;
    color: #0e2744;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.2rem);
    font-weight: 800;
  }
  .marker {
    margin: 0.8rem 0 0;
    font-weight: 700;
  }
  .say {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    font-weight: 700;
  }
  .say input {
    width: 1.15rem;
    height: 1.15rem;
    padding: 0;
    accent-color: #f15a22;
  }
</style>
