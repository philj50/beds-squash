---
import Base from '@/layouts/Base.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { COMMENTARY_NOTES } from '@/lib/commentary-notes';
import { url } from '@/lib/site';
---

<Base
  title="Match commentary"
  description="Follow a squash match being marked on Beds Squash, and hear the score as it changes."
  noindex
  crumbs={[{ name: 'Match commentary', path: '/captains/watch/' }]}
>
  <section class="section">
    <div class="container watch" id="watch-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY} data-login={url('/login/')}>
      <h1>Match commentary</h1>
      <p class="lede">Choose a match that is being marked. Tick Say it out loud to hear the score. Earlier matches stay in the list below.</p>
      <label class="say">
        <input type="checkbox" data-say />
        Say it out loud
      </label>
      <p class="say-note">Take the phone off silent to hear the voice.</p>
      {COMMENTARY_NOTES && (
        <p class="ntfy">
          <a href="https://ntfy.sh/beds_commentary_1234" target="_blank" rel="noopener noreferrer">Subscribe on ntfy</a>
          for a note when a match goes on. The topic is beds_commentary_1234.
        </p>
      )}
      <p class="status" data-status role="status"></p>

      <div data-picker>
        <p class="current-note" data-empty></p>
        <ul class="matches" data-matches></ul>
        <h2 class="archive-title" data-archive-title hidden>Earlier matches</h2>
        <ul class="matches archive" data-archive></ul>
      </div>

      <div class="live" data-live hidden>
        <p class="actions">
          <button class="btn btn--ghost btn--sm" type="button" data-back>Choose another match</button>
        </p>
        <div class="names">
          <p data-a></p>
          <p data-b></p>
        </div>
        <p class="points" data-points></p>
        <p class="clock" data-clock></p>
        <ul class="game-times" data-times></ul>
        <p class="call" data-call></p>
        <p class="shout-banner" data-shout-banner></p>
        <p class="watchers" data-watchers></p>
        <ul class="shout-log" data-shout-log></ul>
        <div class="shout-bar" data-shout-bar>
          <button type="button" data-shout="a">Come on</button>
          <button type="button" data-shout="b">Come on</button>
          <button type="button" data-shout="yes">Yes!</button>
          <button type="button" data-shout="clap" aria-label="Clap">👏</button>
        </div>
        <details class="points-history">
          <summary>Points</summary>
          <div data-history-body></div>
        </details>
        <p class="marker" data-marker></p>
        <p class="updated" data-updated></p>
        <p class="note" data-note></p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import {
    currentGame,
    currentRallies,
    finishedGames,
    liveMatchCurrent,
    matchWinner,
    gameStem,
    publicPlayerName,
    restoreMatch,
    spokenMark,
    spokenPublicLine,
    unpackLiveScore,
  } from '@/lib/scoreboard';
  import { followScore, speakScore, speechUnlocked, stopScore } from '@/lib/speak';

  type LiveRow = {
    id: number;
    playerA: string;
    playerB: string;
    score: string;
    marker: string | null;
    updatedAt: string;
    history: unknown;
    endedAt?: string | null;
  };

  type Room = {
    now?: string[];
    looked?: string[];
    guestsNow?: number;
    guestsEarlier?: number;
  };

  type Shout = { id: number; kind: string; name: string };

  const watchRoot = document.getElementById('watch-app');
  if (!watchRoot) throw new Error('watch app missing');
  const root: HTMLElement = watchRoot;
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const picker = root.querySelector<HTMLElement>('[data-picker]')!;
  const list = root.querySelector<HTMLElement>('[data-matches]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  const live = root.querySelector<HTMLElement>('[data-live]')!;
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const sayBox = root.querySelector<HTMLInputElement>('[data-say]')!;
  const archiveList = root.querySelector<HTMLElement>('[data-archive]')!;
  const archiveTitle = root.querySelector<HTMLElement>('[data-archive-title]')!;
  const shoutBar = root.querySelector<HTMLElement>('[data-shout-bar]')!;
  const shoutLog = root.querySelector<HTMLElement>('[data-shout-log]')!;
  const shoutBanner = root.querySelector<HTMLElement>('[data-shout-banner]')!;
  const watchersEl = root.querySelector<HTMLElement>('[data-watchers]')!;
  const historyBody = root.querySelector<HTMLElement>('[data-history-body]')!;

  let signedIn = false;
  let rows: LiveRow[] = [];
  let matchId: number | null = null;
  let stamp = '';
  let sayScore = localStorage.getItem('beds-say-score') === '1';
  let heard = '';
  let voiceArmed = false;
  let heardRestart = 0;
  let clockText = '';
  let clockAt = 0;
  let clockLive = false;
  let archiveId: number | null = null;
  let archiveRows: LiveRow[] = [];
  let roomReady = true;
  let lastShoutId = 0;
  const seenShouts = new Set<number>();
  let liveNames = { a: '', b: '' };
  let bannerTimer = 0;
  sayBox.checked = sayScore;

  const shown = (name: string) => (signedIn ? name : publicPlayerName(name));
  const pretty = (score: string) => (score || '0-0').replace(/-/g, '–');

  function show(message: string) {
    statusEl.textContent = message;
  }

  function missingFunction(error: { code?: string; message?: string } | null) {
    const message = error?.message ?? '';
    return error?.code === 'PGRST202' || /could not find the function/i.test(message) || /schema cache/i.test(message);
  }

  function updatedAgo(iso: string) {
    const then = new Date(iso).getTime();
    if (Number.isNaN(then)) return '';
    const seconds = Math.max(0, Math.round((Date.now() - then) / 1000));
    if (seconds < 15) return 'Updated just now';
    if (seconds < 60) return `Updated ${seconds}s ago`;
    const minutes = Math.round(seconds / 60);
    return minutes === 1 ? 'Updated 1 min ago' : `Updated ${minutes} min ago`;
  }

  function speak(text: string, quietAfter = text) {
    if (!sayScore || !text || !window.speechSynthesis) return;
    heard = quietAfter;
    speakScore(text);
  }

  function follow(text: string, quietAfter = text) {
    if (!sayScore || !text || !window.speechSynthesis) return;
    if (!speechUnlocked()) return;
    heard = quietAfter;
    followScore(text);
  }

  function announce(text: string, tapped = false) {
    if (!text) return;
    if (!voiceArmed) {
      heard = text;
      voiceArmed = true;
      if (tapped) speak(text);
      return;
    }
    if (text === heard) return;
    if (tapped) speak(text);
    else follow(text);
  }

  function shownClock() {
    if (!clockText) return '';
    if (!clockLive) return clockText;
    const [minutes, seconds] = clockText.split(':').map((part) => Number(part) || 0);
    const total = minutes * 60 + seconds + Math.max(0, Math.floor((Date.now() - clockAt) / 1000));
    const nextMinutes = Math.floor(total / 60);
    const nextSeconds = total % 60;
    return `${String(nextMinutes).padStart(2, '0')}:${String(nextSeconds).padStart(2, '0')}`;
  }

  function paintClock() {
    const clock = root.querySelector<HTMLElement>('[data-clock]');
    if (!clock) return;
    const text = shownClock();
    clock.textContent = text ? `This game ${text}` : '';
  }

  function paintTimes(line: string, times: string[]) {
    const list = root.querySelector<HTMLElement>('[data-times]')!;
    const parts = line && line !== '0-0' ? line.split(',').map((part) => part.trim()).filter(Boolean) : [];
    list.replaceChildren();
    times.forEach((time, index) => {
      const item = document.createElement('li');
      const label = document.createElement('span');
      label.className = 'label';
      label.textContent = `Game ${index + 1}`;
      const score = document.createElement('span');
      score.className = 'game-score';
      score.textContent = (parts[index] || '').replace('-', '–');
      const taken = document.createElement('span');
      taken.className = 'time';
      taken.textContent = time;
      item.append(label, score, taken);
      list.append(item);
    });
  }

  function paintList() {
    live.hidden = true;
    picker.hidden = false;
    list.replaceChildren();
    if (!rows.length) {
      empty.textContent = empty.textContent || 'No matches are being marked right now.';
      return;
    }
    empty.textContent = '';
    for (const row of rows) {
      const item = document.createElement('li');
      const button = document.createElement('button');
      button.type = 'button';
      const players = document.createElement('span');
      players.textContent = `${shown(row.playerA)} v ${shown(row.playerB)}`;
      const score = document.createElement('span');
      score.textContent = pretty(unpackLiveScore(row.score).line);
      button.append(players, score);
      button.addEventListener('click', () => openMatch(row.id));
      item.append(button);
      list.append(item);
    }
  }

  function firstWord(name: string) {
    return name.trim().split(/\s+/)[0] || name;
  }

  function paintHistory(restored: ReturnType<typeof restoreMatch>) {
    historyBody.replaceChildren();
    if (!restored) {
      historyBody.textContent = archiveId
        ? 'No point-by-point list for this match.'
        : 'The points will show here as they are marked.';
      return;
    }
    const played = restored.games.filter((game) => game.length > 0);
    if (!played.length) {
      historyBody.textContent = 'No points yet.';
      return;
    }
    const sheet = document.createElement('div');
    sheet.className = 'result-sheet';
    played.forEach((rallies, index) => {
      const stem = gameStem(rallies);
      const game = document.createElement('section');
      game.className = 'stem';
      const heading = document.createElement('p');
      heading.className = 'stem-head';
      heading.textContent = `Game ${index + 1}`;
      const total = document.createElement('p');
      total.className = 'stem-score';
      total.textContent = `${stem.score.a}–${stem.score.b}`;
      const body = document.createElement('div');
      body.className = 'stem-body';
      for (const mark of stem.rows) {
        const row = document.createElement('div');
        row.className = 'stem-row';
        const pip = document.createElement('span');
        pip.className = `pip${mark.kind === 'let' ? ' is-let' : ''}${mark.kind === 'stroke' ? ' is-stroke' : ''}`;
        pip.textContent = mark.text;
        const box = document.createElement('span');
        box.className = 'box-mark';
        box.textContent = mark.box;
        const cluster = document.createElement('span');
        cluster.className = mark.side === 'a' ? 'cluster cluster--a' : 'cluster cluster--b';
        if (mark.side === 'a') cluster.append(box, pip);
        else cluster.append(pip, box);
        const left = document.createElement('span');
        const right = document.createElement('span');
        const rail = document.createElement('span');
        rail.className = 'stem-rail';
        if (mark.side === 'a') left.append(cluster);
        else right.append(cluster);
        row.append(left, rail, right);
        const kind = mark.kind === 'let' ? 'Yes let' : mark.kind === 'stroke' ? 'Stroke' : 'Point';
        row.setAttribute('aria-label', `${kind}, ${mark.text}, from ${mark.box}`);
        body.append(row);
      }
      game.append(heading, total, body);
      sheet.append(game);
    });
    historyBody.append(sheet);
  }

  function paintComeOn(names: { a: string; b: string }) {
    liveNames = names;
    const comeA = root.querySelector<HTMLButtonElement>('[data-shout="a"]');
    const comeB = root.querySelector<HTMLButtonElement>('[data-shout="b"]');
    if (comeA) comeA.textContent = `Come on ${firstWord(names.a)}`;
    if (comeB) comeB.textContent = `Come on ${firstWord(names.b)}`;
  }

  function shoutText(shout: Shout) {
    const who = signedIn ? shout.name : shout.name === 'Someone' ? 'Someone' : publicPlayerName(shout.name);
    if (shout.kind === 'clap') return `${who} 👏`;
    if (shout.kind === 'yes') return `${who}: Yes!`;
    const player = shout.kind === 'b' ? liveNames.b : liveNames.a;
    return `${who}: Come on ${firstWord(player)}`;
  }

  function showShout(shout: Shout) {
    if (!shout.id || seenShouts.has(shout.id)) return;
    seenShouts.add(shout.id);
    if (shout.id > lastShoutId) lastShoutId = shout.id;
    const text = shoutText(shout);
    shoutBanner.textContent = text;
    window.clearTimeout(bannerTimer);
    bannerTimer = window.setTimeout(() => {
      shoutBanner.textContent = '';
    }, 4000);
    const item = document.createElement('li');
    item.textContent = text;
    shoutLog.prepend(item);
    while (shoutLog.children.length > 6) shoutLog.lastElementChild?.remove();
  }

  function clearShouts() {
    lastShoutId = 0;
    seenShouts.clear();
    shoutLog.replaceChildren();
    shoutBanner.textContent = '';
    watchersEl.textContent = '';
  }

  function peopleLine(names: string[], guests: number) {
    const shownNames = names.map((name) => (signedIn ? name : publicPlayerName(name))).filter(Boolean);
    if (guests === 1) shownNames.push('1 other');
    else if (guests > 1) shownNames.push(`${guests} others`);
    return shownNames.join(', ');
  }

  function paintRoom(room: Room | null, ended: boolean) {
    if (!room) {
      watchersEl.textContent = '';
      return;
    }
    const now = peopleLine(Array.isArray(room.now) ? room.now : [], Number(room.guestsNow) || 0);
    const looked = peopleLine(Array.isArray(room.looked) ? room.looked : [], Number(room.guestsEarlier) || 0);
    const parts = [];
    if (ended) {
      if (looked) parts.push(`Watched by ${looked}`);
    } else {
      if (now) parts.push(`Watching: ${now}`);
      if (looked) parts.push(`Looked in: ${looked}`);
    }
    watchersEl.textContent = parts.join('. ');
  }

  function paintLive(row: LiveRow, tapped = false, quiet = false) {
    const names = { a: shown(row.playerA), b: shown(row.playerB) };
    const shared = unpackLiveScore(row.score || '0-0');
    const restored = restoreMatch(row.history);
    const said = shared.call || spokenPublicLine(names.a, names.b, shared.line);
    const nextStamp = `${shared.line}|${shared.restart}|${said}|${restored ? JSON.stringify(restored) : `${names.a}|${names.b}`}`;
    const changed = nextStamp !== stamp;
    const restarting = !quiet && voiceArmed && shared.restart !== heardRestart;
    if (!quiet) {
      stamp = nextStamp;
      heardRestart = shared.restart;
    }
    picker.hidden = true;
    live.hidden = false;
    shoutBar.hidden = quiet || !roomReady;
    root.querySelector<HTMLElement>('[data-a]')!.textContent = names.a;
    root.querySelector<HTMLElement>('[data-b]')!.textContent = names.b;
    root.querySelector<HTMLElement>('[data-updated]')!.textContent = quiet && row.endedAt ? endedLabel(row.endedAt) : updatedAgo(row.updatedAt);
    clockText = quiet ? '' : shared.clock;
    clockAt = new Date(row.updatedAt).getTime() || Date.now();
    clockLive = !quiet && Boolean(shared.clock);
    paintClock();
    paintTimes(shared.line, shared.times);
    paintComeOn(names);
    const marker = root.querySelector<HTMLElement>('[data-marker]')!;
    const note = root.querySelector<HTMLElement>('[data-note]')!;
    const call = root.querySelector<HTMLElement>('[data-call]')!;
    const points = root.querySelector<HTMLElement>('[data-points]')!;
    if (!restored) {
      const parts = shared.line && shared.line !== '0-0' ? shared.line.split(',').map((part) => part.trim()).filter(Boolean) : [];
      const current = parts.length > shared.times.length ? parts[parts.length - 1] : '0-0';
      points.textContent = pretty(current).replace('–', ' – ');
      call.textContent = said;
      marker.textContent = '';
      note.replaceChildren();
      if (!signedIn) {
        const link = document.createElement('a');
        link.href = root.dataset.login || '/login/';
        link.textContent = 'Sign in';
        note.append(link, ' to see the full names and every point.');
      }
    } else {
      note.replaceChildren();
      if (!signedIn) {
        const link = document.createElement('a');
        link.href = root.dataset.login || '/login/';
        link.textContent = 'Sign in';
        note.append(link, ' to see the full names.');
      }
      const score = currentGame(restored);
      points.textContent = `${score.a} – ${score.b}`;
      const winner = matchWinner(restored);
      const between = !winner && currentRallies(restored).length === 0 && finishedGames(restored).length > 0;
      const phase = winner ? 'done' : between ? 'next' : 'play';
      call.textContent = spokenMark(restored, names, phase);
      marker.textContent = row.marker ? `Marked by ${row.marker}` : '';
    }
    paintHistory(restored);
    if (quiet) {
      voiceArmed = true;
      heard = call.textContent;
      return;
    }
    if (!restored) {
      if (restarting && shared.times.length) {
        follow(spokenPublicLine(names.a, names.b, shared.line), said);
        return;
      }
      if (changed) announce(said, tapped);
      return;
    }
    if (restarting && finishedGames(restored).length) {
      follow(spokenMark(restored, names, 'next'), call.textContent);
      return;
    }
    if (changed) announce(call.textContent, tapped);
  }

  function endedLabel(iso: string) {
    const date = new Date(iso);
    if (Number.isNaN(date.getTime())) return '';
    return `Ended ${date.toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}`;
  }

  function dayLabel(iso: string) {
    const date = new Date(iso);
    if (Number.isNaN(date.getTime())) return '';
    return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
  }

  function paintArchiveList() {
    archiveTitle.hidden = !roomReady || archiveRows.length === 0;
    archiveList.replaceChildren();
    if (!roomReady) return;
    for (const row of archiveRows) {
      const item = document.createElement('li');
      const button = document.createElement('button');
      button.type = 'button';
      const players = document.createElement('span');
      const when = row.endedAt ? dayLabel(row.endedAt) : '';
      players.textContent = `${shown(row.playerA)} v ${shown(row.playerB)}${when ? ` · ${when}` : ''}`;
      const score = document.createElement('span');
      score.textContent = pretty(unpackLiveScore(row.score).line);
      button.append(players, score);
      button.addEventListener('click', () => void openArchive(row.id));
      item.append(button);
      archiveList.append(item);
    }
  }

  function openMatch(id: number) {
    matchId = id;
    archiveId = null;
    stamp = '';
    voiceArmed = false;
    heard = '';
    heardRestart = 0;
    clearShouts();
    const url = new URL(location.href);
    url.searchParams.delete('archive');
    url.searchParams.set('match', String(id));
    history.replaceState(null, '', `${url.pathname}${url.search}`);
    const row = rows.find((item) => item.id === id);
    if (row) paintLive(row, true);
    else show('That match is not being shared.');
    void touchRoom();
    void loadShouts();
  }

  function leaveMatch() {
    matchId = null;
    archiveId = null;
    stamp = '';
    voiceArmed = false;
    const url = new URL(location.href);
    url.searchParams.delete('match');
    url.searchParams.delete('archive');
    history.replaceState(null, '', url.pathname);
    stopScore();
    clearShouts();
    paintList();
    paintArchiveList();
  }

  async function loadRows() {
    const { data, error } = await supabase.rpc('current_matches');
    if (error && missingFunction(error)) {
      empty.textContent = 'Live matches are not on the database yet.';
      list.replaceChildren();
      return;
    }
    if (error) {
      show(error.message);
      return;
    }
    show('');
    rows = (Array.isArray(data) ? (data as LiveRow[]) : []).filter((row) => liveMatchCurrent(row.updatedAt));
    if (archiveId) return;
    if (matchId) {
      const row = rows.find((item) => item.id === matchId);
      if (!row) {
        show('That match is no longer being shared.');
        leaveMatch();
        return;
      }
      paintLive(row);
      return;
    }
    empty.textContent = rows.length ? '' : 'No matches are being marked right now.';
    paintList();
  }

  function guestToken() {
    const key = 'beds-watch-guest';
    let token = sessionStorage.getItem(key);
    if (!token || !/^[0-9a-f-]{36}$/i.test(token)) {
      token = crypto.randomUUID();
      sessionStorage.setItem(key, token);
    }
    return token;
  }

  function roomMissing(error: { code?: string; message?: string } | null) {
    if (!missingFunction(error)) return false;
    roomReady = false;
    shoutBar.hidden = true;
    paintArchiveList();
    return true;
  }

  async function touchRoom() {
    if (!matchId || !roomReady) return;
    const { data, error } = await supabase.rpc('commentary_here', { p_live: matchId, p_guest: guestToken() });
    if (error) {
      roomMissing(error);
      return;
    }
    paintRoom(data as Room, false);
  }

  async function loadShouts() {
    if (!matchId || !roomReady) return;
    const { data, error } = await supabase.rpc('commentary_shouts', { p_live: matchId, p_after: lastShoutId });
    if (error) {
      roomMissing(error);
      return;
    }
    const shouts = (Array.isArray(data) ? (data as Shout[]) : []).slice().sort((a, b) => a.id - b.id);
    for (const shout of shouts) showShout(shout);
  }

  async function sendShout(kind: string) {
    if (!matchId || !roomReady) return;
    const { data, error } = await supabase.rpc('commentary_shout', { p_live: matchId, p_kind: kind, p_guest: guestToken() });
    if (error) {
      roomMissing(error);
      return;
    }
    const shout = data as (Shout & { ok?: boolean }) | null;
    if (shout?.ok && shout.id) showShout(shout);
  }

  async function loadArchive() {
    const { data, error } = await supabase.rpc('commentary_archive');
    if (error) {
      roomMissing(error);
      return;
    }
    archiveRows = Array.isArray(data) ? (data as LiveRow[]) : [];
    if (!archiveId) paintArchiveList();
  }

  async function openArchive(id: number) {
    const { data, error } = await supabase.rpc('commentary_match', { p_id: id });
    if (error) {
      if (!roomMissing(error)) show('That match could not be opened.');
      return;
    }
    const row = data as (LiveRow & { room?: Room; shouts?: Shout[] }) | null;
    if (!row?.id) {
      show('That match is not in the archive.');
      return;
    }
    matchId = null;
    archiveId = id;
    stamp = '';
    clearShouts();
    const url = new URL(location.href);
    url.searchParams.delete('match');
    url.searchParams.set('archive', String(id));
    history.replaceState(null, '', `${url.pathname}${url.search}`);
    paintLive(row, false, true);
    paintRoom(row.room ?? null, true);
    const shouts = (Array.isArray(row.shouts) ? row.shouts : []).slice().sort((a, b) => a.id - b.id);
    for (const shout of shouts) showShout(shout);
  }

  function currentCall() {
    return root.querySelector('[data-call]')?.textContent?.trim() || '';
  }

  root.addEventListener('pointerdown', () => {
    if (!sayScore || speechUnlocked()) return;
    const text = currentCall();
    if (!text) return;
    voiceArmed = true;
    speak(text);
  });

  sayBox.addEventListener('change', () => {
    sayScore = sayBox.checked;
    localStorage.setItem('beds-say-score', sayScore ? '1' : '0');
    if (!sayScore) {
      stopScore();
      return;
    }
    if (!window.speechSynthesis) {
      show('This browser cannot read the score aloud.');
      return;
    }
    voiceArmed = true;
    heard = '';
    const row = rows.find((item) => item.id === matchId);
    const shared = row ? unpackLiveScore(row.score || '0-0') : null;
    const text = currentCall()
      || (row && shared ? shared.call || spokenPublicLine(shown(row.playerA), shown(row.playerB), shared.line) : '');
    speak(text || 'The score will be read out.');
  });

  root.querySelector('[data-back]')!.addEventListener('click', () => leaveMatch());
  for (const button of root.querySelectorAll<HTMLButtonElement>('[data-shout]')) {
    button.addEventListener('click', () => void sendShout(button.dataset.shout || ''));
  }

  const { data } = await supabase.auth.getSession();
  signedIn = Boolean(data.session);
  const params = new URLSearchParams(location.search);
  const requested = Number(params.get('match'));
  const archived = Number(params.get('archive'));
  if (requested) matchId = requested;
  await loadRows();
  await loadArchive();
  if (!requested && archived) await openArchive(archived);
  window.setInterval(() => void loadRows(), 2000);
  window.setInterval(() => {
    if (matchId) void loadShouts();
  }, 2000);
  window.setInterval(() => {
    if (matchId) void touchRoom();
    void loadArchive();
  }, 15000);
  window.setInterval(paintClock, 1000);
</script>

