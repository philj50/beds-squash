---
import Base from '@/layouts/Base.astro';
import ChangePassword from '@/components/ChangePassword.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { url } from '@/lib/site';
---

<Base title="Your profile" description="Your Bedfordshire Squash account and password." noindex>
  <section class="section">
    <div class="container profile" id="profile-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY} data-login={url('/login/')}>
      <h1>Your profile</h1>
      <p class="lede">This is your account. Your name, email, club and team are here, and you can change your password. Nothing is emailed.</p>

      <div data-panel="signed-out">
        <p>Taking you to log in…</p>
      </div>

      <div data-panel="signed-in" hidden>
        <p class="who" data-who></p>
        <p class="status" data-status role="status"></p>
        <form class="card" data-form="name">
          <div class="card__body stack">
            <label>
              Name
              <input name="display_name" data-name-input required minlength="2" maxlength="80" autocomplete="name" />
            </label>
            <p class="muted small">This is the name in the menu and on your account.</p>
            <button class="btn btn--primary btn--sm" type="submit">Save name</button>
          </div>
        </form>
        <dl class="account">
          <div>
            <dt>Email</dt>
            <dd data-email></dd>
          </div>
          <div>
            <dt>Club and team</dt>
            <dd data-places>Loading…</dd>
          </div>
        </dl>
        <p class="actions">
          <a class="btn btn--ghost btn--sm" href={url('/captains/you/')}>My squash</a>
          <a class="btn btn--ghost btn--sm" data-squad-link href={url('/captains/')}>Squad</a>
          <a class="btn btn--ghost btn--sm" href={url('/captains/matches/')}>Matches</a>
          <a class="btn btn--ghost btn--sm" data-admin-link hidden href={url('/captains/admin/')}>Administration</a>
          <button class="btn btn--ghost btn--sm" type="button" data-sign-out>Sign out</button>
        </p>
        <ChangePassword />
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { accountIsActive, hasAccountEmail, loadAccount, noteActivity, saveDisplayName, sendToLogin, stopMessage } from '@/lib/account';

  const root = document.getElementById('profile-app');
  if (!root) throw new Error('profile app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const signedOut = root.querySelector<HTMLElement>('[data-panel="signed-out"]')!;
  const signedIn = root.querySelector<HTMLElement>('[data-panel="signed-in"]')!;
  const adminLink = root.querySelector<HTMLElement>('[data-admin-link]')!;
  const squadLink = root.querySelector<HTMLAnchorElement>('[data-squad-link]')!;
  const nameInput = root.querySelector<HTMLInputElement>('[data-name-input]')!;
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const whoEl = root.querySelector<HTMLElement>('[data-who]')!;
  const emailEl = root.querySelector<HTMLElement>('[data-email]')!;
  const placesEl = root.querySelector<HTMLElement>('[data-places]')!;

  root.querySelector('[data-sign-out]')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    sendToLogin();
  });

  root.querySelector<HTMLFormElement>('[data-form="name"]')!.addEventListener('submit', async (event) => {
    event.preventDefault();
    statusEl.textContent = 'Saving name…';
    const message = await saveDisplayName(supabase, nameInput.value);
    statusEl.textContent = message ?? 'Name saved.';
    if (!message) await showSession();
  });

  async function showSession() {
    const account = await loadAccount(supabase);
    signedOut.hidden = Boolean(account);
    signedIn.hidden = !account;
    if (!account) {
      sendToLogin();
      return;
    }
    whoEl.textContent = `Signed in as ${account.displayName || account.email}`;
    const inactive = !(await accountIsActive(supabase));
    const nameForm = root.querySelector<HTMLElement>('[data-form="name"]')!;
    const passwordSlot = root.querySelector<HTMLElement>('[data-change-password-slot]')!;
    nameForm.hidden = inactive;
    passwordSlot.hidden = inactive;
    if (inactive) {
      statusEl.textContent = stopMessage('inactive');
      return;
    }
    void noteActivity(supabase);
    if (!hasAccountEmail(account.email)) statusEl.textContent = stopMessage('email');
    nameInput.value = account.displayName;
    emailEl.textContent = account.email || '—';
    placesEl.textContent = account.places.length
      ? account.places.map((place) => place.label).join('. ')
      : 'No club or team yet. An admin sets that from Administration.';
    adminLink.hidden = !account.isAdmin;
    squadLink.textContent = account.playerOnly ? 'Your team' : 'Squad';
  }

  showSession();
</script>

<style>
  .profile {
    max-width: 640px;
  }
  .lede {
    color: var(--ink-200);
  }
  .status:empty {
    display: none;
  }
  .status {
    margin: 1rem 0;
    color: var(--gold-400);
  }
  .stack {
    display: grid;
    gap: 0.75rem;
  }
  label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  input {
    width: 100%;
    background: var(--ink-900);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.75rem;
    font: inherit;
  }
  .who {
    margin-bottom: 0.75rem;
  }
  form.card {
    margin: 0 0 1rem;
  }
  .account {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1rem;
  }
  .account div {
    display: grid;
    gap: 0.15rem;
  }
  .account dt {
    font-size: 0.8rem;
    color: var(--ink-300);
  }
  .account dd {
    margin: 0;
    font-weight: 600;
  }
  .muted {
    color: var(--ink-200);
  }
  .small {
    font-size: 0.85rem;
    margin: 0.35rem 0 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }
</style>
