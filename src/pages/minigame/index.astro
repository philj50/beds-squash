---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { COURT, SERVE_SPOT } from '@/lib/squash-arcade';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';

---

<Base
  title="Minigame"
  description="A one-player squash game on a court floor. Enter your initials, serve, and send the ball back to the front wall."
  crumbs={[{ name: 'Minigame', path: '/minigame/' }]}
>
  <PageHero
    eyebrow="Arcade"
    title="Minigame"
    lede="One player, looking down the court. Type your initials, press Serve, and send the ball back to the front wall."
  />
  <section class="section">
    <div class="container arcade" id="minigame" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <div class="play">
        <form class="card name-card" data-start>
          <div class="card__body stack">
            <label>
              Your initials
              <input name="player" required minlength="2" maxlength="3" autocomplete="off" placeholder="PJ" />
            </label>
            <button class="btn btn--primary" type="submit">Play</button>
          </div>
        </form>
        <p class="hud" data-hud hidden>
          <span data-score>0000</span>
          <span data-lives></span>
        </p>
        <div class="court" style={`--serve-x: ${SERVE_SPOT.x}%; --serve-y: ${SERVE_SPOT.y}%;`}>
          <canvas width={COURT.width} height={COURT.height} data-court tabindex="0" aria-label="Squash court"></canvas>
          <button class="btn btn--primary serve-on-court" type="button" data-serve-btn hidden>Serve</button>
        </div>
        <div class="bat-track" data-bat hidden>
          <span class="bat-knob" data-knob>
            <svg viewBox="0 0 40 56" aria-hidden="true">
              <ellipse cx="20" cy="16" rx="14" ry="16" fill="none" stroke="currentColor" stroke-width="2"></ellipse>
              <line x1="20" y1="32" x2="20" y2="52" stroke="currentColor" stroke-width="2"></line>
            </svg>
          </span>
        </div>
        <p class="hint">Touch the court. The racket sits just in front of your finger, and it can meet the ball anywhere. The ball still comes back to the front wall. Arrow keys move along the back.</p>
        <p class="result" data-result hidden></p>
        <p class="again" data-again hidden>
          <button class="btn btn--primary btn--sm" type="button" data-replay>Play again</button>
          <button class="btn btn--ghost btn--sm" type="button" data-rename>Change initials</button>
        </p>
        <dialog data-naughty>
          <p data-naughty-line></p>
          <button class="btn btn--primary btn--sm" type="button" data-naughty-ok>Try again</button>
        </dialog>
      </div>
      <aside class="board-card">
        <h2>High scores</h2>
        <ol data-board></ol>
      </aside>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { rudeName } from '@/lib/name-check';
  import { PLAY, beginServe, createArcade, drawCourt, setRacket, tick, type Arcade } from '@/lib/squash-arcade';

  type Row = { name: string; score: number };

  const root = document.getElementById('minigame');
  if (!root) throw new Error('minigame missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const form = root.querySelector<HTMLFormElement>('[data-start]')!;
  const nameInput = form.querySelector<HTMLInputElement>('[name="player"]')!;
  const serveBtn = root.querySelector<HTMLButtonElement>('[data-serve-btn]')!;
  const hud = root.querySelector<HTMLElement>('[data-hud]')!;
  const scoreEl = root.querySelector<HTMLElement>('[data-score]')!;
  const livesEl = root.querySelector<HTMLElement>('[data-lives]')!;
  const canvas = root.querySelector<HTMLCanvasElement>('[data-court]')!;
  const track = root.querySelector<HTMLElement>('[data-bat]')!;
  const knob = root.querySelector<HTMLElement>('[data-knob]')!;
  const resultEl = root.querySelector<HTMLElement>('[data-result]')!;
  const again = root.querySelector<HTMLElement>('[data-again]')!;
  const boardEl = root.querySelector<HTMLElement>('[data-board]')!;
  const naughty = root.querySelector<HTMLDialogElement>('[data-naughty]')!;
  const naughtyLine = root.querySelector<HTMLElement>('[data-naughty-line]')!;
  const RUDE_LINES = [
    'Let. That name hit the tin, so the box is clear. Try one you would put on a trophy.',
    'Conduct stroke. That name is off court. The line has been wiped.',
    'No let. The referee will not read that one out. Have another go.',
  ];
  const ctx = canvas.getContext('2d');
  if (!ctx) throw new Error('court missing');

  let game: Arcade | null = null;
  let playId = 0;
  let last = 0;
  let pointer = 0.5;
  let pointerY: number | null = null;
  let saved = false;
  let blockedInitials: string[] = [];
  let audioCtx: AudioContext | null = null;

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);

  function audio() {
    audioCtx ??= new AudioContext();
    return audioCtx;
  }

  function whenReady(play: (ctxAudio: AudioContext) => void) {
    const ctxAudio = audio();
    if (ctxAudio.state === 'suspended') {
      void ctxAudio.resume().then(() => play(ctxAudio));
      return;
    }
    play(ctxAudio);
  }

  function beep(freq: number, at: number, dur: number, type: OscillatorType, volume: number) {
    whenReady((ctxAudio) => {
      const start = Math.max(at, ctxAudio.currentTime);
      const osc = ctxAudio.createOscillator();
      const gain = ctxAudio.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, start);
      gain.gain.setValueAtTime(volume, start);
      gain.gain.exponentialRampToValueAtTime(0.0001, start + dur);
      osc.connect(gain);
      gain.connect(ctxAudio.destination);
      osc.start(start);
      osc.stop(start + dur);
    });
  }

  function intro() {
    try {
      const now = audio().currentTime;
      [330, 392, 494, 659].forEach((freq, index) => beep(freq, now + index * 0.11, 0.12, 'square', 0.07));
    } catch {
      /* the game still plays if sound is blocked */
    }
  }

  function batHit() {
    try {
      whenReady((ctxAudio) => {
        const dur = 0.07;
        const buffer = ctxAudio.createBuffer(1, Math.floor(ctxAudio.sampleRate * dur), ctxAudio.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < data.length; i += 1) data[i] = (Math.random() * 2 - 1) * (1 - i / data.length);
        const src = ctxAudio.createBufferSource();
        src.buffer = buffer;
        const filter = ctxAudio.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 720;
        const gain = ctxAudio.createGain();
        gain.gain.value = 0.16;
        src.connect(filter);
        filter.connect(gain);
        gain.connect(ctxAudio.destination);
        src.start();
        beep(180, ctxAudio.currentTime, 0.06, 'square', 0.06);
      });
    } catch {
      /* the game still plays if sound is blocked */
    }
  }

  function wahwah() {
    try {
      whenReady((ctxAudio) => {
        const now = ctxAudio.currentTime;
        [392, 330, 262].forEach((freq, index) => {
          const at = now + index * 0.24;
          const osc = ctxAudio.createOscillator();
          const gain = ctxAudio.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(freq * 1.5, at);
          osc.frequency.exponentialRampToValueAtTime(freq * 0.7, at + 0.2);
          gain.gain.setValueAtTime(0.08, at);
          gain.gain.exponentialRampToValueAtTime(0.0001, at + 0.22);
          osc.connect(gain);
          gain.connect(ctxAudio.destination);
          osc.start(at);
          osc.stop(at + 0.24);
        });
      });
    } catch {
      /* the game still plays if sound is blocked */
    }
  }

  function paint() {
    if (!game) {
      drawCourt(ctx!, createArcade());
      return;
    }
    setRacket(game, pointer, pointerY ?? undefined);
    drawCourt(ctx!, game);
    scoreEl.textContent = String(game.score).padStart(4, '0');
    livesEl.textContent = game.lives > 0 ? `${game.lives} ${game.lives === 1 ? 'life' : 'lives'}` : '';
    knob.style.left = `${pointer * 100}%`;
  }

  async function loadBlocked() {
    const { data, error } = await supabase.from('minigame_blocked_initials').select('initials');
    if (error || !data) return;
    blockedInitials = data.map((row) => row.initials);
  }

  async function loadBoard() {
    const { data, error } = await supabase.rpc('minigame_leaderboard');
    if (error) {
      boardEl.innerHTML = '<li class="empty">The board is not available yet.</li>';
      return;
    }
    const rows = (data ?? []) as Row[];
    boardEl.innerHTML = rows.length
      ? rows
          .map(
            (row, index) =>
              `<li><span class="rank">${index + 1}</span><span class="who">${escapeHtml(row.name)}</span><span class="tally">${row.score}</span></li>`,
          )
          .join('')
      : '<li class="empty">No scores yet.</li>';
  }

  async function saveScore(name: string, score: number) {
    if (score < 1) {
      resultEl.textContent = 'Better luck next time.';
      wahwah();
      return;
    }
    if (saved) return;
    saved = true;
    const { data, error } = await supabase.rpc('submit_minigame_score', { p_name: name, p_score: score });
    if (error) {
      resultEl.textContent = `${name}, you scored ${score}. The board did not save it.`;
      return;
    }
    const rank = Number(data);
    if (rank <= 10) {
      resultEl.textContent = `${name} scored ${score} and is number ${rank}.`;
      try {
        const now = audio().currentTime;
        [523, 659, 784].forEach((freq, index) => beep(freq, now + index * 0.09, 0.14, 'square', 0.07));
      } catch {
        /* still show the place */
      }
    } else {
      resultEl.textContent = `${name} scored ${score}. Better luck next time.`;
      wahwah();
    }
    await loadBoard();
  }

  function finish(name: string) {
    if (!game) return;
    resultEl.hidden = false;
    again.hidden = false;
    hud.hidden = true;
    serveBtn.hidden = true;
    resultEl.textContent = 'Game over.';
    void saveScore(name, game.score);
  }

  function frame(now: number, id: number) {
    if (id !== playId || !game || game.phase === 'over' || game.phase === 'idle') return;
    const dt = last ? (now - last) / 1000 : 0;
    last = now;
    setRacket(game, pointer, pointerY ?? undefined);
    const events = tick(game, dt);
    try {
      if (events.includes('hit')) batHit();
      if (events.includes('score')) beep(740, audio().currentTime, 0.08, 'square', 0.06);
      if (events.includes('bonus')) {
        const nowTone = audio().currentTime;
        beep(880, nowTone, 0.08, 'square', 0.07);
        beep(1180, nowTone + 0.08, 0.1, 'square', 0.06);
      }
      if (events.includes('miss') || events.includes('over')) beep(120, audio().currentTime, 0.1, 'square', 0.07);
    } catch {
      /* the rally continues if sound is blocked */
    }
    paint();
    if (events.includes('over')) {
      finish(nameInput.value.trim());
      return;
    }
    requestAnimationFrame((time) => frame(time, id));
  }

  function showServe() {
    playId += 1;
    game = createArcade();
    setRacket(game, pointer, pointerY ?? undefined);
    saved = false;
    last = 0;
    form.hidden = true;
    resultEl.hidden = true;
    again.hidden = true;
    hud.hidden = true;
    serveBtn.hidden = false;
    track.hidden = false;
    paint();
  }

  function serve() {
    if (!game) game = createArcade();
    const id = ++playId;
    saved = false;
    last = 0;
    beginServe(game);
    serveBtn.hidden = true;
    resultEl.hidden = true;
    again.hidden = true;
    hud.hidden = false;
    intro();
    paint();
    requestAnimationFrame((time) => frame(time, id));
  }

  function aimTrack(clientX: number) {
    const rect = track.getBoundingClientRect();
    pointer = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
    pointerY = null;
    if (game) setRacket(game, pointer);
    paint();
  }

  function aimCourt(clientX: number, clientY: number) {
    const rect = canvas.getBoundingClientRect();
    const scaleY = canvas.height / rect.height;
    const x = ((clientX - rect.left) / rect.width) * canvas.width;
    const y = ((clientY - rect.top) / rect.height) * canvas.height - 64 * scaleY;
    const spanX = PLAY.right - PLAY.left;
    const spanY = PLAY.back - PLAY.front;
    pointer = Math.min(1, Math.max(0, (x - PLAY.left) / spanX));
    pointerY = Math.min(1, Math.max(0, (y - PLAY.front) / spanY));
    if (game) setRacket(game, pointer, pointerY);
    paint();
  }

  function rejectName() {
    nameInput.value = '';
    naughtyLine.textContent = RUDE_LINES[Math.floor(Math.random() * RUDE_LINES.length)]!;
    if (!naughty.open) naughty.showModal();
    nameInput.focus();
  }

  naughty.querySelector('[data-naughty-ok]')!.addEventListener('click', () => {
    naughty.close();
    nameInput.focus();
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const initials = nameInput.value.trim().toUpperCase();
    if (!/^[A-Z]{2,3}$/.test(initials)) {
      nameInput.value = '';
      nameInput.setCustomValidity('Use two or three letters.');
      nameInput.reportValidity();
      nameInput.setCustomValidity('');
      nameInput.focus();
      return;
    }
    nameInput.value = initials;
    await loadBlocked();
    if (rudeName(initials, blockedInitials)) {
      rejectName();
      return;
    }
    showServe();
  });

  serveBtn.addEventListener('click', () => serve());
  root.querySelector('[data-replay]')!.addEventListener('click', () => showServe());
  root.querySelector('[data-rename]')!.addEventListener('click', () => {
    playId += 1;
    game = null;
    form.hidden = false;
    again.hidden = true;
    resultEl.hidden = true;
    hud.hidden = true;
    serveBtn.hidden = true;
    track.hidden = true;
    paint();
    nameInput.focus();
  });

  track.addEventListener('pointerdown', (event) => {
    track.setPointerCapture(event.pointerId);
    aimTrack(event.clientX);
  });
  track.addEventListener('pointermove', (event) => {
    if (!track.hasPointerCapture(event.pointerId)) return;
    aimTrack(event.clientX);
  });
  canvas.addEventListener('pointerdown', (event) => {
    if (event.pointerType === 'mouse' && event.button !== 0) return;
    canvas.setPointerCapture(event.pointerId);
    aimCourt(event.clientX, event.clientY);
  });
  canvas.addEventListener('pointermove', (event) => {
    const dragging = canvas.hasPointerCapture(event.pointerId);
    if (!dragging && event.pointerType !== 'mouse') return;
    aimCourt(event.clientX, event.clientY);
  });
  window.addEventListener('keydown', (event) => {
    if (!game || game.phase === 'over') return;
    if (event.key === 'ArrowLeft' || event.key === 'a' || event.key === 'A') {
      pointer = Math.max(0, pointer - 0.06);
      event.preventDefault();
      paint();
    }
    if (event.key === 'ArrowRight' || event.key === 'd' || event.key === 'D') {
      pointer = Math.min(1, pointer + 0.06);
      event.preventDefault();
      paint();
    }
  });

  paint();
  void loadBlocked();
  void loadBoard();
</script>

<style>
  .arcade {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .arcade {
      grid-template-columns: minmax(0, 22rem) 16rem;
    }
  }
  .play {
    max-width: 28rem;
  }
  .stack {
    display: grid;
    gap: 0.75rem;
  }
  label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  input {
    width: 100%;
    background: var(--ink-900);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.75rem;
    font: inherit;
  }
  .name-card {
    margin-bottom: 0.8rem;
  }
  .court {
    position: relative;
  }
  .serve-on-court {
    position: absolute;
    left: var(--serve-x);
    top: var(--serve-y);
    transform: translate(-50%, -50%);
    z-index: 2;
  }
  canvas {
    width: 100%;
    height: auto;
    display: block;
    background: #07182c;
    border: 1px solid var(--gold-500);
    border-radius: var(--radius-sm);
    touch-action: none;
  }
  @media (max-width: 700px) {
    .play {
      max-width: none;
    }
    .court {
      display: flex;
      justify-content: center;
    }
    canvas {
      width: min(100%, calc(72dvh * 440 / 660));
    }
    .bat-track {
      display: none;
    }
  }
  .bat-track {
    position: relative;
    height: 4.4rem;
    margin-top: 0.45rem;
    border: 1px solid var(--gold-500);
    border-radius: var(--radius-sm);
    background: #07182c;
    touch-action: none;
  }
  .bat-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.3rem;
    height: 3.3rem;
    color: #9fd0ff;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .bat-knob svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hud {
    display: flex;
    justify-content: space-between;
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .hint,
  .result {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 0.55rem 0 0;
  }
  .again {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }
  .board-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.8rem 0.9rem;
  }
  .board-card h2 {
    margin: 0 0 0.6rem;
  }
  [data-board] {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  [data-board] :global(li) {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr) auto;
    column-gap: 0.55rem;
    align-items: baseline;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
  }
  [data-board] :global(li:last-child) {
    border-bottom: 0;
    padding-bottom: 0;
  }
  [data-board] :global(.rank) {
    color: var(--gold-400);
    font-weight: 700;
  }
  [data-board] :global(.who) {
    overflow-wrap: anywhere;
  }
  [data-board] :global(.tally) {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  [data-board] :global(li.empty) {
    display: block;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  [hidden] {
    display: none !important;
  }
  dialog {
    background: var(--ink-800);
    color: var(--text);
    border: 1px solid var(--gold-500);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem;
    max-width: 24rem;
  }
  dialog::backdrop {
    background: rgba(0, 10, 24, 0.62);
  }
  dialog p {
    margin: 0 0 0.9rem;
  }
</style>
