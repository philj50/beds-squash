---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { SITE, url } from '@/lib/site';

const crumbs = [
  { name: 'Leagues', path: '/leagues/' },
  { name: 'Tables and fixtures', path: '/leagues/results/' },
];
---

<Base
  title="League tables and fixtures"
  description="Read-only Bedfordshire Squash league tables and fixtures for the winter and summer leagues."
  crumbs={crumbs}
>
  <PageHero
    eyebrow="Winter and summer"
    title="Tables and fixtures"
    lede="Published results for previous seasons, and the fixtures for the season now in progress. Click a team for its matches, a score for the match card, or a player’s name for every match they have played. This page is for reading only — captains enter scores on League Master."
  >
    <div class="hero-actions">
      <a class="btn btn--ghost" href={url('/leagues/')}>League rules</a>
      <a class="btn btn--ghost" href={SITE.leagueMaster} target="_blank" rel="noopener">League Master ↗</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div
        id="results-app"
        data-url={SUPABASE_URL}
        data-key={SUPABASE_PUBLISHABLE_KEY}
      >
        <p data-status>Loading tables…</p>
        <div class="kind-row" data-kinds hidden></div>
        <div class="season-row" data-seasons hidden></div>
        <p class="season-meta" data-meta hidden></p>
        <div class="div-row" data-divisions hidden></div>
        <div data-board></div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';

  type Season = { id: number; name: string; starts_on: string; ends_on: string };
  type Division = { id: number; name: string; scoring: string | null };
  type Team = { id: number; name: string; division_id: number };
  type Fixture = {
    id: number;
    division_id: number;
    home_team_id: number;
    away_team_id: number;
    starts_at: string;
    status: string;
    home_points: number | null;
    away_points: number | null;
    home_games: number | null;
    away_games: number | null;
    home: { name: string } | null;
    away: { name: string } | null;
  };
  type Rubber = {
    position: number;
    home_player: string | null;
    away_player: string | null;
    score: string | null;
    winner: string | null;
  };
  type Standing = {
    id: number;
    name: string;
    played: number;
    won: number;
    drawn: number;
    lost: number;
    gamesFor: number;
    gamesAgainst: number;
    points: number;
  };

  const root = document.getElementById('results-app');
  const statusEl = root?.querySelector<HTMLElement>('[data-status]');
  const kindsEl = root?.querySelector<HTMLElement>('[data-kinds]');
  const seasonsEl = root?.querySelector<HTMLElement>('[data-seasons]');
  const metaEl = root?.querySelector<HTMLElement>('[data-meta]');
  const divisionsEl = root?.querySelector<HTMLElement>('[data-divisions]');
  const boardEl = root?.querySelector<HTMLElement>('[data-board]');

  const dateFmt = new Intl.DateTimeFormat('en-GB', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'Europe/London',
  });
  const timeFmt = new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Europe/London',
  });
  const dayFmt = new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'Europe/London',
  });

  function setStatus(message: string) {
    if (!statusEl) return;
    statusEl.hidden = !message;
    statusEl.textContent = message;
  }

  function kindOf(name: string): 'winter' | 'summer' | null {
    if (/^winter\b/i.test(name)) return 'winter';
    if (/^summer\b/i.test(name)) return 'summer';
    return null;
  }

  function shortName(name: string): string {
    return name.replace(/^Winter\s+/i, '').replace(/^Summer League\s+/i, '');
  }

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function hasScore(fixture: Fixture): boolean {
    return fixture.home_points != null && fixture.away_points != null;
  }

  function standingsFor(teams: Team[], fixtures: Fixture[]): Standing[] {
    const rows = new Map<number, Standing>();
    for (const team of teams) {
      rows.set(team.id, {
        id: team.id,
        name: team.name,
        played: 0,
        won: 0,
        drawn: 0,
        lost: 0,
        gamesFor: 0,
        gamesAgainst: 0,
        points: 0,
      });
    }
    for (const fixture of fixtures) {
      if (!hasScore(fixture)) continue;
      const home = rows.get(fixture.home_team_id);
      const away = rows.get(fixture.away_team_id);
      if (!home || !away) continue;
      const hp = fixture.home_points ?? 0;
      const ap = fixture.away_points ?? 0;
      home.played += 1;
      away.played += 1;
      home.points += hp;
      away.points += ap;
      home.gamesFor += fixture.home_games ?? 0;
      home.gamesAgainst += fixture.away_games ?? 0;
      away.gamesFor += fixture.away_games ?? 0;
      away.gamesAgainst += fixture.home_games ?? 0;
      if (hp > ap) {
        home.won += 1;
        away.lost += 1;
      } else if (hp < ap) {
        away.won += 1;
        home.lost += 1;
      } else {
        home.drawn += 1;
        away.drawn += 1;
      }
    }
    return [...rows.values()].sort((a, b) => {
      const points = b.points - a.points;
      if (points) return points;
      const diff = b.gamesFor - b.gamesAgainst - (a.gamesFor - a.gamesAgainst);
      if (diff) return diff;
      const games = b.gamesFor - a.gamesFor;
      if (games) return games;
      return a.name.localeCompare(b.name, 'en-GB');
    });
  }

  function scoreLabel(fixture: Fixture): string {
    if (hasScore(fixture)) return `${fixture.home_points}\u2013${fixture.away_points}`;
    if (fixture.status === 'scheduled') return 'v';
    if (fixture.status === 'postponed') return 'PP';
    if (fixture.status === 'cancelled') return 'Canc';
    if (fixture.status === 'walkover') return 'W/O';
    return '\u2014';
  }

  function resultFor(fixture: Fixture, teamId: number): 'W' | 'D' | 'L' | null {
    if (!hasScore(fixture)) return null;
    const isHome = fixture.home_team_id === teamId;
    const mine = (isHome ? fixture.home_points : fixture.away_points) ?? 0;
    const theirs = (isHome ? fixture.away_points : fixture.home_points) ?? 0;
    if (mine > theirs) return 'W';
    if (mine < theirs) return 'L';
    return 'D';
  }

  function linkablePlayer(name: string | null): string | null {
    const label = name?.trim() ?? '';
    if (label.length < 2 || /walkover/i.test(label)) return null;
    return label;
  }

  function playerCell(name: string | null): string {
    const label = linkablePlayer(name);
    if (!label) return escapeHtml(name?.trim() || '\u2014');
    return `<button type="button" class="player-link" data-player="${escapeHtml(label)}">${escapeHtml(label)}</button>`;
  }

  function rubberGames(score: string | null): { home: number; away: number } | null {
    if (!score) return null;
    let home = 0;
    let away = 0;
    for (const part of score.trim().split(/\s+/)) {
      const [left, right] = part.split('/').map(Number);
      if (!Number.isFinite(left) || !Number.isFinite(right) || left === right) continue;
      if (left > right) home += 1;
      else away += 1;
    }
    return home || away ? { home, away } : null;
  }

  type PlayerMatch = {
    playedOn: string;
    season: string;
    division: string;
    homeTeam: string;
    awayTeam: string;
    opponent: string;
    side: 'home' | 'away';
    won: boolean | null;
    mine: number | null;
    theirs: number | null;
  };

  function renderPlayer(name: string, matches: PlayerMatch[]): string {
    const decided = matches.filter((match) => match.won != null);
    const won = decided.filter((match) => match.won).length;
    const lost = decided.length - won;
    const recent = decided.slice(0, 16).reverse();
    const form = recent
      .map((match) => `<span class="form form--${match.won ? 'w' : 'l'}">${match.won ? 'W' : 'L'}</span>`)
      .join('');
    let lastGroup = '';
    const rows = matches
      .map((match) => {
        const group = `${match.season}${match.division ? ` · ${match.division}` : ''}`;
        const seasonRow = group !== lastGroup ? `<tr class="player-season"><td colspan="5">${escapeHtml(group)}</td></tr>` : '';
        lastGroup = group;
        const when = new Date(match.playedOn);
        const games = match.mine != null && match.theirs != null ? `${match.mine}\u2013${match.theirs}` : '\u2014';
        const mine = match.side === 'home' ? match.homeTeam : match.awayTeam;
        const other = match.side === 'home' ? match.awayTeam : match.homeTeam;
        const result =
          match.won == null ? '' : `<span class="form form--${match.won ? 'w' : 'l'}">${match.won ? 'W' : 'L'}</span>`;
        return `${seasonRow}<tr>
          <td class="when"><time datetime="${match.playedOn}">${dateFmt.format(when)}</time></td>
          <td class="player ${match.won ? 'is-win' : ''}">${playerCell(match.opponent)}</td>
          <td class="score">${games}</td>
          <td class="side"><strong>${escapeHtml(mine)}</strong> v ${escapeHtml(other)}</td>
          <td class="outcome">${result}</td>
        </tr>`;
      })
      .join('');
    return `<article class="card player-card" id="player-matches">
      <div class="card__body">
        <div class="board-head board-head--focus">
          <div>
            <h2>${escapeHtml(name)}</h2>
            <p>${matches.length} match${matches.length === 1 ? '' : 'es'} · won ${won}, lost ${lost} · every published league match under this name</p>
            ${form ? `<div class="form-strip" aria-label="Recent results">${form}</div>` : ''}
          </div>
          <button type="button" class="btn btn--ghost btn--sm" data-player-back>Back to tables</button>
        </div>
        <div class="table-wrap">
          <table class="fixtures">
            <caption class="sr-only">Matches for ${escapeHtml(name)}</caption>
            <thead><tr><th>Date</th><th>Opponent</th><th class="score">Games</th><th>Teams</th><th></th></tr></thead>
            <tbody>${rows || '<tr><td colspan="5">No published matches for this name.</td></tr>'}</tbody>
          </table>
        </div>
      </div>
    </article>`;
  }

  function renderRubbers(fixture: Fixture, rubbers: Rubber[] | null): string {
    if (rubbers === null) return '<p class="muted detail-note">Loading match card…</p>';
    if (!rubbers.length) {
      return `<p class="muted detail-note">${hasScore(fixture) ? 'No match card has been published for this match.' : 'Not played yet.'}</p>`;
    }
    const rows = rubbers
      .map((rubber) => {
        const homeWon = rubber.winner === 'home';
        const awayWon = rubber.winner === 'away';
        const walkover = /walkover/i.test(`${rubber.home_player ?? ''} ${rubber.away_player ?? ''}`) || rubber.score == null;
        return `<tr>
          <td class="num">${rubber.position}</td>
          <td class="player ${homeWon ? 'is-win' : ''}">${playerCell(rubber.home_player)}</td>
          <td class="score">${walkover && !rubber.score ? '<span class="muted">walkover</span>' : escapeHtml(rubber.score ?? '\u2014')}</td>
          <td class="player away ${awayWon ? 'is-win' : ''}">${playerCell(rubber.away_player)}</td>
        </tr>`;
      })
      .join('');
    return `<table class="rubbers">
      <caption class="sr-only">Match card</caption>
      <thead><tr><th class="num">#</th><th>${escapeHtml(fixture.home?.name ?? 'Home')}</th><th>Games</th><th class="away">${escapeHtml(fixture.away?.name ?? 'Away')}</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>`;
  }

  function renderBoard(
    division: Division,
    teams: Team[],
    fixtures: Fixture[],
    focusTeamId: number | null,
    openFixtureId: number | null,
    rubbers: Map<number, Rubber[]>,
  ) {
    if (!boardEl) return;
    const table = standingsFor(teams, fixtures);
    const played = fixtures.filter(hasScore).length;
    const focus = focusTeamId ? teams.find((team) => team.id === focusTeamId) ?? null : null;
    const head = `<div class="board-head"><h2>${escapeHtml(division.name)}</h2><p>${escapeHtml(division.scoring ?? 'League')} · ${played} result${played === 1 ? '' : 's'} · ordered by points, then game difference · click a team for its matches</p></div>`;
    const rows = table
      .map((row, index) => {
        const diff = row.gamesFor - row.gamesAgainst;
        const withdrawn = /withdrawn/i.test(row.name);
        const isFocus = row.id === focusTeamId;
        return `<tr class="team-row ${index === 0 && row.played ? 'is-leader' : ''} ${withdrawn ? 'is-withdrawn' : ''} ${isFocus ? 'is-focus' : ''}" data-team="${row.id}">
          <td class="num">${index + 1}</td>
          <th scope="row"><button type="button" class="team-btn" data-team-btn="${row.id}" aria-pressed="${isFocus}">${escapeHtml(row.name)}</button></th>
          <td class="num">${row.played}</td>
          <td class="num">${row.won}</td>
          <td class="num">${row.drawn}</td>
          <td class="num">${row.lost}</td>
          <td class="num">${row.gamesFor}\u2013${row.gamesAgainst}</td>
          <td class="num">${diff > 0 ? '+' : ''}${diff}</td>
          <td class="num pts">${row.points}</td>
        </tr>`;
      })
      .join('');
    const sorted = [...fixtures].sort((a, b) => a.starts_at.localeCompare(b.starts_at));
    const shown = focus ? sorted.filter((fixture) => fixture.home_team_id === focus.id || fixture.away_team_id === focus.id) : sorted;
    const fixtureRows = shown
      .map((fixture) => {
        const when = new Date(fixture.starts_at);
        const games =
          fixture.home_games != null && fixture.away_games != null
            ? `<span class="games">${fixture.home_games}\u2013${fixture.away_games}</span>`
            : '';
        const homeWin = hasScore(fixture) && (fixture.home_points ?? 0) > (fixture.away_points ?? 0);
        const awayWin = hasScore(fixture) && (fixture.away_points ?? 0) > (fixture.home_points ?? 0);
        const isOpen = fixture.id === openFixtureId;
        const outcome = focus ? resultFor(fixture, focus.id) : null;
        const detail = isOpen
          ? `<tr class="fx-detail"><td colspan="5">${renderRubbers(fixture, rubbers.get(fixture.id) ?? null)}</td></tr>`
          : '';
        return `<tr class="fx-row ${isOpen ? 'is-open' : ''}" data-fixture="${fixture.id}">
          <td class="when"><time datetime="${fixture.starts_at}">${dateFmt.format(when)}<span>${timeFmt.format(when)}</span></time></td>
          <td class="side ${homeWin ? 'is-win' : ''} ${focus && fixture.home_team_id === focus.id ? 'is-focus' : ''}">${escapeHtml(fixture.home?.name ?? 'Home')}</td>
          <td class="score"><button type="button" class="score-btn" data-fixture-btn="${fixture.id}" aria-expanded="${isOpen}" title="${isOpen ? 'Hide match card' : 'Show match card'}">${scoreLabel(fixture)}${games}</button></td>
          <td class="side away ${awayWin ? 'is-win' : ''} ${focus && fixture.away_team_id === focus.id ? 'is-focus' : ''}">${escapeHtml(fixture.away?.name ?? 'Away')}</td>
          <td class="outcome">${outcome ? `<span class="form form--${outcome.toLowerCase()}">${outcome}</span>` : ''}</td>
        </tr>${detail}`;
      })
      .join('');
    let fixtureHead = `<div class="board-head"><h2>Fixtures</h2><p>${fixtures.length} match${fixtures.length === 1 ? '' : 'es'} · home team first · click a score for the match card, then a name for that player’s matches</p></div>`;
    if (focus) {
      const record = shown.reduce(
        (acc, fixture) => {
          const outcome = resultFor(fixture, focus.id);
          if (outcome === 'W') acc.w += 1;
          else if (outcome === 'D') acc.d += 1;
          else if (outcome === 'L') acc.l += 1;
          return acc;
        },
        { w: 0, d: 0, l: 0 },
      );
      const form = shown
        .filter(hasScore)
        .map((fixture) => resultFor(fixture, focus.id))
        .filter((outcome): outcome is 'W' | 'D' | 'L' => outcome !== null)
        .map((outcome) => `<span class="form form--${outcome.toLowerCase()}">${outcome}</span>`)
        .join('');
      fixtureHead = `<div class="board-head board-head--focus">
        <div>
          <h2>${escapeHtml(focus.name)}</h2>
          <p>${shown.length} match${shown.length === 1 ? '' : 'es'} · won ${record.w}${record.d ? `, drawn ${record.d}` : ''}, lost ${record.l}</p>
          ${form ? `<div class="form-strip" aria-label="Results in order">${form}</div>` : ''}
        </div>
        <button type="button" class="btn btn--ghost btn--sm" data-show-all>Show all fixtures</button>
      </div>`;
    }
    boardEl.innerHTML = `
      <article class="card standings-card">
        <div class="card__body">
          ${head}
          <div class="table-wrap">
            <table class="standings">
              <caption class="sr-only">${escapeHtml(division.name)} table</caption>
              <thead>
                <tr>
                  <th class="num">Pos</th>
                  <th>Team</th>
                  <th class="num" title="Played">P</th>
                  <th class="num" title="Won">W</th>
                  <th class="num" title="Drawn">D</th>
                  <th class="num" title="Lost">L</th>
                  <th class="num" title="Games for and against">Games</th>
                  <th class="num" title="Game difference">+/-</th>
                  <th class="num" title="Points">Pts</th>
                </tr>
              </thead>
              <tbody>${rows || '<tr><td colspan="9">No teams in this division.</td></tr>'}</tbody>
            </table>
          </div>
        </div>
      </article>
      <article class="card fixtures-card" id="fixtures">
        <div class="card__body">
          ${fixtureHead}
          <div class="table-wrap">
            <table class="fixtures">
              <caption class="sr-only">${escapeHtml(division.name)} fixtures</caption>
              <thead>
                <tr><th>Date</th><th>Home</th><th class="score">Score</th><th class="away">Away</th><th></th></tr>
              </thead>
              <tbody>${fixtureRows || '<tr><td colspan="5">No fixtures published for this division.</td></tr>'}</tbody>
            </table>
          </div>
        </div>
      </article>`;
  }

  if (root && kindsEl && seasonsEl && metaEl && divisionsEl && boardEl) {
    const kinds = kindsEl;
    const seasonsNav = seasonsEl;
    const meta = metaEl;
    const divisionsNav = divisionsEl;
    const board = boardEl;
    const supabase = createClient(root.dataset.url!, root.dataset.key!);
    let seasons: Season[] = [];
    let kind: 'winter' | 'summer' = 'winter';
    let seasonId = 0;
    let divisionId = 0;
    let divisions: Division[] = [];
    let teams: Team[] = [];
    let fixtures: Fixture[] = [];
    let focusTeamId: number | null = null;
    let openFixtureId: number | null = null;
    let playerName: string | null = null;
    const rubberCache = new Map<number, Rubber[]>();

    function one<T>(value: T | T[] | null | undefined): T | null {
      if (Array.isArray(value)) return value[0] ?? null;
      return value ?? null;
    }

    async function loadPlayerMatches(name: string): Promise<PlayerMatch[]> {
      const quoted = `"${name.replace(/["\\]/g, '')}"`;
      const { data, error } = await supabase
        .from('rubbers')
        .select(
          'home_player, away_player, score, winner, fixtures!inner(starts_at, home:league_teams!fixtures_home_team_id_fkey(name), away:league_teams!fixtures_away_team_id_fkey(name), divisions(name, league_seasons(name)))',
        )
        .or(`home_player.ilike.${quoted},away_player.ilike.${quoted}`)
        .limit(500);
      if (error) throw error;
      const matches = ((data ?? []) as Array<Record<string, unknown>>).flatMap((row) => {
        const fixture = one(row.fixtures as never);
        if (!fixture) return [];
        const division = one((fixture as { divisions?: unknown }).divisions as never) as {
          name?: string;
          league_seasons?: { name?: string } | { name?: string }[] | null;
        } | null;
        const season = one(division?.league_seasons ?? null);
        const home = one((fixture as { home?: unknown }).home as never) as { name?: string } | null;
        const away = one((fixture as { away?: unknown }).away as never) as { name?: string } | null;
        const homePlayer = String(row.home_player ?? '');
        const awayPlayer = String(row.away_player ?? '');
        const side: 'home' | 'away' = homePlayer.toLowerCase() === name.toLowerCase() ? 'home' : 'away';
        const games = rubberGames(row.score == null ? null : String(row.score));
        const winner = row.winner == null ? null : String(row.winner);
        const won = winner === 'home' || winner === 'away' ? winner === side : null;
        return [
          {
            playedOn: String((fixture as { starts_at: string }).starts_at),
            season: season?.name ?? 'League',
            division: division?.name ?? '',
            homeTeam: home?.name ?? 'Home',
            awayTeam: away?.name ?? 'Away',
            opponent: side === 'home' ? awayPlayer : homePlayer,
            side,
            won,
            mine: games ? (side === 'home' ? games.home : games.away) : null,
            theirs: games ? (side === 'home' ? games.away : games.home) : null,
          } satisfies PlayerMatch,
        ];
      });
      return matches.sort((a, b) => b.playedOn.localeCompare(a.playedOn));
    }

    async function showPlayer(name: string) {
      playerName = name;
      history.replaceState(null, '', `#player/${encodeURIComponent(name)}`);
      board.innerHTML = `<article class="card player-card" id="player-matches"><div class="card__body"><p class="muted">Loading matches…</p></div></article>`;
      document.getElementById('player-matches')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      try {
        const matches = await loadPlayerMatches(name);
        if (playerName !== name) return;
        board.innerHTML = renderPlayer(name, matches);
        setStatus('');
      } catch (error) {
        if (playerName !== name) return;
        setStatus(error instanceof Error ? error.message : 'Those matches could not be loaded.');
      }
    }

    async function loadRubbers(fixtureId: number) {
      if (rubberCache.has(fixtureId)) return;
      const { data, error } = await supabase
        .from('rubbers')
        .select('position, home_player, away_player, score, winner')
        .eq('fixture_id', fixtureId)
        .order('position');
      if (error) throw error;
      rubberCache.set(fixtureId, (data ?? []) as Rubber[]);
    }

    function seasonsInKind(value: 'winter' | 'summer'): Season[] {
      return seasons.filter((season) => kindOf(season.name) === value);
    }

    function showKind(value: 'winter' | 'summer') {
      kinds.hidden = false;
      kinds.innerHTML = (['winter', 'summer'] as const)
        .map((item) => {
          const count = seasonsInKind(item).length;
          return `<button type="button" class="kind-btn ${item === value ? 'is-on' : ''}" data-kind="${item}" ${count ? '' : 'disabled'}>${item === 'winter' ? 'Winter' : 'Summer'}<span>${count}</span></button>`;
        })
        .join('');
    }

    function showSeasons(list: Season[], current: number) {
      seasonsNav.hidden = false;
      seasonsNav.innerHTML = list
        .map(
          (season) =>
            `<button type="button" class="season-btn ${season.id === current ? 'is-on' : ''}" data-season="${season.id}">${escapeHtml(shortName(season.name))}</button>`,
        )
        .join('');
    }

    function showDivisions(list: Division[], current: number) {
      divisionsNav.hidden = list.length < 2;
      divisionsNav.innerHTML = list
        .map(
          (division) =>
            `<button type="button" class="div-btn ${division.id === current ? 'is-on' : ''}" data-division="${division.id}">${escapeHtml(division.name)}</button>`,
        )
        .join('');
    }

    async function loadSeason(id: number) {
      setStatus('Loading tables…');
      board.innerHTML = '';
      const { data: divisionRows, error: divisionError } = await supabase
        .from('divisions')
        .select('id, name, scoring')
        .eq('season_id', id)
        .order('name');
      if (divisionError) throw divisionError;
      divisions = divisionRows ?? [];
      const ids = divisions.map((division) => division.id);
      if (!ids.length) {
        teams = [];
        fixtures = [];
        return;
      }
      const [teamResult, fixtureResult] = await Promise.all([
        supabase.from('league_teams').select('id, name, division_id').in('division_id', ids).order('name'),
        supabase
          .from('fixtures')
          .select(
            'id, division_id, home_team_id, away_team_id, starts_at, status, home_points, away_points, home_games, away_games, home:league_teams!fixtures_home_team_id_fkey(name), away:league_teams!fixtures_away_team_id_fkey(name)',
          )
          .in('division_id', ids)
          .order('starts_at'),
      ]);
      if (teamResult.error) throw teamResult.error;
      if (fixtureResult.error) throw fixtureResult.error;
      teams = teamResult.data ?? [];
      fixtures = (fixtureResult.data ?? []).map((row) => {
        const home = Array.isArray(row.home) ? row.home[0] : row.home;
        const away = Array.isArray(row.away) ? row.away[0] : row.away;
        return { ...row, home: home ?? null, away: away ?? null } as Fixture;
      });
    }

    function paint() {
      if (playerName) return;
      const season = seasons.find((item) => item.id === seasonId);
      const inKind = seasonsInKind(kind);
      showKind(kind);
      showSeasons(inKind, seasonId);
      if (!season) {
        meta.hidden = true;
        divisionsNav.hidden = true;
        board.innerHTML = '';
        setStatus('No seasons published yet.');
        return;
      }
      const today = new Date().toISOString().slice(0, 10);
      const ends = season.ends_on.slice(0, 10);
      const inProgress = ends >= today;
      meta.hidden = false;
      meta.textContent = `${dayFmt.format(new Date(`${season.starts_on.slice(0, 10)}T12:00:00`))} – ${dayFmt.format(new Date(`${ends}T12:00:00`))}${inProgress ? ' · in progress' : ''}`;
      const division = divisions.find((item) => item.id === divisionId) ?? divisions[0];
      if (!division) {
        divisionsNav.hidden = true;
        board.innerHTML = '<p class="muted">No divisions published for this season.</p>';
        setStatus('');
        return;
      }
      divisionId = division.id;
      showDivisions(divisions, division.id);
      const divisionTeams = teams.filter((team) => team.division_id === division.id);
      const divisionFixtures = fixtures.filter((fixture) => fixture.division_id === division.id);
      if (focusTeamId && !divisionTeams.some((team) => team.id === focusTeamId)) focusTeamId = null;
      if (openFixtureId && !divisionFixtures.some((fixture) => fixture.id === openFixtureId)) openFixtureId = null;
      renderBoard(division, divisionTeams, divisionFixtures, focusTeamId, openFixtureId, rubberCache);
      setStatus('');
      const parts = [season.id, division.id, focusTeamId ? `t${focusTeamId}` : '', openFixtureId ? `m${openFixtureId}` : ''].filter(Boolean);
      history.replaceState(null, '', `#${parts.join('/')}`);
    }

    async function openFixture(id: number | null) {
      openFixtureId = id;
      paint();
      if (id === null || rubberCache.has(id)) return;
      try {
        await loadRubbers(id);
      } catch {
        rubberCache.set(id, []);
      }
      if (openFixtureId === id) paint();
    }

    board.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const playerButton = target.closest<HTMLButtonElement>('[data-player]');
      if (playerButton?.dataset.player) {
        void showPlayer(playerButton.dataset.player);
        return;
      }
      if (target.closest('[data-player-back]')) {
        playerName = null;
        paint();
        return;
      }
      const teamButton = target.closest<HTMLButtonElement>('[data-team-btn]');
      if (teamButton) {
        const id = Number(teamButton.dataset.teamBtn);
        focusTeamId = focusTeamId === id ? null : id;
        openFixtureId = null;
        paint();
        if (focusTeamId) document.getElementById('fixtures')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      if (target.closest('[data-show-all]')) {
        focusTeamId = null;
        paint();
        return;
      }
      const fixtureButton = target.closest<HTMLButtonElement>('[data-fixture-btn]');
      if (fixtureButton) {
        const id = Number(fixtureButton.dataset.fixtureBtn);
        void openFixture(openFixtureId === id ? null : id);
      }
    });

    async function selectSeason(id: number) {
      const season = seasons.find((item) => item.id === id);
      if (!season) return;
      const nextKind = kindOf(season.name);
      if (nextKind) kind = nextKind;
      seasonId = season.id;
      focusTeamId = null;
      openFixtureId = null;
      playerName = null;
      await loadSeason(season.id);
      divisionId = divisions[0]?.id ?? 0;
      paint();
    }

    kinds.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-kind]');
      if (!button || button.disabled) return;
      const next = button.dataset.kind === 'summer' ? 'summer' : 'winter';
      const list = seasonsInKind(next);
      if (!list.length) return;
      kind = next;
      const today = new Date().toISOString().slice(0, 10);
      const completed = list.find((season) => season.ends_on.slice(0, 10) < today);
      void selectSeason((completed ?? list[0]).id);
    });

    seasonsNav.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-season]');
      if (!button) return;
      void selectSeason(Number(button.dataset.season));
    });

    divisionsNav.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-division]');
      if (!button) return;
      divisionId = Number(button.dataset.division);
      focusTeamId = null;
      openFixtureId = null;
      playerName = null;
      paint();
    });

    try {
      const { data, error } = await supabase
        .from('league_seasons')
        .select('id, name, starts_on, ends_on')
        .order('starts_on', { ascending: false });
      if (error) throw error;
      seasons = (data ?? []).filter((season) => kindOf(season.name));
      const rawHash = location.hash.replace('#', '');
      let hash = rawHash;
      try {
        hash = decodeURIComponent(rawHash);
      } catch {
        hash = rawHash;
      }
      const hashParts = hash.split('/');
      const hashPlayer = hashParts[0] === 'player' ? hashParts.slice(1).join('/') : '';
      const hashSeason = Number(hashParts[0]);
      const hashDivision = Number(hashParts[1]);
      const hashTeam = Number(hashParts.find((part) => /^t\d+$/.test(part))?.slice(1));
      const hashMatch = Number(hashParts.find((part) => /^m\d+$/.test(part))?.slice(1));
      const today = new Date().toISOString().slice(0, 10);
      const completed = seasons.filter((season) => season.ends_on.slice(0, 10) < today);
      const initial = seasons.find((season) => season.id === hashSeason) ?? completed[0] ?? seasons[0];
      if (!initial) {
        setStatus('No seasons published yet.');
      } else {
        const nextKind = kindOf(initial.name);
        if (nextKind) kind = nextKind;
        seasonId = initial.id;
        await loadSeason(initial.id);
        divisionId = divisions.some((division) => division.id === hashDivision) ? hashDivision : (divisions[0]?.id ?? 0);
        focusTeamId = hashTeam || null;
        if (hashPlayer) {
          paint();
          await showPlayer(hashPlayer);
        } else if (hashMatch) await openFixture(hashMatch);
        else paint();
      }
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'The tables could not be loaded.');
    }
  }
</script>

