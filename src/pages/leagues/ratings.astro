---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { url } from '@/lib/site';

const crumbs = [
  { name: 'Leagues', path: '/leagues/' },
  { name: 'SquashLevels', path: '/leagues/ratings/' },
];
---

<Base
  title="SquashLevels ratings"
  description="SquashLevels levels for players in Bedfordshire league clubs — updated from match results."
  crumbs={crumbs}
>
  <PageHero
    eyebrow="Levels"
    title="SquashLevels"
    lede="Levels for league players we track on SquashLevels. Updated when league matches are played. Search by name to see a rating history."
  >
    <div class="hero-actions">
      <a class="btn btn--ghost" href={url('/leagues/results/')}>Tables &amp; fixtures</a>
      <a class="btn btn--ghost" href="https://squashlevels.com/" target="_blank" rel="noopener">SquashLevels ↗</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container ratings" id="ratings-app" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
      <label class="search">
        <span class="sr-only">Search players</span>
        <input type="search" name="q" placeholder="Search by player name…" autocomplete="off" data-search />
      </label>
      <p class="status muted" data-status role="status">Type a name to find a player.</p>
      <div class="overview-box" data-list-wrap hidden>
        <table class="table">
          <thead>
            <tr>
              <th>Player</th>
              <th>Level</th>
              <th>Updated</th>
            </tr>
          </thead>
          <tbody data-players></tbody>
        </table>
      </div>
      <article class="card player-detail" data-detail hidden>
        <div class="card__body">
          <h2 data-detail-name></h2>
          <p class="muted" data-detail-level></p>
          <div class="chart" data-chart hidden></div>
          <h3 class="h-small">Recent results</h3>
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr><th>Date</th><th>Level</th><th>Change</th></tr>
              </thead>
              <tbody data-history></tbody>
            </table>
          </div>
          <button class="btn btn--ghost btn--sm" type="button" data-back>← Back to list</button>
        </div>
      </article>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';

  type Player = { id: number; display_name: string; current_level: number | null; updated_at: string | null };
  type Rating = { recorded_on: string; level: number; kind: string | null; squashlevels_match_id?: string | null };

  const root = document.getElementById('ratings-app');
  if (!root) throw new Error('ratings app missing');
  const supabase = createClient(root.dataset.url!, root.dataset.key!);
  const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
  const listWrap = root.querySelector<HTMLElement>('[data-list-wrap]')!;
  const playersBody = root.querySelector<HTMLElement>('[data-players]')!;
  const search = root.querySelector<HTMLInputElement>('[data-search]')!;
  const detail = root.querySelector<HTMLElement>('[data-detail]')!;
  const detailName = root.querySelector<HTMLElement>('[data-detail-name]')!;
  const detailLevel = root.querySelector<HTMLElement>('[data-detail-level]')!;
  const chartEl = root.querySelector<HTMLElement>('[data-chart]')!;
  const historyBody = root.querySelector<HTMLElement>('[data-history]')!;

  let players: Player[] = [];
  const dayFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

  const levelText = (n: number | null) => (n == null ? '—' : n.toLocaleString('en-GB'));

  function renderList(filter = '') {
    const q = filter.trim().toLowerCase();
    statusEl.hidden = false;
    if (q.length < 2) {
      listWrap.hidden = true;
      playersBody.innerHTML = '';
      statusEl.textContent = 'Type a name to find a player.';
      return;
    }
    const rows = players.filter((p) => p.display_name.toLowerCase().includes(q));
    statusEl.textContent = rows.length === 1 ? '1 player' : `${rows.length} players`;
    listWrap.hidden = false;
    playersBody.innerHTML =
      rows.length === 0
        ? '<tr><td colspan="3">No players match.</td></tr>'
        : rows
            .map(
              (p) =>
                `<tr><td><button type="button" class="link-button" data-pick="${p.id}">${escapeHtml(p.display_name)}</button></td><td>${levelText(p.current_level)}</td><td>${p.updated_at ? dayFmt.format(new Date(p.updated_at)) : '—'}</td></tr>`,
            )
            .join('');
  }

  function timeline(ratings: Rating[]) {
    const after = ratings.filter((row) => row.kind === 'after');
    const source = after.length ? after : ratings;
    return source.slice().sort((a, b) => a.recorded_on.localeCompare(b.recorded_on) || String(a.squashlevels_match_id ?? '').localeCompare(String(b.squashlevels_match_id ?? '')));
  }

  function drawChart(points: Rating[]) {
    if (points.length < 2) {
      chartEl.hidden = true;
      chartEl.innerHTML = '';
      return;
    }
    const width = 640;
    const height = 220;
    const pad = { l: 56, r: 16, t: 16, b: 36 };
    const levels = points.map((point) => point.level);
    let min = Math.min(...levels);
    let max = Math.max(...levels);
    if (min === max) {
      min -= 50;
      max += 50;
    }
    const padY = (max - min) * 0.08;
    min -= padY;
    max += padY;
    const innerW = width - pad.l - pad.r;
    const innerH = height - pad.t - pad.b;
    const xAt = (index: number) => pad.l + (index / (points.length - 1)) * innerW;
    const yAt = (level: number) => pad.t + ((max - level) / (max - min)) * innerH;
    const line = points.map((point, index) => `${index === 0 ? 'M' : 'L'}${xAt(index).toFixed(1)},${yAt(point.level).toFixed(1)}`).join(' ');
    const yTicks = [max, (max + min) / 2, min];
    const xTicks = [0, Math.floor((points.length - 1) / 2), points.length - 1];
    const dateLabel = (iso: string) => dayFmt.format(new Date(`${iso}T12:00:00`));
    const anchor = (index: number) => (index === 0 ? 'start' : index === points.length - 1 ? 'end' : 'middle');
    chartEl.hidden = false;
    chartEl.innerHTML = `<svg viewBox="0 0 ${width} ${height}" role="img" aria-label="Level after each match">
      ${yTicks
        .map((tick) => {
          const y = yAt(tick);
          return `<line x1="${pad.l}" y1="${y.toFixed(1)}" x2="${width - pad.r}" y2="${y.toFixed(1)}" stroke="#c5d6e8" stroke-opacity="0.25" /><text x="${pad.l - 8}" y="${(y + 4).toFixed(1)}" text-anchor="end" fill="#c5d6e8" font-size="12">${levelText(Math.round(tick))}</text>`;
        })
        .join('')}
      <path d="${line}" fill="none" stroke="#f2b705" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
      ${xTicks.map((index) => `<text x="${xAt(index).toFixed(1)}" y="${height - 10}" text-anchor="${anchor(index)}" fill="#c5d6e8" font-size="12">${dateLabel(points[index].recorded_on)}</text>`).join('')}
    </svg>
    <p class="muted small">Level after each match.</p>`;
  }

  async function showPlayer(id: number) {
    const player = players.find((p) => p.id === id);
    if (!player) return;
    detailName.textContent = player.display_name;
    detailLevel.textContent = `Current level: ${levelText(player.current_level)}`;
    chartEl.hidden = true;
    chartEl.innerHTML = '';
    historyBody.innerHTML = '<tr><td colspan="3">Loading…</td></tr>';
    listWrap.hidden = true;
    search.hidden = true;
    detail.hidden = false;
    const { data, error } = await supabase
      .from('squashlevels_ratings')
      .select('recorded_on, level, kind, squashlevels_match_id')
      .eq('player_id', id)
      .order('recorded_on', { ascending: true })
      .order('squashlevels_match_id', { ascending: true })
      .limit(1000);
    if (error) {
      historyBody.innerHTML = `<tr><td colspan="3">${escapeHtml(error.message)}</td></tr>`;
      return;
    }
    const points = timeline((data ?? []) as Rating[]);
    drawChart(points);
    const recent = points.slice(-12).reverse();
    historyBody.innerHTML =
      recent.length === 0
        ? '<tr><td colspan="3">No history yet.</td></tr>'
        : recent
            .map((row, index) => {
              const prev = recent[index + 1];
              const delta = prev ? row.level - prev.level : null;
              const change =
                delta == null ? '—' : delta === 0 ? '—' : delta > 0 ? `+${delta}` : String(delta);
              return `<tr><td>${dayFmt.format(new Date(`${row.recorded_on}T12:00:00`))}</td><td>${levelText(row.level)}</td><td>${change}</td></tr>`;
            })
            .join('');
  }

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
  }

  root.addEventListener('click', (event) => {
    const pick = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-pick]');
    if (pick) {
      void showPlayer(Number(pick.dataset.pick));
      return;
    }
    if ((event.target as HTMLElement).closest('[data-back]')) {
      detail.hidden = true;
      search.hidden = false;
      renderList(search.value);
    }
  });

  search.addEventListener('input', () => renderList(search.value));

  const loaded: Player[] = [];
  let loadError: { message: string } | null = null;
  for (let from = 0; ; from += 1000) {
    const { data, error } = await supabase
      .from('squashlevels_players')
      .select('id, display_name, current_level, updated_at')
      .order('display_name', { ascending: true })
      .range(from, from + 999);
    if (error) {
      loadError = error;
      break;
    }
    loaded.push(...((data ?? []) as Player[]));
    if (!data || data.length < 1000) break;
  }
  if (loadError && loaded.length === 0) {
    statusEl.textContent = loadError.message;
  } else {
    players = loaded;
    renderList(search.value);
  }
</script>

<style>
  .ratings .search {
    display: block;
    margin-bottom: 1rem;
  }
  .ratings .search input {
    width: 100%;
    max-width: 28rem;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--bg-elev);
    color: var(--text);
    font: inherit;
  }
  .ratings .overview-box {
    border: 2px solid var(--gold-500);
    border-radius: var(--radius);
    background: var(--bg-elev);
    overflow-x: auto;
  }
  .ratings .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.84rem;
    line-height: 1.25;
  }
  .ratings .table th,
  .ratings .table td {
    text-align: left;
    vertical-align: middle;
    padding: 0.2rem 0.45rem;
    border-bottom: 1px solid var(--border);
  }
  .ratings .table th {
    color: var(--gold-400);
  }
  .ratings .link-button {
    background: none;
    border: none;
    padding: 0;
    color: var(--link);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ratings .player-detail {
    margin-top: 1rem;
  }
  .ratings .h-small {
    margin: 1.25rem 0 0.5rem;
    font-size: 1rem;
  }
  .ratings .chart svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .ratings .chart .grid {
    stroke: var(--border);
    stroke-width: 1;
  }
  .ratings .chart .line {
    fill: none;
    stroke: var(--gold-500);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .ratings .chart text {
    fill: var(--text-muted);
    font-size: 12px;
    font-family: inherit;
  }
  .ratings .chart .small {
    margin: 0.35rem 0 0;
    font-size: 0.8rem;
  }
</style>
