---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { getDocuments } from '@/lib/content';
import { DOC_CATEGORY_LABEL, formatDate, url } from '@/lib/site';

export async function getStaticPaths() {
  const docs = await getDocuments();
  return docs.map((doc) => ({ params: { id: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const hasBody = Boolean(doc.body?.trim());
---

<Base
  title={doc.data.title}
  description={doc.data.summary ?? `${doc.data.title} — ${DOC_CATEGORY_LABEL[doc.data.category]} published by Bedfordshire Squash.`}
  crumbs={[
    { name: 'Documents', path: '/documents/' },
    { name: doc.data.title, path: `/documents/${doc.id}/` },
  ]}
>
  <PageHero eyebrow={DOC_CATEGORY_LABEL[doc.data.category]} title={doc.data.title} lede={doc.data.summary}>
    <div class="actions">
      {doc.data.file && <a class="btn btn--primary" href={url(doc.data.file)} target="_blank" rel="noopener">Download PDF</a>}
      <a class="btn btn--ghost" href={url('/documents/')}>All documents</a>
    </div>
    {doc.data.updated && <p class="muted" style="margin-top:1rem">Last updated {formatDate(doc.data.updated)}</p>}
  </PageHero>
  <section class="section">
    <div class="container narrow prose">
      {
        hasBody ? (
          <Content />
        ) : doc.data.file ? (
          <p class="notice">This document is available as a PDF download above.</p>
        ) : (
          <p class="notice">No file has been uploaded for this document yet.</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }
</style>
