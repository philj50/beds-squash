---
import Base from '@/layouts/Base.astro';
import NewsCard from '@/components/NewsCard.astro';
import EventCard from '@/components/EventCard.astro';
import ClubMap from '@/components/ClubMap.astro';
import PsaTour from '@/components/PsaTour.astro';
import { getNews, getUpcomingEvents, getClubs, onMainNewsList } from '@/lib/content';
import { toMapClubs } from '@/lib/geo';
import { CATEGORY_LABEL, SITE, formatShort, url } from '@/lib/site';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { ruleFor, SINGLES_RULES_EDITION, SINGLES_RULES_URL } from '@/lib/squash-rules';

const news = (await getNews()).filter(onMainNewsList);
const featured = news.find((p) => p.data.featured) ?? news[0];
const latest = news.filter((p) => p.id !== featured?.id).slice(0, 3);
const upcoming = (await getUpcomingEvents()).slice(0, 4);
const stories = news.slice(0, 6).map((post) => ({
  kicker: CATEGORY_LABEL[post.data.category] ?? 'News',
  title: post.data.title,
  href: url(`/news/${post.id}/`),
  when: formatShort(post.data.date),
}));
const nextOn = upcoming[0];
const hooks = [
  ...(stories[0] ? [stories[0]] : []),
  ...(nextOn
    ? [
        {
          kicker: 'Coming up',
          title: nextOn.data.title,
          href: url(`/events/${nextOn.id}/`),
          when: formatShort(nextOn.data.start),
        },
      ]
    : []),
  ...stories.slice(1),
];
const rule = ruleFor(new Date());
const clubs = await getClubs();
const mapClubs = await toMapClubs(clubs);
const leagueClubs = clubs.filter((c) => c.data.leagueClub && !c.data.associate);
const totalCourts = clubs.reduce((n, c) => n + (c.data.courts ?? 0), 0);
const totalTeams = leagueClubs.reduce((n, c) => n + c.data.teams.length, 0);
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <span class="eyebrow">Bedfordshire Squash &amp; Racketball Association</span>
        <h1>
          Squash in <span class="hl">Bedfordshire</span>.<br />
          Find a court. Join a team. Play.
        </h1>
        <p class="lede">
          The county home of squash and racketball — leagues, tournaments, juniors, county teams and every club and
          court from Luton to Bedford.
        </p>
        {
          hooks.length > 0 && (
            <div class="now" data-now>
              <div class="now__bar">
                <p class="now__label">Just in</p>
                <div class="now__nav">
                  <button class="now__btn" type="button" data-now-prev>
                    Back
                  </button>
                  <button class="now__btn" type="button" data-now-next>
                    Next
                  </button>
                </div>
              </div>
              <div class="now__links">
                {hooks.map((item, index) => (
                  <a class="now__link" href={item.href} data-now-item hidden={index > 1}>
                    <span class="now__kicker">{item.kicker}</span>
                    <span class="now__when">{item.when}</span>
                    <span class="now__title">{item.title}</span>
                  </a>
                ))}
              </div>
              <div class="now__meter" aria-hidden="true">
                <span data-now-meter />
              </div>
            </div>
          )
        }
        <div class="hero__cta">
          <a class="btn btn--primary" href={url('/clubs/')}>Find a club near you</a>
          <a class="btn btn--ghost" href={url('/events/')}>What's on</a>
          <a class="btn btn--ghost" href={url('/captains/score/')}>Watch</a>
        </div>
        <ul class="stats" aria-label="County at a glance">
          <li><strong>{leagueClubs.length}</strong><span>league clubs</span></li>
          <li><strong>{totalTeams}</strong><span>league teams</span></li>
          <li><strong>{totalCourts}+</strong><span>courts</span></li>
          <li><strong>2</strong><span>divisions</span></li>
        </ul>
      </div>
      <figure class="hero__film">
        <video
          controls
          playsinline
          preload="metadata"
          src={url('/video/beds-squash-launch-v3.mp4')}
          aria-label="Bedfordshire Squash launch film"
        ></video>
      </figure>
    </div>
  </section>

  <section class="section section--tight" id="on-court" data-home-watch data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY} data-score={url('/captains/score/')} hidden>
    <div class="container">
      <div class="section-head">
        <h2>On court</h2>
        <a href={url('/captains/score/')}>Watch →</a>
      </div>
      <ul class="watch-list" data-watch-list></ul>
    </div>
  </section>

  <!-- QUICK LINKS -->
  <section class="section section--tight">
    <div class="container quick">
      <a href={url('/leagues/results/')} class="quick__item">
        <span class="quick__icon">🏆</span>
        <span><strong>League tables</strong><small>Winter and summer fixtures and results</small></span>
      </a>
      <a href={url('/tournaments/')} class="quick__item">
        <span class="quick__icon">🎯</span>
        <span><strong>Tournaments</strong><small>County Closed, League Cup and the honours board</small></span>
      </a>
      <a href={url('/juniors/')} class="quick__item">
        <span class="quick__icon">⚡</span>
        <span><strong>Juniors</strong><small>County squad, ladder &amp; coaching</small></span>
      </a>
    </div>
  </section>

  <!-- RULE OF THE DAY -->
  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <h2>Rule of the day</h2>
        <a href={SINGLES_RULES_URL} target="_blank" rel="noopener">Singles rules →</a>
      </div>
      <article class="rule" data-rule data-rule-index={rule.index}>
        <p class="rule__when" data-rule-when>{rule.when}</p>
        <h3 data-rule-title>{rule.title}</h3>
        <p class="rule__text" data-rule-text>{rule.text}</p>
        <p class="rule__ref">{SINGLES_RULES_EDITION}, <span data-rule-ref>{rule.rule}</span></p>
        <p class="rule__note">A plain-language reminder for a league night. The official singles rules decide a match.</p>
      </article>
    </div>
  </section>

  <!-- NEWS -->
  {
    featured && (
      <section class="section" data-home-news>
        <div class="container">
          <div class="section-head">
            <h2>Latest news</h2>
            <a href={url('/news/')}>All news →</a>
          </div>
          <div class="stack" style="--stack: 1.25rem">
            <NewsCard post={featured} large />
            {latest.length > 0 && (
              <div class="grid grid--3">
                {latest.map((p) => (
                  <NewsCard post={p} />
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <section class="section" id="home-photos" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY} hidden>
    <div class="container">
      <div class="section-head">
        <h2>Photos</h2>
        <a href={url('/gallery/')}>All photos →</a>
      </div>
      <div class="grid grid--4" data-home-photos></div>
    </div>
    <dialog class="photo-view" data-photo-view>
      <button class="photo-view__close" type="button" aria-label="Close" data-photo-close>×</button>
      <figure>
        <img alt="" data-photo-img />
        <figcaption data-photo-cap></figcaption>
      </figure>
    </dialog>
  </section>

  <!-- EVENTS -->
  <section class="section events-band">
    <div class="container">
      <div class="section-head">
        <h2>Coming up</h2>
        <a href={url('/events/')}>Full calendar →</a>
      </div>
      {
        upcoming.length > 0 ? (
          <div class="grid grid--2">
            {upcoming.map((e) => (
              <EventCard event={e} />
            ))}
          </div>
        ) : (
          <p class="notice">No upcoming events listed yet. Check back soon or see the England Squash calendar.</p>
        )
      }
      <p class="muted small">
        Includes county events, club tournaments and key <a href={SITE.englandSquashEvents} target="_blank" rel="noopener">England Squash</a> dates.
        <a href={url('/events.ics')}>Subscribe to the calendar</a>.
      </p>
    </div>
  </section>

  <PsaTour compact />

  <!-- MAP -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Clubs &amp; courts</h2>
        <a href={url('/clubs/')}>All clubs →</a>
      </div>
      <ClubMap clubs={mapClubs} height="320px" />
      <div class="club-chips">
        {
          leagueClubs.map((c) => (
            <a class="chip" href={url(`/clubs/${c.id}/`)}>
              {c.data.name}
              {c.data.town && <small>{c.data.town}</small>}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container cta">
      <div>
        <span class="eyebrow">Get involved</span>
        <h2>New to squash? Returning after a break?</h2>
        <p>
          Every club in the county welcomes new players, and most teams are looking for members. Pay-and-play courts
          are available across Bedford, Luton, Biggleswade, Flitwick and Leighton Buzzard.
        </p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--primary" href={url('/clubs/')}>Find your nearest court</a>
        <a class="btn btn--ghost" href={url('/contact/')}>Contact the committee</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(900px 500px at 85% 20%, rgba(241, 90, 34, 0.1), transparent 60%),
      repeating-linear-gradient(-55deg, transparent 0 38px, rgba(14, 39, 68, 0.025) 38px 40px);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 1.25rem;
    padding: clamp(1.4rem, 3.5vw, 2.4rem) 0 clamp(1.1rem, 2.5vw, 1.8rem);
  }
  .hero h1 {
    margin-bottom: 1rem;
  }
  .hl {
    color: var(--accent);
  }
  .lede {
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    color: var(--text-muted);
    max-width: 58ch;
  }
  .hero__cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin: 0.75rem 0 1rem;
  }
  .stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .stats li {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .stats strong {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 800;
    color: var(--accent);
  }
  .stats span {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .hero__film {
    margin: 0;
  }
  .hero__film video {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    background: #000;
  }

  .watch-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .watch-list a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
  }
  .watch-list a:hover {
    border-color: var(--accent);
  }
  .watch-list span {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .quick {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }
  .quick__item {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    padding: 0.45rem 0.65rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .quick__item:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .quick__icon {
    font-size: 1.2rem;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border-radius: 10px;
    flex-shrink: 0;
  }
  .quick__item strong {
    display: block;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.1rem;
    letter-spacing: 0.03em;
  }
  .quick__item small {
    color: var(--text-muted);
    display: block;
  }

  .rule {
    background: #fff;
    border: 1px solid var(--border-strong);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.75rem 0.9rem 0.65rem;
  }
  .rule__when {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .rule h3 {
    margin: 0.15rem 0 0.35rem;
  }
  .rule__text {
    margin: 0;
    max-width: 68ch;
    font-size: 1.05rem;
    line-height: 1.45;
  }
  .rule__ref {
    margin: 0.45rem 0 0;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .rule__note {
    margin: 0.35rem 0 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .events-band {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .small {
    font-size: 0.9rem;
    margin: 1.25rem 0 0;
  }

  .club-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .chip {
    display: inline-flex;
    flex-direction: column;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.2;
  }
  .chip small {
    color: var(--text-muted);
    font-weight: 400;
    font-size: 0.75rem;
  }
  .chip:hover {
    border-color: var(--accent);
  }

  .cta {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background:
      linear-gradient(135deg, rgba(241, 90, 34, 0.1), rgba(14, 39, 68, 0.04)),
      #fff;
    border: 1px solid var(--border-strong);
  }
  .cta p {
    color: var(--text-muted);
    margin: 0;
  }
  .cta__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .now {
    margin: 0.85rem 0 0.15rem;
    background: #fff;
    border: 1px solid var(--border-strong);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.45rem 0.7rem 0.4rem;
  }
  .now__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .now__label {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--accent);
  }
  .now__nav {
    display: none;
    gap: 0.35rem;
  }
  .now--live .now__nav {
    display: flex;
  }
  .now__btn {
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    color: #0e2744;
    background: #fff;
    border: 1px solid rgba(14, 39, 68, 0.28);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    cursor: pointer;
  }
  .now__btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .now__links {
    display: grid;
    gap: 0.15rem;
  }
  @media (min-width: 720px) {
    .now__links {
      grid-template-columns: 1fr 1fr;
      gap: 0.65rem;
    }
  }
  .now__link[hidden] {
    display: none;
  }
  .now__link {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'kicker when'
      'title title';
    column-gap: 0.6rem;
    row-gap: 0.1rem;
    padding: 0.4rem 0 0.25rem;
    color: #0e2744;
    text-decoration: none;
    border-top: 1px solid rgba(14, 39, 68, 0.12);
  }
  @media (min-width: 720px) {
    .now__link {
      border-top: 0;
      padding-top: 0.35rem;
    }
  }
  .now__link.is-fresh {
    animation: now-in 0.35s ease;
  }
  .now__kicker {
    grid-area: kicker;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .now__when {
    grid-area: when;
    justify-self: end;
    color: #3d4d5f;
    font-size: 0.75rem;
  }
  .now__title {
    grid-area: title;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.08rem;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .now__link:hover .now__title {
    color: var(--accent);
  }
  .now__meter {
    display: none;
    height: 2px;
    margin-top: 0.2rem;
    border-radius: 2px;
    background: rgba(14, 39, 68, 0.08);
    overflow: hidden;
  }
  .now--live .now__meter {
    display: block;
  }
  .now__meter span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
  }
  .now__meter span.is-on {
    animation: now-meter var(--now-hold, 600s) linear;
  }
  @keyframes now-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes now-meter {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.35rem;
    }
    .stats strong {
      font-size: 1.35rem;
    }
    .stats span {
      font-size: 0.68rem;
      letter-spacing: 0.04em;
    }
    .cta {
      grid-template-columns: 1fr;
    }
  }
  #home-photos[hidden] {
    display: none;
  }
  #home-photos :global(.photo-open) {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  #home-photos :global(.photo-open img) {
    display: block;
  }
  .photo-view {
    border: 0;
    padding: 0.75rem;
    background: var(--ink-900);
    color: var(--text);
    max-width: min(52rem, 94vw);
  }
  .photo-view::backdrop {
    background: rgba(5, 6, 8, 0.78);
  }
  .photo-view figure {
    margin: 0;
  }
  .photo-view img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(50rem, 90vw);
    max-height: 78vh;
    object-fit: contain;
    background: var(--ink-950);
  }
  .photo-view figcaption {
    margin-top: 0.55rem;
    color: var(--ink-200);
  }
  .photo-view figcaption:empty {
    display: none;
  }
  .photo-view__close {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    width: 2.2rem;
    height: 2.2rem;
    border: 0;
    border-radius: 50%;
    background: rgba(5, 6, 8, 0.72);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { publicPlayerName } from '@/lib/scoreboard';

  const homeWatch = document.querySelector<HTMLElement>('[data-home-watch]');
  if (homeWatch?.dataset.url && homeWatch.dataset.key) {
    const homeScore = homeWatch.dataset.score || '/captains/score/';
    const homeList = homeWatch.querySelector<HTMLElement>('[data-watch-list]')!;
    const homeClient = createClient(homeWatch.dataset.url, homeWatch.dataset.key);
    type HomeMatch = { id: number; playerA: string; playerB: string; score: string };

    async function paintHomeWatch() {
      const { data: sessionData } = await homeClient.auth.getSession();
      const { data, error } = await homeClient.rpc('current_matches');
      const rows = !error && Array.isArray(data) ? (data as HomeMatch[]) : [];
      if (!rows.length) {
        homeWatch.hidden = true;
        homeList.replaceChildren();
        return;
      }
      const signedIn = Boolean(sessionData.session);
      const name = (value: string) => (signedIn ? value : publicPlayerName(value));
      const pretty = (score: string) => (score || '0-0').replace(/-/g, '–');
      homeList.replaceChildren();
      for (const row of rows) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `${homeScore}?watch=${row.id}`;
        const players = document.createElement('span');
        players.textContent = `${name(row.playerA)} v ${name(row.playerB)}`;
        players.style.color = 'inherit';
        const score = document.createElement('span');
        score.textContent = pretty(row.score);
        link.append(players, score);
        item.append(link);
        homeList.append(item);
      }
      homeWatch.hidden = false;
    }

    void paintHomeWatch();
    window.setInterval(() => void paintHomeWatch(), 15000);
  }
</script>

<script>
  import { createClient } from '@supabase/supabase-js';

  type HomePhoto = { caption: string | null; storage_path: string };

  const photos = document.getElementById('home-photos');
  if (photos) {
    const supabase = createClient(photos.dataset.url!, photos.dataset.key!);
    const host = photos.querySelector<HTMLElement>('[data-home-photos]')!;
    const escapeHtml = (value: string) =>
      value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
    const { data } = await supabase
      .from('contributions')
      .select('caption, storage_path')
      .eq('kind', 'photo')
      .eq('status', 'published')
      .order('published_at', { ascending: false })
      .limit(4);
    const items = ((data ?? []) as HomePhoto[]).filter((item) => item.storage_path);
    if (items.length) {
      const { data: signed } = await supabase.storage.from('contributions').createSignedUrls(
        items.map((item) => item.storage_path),
        3600,
      );
      const urls = new Map((signed ?? []).filter((row) => row.path && row.signedUrl).map((row) => [row.path!, row.signedUrl!]));
      host.innerHTML = items
        .map((item) => {
          const src = urls.get(item.storage_path);
          if (!src) return '';
          const label = escapeHtml(item.caption?.trim() || 'Photo');
          return `<button class="photo-open" type="button" data-photo-open><img class="card__img" src="${escapeHtml(src)}" alt="${label}" loading="lazy" /></button>`;
        })
        .join('');
      if (host.innerHTML.trim()) photos.hidden = false;
      const view = photos.querySelector<HTMLDialogElement>('[data-photo-view]')!;
      const viewImg = view.querySelector<HTMLImageElement>('[data-photo-img]')!;
      const viewCap = view.querySelector<HTMLElement>('[data-photo-cap]')!;
      host.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-photo-open]');
        const image = button?.querySelector('img');
        if (!button || !image) return;
        viewImg.src = image.src;
        viewImg.alt = image.alt;
        viewCap.textContent = image.alt === 'Photo' ? '' : image.alt;
        if (!view.open) view.showModal();
      });
      view.querySelector('[data-photo-close]')?.addEventListener('click', () => view.close());
      view.addEventListener('click', (event) => {
        if (event.target === view) view.close();
      });
    }
  }
</script>

<script>
  import { ruleFor } from '@/lib/squash-rules';

  const ruleCard = document.querySelector('[data-rule]');
  if (ruleCard instanceof HTMLElement) {
    const today = ruleFor(new Date());
    if (ruleCard.dataset.ruleIndex !== String(today.index)) {
      ruleCard.dataset.ruleIndex = String(today.index);
      const when = ruleCard.querySelector('[data-rule-when]');
      const title = ruleCard.querySelector('[data-rule-title]');
      const text = ruleCard.querySelector('[data-rule-text]');
      const ref = ruleCard.querySelector('[data-rule-ref]');
      if (when) when.textContent = today.when;
      if (title) title.textContent = today.title;
      if (text) text.textContent = today.text;
      if (ref) ref.textContent = today.rule;
    }
  }

  const root = document.querySelector('[data-now]');
  if (root instanceof HTMLElement) {
    let items = [...root.querySelectorAll<HTMLElement>('[data-now-item]')];
    const meter = root.querySelector<HTMLElement>('[data-now-meter]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (items.length > 2) {
      const hold = 10 * 60 * 1000;
      root.style.setProperty('--now-hold', `${hold}ms`);
      let pages = Math.ceil(items.length / 2);
      let page = 0;
      let timer = 0;
      let paused = false;
      let swiped = false;

      const show = (nextPage: number) => {
        page = ((nextPage % pages) + pages) % pages;
        const start = page * 2;
        items.forEach((item, index) => {
          const on = index === start || index === start + 1;
          item.hidden = !on;
          item.classList.toggle('is-fresh', on && !reduce);
        });
        if (meter && !reduce && !paused) {
          meter.classList.remove('is-on');
          void meter.offsetWidth;
          meter.classList.add('is-on');
        }
      };

      const stop = () => {
        window.clearInterval(timer);
        timer = 0;
        meter?.classList.remove('is-on');
      };

      const play = () => {
        stop();
        if (reduce || paused) return;
        timer = window.setInterval(() => show(page + 1), hold);
        if (meter) {
          meter.classList.remove('is-on');
          void meter.offsetWidth;
          meter.classList.add('is-on');
        }
      };

      root.querySelector('[data-now-prev]')?.addEventListener('click', () => {
        show(page - 1);
        play();
      });
      root.querySelector('[data-now-next]')?.addEventListener('click', () => {
        show(page + 1);
        play();
      });
      if (!window.matchMedia('(pointer: coarse)').matches) {
        root.addEventListener('pointerenter', () => {
          paused = true;
          stop();
        });
        root.addEventListener('pointerleave', () => {
          paused = false;
          play();
        });
      }
      root.addEventListener('focusin', () => {
        paused = true;
        stop();
      });
      root.addEventListener('focusout', (event) => {
        if (event.relatedTarget instanceof Node && root.contains(event.relatedTarget)) return;
        paused = false;
        play();
      });

      let touchX = 0;
      root.addEventListener(
        'touchstart',
        (event) => {
          touchX = event.changedTouches[0]?.clientX ?? 0;
          swiped = false;
        },
        { passive: true },
      );
      root.addEventListener(
        'touchend',
        (event) => {
          const delta = (event.changedTouches[0]?.clientX ?? touchX) - touchX;
          if (Math.abs(delta) < 36) return;
          swiped = true;
          show(delta < 0 ? page + 1 : page - 1);
          play();
        },
        { passive: true },
      );
      root.addEventListener(
        'click',
        (event) => {
          if (!swiped) return;
          event.preventDefault();
          swiped = false;
        },
        true,
      );

      document.addEventListener('beds-match-places', () => {
        items = items.filter((item) => item.isConnected);
        pages = Math.ceil(items.length / 2);
        if (pages < 1) {
          root.hidden = true;
          stop();
          return;
        }
        show(Math.min(page, pages - 1));
      });

      root.classList.add('now--live');
      show(0);
      play();
    }
  }
</script>
