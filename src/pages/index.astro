---
import Base from '@/layouts/Base.astro';
import NewsCard from '@/components/NewsCard.astro';
import EventCard from '@/components/EventCard.astro';
import { eventDay, getNews, getUpcomingEvents, getClubs, todayKey } from '@/lib/content';
import { SITE, url } from '@/lib/site';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { ruleFor, SINGLES_RULES_EDITION, SINGLES_RULES_URL } from '@/lib/squash-rules';

const news = await getNews();
const upcoming = (await getUpcomingEvents()).filter((event) => eventDay(event) >= todayKey()).slice(0, 4);
const rule = ruleFor(new Date());
const clubs = await getClubs();
const leagueClubs = clubs.filter((c) => c.data.leagueClub && !c.data.associate);
const totalCourts = clubs.reduce((n, c) => n + (c.data.courts ?? 0), 0);
const totalTeams = leagueClubs.reduce((n, c) => n + c.data.teams.length, 0);
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <span class="eyebrow">Bedfordshire Squash &amp; Racketball Association</span>
        <h1>
          Squash in <span class="hl">Bedfordshire</span>.<br />
          Find a court. Join a team. Play.
        </h1>
        <p class="lede">
          The county home of squash and racketball — leagues, tournaments, juniors, county teams and every club and
          court from Luton to Bedford.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={url('/captains/watch/')}>Match commentary</a>
          <a class="btn btn--ghost" href={url('/clubs/')}>Find a club near you</a>
          <a class="btn btn--ghost" href={url('/events/')}>What's on</a>
        </div>
        <ul class="stats" aria-label="County at a glance">
          <li><strong>{leagueClubs.length}</strong><span>league clubs</span></li>
          <li><strong>{totalTeams}</strong><span>league teams</span></li>
          <li><strong>{totalCourts}+</strong><span>courts</span></li>
          <li><strong>2</strong><span>divisions</span></li>
        </ul>
      </div>
      <figure class="hero__film">
        <video
          controls
          playsinline
          preload="metadata"
          src={url('/video/beds-squash-launch-v3.mp4')}
          aria-label="Bedfordshire Squash launch film"
        ></video>
      </figure>
    </div>
  </section>

  <section class="section section--tight" id="on-court" data-home-watch data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY} data-watch={url('/captains/watch/')} hidden>
    <div class="container">
      <div class="section-head">
        <h2>On court</h2>
        <a href={url('/captains/watch/')}>Match commentary →</a>
      </div>
      <ul class="watch-list" data-watch-list></ul>
    </div>
  </section>

  <!-- QUICK LINKS -->
  <section class="section section--tight">
    <div class="container quick">
      <a href={url('/leagues/results/')} class="quick__item">
        <span class="quick__icon">🏆</span>
        <span><strong>League tables</strong><small>Winter and summer fixtures and results</small></span>
      </a>
      <a href={url('/tournaments/')} class="quick__item">
        <span class="quick__icon">🎯</span>
        <span><strong>Tournaments</strong><small>County Closed, League Cup and the honours board</small></span>
      </a>
      <a href={url('/juniors/')} class="quick__item">
        <span class="quick__icon">⚡</span>
        <span><strong>Juniors</strong><small>County squad, ladder &amp; coaching</small></span>
      </a>
    </div>
  </section>

  <!-- RULE OF THE DAY -->
  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <h2>Rule of the day</h2>
        <a href={SINGLES_RULES_URL} target="_blank" rel="noopener">Singles rules →</a>
      </div>
      <article class="rule" data-rule data-rule-index={rule.index}>
        <p class="rule__when" data-rule-when>{rule.when}</p>
        <h3 data-rule-title>{rule.title}</h3>
        <p class="rule__text" data-rule-text>{rule.text}</p>
        <p class="rule__ref">{SINGLES_RULES_EDITION}, <span data-rule-ref>{rule.rule}</span></p>
        <p class="rule__note">A plain-language reminder for a league night. The official singles rules decide a match.</p>
      </article>
    </div>
  </section>

  <!-- NEWS -->
  {
    news.length > 0 && (
      <section class="section" data-home-news data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
        <div class="container">
          <div class="section-head">
            <h2>Latest news</h2>
            <a href={url('/news/')}>All news →</a>
          </div>
          <div class="home-news" data-home-list>
            {news.map((post) => (
              <div data-home-card data-slug={post.id} data-front={post.data.featured ? 'yes' : 'no'} hidden={!post.data.featured}>
                <NewsCard post={post} large={post.data.featured} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section" id="home-photos" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY} hidden>
    <div class="container">
      <div class="section-head">
        <h2>Photos</h2>
        <a href={url('/gallery/')}>All photos →</a>
      </div>
      <div class="home-photo" data-home-photos></div>
    </div>
    <dialog class="photo-view" data-photo-view>
      <button class="photo-view__close" type="button" aria-label="Close" data-photo-close>×</button>
      <figure>
        <img alt="" data-photo-img />
        <figcaption data-photo-cap></figcaption>
      </figure>
    </dialog>
  </section>

  <!-- EVENTS -->
  <section class="section events-band" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
    <div class="container">
      <div class="section-head">
        <h2>Coming up</h2>
        <a href={url('/events/')}>Full calendar →</a>
      </div>
      <div class="grid grid--2" data-home-events hidden={upcoming.length === 0}>
        {upcoming.map((event) => (
          <div data-home-event data-slug={event.id} data-start={eventDay(event)}>
            <EventCard event={event} />
          </div>
        ))}
      </div>
      <p class="notice" data-home-events-empty hidden={upcoming.length > 0}>
        No upcoming events listed yet. Check back soon or see the England Squash calendar.
      </p>
      <p class="muted small">
        Includes county events, club tournaments and key <a href={SITE.englandSquashEvents} target="_blank" rel="noopener">England Squash</a> dates.
        <a href={url('/events.ics')}>Subscribe to the calendar</a>.
      </p>
    </div>
  </section>

</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(900px 500px at 85% 20%, rgba(241, 90, 34, 0.1), transparent 60%),
      repeating-linear-gradient(-55deg, transparent 0 38px, rgba(14, 39, 68, 0.025) 38px 40px);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 1.25rem;
    padding: clamp(1.4rem, 3.5vw, 2.4rem) 0 clamp(1.1rem, 2.5vw, 1.8rem);
  }
  .hero h1 {
    margin-bottom: 1rem;
  }
  .hl {
    color: var(--accent);
  }
  .lede {
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    color: var(--text-muted);
    max-width: 58ch;
  }
  .hero__cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin: 0.75rem 0 1rem;
  }
  .stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .stats li {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .stats strong {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 800;
    color: var(--accent);
  }
  .stats span {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .hero__film {
    margin: 0;
  }
  .hero__film video {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    background: #000;
  }

  .watch-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .watch-list a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
  }
  .watch-list a:hover {
    border-color: var(--accent);
  }
  .watch-list a span:first-child {
    min-width: 0;
  }
  .watch-list span {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .quick {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }
  .quick__item {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    padding: 0.45rem 0.65rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .quick__item:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .quick__icon {
    font-size: 1.2rem;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border-radius: 10px;
    flex-shrink: 0;
  }
  .quick__item strong {
    display: block;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.1rem;
    letter-spacing: 0.03em;
  }
  .quick__item small {
    color: var(--text-muted);
    display: block;
  }

  .rule {
    background: #fff;
    border: 1px solid var(--border-strong);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.75rem 0.9rem 0.65rem;
  }
  .rule__when {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .rule h3 {
    margin: 0.15rem 0 0.35rem;
  }
  .rule__text {
    margin: 0;
    max-width: 68ch;
    font-size: 1.05rem;
    line-height: 1.45;
  }
  .rule__ref {
    margin: 0.45rem 0 0;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .rule__note {
    margin: 0.35rem 0 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .events-band {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .small {
    font-size: 0.9rem;
    margin: 1.25rem 0 0;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.35rem;
    }
    .stats strong {
      font-size: 1.35rem;
    }
    .stats span {
      font-size: 0.68rem;
      letter-spacing: 0.04em;
    }
  }
  #home-photos[hidden] {
    display: none;
  }
  #home-photos :global(.photo-open) {
    display: block;
    width: min(100%, 28rem);
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  #home-photos :global(.photo-open img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .home-news--many {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
  }
  .home-news--many .is-lead {
    grid-column: 1 / -1;
  }
  @media (max-width: 720px) {
    .home-news--many {
      grid-template-columns: 1fr;
    }
  }
  .photo-view {
    border: 0;
    padding: 0.75rem;
    background: var(--ink-900);
    color: var(--text);
    max-width: min(52rem, 94vw);
  }
  .photo-view::backdrop {
    background: rgba(5, 6, 8, 0.78);
  }
  .photo-view figure {
    margin: 0;
  }
  .photo-view img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(50rem, 90vw);
    max-height: 78vh;
    object-fit: contain;
    background: var(--ink-950);
  }
  .photo-view figcaption {
    margin-top: 0.55rem;
    color: var(--ink-200);
  }
  .photo-view figcaption:empty {
    display: none;
  }
  .photo-view__close {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    width: 2.2rem;
    height: 2.2rem;
    border: 0;
    border-radius: 50%;
    background: rgba(5, 6, 8, 0.72);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { liveMatchCurrent, publicPlayerName, unpackLiveScore } from '@/lib/scoreboard';

  const homeWatch = document.querySelector<HTMLElement>('[data-home-watch]');
  const homeUrl = homeWatch?.dataset.url;
  const homeKey = homeWatch?.dataset.key;
  if (homeWatch && homeUrl && homeKey) {
    const panel: HTMLElement = homeWatch;
    const homeScore = panel.dataset.watch || '/captains/watch/';
    const homeList = panel.querySelector<HTMLElement>('[data-watch-list]')!;
    const homeClient = createClient(homeUrl, homeKey);
    type HomeMatch = { id: number; playerA: string; playerB: string; score: string; updatedAt: string };

    async function paintHomeWatch() {
      const { data: sessionData } = await homeClient.auth.getSession();
      const { data, error } = await homeClient.rpc('current_matches');
      const rows = (!error && Array.isArray(data) ? (data as HomeMatch[]) : []).filter((row) => liveMatchCurrent(row.updatedAt));
      if (!rows.length) {
        panel.hidden = true;
        homeList.replaceChildren();
        return;
      }
      const signedIn = Boolean(sessionData.session);
      const name = (value: string) => (signedIn ? value : publicPlayerName(value));
      const pretty = (score: string) => (unpackLiveScore(score).line || '0-0').replace(/-/g, '–');
      homeList.replaceChildren();
      for (const row of rows) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `${homeScore}?match=${row.id}`;
        const players = document.createElement('span');
        players.textContent = `${name(row.playerA)} v ${name(row.playerB)}`;
        players.style.color = 'inherit';
        const score = document.createElement('span');
        score.textContent = `\u2002${pretty(row.score)}`;
        link.append(players, score);
        item.append(link);
        homeList.append(item);
      }
      panel.hidden = false;
    }

    void paintHomeWatch();
    window.setInterval(() => void paintHomeWatch(), 15000);
  }
</script>

<script>
  import { createClient } from '@supabase/supabase-js';

  type HomePhoto = { caption: string | null; storage_path: string };

  const photos = document.getElementById('home-photos');
  if (photos) {
    const supabase = createClient(photos.dataset.url!, photos.dataset.key!);
    const host = photos.querySelector<HTMLElement>('[data-home-photos]')!;
    const escapeHtml = (value: string) =>
      value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
    const { data } = await supabase
      .from('contributions')
      .select('caption, storage_path')
      .eq('kind', 'photo')
      .eq('status', 'published')
      .order('published_at', { ascending: false })
      .limit(1);
    const items = ((data ?? []) as HomePhoto[]).filter((item) => item.storage_path);
    if (items.length) {
      const { data: signed } = await supabase.storage.from('contributions').createSignedUrls(
        items.map((item) => item.storage_path),
        3600,
      );
      const urls = new Map((signed ?? []).filter((row) => row.path && row.signedUrl).map((row) => [row.path!, row.signedUrl!]));
      host.innerHTML = items
        .map((item) => {
          const src = urls.get(item.storage_path);
          if (!src) return '';
          const label = escapeHtml(item.caption?.trim() || 'Photo');
          return `<button class="photo-open" type="button" data-photo-open><img class="card__img" src="${escapeHtml(src)}" alt="${label}" loading="lazy" /></button>`;
        })
        .join('');
      if (host.innerHTML.trim()) photos.hidden = false;
      const view = photos.querySelector<HTMLDialogElement>('[data-photo-view]')!;
      const viewImg = view.querySelector<HTMLImageElement>('[data-photo-img]')!;
      const viewCap = view.querySelector<HTMLElement>('[data-photo-cap]')!;
      host.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-photo-open]');
        const image = button?.querySelector('img');
        if (!button || !image) return;
        viewImg.src = image.src;
        viewImg.alt = image.alt;
        viewCap.textContent = image.alt === 'Photo' ? '' : image.alt;
        if (!view.open) view.showModal();
      });
      view.querySelector('[data-photo-close]')?.addEventListener('click', () => view.close());
      view.addEventListener('click', (event) => {
        if (event.target === view) view.close();
      });
    }
  }
</script>

<script>
  import { createClient } from '@supabase/supabase-js';

  const homeNews = document.querySelector<HTMLElement>('[data-home-news]');
  const homeList = homeNews?.querySelector<HTMLElement>('[data-home-list]');
  if (homeNews && homeList && homeNews.dataset.url && homeNews.dataset.key) {
    const frontClient = createClient(homeNews.dataset.url, homeNews.dataset.key);
    const layoutHomeNews = () => {
      const cards = [...homeList.querySelectorAll<HTMLElement>('[data-home-card]')];
      const shown = cards.filter((card) => !card.hidden && card.isConnected);
      homeList.classList.toggle('home-news--many', shown.length > 1);
      cards.forEach((card) => card.classList.remove('is-lead', 'is-rest'));
      shown.forEach((card, index) => {
        card.classList.add(shown.length > 1 && index > 0 ? 'is-rest' : 'is-lead');
        card.querySelector('.news-card')?.classList.toggle('news-card--large', shown.length === 1 || index === 0);
      });
      homeNews.hidden = shown.length === 0;
    };
    const applyFrontPage = async () => {
      const { data, error } = await frontClient.rpc('news_front_page');
      if (error || !Array.isArray(data) || data.length === 0) {
        layoutHomeNews();
        return;
      }
      const chosen = new Map(
        (data as { slug: string; on_front: boolean }[])
          .filter((row) => row.slug)
          .map((row) => [row.slug, Boolean(row.on_front)]),
      );
      homeList.querySelectorAll<HTMLElement>('[data-home-card]').forEach((card) => {
        const slug = card.dataset.slug ?? '';
        card.hidden = chosen.has(slug) ? !chosen.get(slug) : true;
      });
      layoutHomeNews();
    };
    document.addEventListener('beds-match-places', layoutHomeNews);
    void applyFrontPage();
  }

  const homeEvents = document.querySelector<HTMLElement>('[data-home-events]');
  if (homeEvents) {
    const today = new Date();
    const todayStamp = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
    const empty = document.querySelector<HTMLElement>('[data-home-events-empty]');
    const showEvents = () => {
      const shown = [...homeEvents.querySelectorAll<HTMLElement>('[data-home-event]')].filter((card) => !card.hidden);
      homeEvents.hidden = shown.length === 0;
      if (empty) empty.hidden = shown.length > 0;
    };
    homeEvents.querySelectorAll<HTMLElement>('[data-home-event]').forEach((card) => {
      if ((card.dataset.start ?? '') < todayStamp) card.hidden = true;
    });
    showEvents();
    const eventRoot = homeEvents.closest<HTMLElement>('[data-url]');
    if (eventRoot?.dataset.url && eventRoot.dataset.key) {
      const eventClient = createClient(eventRoot.dataset.url, eventRoot.dataset.key);
      const { data, error } = await eventClient.rpc('event_front_page');
      if (!error && Array.isArray(data) && data.length > 0) {
        const chosen = new Map(
          (data as { slug: string; on_front: boolean }[])
            .filter((row) => row.slug)
            .map((row) => [row.slug, Boolean(row.on_front)]),
        );
        homeEvents.querySelectorAll<HTMLElement>('[data-home-event]').forEach((card) => {
          const slug = card.dataset.slug ?? '';
          const passed = (card.dataset.start ?? '') < todayStamp;
          if (passed) card.hidden = true;
          else if (chosen.has(slug)) card.hidden = !chosen.get(slug);
        });
        showEvents();
      }
    }
  }
</script>

<script>
  import { ruleFor } from '@/lib/squash-rules';

  const ruleCard = document.querySelector('[data-rule]');
  if (ruleCard instanceof HTMLElement) {
    const today = ruleFor(new Date());
    if (ruleCard.dataset.ruleIndex !== String(today.index)) {
      ruleCard.dataset.ruleIndex = String(today.index);
      const when = ruleCard.querySelector('[data-rule-when]');
      const title = ruleCard.querySelector('[data-rule-title]');
      const text = ruleCard.querySelector('[data-rule-text]');
      const ref = ruleCard.querySelector('[data-rule-ref]');
      if (when) when.textContent = today.when;
      if (title) title.textContent = today.title;
      if (text) text.textContent = today.text;
      if (ref) ref.textContent = today.rule;
    }
  }
</script>
