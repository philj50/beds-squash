---
import Base from '@/layouts/Base.astro';
import ContentPage from '@/components/ContentPage.astro';
import EventCard from '@/components/EventCard.astro';
import { getClubs, getDocuments, getUpcomingEvents } from '@/lib/content';
import { url } from '@/lib/site';

const events = (await getUpcomingEvents()).filter((e) => e.data.category === 'juniors').slice(0, 4);
const juniorClubs = (await getClubs()).filter((c) => c.data.tags.includes('juniors'));
const safeguarding = (await getDocuments()).filter((d) => d.data.category === 'safeguarding' || d.data.category === 'code-of-conduct');
---

<Base title="Juniors" description="Junior squash in Bedfordshire: county squad programme, junior ladder, coaching venues, inter-county competition and safeguarding.">
  <ContentPage id="juniors" eyebrow="Under 19s" fallbackTitle="Juniors">
    <div slot="aside" class="stack">
      <div class="card"><div class="card__body">
        <h3>Junior events</h3>
        {events.length > 0 ? <div class="stack" style="--stack:.75rem">{events.map((e) => <EventCard event={e} compact />)}</div> : <p class="muted">No junior events listed yet. <a href={url('/events/')}>See all events</a>.</p>}
      </div></div>
      <div class="card"><div class="card__body">
        <h3>Clubs with junior coaching</h3>
        <ul class="links">{juniorClubs.map((c) => <li><a href={url(`/clubs/${c.id}/`)}>{c.data.name}</a><span class="muted"> · {c.data.town}</span></li>)}</ul>
      </div></div>
      <div class="card"><div class="card__body">
        <h3>Safeguarding</h3>
        <ul class="links">{safeguarding.map((d) => <li><a href={url(`/documents/${d.id}/`)}>{d.data.title}</a></li>)}</ul>
      </div></div>
    </div>
  </ContentPage>
</Base>

<style>
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .links li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
  }
  .links li:last-child {
    border-bottom: 0;
  }
</style>
