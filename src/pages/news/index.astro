---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import NewsCard from '@/components/NewsCard.astro';
import { getNews } from '@/lib/content';
import { CATEGORY_LABEL, url } from '@/lib/site';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';

const posts = await getNews();
const updates = posts.filter((post) => post.data.category === 'website');
const reports = posts.filter((post) => post.data.category !== 'website');
const categories = [...new Set(reports.map((p) => p.data.category))];
---

<Base title="Bedfordshire squash news" description="News from Bedfordshire Squash — tournaments, leagues, juniors, county teams and England Squash updates." crumbs={[{ name: 'News', path: '/news/' }]}>
  <PageHero eyebrow="Latest" title="News" lede="Reports, results and announcements from around the county." />
  <section class="section">
    <div class="container">
      {
        categories.length > 1 && (
          <div class="filters" role="group" aria-label="Filter by category">
            <button class="pill is-active" data-filter="all" type="button">All</button>
            {categories.map((c) => (
              <button class="pill" data-filter={c} type="button">
                {CATEGORY_LABEL[c] ?? c}
              </button>
            ))}
          </div>
        )
      }
      <div class="grid grid--3" data-news-grid>
        {
          reports.map((p) => (
            <div data-category={p.data.category}>
              <NewsCard post={p} />
            </div>
          ))
        }
      </div>
      {reports.length === 0 && <p class="notice">No news yet.</p>}
      {
        updates.length > 0 && (
          <div class="website-updates">
            <div class="section-head">
              <h2>Website updates</h2>
            </div>
            <p class="updates-lede">What has changed on this site, written for players and captains.</p>
            <div class="grid grid--3">
              {updates.map((post) => (
                <NewsCard post={post} />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
  <section class="section" id="shared-news" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY} hidden>
    <div class="container">
      <div class="section-head">
        <h2>Sent in</h2>
        <a href={url('/share/')}>Sign in to send an article →</a>
      </div>
      <div class="grid grid--3" data-shared-news></div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';

  const shared = document.getElementById('shared-news');
  if (shared) {
    const supabase = createClient(shared.dataset.url!, shared.dataset.key!);
    const host = shared.querySelector<HTMLElement>('[data-shared-news]')!;
    const escapeHtml = (value: string) =>
      value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
    const { data } = await supabase
      .from('contributions')
      .select('id, title, published_at')
      .eq('kind', 'article')
      .eq('status', 'published')
      .order('published_at', { ascending: false })
      .limit(12);
    if (data?.length) {
      const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
      host.innerHTML = data
        .map((row) => {
          const when = row.published_at
            ? new Date(row.published_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
            : '';
          return `<article class="card"><div class="card__body"><div class="card__meta"><span class="pill">Sent in</span><time>${escapeHtml(when)}</time></div><h3 class="card__title"><a href="${base}/share/article/#${row.id}">${escapeHtml(row.title ?? 'Article')}</a></h3></div></article>`;
        })
        .join('');
      shared.hidden = false;
    }
  }

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-news-grid] > [data-category]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => x.classList.toggle('is-active', x === b));
      const f = b.dataset.filter;
      items.forEach((it) => (it.hidden = f !== 'all' && it.dataset.category !== f));
    }),
  );
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
  }
  .filters .pill {
    cursor: pointer;
    background: transparent;
    color: var(--ink-200);
    border-color: var(--border-strong);
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
  }
  .filters .pill.is-active {
    background: var(--accent);
    color: var(--ink-950);
    border-color: var(--accent);
  }
  .website-updates {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .updates-lede {
    margin: -0.4rem 0 1rem;
    color: var(--ink-200);
  }
  #shared-news[hidden] {
    display: none;
  }
  #shared-news .card__title {
    font-size: 1.28rem;
    line-height: 1.25;
  }
</style>
