---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import NewsCard from '@/components/NewsCard.astro';
import { getNews } from '@/lib/content';
import { CATEGORY_LABEL, formatDate, url } from '@/lib/site';
import { abs, organizationId } from '@/lib/seo';

export async function getStaticPaths() {
  const posts = await getNews();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, summary, image, imageAlt, category } = post.data;
const expandHero = post.id === '2026-10-10-beds-closed-sponsors';
const more = (await getNews()).filter((p) => p.id !== post.id).slice(0, 3);
---

<Base
  title={title}
  description={summary}
  image={image ? url(image) : undefined}
  type="article"
  published={date}
  crumbs={[
    { name: 'News', path: '/news/' },
    { name: title, path: `/news/${post.id}/` },
  ]}
  jsonLd={{
    '@type': 'NewsArticle',
    headline: title,
    description: summary,
    datePublished: date.toISOString(),
    image: image ? abs(Astro.site, image) : abs(Astro.site, '/brand/og-default.png'),
    mainEntityOfPage: abs(Astro.site, `/news/${post.id}/`),
    author: { '@id': organizationId(Astro.site) },
    publisher: { '@id': organizationId(Astro.site) },
  }}
>
  <article data-article-slug={post.id}>
    <header class="page-hero">
      <div class="container narrow">
        <a class="back" href={url('/news/')}>← All news</a>
        <div class="card__meta" style="margin-bottom:.75rem">
          <span class="pill">{CATEGORY_LABEL[category] ?? category}</span>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
        </div>
        <h1 data-article-title>{title}</h1>
        <p class="lede" data-article-summary hidden={!summary}>{summary}</p>
      </div>
    </header>
    {
      image && (
        <div class="container narrow" style="margin-top:2rem">
          {expandHero ? (
            <a class="hero-expand" href={url(image)} data-hero-expand aria-haspopup="dialog" aria-controls="article-photo" aria-label="Expand main photo">
              <img class="hero-img" src={url(image)} alt={imageAlt ?? ''} />
              <span class="hero-expand__hint">Click to enlarge</span>
            </a>
          ) : (
            <img class="hero-img" src={url(image)} alt={imageAlt ?? ''} />
          )}
        </div>
      )
    }
    <div class="container narrow section prose" data-article-body>
      <Content />
    </div>
  </article>

  {expandHero && image && (
    <dialog id="article-photo" class="hero-lightbox" aria-label="Enlarged article photo" data-hero-dialog>
      <button type="button" class="hero-lightbox__close" aria-label="Close enlarged photo" data-hero-close>×</button>
      <figure>
        <img src={url(image)} alt={imageAlt ?? ''} />
      </figure>
    </dialog>
  )}

  {
    more.length > 0 && (
      <section class="section" style="border-top:1px solid var(--border)">
        <div class="container">
          <div class="section-head">
            <h2>More news</h2>
            <a href={url('/news/')}>All news →</a>
          </div>
          <div class="grid grid--3">
            {more.map((p) => (
              <NewsCard post={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<script>
  const trigger = document.querySelector<HTMLAnchorElement>('[data-hero-expand]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-hero-dialog]');
  if (trigger && dialog) {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      if (!dialog.open) dialog.showModal();
    });
    dialog.querySelector('[data-hero-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || event.target === dialog.querySelector('figure')) dialog.close();
    });
  }
</script>

<style>
  [data-article-slug="2026-10-10-beds-closed-sponsors"] :global(.sponsor-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2rem 1.5rem;
    margin-block: 1.5rem 2rem;
  }
  [data-article-slug="2026-10-10-beds-closed-sponsors"] :global(.sponsor-card) {
    min-width: 0;
  }
  [data-article-slug="2026-10-10-beds-closed-sponsors"] :global(.sponsor-card p) {
    margin: 0 0 .75rem;
    font-weight: 600;
  }
  [data-article-slug="2026-10-10-beds-closed-sponsors"] :global(.sponsor-card img) {
    margin-block: 0;
  }

  [data-article-slug="2026-10-10-beds-closed-sponsors"] [data-article-body] :global(img) {
    display: block;
    width: 15rem;
    max-width: 100%;
    height: auto;
    margin-block: .75rem 1.5rem;
  }

  .hero-expand {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    text-align: center;
    text-decoration: none;
    cursor: zoom-in;
  }
  .hero-expand__hint {
    display: block;
    margin-top: .5rem;
    color: var(--text-muted);
    font-size: .875rem;
  }
  .hero-lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
  }
  .hero-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-lightbox::backdrop {
    background: rgba(5, 6, 8, .92);
  }
  .hero-lightbox figure {
    margin: 0;
  }
  .hero-lightbox img {
    display: block;
    width: auto;
    height: auto;
    max-width: 92vw;
    max-height: 84vh;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }
  .hero-lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 48px;
    height: 48px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: rgba(255, 255, 255, .08);
    color: #fff;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }
  .hero-lightbox__close:hover {
    background: var(--accent);
    color: var(--ink-950);
  }

  .back {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  .hero-img {
    display: block;
    border-radius: var(--radius);
    width: auto;
    max-width: min(100%, 22rem);
    max-height: 36rem;
    margin-inline: auto;
    object-fit: contain;
  }
</style>
