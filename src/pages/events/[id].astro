---
import { getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ClosedSponsors from '@/components/ClosedSponsors.astro';
import EventCard from '@/components/EventCard.astro';
import OrderOfPlay from '@/components/OrderOfPlay.astro';
import { getEvents, getUpcomingEvents } from '@/lib/content';
import type { TournamentData } from '@/lib/sportmgr';
import { CATEGORY_LABEL, SOURCE_LABEL, formatRange, formatTime, isoDate, url } from '@/lib/site';
import { abs, organizationId } from '@/lib/seo';

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const { title, start, end, allDay, venue, club, source, category, link, entryUrl, sportmgr, entryForm, image, cancelled } = event.data;
const snapshots = import.meta.glob<TournamentData>('../../data/sportmgr/*.json', { eager: true, import: 'default' });
const tournament = sportmgr ? snapshots[`../../data/sportmgr/${sportmgr}.json`] : undefined;
const tournamentLive = Boolean(tournament) && (end ?? start).getTime() >= Date.now() - 86400000;
const externalLabel = link?.includes('sportmgr.co.uk') ? 'Sport Manager' : 'More details';
const clubEntry = club ? await getEntry('clubs', club) : undefined;
const others = (await getUpcomingEvents()).filter((e) => e.id !== event.id).slice(0, 3);
const showSponsors = event.id === '2027-01-beds-closed';
const closedYears = /Bedfordshire County Closed Championships/i.test(title)
  ? (await getEvents())
      .filter((item) => /Bedfordshire County Closed Championships/i.test(item.data.title))
      .sort((a, b) => b.data.start.getTime() - a.data.start.getTime())
  : [];

// Google Calendar quick-add link
const gcalDates = allDay
  ? `${isoDate(start).replace(/-/g, '')}/${isoDate(new Date((end ?? start).getTime() + 86400000)).replace(/-/g, '')}`
  : `${start.toISOString().replace(/[-:]|\.\d{3}/g, '')}/${(end ?? new Date(start.getTime() + 2 * 3600000)).toISOString().replace(/[-:]|\.\d{3}/g, '')}`;
const gcal = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(title)}&dates=${gcalDates}&location=${encodeURIComponent(venue ?? '')}&details=${encodeURIComponent(new URL(url(`/events/${event.id}/`), Astro.site).href)}`;
---

<Base
  title={title}
  description={`${title} — ${formatRange(start, end)}${venue ? ` at ${venue}` : ''}. A Bedfordshire squash event.`}
  image={image ? url(image) : undefined}
  type="article"
  published={start}
  crumbs={[
    { name: 'Events', path: '/events/' },
    { name: title, path: `/events/${event.id}/` },
  ]}
  jsonLd={{
    '@type': 'Event',
    name: title,
    startDate: start.toISOString(),
    endDate: (end ?? start).toISOString(),
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    eventStatus: cancelled ? 'https://schema.org/EventCancelled' : 'https://schema.org/EventScheduled',
    location: { '@type': 'Place', name: venue ?? 'Bedfordshire' },
    organizer: { '@id': organizationId(Astro.site) },
    url: abs(Astro.site, `/events/${event.id}/`),
  }}
>
  <article>
    <header class="page-hero">
      <div class:list={['container', showSponsors ? 'hero-split' : 'narrow']}>
        <div>
        <a class="back" href={url('/events/')}>← All events</a>
        <div class="card__meta" style="margin-bottom:.75rem">
          <span class:list={['pill', { 'pill--red': source === 'england-squash' }]}>{SOURCE_LABEL[source]}</span>
          <span class="pill pill--muted">{CATEGORY_LABEL[category]}</span>
          {cancelled && <span class="pill pill--red">Cancelled</span>}
        </div>
        <h1>{title}</h1>
        <p class="lede when">
          <strong>{formatRange(start, end)}</strong>{!allDay && ` · ${formatTime(start)}`}
          {venue && <span> · {venue}</span>}
        </p>
        <div class="actions">
          {entryUrl && (
            <a class="btn btn--primary btn--sm" href={entryUrl} target="_blank" rel="noopener">Enter now</a>
          )}
          {entryForm && <a class="btn btn--primary btn--sm" href={url(entryForm)}>Entry form</a>}
          {link && (
            <a class="btn btn--ghost btn--sm" href={link} target="_blank" rel="noopener">{externalLabel} ↗</a>
          )}
          {closedYears.map((item) => (
            <a
              class:list={['btn', 'btn--sm', item.id === event.id ? 'btn--primary' : 'btn--ghost']}
              href={url(`/events/${item.id}/`)}
              aria-current={item.id === event.id ? 'page' : undefined}
            >
              {item.data.start.getUTCFullYear()}
            </a>
          ))}
          <a class="btn btn--ghost btn--sm" href={gcal} target="_blank" rel="noopener">Add to Google Calendar</a>
        </div>
        </div>
        {showSponsors && <ClosedSponsors place="main" />}
      </div>
    </header>

    {showSponsors && <ClosedSponsors place="board" />}

    {
      tournament && tournament.matches.length > 0 && (
        <section class="section">
          <div class="container">
            <OrderOfPlay data={tournament} live={tournamentLive} />
          </div>
        </section>
      )
    }

    <div class="container narrow section">
      {image && <img class="hero-img" src={url(image)} alt="" style="margin-bottom:2rem" />}
      <div class="prose">
        <Content />
      </div>
      {
        clubEntry && (
          <aside class="venue">
            <span class="eyebrow">Venue</span>
            <h3>{clubEntry.data.venue}</h3>
            <p>
              {clubEntry.data.address}, {clubEntry.data.postcode}
            </p>
            <a href={url(`/clubs/${clubEntry.id}/`)}>Club details &amp; map →</a>
          </aside>
        )
      }
    </div>

    {
      tournament && tournament.matches.length === 0 && (
        <section class="section" style="padding-top:0">
          <div class="container">
            <OrderOfPlay data={tournament} live={tournamentLive} />
          </div>
        </section>
      )
    }

    {showSponsors && <ClosedSponsors place="board" />}
  </article>

  {
    others.length > 0 && (
      <section class="section" style="border-top:1px solid var(--border)">
        <div class="container">
          <div class="section-head">
            <h2>Also coming up</h2>
            <a href={url('/events/')}>Full calendar →</a>
          </div>
          <div class="grid grid--3">
            {others.map((e) => (
              <EventCard event={e} compact />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  .hero-split {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 800px) {
    .hero-split {
      grid-template-columns: minmax(0, 1fr) 17rem;
    }
  }
  .when strong {
    color: var(--accent);
  }
  .actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }
  .hero-img {
    border-radius: var(--radius);
    width: 100%;
  }
  .venue {
    margin-top: 1rem;
    padding: 0.65rem 0.8rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .venue h3 {
    margin-bottom: 0.25rem;
  }
  .venue p {
    color: var(--ink-200);
    margin-bottom: 0.5rem;
  }
</style>
