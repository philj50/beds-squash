---
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
---

<section class="junior-public-draw" data-junior-public-draw hidden data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
  <h2>The draw</h2>
  <p class="junior-public-draw__note">Names are shown as a first name and surname initial.</p>
  <div data-junior-public-sheet></div>
</section>

<script>
  import { createClient } from '@supabase/supabase-js';

  type Slot = { place?: number; name?: string };
  type Group = { label?: string; top?: Slot[]; bottom?: Slot[] };
  type Payload = { published?: boolean; groups?: Group[] };

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);

  const half = (title: string, rows: Slot[]) => {
    const body = rows.length
      ? `<ol>${rows
          .map((row) => `<li><span class="junior-public-draw__slot">${escapeHtml(String(row.place ?? ''))}</span> ${escapeHtml((row.name ?? '').trim())}</li>`)
          .join('')}</ol>`
      : '<p class="muted">Bye.</p>';
    return `<section class="junior-public-draw__half"><h4>${title}</h4>${body}</section>`;
  };

  const paint = (root: HTMLElement, groups: Group[]) => {
    const sheet = root.querySelector<HTMLElement>('[data-junior-public-sheet]');
    if (!sheet) return;
    sheet.innerHTML = groups
      .map((group) => {
        const top = Array.isArray(group.top) ? group.top : [];
        const bottom = Array.isArray(group.bottom) ? group.bottom : [];
        return `<article class="junior-public-draw__group"><h3>${escapeHtml(group.label ?? '')}</h3><div class="junior-public-draw__halves">${half('Top half', top)}${half('Bottom half', bottom)}</div></article>`;
      })
      .join('');
  };

  const load = async (root: HTMLElement) => {
    const url = root.dataset.url;
    const key = root.dataset.key;
    if (!url || !key) return;
    const supabase = createClient(url, key);
    const { data, error } = await supabase.rpc('junior_public_draw');
    const payload = (data ?? null) as Payload | null;
    const groups = Array.isArray(payload?.groups) ? payload.groups.filter((group) => (group.top?.length ?? 0) + (group.bottom?.length ?? 0) > 0) : [];
    if (error || payload?.published !== true || !groups.length) {
      root.hidden = true;
      return;
    }
    paint(root, groups);
    root.hidden = false;
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-junior-public-draw]')) void load(root);
</script>

<style>
  .junior-public-draw {
    margin: 0 0 1.5rem;
  }
  .junior-public-draw h2 {
    margin: 0 0 0.35rem;
  }
  .junior-public-draw__note {
    margin: 0 0 0.75rem;
    color: var(--ink-200);
  }
  .junior-public-draw__group {
    margin: 0 0 1rem;
  }
  .junior-public-draw__group h3 {
    margin: 0 0 0.4rem;
  }
  .junior-public-draw__halves {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .junior-public-draw__half {
    margin: 0;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-card);
  }
  .junior-public-draw__half h4,
  .junior-public-draw__half p {
    margin: 0;
  }
  .junior-public-draw__half ol {
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.3rem;
  }
  .junior-public-draw__slot {
    color: var(--gold-600);
    font-weight: 700;
  }
  @media (max-width: 700px) {
    .junior-public-draw__halves {
      grid-template-columns: 1fr;
    }
  }
</style>
