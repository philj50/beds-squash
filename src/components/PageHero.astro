---
interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
}
const { title, eyebrow, lede } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>
