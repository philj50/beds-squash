---
import { NAV, SITE, url } from '@/lib/site';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const current = Astro.url.pathname.replace(base, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
const loginHref = url('/login/');
const youHref = url('/captains/you/');
const profileHref = url('/captains/profile/');
---

<header class="site-header" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY} data-login={loginHref} data-profile={profileHref}>
  <div class="container bar">
    <a class="brand" href={url('/')} aria-label={`${SITE.name} home`}>
      <img src={url('/brand/logo-coral.png')} alt="" width="154" height="91" />
    </a>

    <div class="bar-end">
      <nav id="site-nav" class="nav" aria-label="Primary">
        <ul>
          {
            NAV.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="account" data-account-item>
            <a data-account-login href={loginHref}>Log in</a>
            <div data-account-signed hidden>
              <button class="account-toggle" type="button" data-account-toggle aria-expanded="false" aria-controls="account-menu" aria-haspopup="menu">
                <span data-account-name>Profile</span>
              </button>
              <div id="account-menu" class="account-menu" data-account-menu hidden role="menu">
                <a role="menuitem" href={youHref}>Your squash</a>
                <a role="menuitem" href={profileHref}>Profile</a>
                <button role="menuitem" type="button" data-log-out>Log out</button>
              </div>
            </div>
          </li>
        </ul>
      </nav>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <span class="menu-btn__bars" aria-hidden="true"></span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { createClient } from '@supabase/supabase-js';

  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
    document.body.classList.toggle('nav-open', !open);
  });

  const header = document.querySelector<HTMLElement>('.site-header');
  const accountItem = header?.querySelector<HTMLElement>('[data-account-item]');
  const loginLink = header?.querySelector<HTMLAnchorElement>('[data-account-login]');
  const signedIn = header?.querySelector<HTMLElement>('[data-account-signed]');
  const nameEl = header?.querySelector<HTMLElement>('[data-account-name]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-account-toggle]');
  const menu = header?.querySelector<HTMLElement>('[data-account-menu]');
  const logOut = header?.querySelector<HTMLButtonElement>('[data-log-out]');
  if (header && accountItem && loginLink && signedIn && nameEl && toggle && menu && logOut && header.dataset.url && header.dataset.key) {
    const supabase = createClient(header.dataset.url, header.dataset.key);

    function setMenuOpen(open: boolean) {
      toggle!.setAttribute('aria-expanded', String(open));
      menu!.hidden = !open;
    }

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('click', (event) => {
      if (!accountItem.contains(event.target as Node)) setMenuOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenuOpen(false);
    });
    logOut.addEventListener('click', async (event) => {
      event.stopPropagation();
      setMenuOpen(false);
      await supabase.auth.signOut();
      location.reload();
    });

    let paintId = 0;
    async function paintAccount() {
      const id = ++paintId;
      const { data } = await supabase.auth.getSession();
      if (id !== paintId) return;
      const session = data.session;
      if (!session) {
        setMenuOpen(false);
        loginLink!.hidden = false;
        signedIn!.hidden = true;
        return;
      }
      loginLink!.hidden = true;
      signedIn!.hidden = false;
      nameEl!.textContent = session.user.user_metadata?.display_name || session.user.email?.split('@')[0] || 'Profile';
      const { data: me } = await supabase.from('profiles').select('display_name').eq('id', session.user.id).maybeSingle();
      if (id !== paintId || !me?.display_name) return;
      nameEl!.textContent = me.display_name;
    }

    supabase.auth.onAuthStateChange(() => {
      void paintAccount();
    });
    void paintAccount();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--ink-950) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  :global(html[data-theme='navy']) .site-header,
  :global(html[data-theme='light']) .site-header {
    background: #fff;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 72px;
  }
  .bar-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    min-width: 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text);
  }
  .brand img {
    width: auto;
    height: 52px;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: nowrap;
    justify-content: flex-end;
  }
  .nav > ul > li > a[hidden] {
    display: none;
  }
  .nav > ul > li > a,
  .account-toggle {
    display: block;
    padding: 0.5rem 0.55rem;
    color: var(--ink-200);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 6px;
    position: relative;
    white-space: nowrap;
  }
  .account-toggle {
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .account-toggle::after {
    content: '';
    display: inline-block;
    margin-left: 0.35rem;
    border: 4px solid transparent;
    border-top-color: currentColor;
    vertical-align: middle;
  }
  .nav > ul > li > a:hover,
  .account-toggle:hover,
  .account-toggle[aria-expanded='true'] {
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
  }
  :global(html[data-theme='navy']) .nav > ul > li > a,
  :global(html[data-theme='navy']) .account-toggle,
  :global(html[data-theme='light']) .nav > ul > li > a,
  :global(html[data-theme='light']) .account-toggle {
    color: var(--text);
  }
  :global(html[data-theme='navy']) .nav > ul > li > a:hover,
  :global(html[data-theme='navy']) .account-toggle:hover,
  :global(html[data-theme='navy']) .account-toggle[aria-expanded='true'],
  :global(html[data-theme='light']) .nav > ul > li > a:hover,
  :global(html[data-theme='light']) .account-toggle:hover,
  :global(html[data-theme='light']) .account-toggle[aria-expanded='true'] {
    color: var(--accent);
    background: transparent;
  }
  :global(html[data-theme='navy']) .nav > ul > li > a[data-account-login],
  :global(html[data-theme='light']) .nav > ul > li > a[data-account-login] {
    background: var(--accent);
    color: #fff;
    border-radius: 999px;
    padding: 0.4rem 0.95rem;
  }
  :global(html[data-theme='navy']) .nav > ul > li > a[data-account-login]:hover,
  :global(html[data-theme='light']) .nav > ul > li > a[data-account-login]:hover {
    background: var(--accent-hover);
    color: #fff;
  }
  :global(html[data-theme='navy']) .account-menu,
  :global(html[data-theme='light']) .account-menu {
    background: #fff;
  }
  :global(html[data-theme='navy']) .nav.is-open,
  :global(html[data-theme='light']) .nav.is-open {
    background: #0e2744;
  }
  :global(html[data-theme='navy']) .nav.is-open > ul > li > a:not([data-account-login]),
  :global(html[data-theme='navy']) .nav.is-open .account-toggle,
  :global(html[data-theme='light']) .nav.is-open > ul > li > a:not([data-account-login]),
  :global(html[data-theme='light']) .nav.is-open .account-toggle {
    color: #fff;
  }
  :global(html[data-theme='navy']) .nav.is-open > ul > li > a:not([data-account-login]):hover,
  :global(html[data-theme='navy']) .nav.is-open .account-toggle:hover,
  :global(html[data-theme='light']) .nav.is-open > ul > li > a:not([data-account-login]):hover,
  :global(html[data-theme='light']) .nav.is-open .account-toggle:hover {
    color: #ffb088;
    background: transparent;
  }
  :global(html[data-theme='navy']) .account-menu a,
  :global(html[data-theme='navy']) .account-menu button,
  :global(html[data-theme='light']) .account-menu a,
  :global(html[data-theme='light']) .account-menu button {
    color: var(--text);
  }
  :global(html[data-theme='navy']) .account-menu a:hover,
  :global(html[data-theme='navy']) .account-menu button:hover,
  :global(html[data-theme='light']) .account-menu a:hover,
  :global(html[data-theme='light']) .account-menu button:hover {
    color: var(--accent);
    background: rgba(241, 90, 34, 0.08);
  }
  .nav > ul > li > a[aria-current='page'] {
    color: var(--accent);
  }
  .nav > ul > li > a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.65rem;
    right: 0.65rem;
    bottom: 2px;
    height: 2px;
    background: var(--accent);
    border-radius: 1px;
  }
  .account {
    position: relative;
  }
  .account-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.35rem);
    min-width: 10.5rem;
    background: var(--ink-900);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 0.35rem;
    box-shadow: var(--shadow);
    z-index: 30;
  }
  .account-menu a,
  .account-menu button {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    color: var(--ink-200);
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.55rem 0.7rem;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
  }
  .account-menu a:hover,
  .account-menu button:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }
  .menu-btn {
    display: none;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .menu-btn__bars,
  .menu-btn__bars::before,
  .menu-btn__bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    position: relative;
    transition: transform 0.2s ease;
  }
  .menu-btn__bars::before,
  .menu-btn__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .menu-btn__bars::before {
    top: -7px;
  }
  .menu-btn__bars::after {
    top: 7px;
  }
  .menu-btn[aria-expanded='true'] .menu-btn__bars {
    background: transparent;
  }
  .menu-btn[aria-expanded='true'] .menu-btn__bars::before {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .menu-btn__bars::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 1240px) {
    .menu-btn {
      display: inline-flex;
    }
    .nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--ink-900);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
      padding: 0.75rem var(--gutter) 1.25rem;
      max-height: calc(100dvh - 72px);
      overflow: auto;
    }
    .nav.is-open {
      display: block;
    }
    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav > ul > li > a,
    .account-toggle {
      padding: 0.8rem 0.5rem;
      font-size: 1.1rem;
      border-bottom: 1px solid var(--border);
      border-radius: 0;
    }
    .nav > ul > li > a[aria-current='page']::after {
      display: none;
    }
    .account-menu {
      position: static;
      min-width: 0;
      margin: 0;
      padding: 0 0 0 0.75rem;
      border: none;
      border-radius: 0;
      box-shadow: none;
      background: transparent;
    }
  }
</style>
