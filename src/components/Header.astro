---
import { NAV, SITE, url } from '@/lib/site';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const current = Astro.url.pathname.replace(base, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
const loginHref = url('/login/');
const profileHref = url('/captains/profile/');
---

<header class="site-header" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY} data-login={loginHref} data-profile={profileHref}>
  <div class="container bar">
    <a class="brand" href={url('/')} aria-label={`${SITE.name} home`}>
      <img src={url('/brand/logo-navy.png')} alt="" width="154" height="91" />
    </a>

    <div class="bar-end">
      <nav id="site-nav" class="nav" aria-label="Primary">
        <ul>
          {
            NAV.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="nav__cta">
            <a class="btn btn--primary btn--sm" href={url('/leagues/results/')} aria-current={current.startsWith('/leagues/results') ? 'page' : undefined} title="League tables and fixtures">
              Tables
            </a>
          </li>
        </ul>
      </nav>
      <a class="btn btn--ghost btn--sm account-link" data-account href={loginHref}>Log in</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <span class="menu-btn__bars" aria-hidden="true"></span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { createClient } from '@supabase/supabase-js';

  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
    document.body.classList.toggle('nav-open', !open);
  });

  const header = document.querySelector<HTMLElement>('.site-header');
  const account = header?.querySelector<HTMLAnchorElement>('[data-account]');
  if (header && account && header.dataset.url && header.dataset.key) {
    const supabase = createClient(header.dataset.url, header.dataset.key);
    const loginHref = header.dataset.login!;
    const profileHref = header.dataset.profile!;

    let paintId = 0;
    async function paintAccount() {
      const id = ++paintId;
      const { data } = await supabase.auth.getSession();
      if (id !== paintId) return;
      const session = data.session;
      if (!session) {
        account!.textContent = 'Log in';
        account!.href = loginHref;
        account!.title = 'Log in';
        delete account!.dataset.signedIn;
        return;
      }
      let name = session.user.user_metadata?.display_name || session.user.email?.split('@')[0] || 'Profile';
      account!.textContent = name;
      account!.href = profileHref;
      account!.title = 'Your profile';
      account!.dataset.signedIn = 'true';
      const { data: me } = await supabase.from('profiles').select('display_name').eq('id', session.user.id).maybeSingle();
      if (id !== paintId || !me?.display_name) return;
      account!.textContent = me.display_name;
    }

    supabase.auth.onAuthStateChange(() => {
      void paintAccount();
    });
    void paintAccount();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--ink-950) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 72px;
  }
  .bar-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    min-width: 0;
  }
  .account-link {
    flex-shrink: 1;
    min-width: 0;
    max-width: 12rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .account-link[data-signed-in] {
    text-transform: none;
    letter-spacing: 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text);
  }
  .brand img {
    width: auto;
    height: 52px;
    border-radius: 6px;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: nowrap;
    justify-content: flex-end;
  }
  .nav a:not(.btn) {
    display: block;
    padding: 0.5rem 0.55rem;
    color: var(--ink-200);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 6px;
    position: relative;
    white-space: nowrap;
  }
  .nav a:not(.btn):hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
  }
  .nav a[aria-current='page'] {
    color: var(--accent);
  }
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.65rem;
    right: 0.65rem;
    bottom: 2px;
    height: 2px;
    background: var(--accent);
    border-radius: 1px;
  }
  .nav__cta {
    margin-left: 0.5rem;
  }
  .nav .btn {
    white-space: nowrap;
  }

  .menu-btn {
    display: none;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .menu-btn__bars,
  .menu-btn__bars::before,
  .menu-btn__bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    position: relative;
    transition: transform 0.2s ease;
  }
  .menu-btn__bars::before,
  .menu-btn__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .menu-btn__bars::before {
    top: -7px;
  }
  .menu-btn__bars::after {
    top: 7px;
  }
  .menu-btn[aria-expanded='true'] .menu-btn__bars {
    background: transparent;
  }
  .menu-btn[aria-expanded='true'] .menu-btn__bars::before {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .menu-btn__bars::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 1240px) {
    .menu-btn {
      display: inline-flex;
    }
    .nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--ink-900);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
      padding: 0.75rem var(--gutter) 1.25rem;
      max-height: calc(100dvh - 72px);
      overflow: auto;
    }
    .nav.is-open {
      display: block;
    }
    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav a:not(.btn) {
      padding: 0.8rem 0.5rem;
      font-size: 1.1rem;
      border-bottom: 1px solid var(--border);
      border-radius: 0;
    }
    .nav a[aria-current='page']::after {
      display: none;
    }
    .nav__cta {
      margin: 1rem 0 0;
    }
  }
</style>
