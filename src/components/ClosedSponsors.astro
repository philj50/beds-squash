---
import { url } from '@/lib/site';

interface Sponsor {
  name: string;
  href: string;
  src: string;
  dark?: boolean;
}

/** Main sponsor, then the additional sponsors confirmed for the 2027 County Closed. */
const main: Sponsor = {
  name: 'The Dental Centre Bedford',
  href: 'https://www.dentalcentrebedford.co.uk/',
  src: '/uploads/news/dental-centre-bedford.png',
};

const sponsors: Sponsor[] = [
  { name: 'The Bedford Cheese Company', href: 'https://bedfordcheesecompany.co.uk/', src: '/uploads/news/bedford-cheese-company.png' },
  { name: 'Brook Harris Bespoke Tailors', href: 'https://www.brookharris.co.uk/', src: '/uploads/news/brook-harris-v2.png', dark: true },
  { name: 'David Birch Soft Tissue Therapy', href: 'https://www.instagram.com/db.softtissuetherapist/', src: '/uploads/news/david-birch-soft-tissue-therapy.jpg' },
  { name: 'Decant Wine & Cheese Bar', href: 'https://decantbar.co.uk/', src: '/uploads/news/decant.png' },
  { name: 'EpicTech Media', href: 'https://www.epictechmedia.co.uk/', src: '/uploads/news/epictech-media-v2.png' },
  { name: 'J.A.J Electrical Services', href: 'https://www.instagram.com/j.a.jelectricalservices/', src: '/uploads/news/jaj-electrical-v2.png', dark: true },
  { name: 'JR Builders Ltd', href: 'https://jrbuilders-ltd.co.uk/', src: '/uploads/news/jr-builders.png' },
  { name: 'My Next Car', href: 'https://www.my-next-car.co.uk/', src: '/uploads/news/my-next-car.png' },
  { name: 'Open House', href: 'https://www.openhousebedford.co.uk/', src: '/uploads/news/open-house-v2.png' },
  { name: 'samo sports', href: 'https://www.instagram.com/samo.sports/', src: '/uploads/news/samo-sports.png' },
  { name: 'Specsavers', href: 'https://www.specsavers.co.uk/stores/bedford', src: '/uploads/news/specsavers.png' },
];

interface Props {
  place: 'main' | 'board';
}

const { place } = Astro.props;
---

{
  place === 'main' && (
    <a class="main-sponsor" href={main.href} target="_blank" rel="noopener noreferrer">
      <span class="eyebrow">Main sponsor</span>
      <img src={url(main.src)} alt={main.name} width="320" height="180" />
    </a>
  )
}

{
  place === 'board' && (
    <section class="sponsor-board" aria-label="Sponsors">
      <div class="sponsor-board__inner">
        <p class="eyebrow">Sponsors</p>
        <ul>
          {sponsors.map((sponsor) => (
            <li>
              <a href={sponsor.href} target="_blank" rel="noopener noreferrer" data-dark={sponsor.dark || undefined}>
                <img src={url(sponsor.src)} alt={sponsor.name} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .main-sponsor {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0.85rem 1.1rem 1rem;
    background: #fff;
    border: 1px solid rgba(14, 39, 68, 0.1);
    border-top: 3px solid var(--accent);
    border-radius: 14px;
    text-decoration: none;
    box-shadow: 0 10px 28px rgba(14, 39, 68, 0.07);
  }
  .main-sponsor .eyebrow {
    margin: 0;
  }
  .main-sponsor img {
    width: min(100%, 13.5rem);
    height: 7.25rem;
    object-fit: contain;
  }
  .main-sponsor:hover {
    border-color: rgba(241, 90, 34, 0.45);
  }

  .sponsor-board {
    background: #fff;
    border-block: 1px solid rgba(14, 39, 68, 0.08);
    padding: 1.15rem 0 1.35rem;
  }
  .sponsor-board__inner {
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
  }
  .sponsor-board .eyebrow {
    display: block;
    text-align: center;
    margin: 0 0 0.85rem;
  }
  .sponsor-board ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sponsor-board a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 10.25rem;
    height: 6.15rem;
    padding: 0.65rem 0.75rem;
    background: #fff;
    border: 1px solid rgba(14, 39, 68, 0.1);
    border-radius: 12px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .sponsor-board a[data-dark] {
    background: #111;
    border-color: #111;
  }
  .sponsor-board a:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(14, 39, 68, 0.1);
  }
  .sponsor-board img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
