---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_LABEL, SOURCE_LABEL, formatRange, formatTime, url } from '@/lib/site';

interface Props {
  event: CollectionEntry<'events'>;
  compact?: boolean;
}
const { event, compact = false } = Astro.props;
const { title, start, end, allDay, venue, source, category, cancelled } = event.data;
const href = url(`/events/${event.id}/`);
const month = new Intl.DateTimeFormat('en-GB', { month: 'short' }).format(start);
const day = start.getDate();
const isES = source === 'england-squash';
---

<article class:list={['card', 'event', { 'event--compact': compact, 'event--cancelled': cancelled }]}>
  <a href={href} class="event__date" aria-hidden="true" tabindex="-1">
    <span class="event__day">{day}</span>
    <span class="event__month">{month}</span>
  </a>
  <div class="event__body">
    <div class="card__meta">
      <span class:list={['pill', { 'pill--red': isES }]}>{SOURCE_LABEL[source]}</span>
      <span class="pill pill--muted">{CATEGORY_LABEL[category]}</span>
      {cancelled && <span class="pill pill--red">Cancelled</span>}
    </div>
    <h3 class="card__title"><a href={href}>{title}</a></h3>
    <p class="event__when">
      {formatRange(start, end)}{!allDay && ` · ${formatTime(start)}`}
      {venue && <span class="muted"> · {venue}</span>}
    </p>
  </div>
</article>

<style>
  .event {
    display: grid;
    grid-template-columns: 84px 1fr;
  }
  .event__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, var(--gold-500), var(--gold-600));
    color: var(--ink-950);
    text-decoration: none;
    font-family: var(--font-display);
    line-height: 1;
    padding: 0.75rem 0;
  }
  .event__day {
    font-size: 2.2rem;
    font-weight: 800;
  }
  .event__month {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .event__body {
    padding: 0.9rem 1.1rem 1rem;
  }
  .event__when {
    margin: 0.25rem 0 0;
    color: var(--ink-200);
    font-size: 0.95rem;
  }
  .event--compact .card__title {
    font-size: 1.15rem;
  }
  .event--cancelled .card__title a {
    text-decoration: line-through;
    color: var(--text-muted);
  }
  .event--cancelled .event__date {
    filter: grayscale(1);
    opacity: 0.6;
  }
</style>
