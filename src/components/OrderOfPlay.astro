---
import { defaultState, renderBoard, renderDraw, type TournamentData } from '@/lib/sportmgr';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';

interface Props {
  data: TournamentData;
  live?: boolean;
}
const { data, live = false } = Astro.props;
const state = defaultState(data);
const html = renderBoard(data, state);
const drawGrade = data.grades[0] ?? '';
const draw = renderDraw(data, drawGrade);
---

<div
  class="order-root"
  data-id={data.id}
  data-live={live ? 'true' : 'false'}
  data-today={state.today}
  data-url={SUPABASE_URL}
  data-key={SUPABASE_PUBLISHABLE_KEY}
>
  <div data-draw data-grade={drawGrade} set:html={draw} />
  <div data-view set:html={html} />
</div>

<script>
  import { createClient } from '@supabase/supabase-js';
  import {
    defaultState,
    londonMinutes,
    londonToday,
    renderBoard,
    renderDraw,
    type BoardState,
    type TournamentData,
    type TournamentEntry,
    type TournamentMatch,
  } from '@/lib/sportmgr';

  const files = import.meta.glob('../data/sportmgr/*.json', { eager: true });

  function snapshot(id: string): TournamentData | null {
    const key = Object.keys(files).find((path) => path.endsWith(`/${id}.json`));
    if (!key) return null;
    return (files[key] as { default: TournamentData }).default;
  }

  function fromRows(base: TournamentData, matchRows: Record<string, string>[], entryRows: Record<string, string>[], syncedAt: string): TournamentData {
    const matches: TournamentMatch[] = matchRows.map((row) => ({
      id: Number(row.id),
      date: row.played_on,
      start: row.start_time ?? '',
      end: row.end_time ?? '',
      court: row.court ?? '',
      grade: row.grade,
      round: row.round_label ?? '',
      home: row.home_name,
      away: row.away_name,
      score: row.score ?? '',
    }));
    const entries: TournamentEntry[] = entryRows.map((row) => ({
      grade: row.grade,
      name: row.player_name,
      seed: row.seed ?? '',
      club: row.club ?? '',
    }));
    const grades = [...base.grades];
    for (const grade of [...matches.map((match) => match.grade), ...entries.map((entry) => entry.grade)]) {
      if (!grades.includes(grade)) grades.push(grade);
    }
    const dates = [...new Set([...base.dates, ...matches.map((match) => match.date)])].sort();
    return { ...base, grades, dates, matches, entries, syncedAt: syncedAt || base.syncedAt };
  }

  function setup(root: HTMLElement) {
    const id = root.dataset.id;
    const view = root.querySelector<HTMLElement>('[data-view]');
    const draw = root.querySelector<HTMLElement>('[data-draw]');
    const base = id ? snapshot(id) : null;
    if (!id || !view || !draw || !base) return;

    let data = base;
    let drawGrade = draw.dataset.grade || data.grades[0] || '';
    let state: BoardState = { ...defaultState(data), today: root.dataset.today || londonToday() };

    let signedIn = false;
    const paintDraw = () => {
      if (!data.grades.includes(drawGrade)) drawGrade = data.grades[0] || '';
      draw.dataset.grade = drawGrade;
      draw.innerHTML = renderDraw(data, drawGrade);
      if (signedIn) draw.querySelectorAll<HTMLElement>('.draw-note').forEach((note) => { note.hidden = true; });
    };
    const paint = () => {
      view.innerHTML = renderBoard(data, state);
    };

    const followClock = () => {
      const today = londonToday();
      if (!data.dates.includes(today)) return;
      const viewingToday = state.day === state.today || state.day === today;
      state = { ...state, today, nowMinutes: londonMinutes(), day: viewingToday ? today : state.day };
      paint();
    };
    followClock();
    window.setInterval(followClock, 30_000);

    root.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const drawButton = target.closest<HTMLElement>('[data-draw-grade]');
      if (drawButton?.dataset.drawGrade) {
        drawGrade = drawButton.dataset.drawGrade;
        paintDraw();
        return;
      }
      const day = target.closest<HTMLElement>('[data-day]');
      const grade = target.closest<HTMLElement>('[data-grade-filter]');
      if (day?.dataset.day) state = { ...state, day: day.dataset.day };
      if (grade?.dataset.gradeFilter) state = { ...state, grade: grade.dataset.gradeFilter };
      if (day || grade) paint();
    });

    if (!root.dataset.url || !root.dataset.key) return;
    const supabase = createClient(root.dataset.url, root.dataset.key);
    void supabase.auth.getSession().then(({ data: session }) => {
      signedIn = Boolean(session.session);
      if (signedIn) draw.querySelectorAll<HTMLElement>('.draw-note').forEach((note) => { note.hidden = true; });
    });
    if (root.dataset.live !== 'true') return;
    const refresh = async () => {
      const [matches, entries, tournament] = await Promise.all([
        supabase.from('sportmgr_matches').select('id,played_on,start_time,end_time,court,grade,round_label,home_name,away_name,score').eq('tournament_id', Number(id)),
        supabase.from('sportmgr_entries').select('grade,player_name,club,seed').eq('tournament_id', Number(id)),
        supabase.from('sportmgr_tournaments').select('synced_at').eq('id', Number(id)).maybeSingle(),
      ]);
      if (matches.error || entries.error || tournament.error) return false;
      const remoteMatches = matches.data ?? [];
      if (remoteMatches.length === 0 && base.matches.length > 0) return true;
      data = fromRows(base, remoteMatches as Record<string, string>[], (entries.data ?? []) as Record<string, string>[], tournament.data?.synced_at ?? '');
      state = { ...state, showUpdated: true };
      if (data.dates.includes(state.day) === false && data.dates[0]) state = { ...state, day: data.dates[0] };
      paintDraw();
      paint();
      return true;
    };
    void refresh().then((ok) => {
      if (!ok) return;
      window.setInterval(() => void refresh(), 60_000);
    });
  }

  for (const root of document.querySelectorAll<HTMLElement>('.order-root')) setup(root);
</script>

<style>
  .order-root :global(.filters) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 0.7rem;
  }
  .order-root :global(.filters .pill) {
    cursor: pointer;
    background: transparent;
    color: var(--ink-200);
    border: 1px solid var(--border-strong);
    padding: 0.35rem 0.8rem;
    font-size: 0.85rem;
  }
  .order-root :global(.filters .pill.is-active) {
    background: var(--accent);
    color: var(--ink-950);
    border-color: var(--accent);
  }
  .order-root :global(.day-heading) {
    margin: 0.2rem 0 0.4rem;
  }
  .order-root :global(.on-now) {
    margin: 0 0 1rem;
  }
  .order-root :global(.on-now__head) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.45rem;
  }
  .order-root :global(.on-now h3) {
    margin: 0;
  }
  .order-root :global(.courts) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.6rem;
  }
  .order-root :global(.court-card) {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.7rem 0.85rem;
  }
  .order-root :global(.court-card--live) {
    border-color: var(--accent);
    border-top: 3px solid var(--accent);
  }
  .order-root :global(.court-card .eyebrow) {
    color: var(--accent);
  }
  .order-root :global(.court-card strong) {
    display: block;
    margin-bottom: 0.25rem;
    font-variant-numeric: tabular-nums;
  }
  .order-root :global(.court-card p) {
    margin: 0;
  }
  .order-root :global(.programme) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .order-root :global(.match) {
    display: grid;
    grid-template-columns: 5.4rem minmax(0, 1fr) auto;
    gap: 0.35rem 1rem;
    align-items: start;
    padding: 0.7rem 0;
    border-top: 1px solid var(--border);
  }
  .order-root :global(.match__when) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.28rem;
  }
  .order-root :global(.match__time) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: 0.03em;
  }
  .order-root :global(.match__court) {
    display: inline-block;
    padding: 0.08rem 0.4rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .order-root :global(.match__grade) {
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .order-root :global(.match__players) {
    display: block;
  }
  .order-root :global(.match__players a) {
    color: var(--link);
    text-decoration: none;
  }
  .order-root :global(.winner) {
    color: var(--link);
    font-weight: 700;
  }
  .order-root :global(.v) {
    color: var(--text-muted);
    font-weight: 600;
    padding-inline: 0.2rem;
  }
  .order-root :global(.match__score) {
    font-variant-numeric: tabular-nums;
    text-align: right;
    font-weight: 600;
  }
  .order-root :global(.match--pending .match__score) {
    font-weight: 500;
    color: var(--text-muted);
  }
  .order-root :global(.match-note) {
    list-style: none;
    margin-top: 0.8rem;
    padding-top: 0.6rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .order-root :global(.player-list) {
    margin-top: 1.25rem;
    border-top: 1px solid var(--border);
    padding-top: 0.8rem;
  }
  .order-root :global(.player-list summary) {
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .order-root :global(.player-list summary span) {
    color: var(--text-muted);
    font-weight: 600;
  }
  .order-root :global(.player-grades) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.8rem 1.5rem;
    margin-top: 0.8rem;
  }
  .order-root :global(.player-grades h3) {
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }
  .order-root :global(.player-grades ol) {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .order-root :global(.player-grades li) {
    padding: 0.15rem 0;
  }
  .order-root :global(.seed) {
    display: inline-block;
    min-width: 1.6rem;
    margin-right: 0.35rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .order-root :global(.draw-filters) {
    flex-wrap: nowrap;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }
  .order-root :global(.draw-filters .pill) {
    flex: none;
  }
  .order-root :global(.draw-note) {
    margin: -0.15rem 0 0.65rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-style: italic;
  }
  .order-root :global(.draw-note[hidden]) {
    display: none;
  }
  .order-root :global(a.player-link) {
    color: inherit;
    text-decoration: none;
  }
  .order-root :global(a.player-link:hover) {
    text-decoration: underline;
  }
  .order-root :global(.champion) {
    background: var(--ink-950);
    color: #fff;
    border-radius: var(--radius);
    padding: 0.75rem 0.95rem 0.85rem;
    margin: 0 0 0.75rem;
    box-shadow: var(--shadow);
  }
  .order-root :global(.champion .eyebrow) {
    color: var(--accent);
  }
  .order-root :global(.champion strong) {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 6vw, 2.3rem);
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .order-root :global(.champion p) {
    margin: 0.3rem 0 0;
    color: rgba(255, 255, 255, 0.82);
  }
  .order-root :global(.champion a) {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }
  .order-root :global(.champion p span) {
    color: #fff;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .order-root :global(.champion .v) {
    color: rgba(255, 255, 255, 0.7);
    font-weight: 600;
  }
  .order-root :global(.sides) {
    display: grid;
    gap: 0.8rem;
  }
  .order-root :global(.side h3) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.35rem;
  }
  .order-root :global(.side h3 span) {
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .order-root :global(.side h3 strong) {
    color: var(--link);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1;
    text-align: right;
    text-transform: uppercase;
  }
  .order-root :global(.bracket-scroll) {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-bottom: 0.2rem;
  }
  .order-root :global(.sheet) {
    position: relative;
  }
  .order-root :global(.wires) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .order-root :global(.wires path) {
    fill: none;
    stroke: var(--ink-300);
    stroke-width: 1.5;
  }
  .order-root :global(.wires path.is-path) {
    stroke: var(--accent);
    stroke-width: 2.5;
  }
  .order-root :global(.col-label) {
    position: absolute;
    top: 0;
    width: 172px;
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .order-root :global(.cell) {
    position: absolute;
    width: 172px;
    height: 54px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.15rem 0.4rem;
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ink-950) 8%, transparent);
  }
  .order-root :global(.cell.is-path) {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-card));
  }
  .order-root :global(.cell.is-blank) {
    background: transparent;
    box-shadow: none;
  }
  .order-root :global(.cell.is-blank .line) {
    height: 0.45rem;
    margin: 0.16rem 0;
    border-radius: 99px;
    background: var(--border-strong);
  }
  .order-root :global(.line) {
    display: flex;
    align-items: baseline;
    gap: 0.28rem;
    min-width: 0;
    color: var(--text);
    font-size: 0.78rem;
    line-height: 1.15;
    text-decoration: none;
  }
  .order-root :global(a.line:not(.is-winner)) {
    color: var(--link);
  }
  .order-root :global(.line .seed) {
    flex: none;
    min-width: 0;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.62rem;
    font-weight: 700;
  }
  .order-root :global(.line .who) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .order-root :global(.line.is-winner) {
    color: var(--ink-950);
    font-weight: 700;
  }
  .order-root :global(.cell.is-path .line.is-winner) {
    color: var(--link);
  }
  .order-root :global(.line.is-bye) {
    color: var(--text-muted);
    font-style: italic;
  }
  .order-root :global(.pts) {
    color: var(--text-muted);
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .order-root :global(.also) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .order-root :global(.also .cell) {
    position: static;
  }
  .order-root :global(.side--extra) {
    margin-top: 0.35rem;
  }
  .order-root :global(.side .muted) {
    margin: 0.2rem 0 0.4rem;
  }
  @media (max-width: 720px) {
    .order-root :global(.match) {
      grid-template-columns: 5.4rem minmax(0, 1fr);
    }
    .order-root :global(.match__score) {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
