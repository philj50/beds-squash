---
import tour from '@/data/psa-tour.json';
import { SITE, formatDate, formatRange, url } from '@/lib/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const events = compact ? tour.events.slice(0, 2) : tour.events;
const video = tour.videos[0];
const moreVideos = compact ? [] : tour.videos.slice(1);
const checked = tour.checkedAt ? formatDate(new Date(tour.checkedAt)) : '';

function onDate(iso: string) {
  const [year, month, day] = iso.split('-').map(Number);
  return new Date(year, month - 1, day);
}
---

<section class="section psa" id="psa-tour">
  <div class="container">
    <div class="section-head">
      <h2>PSA tour in England</h2>
      {compact && <a href={url('/events/#psa-tour')}>On the calendar →</a>}
    </div>
    <p class="muted">The next England events from the public PSA calendar.</p>
    <p class="psa__links">
      <a href={SITE.psaTour} target="_blank" rel="noopener">PSA calendar ↗</a>
      <a href={SITE.squashTv} target="_blank" rel="noopener">SquashTV schedule ↗</a>
      <a href={SITE.squashTvFree} target="_blank" rel="noopener">Free highlights ↗</a>
    </p>
    {
      events.length > 0 ? (
        <div class="grid grid--2">
          {events.map((event) => (
            <article class="card psa-event">
              <div class="card__body">
                <div class="card__meta">
                  <span class="pill">PSA</span>
                  {event.level && <span class="pill pill--muted">{event.level}</span>}
                  {event.prize && <span class="pill pill--muted">{event.prize}</span>}
                </div>
                <h3 class="card__title"><a href={event.url} target="_blank" rel="noopener">{event.title}</a></h3>
                <p class="muted">
                  {formatRange(onDate(event.start), onDate(event.end))}
                  {event.venue && <> · {event.venue}</>}
                </p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="notice">No England events are listed on the PSA calendar just now.</p>
      )
    }
    {
      video && !compact && (
        <div class="psa-watch">
          <h3>Latest highlight</h3>
          <div class="psa-film">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${video.id}`}
              title={video.title}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <p><a href={video.url} target="_blank" rel="noopener">{video.title}</a></p>
          {
            moreVideos.length > 0 && (
              <ul>
                {moreVideos.map((item) => (
                  <li><a href={item.url} target="_blank" rel="noopener">{item.title}</a></li>
                ))}
              </ul>
            )
          }
        </div>
      )
    }
    {
      video && compact && (
        <p><a href={video.url} target="_blank" rel="noopener">Latest highlight: {video.title}</a></p>
      )
    }
    {checked && <p class="muted small">Checked {checked}. Live matches stay on SquashTV.</p>}
  </div>
</section>

<style>
  .psa__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 0.4rem 0 1rem;
    font-weight: 600;
  }
  .psa-event .card__title {
    font-size: 1.2rem;
  }
  .psa-watch {
    margin-top: 1.5rem;
  }
  .psa-watch h3 {
    margin-bottom: 0.6rem;
  }
  .psa-film {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 720px;
    background: #000;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .psa-film iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .psa-watch ul {
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
  }
</style>
