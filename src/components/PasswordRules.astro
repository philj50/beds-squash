---
/** Live password checklist. Pair with bindPasswordRules() on the surrounding form. */
---

<ul class="pw-rules" data-password-rules hidden>
  <li data-rule="length">At least 12 characters</li>
  <li data-rule="lower">A lowercase letter</li>
  <li data-rule="upper">An uppercase letter</li>
  <li data-rule="number">A number</li>
  <li data-rule="symbol">A symbol</li>
</ul>
<p class="pw-meter" data-password-strength hidden></p>

<style is:global>
  .pw-rules {
    list-style: none;
    margin: 0;
    padding: 0.15rem 0 0;
    display: grid;
    gap: 0.2rem;
  }
  .pw-rules li {
    font-size: 0.85rem;
    color: var(--ink-300);
  }
  .pw-rules li::before {
    content: '○ ';
  }
  .pw-rules li.met {
    color: var(--gold-400);
  }
  .pw-rules li.met::before {
    content: '✓ ';
  }
  .pw-meter {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .pw-meter[data-level='weak'] {
    color: var(--red-600);
  }
  .pw-meter[data-level='fair'] {
    color: var(--gold-400);
  }
  .pw-meter[data-level='strong'] {
    color: #7dcea0;
  }
</style>
