---
import { SITE, url } from '@/lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <img src={url('/brand/logo-navy.png')} alt="" width="193" height="114" />
      <p class="legal">{SITE.legalName}</p>
      <p class="muted">
        Affiliated to <a href={SITE.englandSquash} target="_blank" rel="noopener">England Squash</a>. Promoting squash
        and racketball across Bedfordshire and Milton Keynes.
      </p>
      <div class="social">
        <a href={SITE.facebook} target="_blank" rel="noopener" aria-label="Beds SRA on Facebook">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"
            ><path
              d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12"
            /></svg
          >
        </a>
        <a href={`mailto:${SITE.email}`} aria-label="Email Beds SRA">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
            ><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg
          >
        </a>
      </div>
    </div>
  </div>
  <div class="container bottom">
    <span>© {year} {SITE.legalName}</span>
    <span>
      <a href={url('/documents/')}>Policies</a> · <button type="button" data-cookie-settings>Cookies</button>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 1.5rem;
    border-top: 1px solid var(--border);
    background: var(--ink-950);
    padding: 1.25rem 0 0.85rem;
    font-size: 0.95rem;
  }
  :global(html[data-theme='navy']) .site-footer,
  :global(html[data-theme='light']) .site-footer {
    background: #0e2744;
    color: #e7eef6;
    border-top: 0;
  }
  :global(html[data-theme='navy']) .site-footer .muted,
  :global(html[data-theme='navy']) .site-footer a,
  :global(html[data-theme='navy']) .site-footer .bottom,
  :global(html[data-theme='navy']) .site-footer .bottom button,
  :global(html[data-theme='light']) .site-footer .muted,
  :global(html[data-theme='light']) .site-footer a,
  :global(html[data-theme='light']) .site-footer .bottom,
  :global(html[data-theme='light']) .site-footer .bottom button {
    color: #e7eef6;
  }
  :global(html[data-theme='navy']) .site-footer a:hover,
  :global(html[data-theme='light']) .site-footer a:hover {
    color: #fff;
  }
  :global(html[data-theme='navy']) .site-footer .legal,
  :global(html[data-theme='light']) .site-footer .legal {
    color: #fff;
  }
  .grid {
    display: block;
  }
  .about {
    max-width: 36rem;
  }
  .about img {
    display: block;
    width: min(100%, 193px);
    height: auto;
    border-radius: 8px;
    margin-bottom: 0.4rem;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
  }
  .legal {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.15rem;
  }
  .social {
    display: flex;
    gap: 0.75rem;
  }
  .social a {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--ink-200);
  }
  .social a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .bottom {
    margin-top: 0.9rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .bottom a,
  .bottom button {
    color: var(--text-muted);
  }
  .bottom button {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
  }
</style>
