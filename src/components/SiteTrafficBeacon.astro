---
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';

interface Props {
  /** Captain and admin pages are only counted when someone is signed in. */
  signedInOnly?: boolean;
}

const { signedInOnly = false } = Astro.props;
const path = Astro.url.pathname;
---

<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, path, signedInOnly }}>
  (function () {
    const SESSION_KEY = 'beds_traffic_session';
    function readLogin() {
      try {
        const ref = new URL(SUPABASE_URL).hostname.split('.')[0];
        const raw = localStorage.getItem('sb-' + ref + '-auth-token');
        if (!raw) return null;
        const stored = JSON.parse(raw);
        const session = stored && stored.access_token ? stored : stored && stored.currentSession;
        if (!session || typeof session.access_token !== 'string' || !session.access_token) return null;
        const fresh = !(session.expires_at && session.expires_at * 1000 < Date.now() + 5000);
        return { token: session.access_token, fresh: fresh };
      } catch (e) {
        return null;
      }
    }
    function send(token) {
      try {
        let sessionId = sessionStorage.getItem(SESSION_KEY);
        if (!sessionId) {
          sessionId = crypto.randomUUID();
          sessionStorage.setItem(SESSION_KEY, sessionId);
        }
        fetch(`${SUPABASE_URL}/rest/v1/rpc/record_site_page_view`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: SUPABASE_PUBLISHABLE_KEY,
            Authorization: 'Bearer ' + (token || SUPABASE_PUBLISHABLE_KEY),
          },
          body: JSON.stringify({ p_path: path, p_session_id: sessionId }),
          keepalive: true,
        }).catch(() => {});
      } catch (e) {
        /* ignore */
      }
    }
    const login = readLogin();
    if (login && login.fresh) {
      send(login.token);
      return;
    }
    if (!login) {
      if (!signedInOnly) send('');
      return;
    }
    const started = Date.now();
    const timer = setInterval(function () {
      const next = readLogin();
      if (next && next.fresh) {
        clearInterval(timer);
        send(next.token);
        return;
      }
      if (Date.now() - started < 8000) return;
      clearInterval(timer);
      if (!signedInOnly) send('');
    }, 250);
  })();
</script>
