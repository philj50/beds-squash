---
import PasswordRules from '@/components/PasswordRules.astro';

/** Signed-in password change. The nearest ancestor with data-url and data-key is the Supabase client. */
---

<form class="card password-card" method="post" data-change-password>
  <div class="card__body stack">
    <h2>Change your password</h2>
    <p class="muted small">
      You need the password you use now. The new one has to meet every line below. Nothing is emailed.
    </p>
    <p class="password-status" data-password-status role="status"></p>
    <input class="sr-only" type="text" name="username" autocomplete="username" tabindex="-1" data-account-email readonly />
    <label>
      Current password
      <span class="pw-field">
        <input name="current_password" type="password" required autocomplete="current-password" />
        <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
      </span>
    </label>
    <label>
      New password
      <span class="pw-field">
        <input name="password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" passwordrules="minlength: 12; required: lower; required: upper; required: digit; required: special;" />
        <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
      </span>
      <PasswordRules />
    </label>
    <label>
      Confirm new password
      <span class="pw-field">
        <input name="confirm_password" type="password" required minlength="12" maxlength="72" autocomplete="new-password" />
        <button class="btn btn--ghost btn--sm" type="button" data-toggle-password>Show</button>
      </span>
    </label>
    <button class="btn btn--primary btn--sm" type="submit">Update password</button>
  </div>
</form>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { bindPasswordRules, bindPasswordToggles, changeOwnPassword, offerToSavePassword } from '@/lib/passwords';

  document.querySelectorAll<HTMLFormElement>('[data-change-password]').forEach((form) => {
    if (form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    bindPasswordToggles(form);
    bindPasswordRules(form);
    const status = form.querySelector<HTMLElement>('[data-password-status]')!;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const host = form.closest<HTMLElement>('[data-url][data-key]');
      if (!host?.dataset.url || !host.dataset.key) {
        status.textContent = 'Password change is not available on this page.';
        return;
      }
      const data = new FormData(form);
      status.textContent = 'Updating password…';
      const supabase = createClient(host.dataset.url, host.dataset.key);
      const { data: sessionData } = await supabase.auth.getSession();
      const emailInput = form.querySelector<HTMLInputElement>('[data-account-email]');
      if (emailInput && sessionData.session?.user.email) emailInput.value = sessionData.session.user.email;
      const message = await changeOwnPassword(
        supabase,
        String(data.get('current_password') ?? ''),
        String(data.get('password') ?? ''),
        String(data.get('confirm_password') ?? ''),
      );
      status.textContent = message ?? 'Password updated. Use the new one next time you sign in.';
      if (!message) {
        await offerToSavePassword(form);
        form.reset();
      }
    });
  });
</script>

<style>
  .password-card {
    margin-top: 1rem;
  }
  .password-card h2 {
    margin: 0;
    font-size: 1.2rem;
  }
  .stack {
    display: grid;
    gap: 0.75rem;
  }
  .small {
    margin: 0;
    font-size: 0.85rem;
  }
  .password-status:empty {
    display: none;
  }
  .password-status {
    margin: 0;
    color: var(--gold-400);
  }
  label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  input {
    width: 100%;
    background: var(--ink-900);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.75rem;
    font: inherit;
  }
  .pw-field {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .pw-field input {
    flex: 1;
    min-width: 0;
  }
</style>
