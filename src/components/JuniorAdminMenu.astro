---
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '@/lib/supabase-public';
import { url } from '@/lib/site';
---

<div class="junior-admin no-print" data-junior-admin hidden data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY}>
  <button class="junior-admin__toggle" type="button" data-junior-admin-toggle aria-expanded="false" aria-haspopup="menu" aria-controls="junior-admin-menu">
    Junior admin
  </button>
  <div id="junior-admin-menu" class="junior-admin__menu" data-junior-admin-menu hidden role="menu">
    <a role="menuitem" href={url('/juniors/closed/entries/')}>County Closed entries</a>
  </div>
</div>

<script>
  import { createClient } from '@supabase/supabase-js';

  const roots = [...document.querySelectorAll<HTMLElement>('[data-junior-admin]')];
  const first = roots[0];
  if (first?.dataset.url && first.dataset.key) {
    const supabase = createClient(first.dataset.url, first.dataset.key);

    const closeAll = () => {
      for (const root of roots) {
        root.querySelector('[data-junior-admin-toggle]')?.setAttribute('aria-expanded', 'false');
        const menu = root.querySelector<HTMLElement>('[data-junior-admin-menu]');
        if (menu) menu.hidden = true;
      }
    };

    for (const root of roots) {
      const toggle = root.querySelector<HTMLButtonElement>('[data-junior-admin-toggle]');
      const menu = root.querySelector<HTMLElement>('[data-junior-admin-menu]');
      toggle?.addEventListener('click', (event) => {
        event.stopPropagation();
        const open = toggle.getAttribute('aria-expanded') === 'true';
        closeAll();
        if (!open && menu) {
          toggle.setAttribute('aria-expanded', 'true');
          menu.hidden = false;
        }
      });
    }

    document.addEventListener('click', (event) => {
      if (!(event.target as HTMLElement).closest('[data-junior-admin]')) closeAll();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAll();
    });

    const { data } = await supabase.auth.getSession();
    const session = data.session;
    if (session) {
      const { data: me } = await supabase.from('profiles').select('is_admin').eq('id', session.user.id).maybeSingle();
      if (me?.is_admin) {
        for (const root of roots) root.hidden = false;
      }
    }
  }
</script>

<style>
  .junior-admin {
    position: relative;
    display: inline-block;
  }
  .junior-admin[hidden] {
    display: none;
  }
  .junior-admin__toggle {
    appearance: none;
    background: transparent;
    border: 1px solid var(--gold-500);
    color: var(--gold-400);
    font: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    cursor: pointer;
  }
  .junior-admin__toggle::after {
    content: '';
    display: inline-block;
    margin-left: 0.4rem;
    border: 4px solid transparent;
    border-top-color: currentColor;
    vertical-align: middle;
  }
  .junior-admin__toggle:hover,
  .junior-admin__toggle[aria-expanded='true'] {
    color: var(--ink-950);
    background: var(--gold-500);
  }
  .junior-admin__menu {
    position: absolute;
    left: 0;
    top: calc(100% + 0.35rem);
    min-width: 14rem;
    z-index: 20;
    background: var(--ink-900);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 0.35rem;
    box-shadow: var(--shadow);
  }
  .junior-admin__menu a {
    display: block;
    padding: 0.5rem 0.7rem;
    border-radius: 6px;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .junior-admin__menu a:hover {
    color: var(--gold-400);
    background: rgba(255, 255, 255, 0.06);
  }
</style>
